// Custom error handling for Service Usage v2 backend constraints
if err != nil {
    // 1. Handle ETag mismatch (Concurrent Modifications)
    if strings.Contains(err.Error(), "SU_CONFLICTING_CONCURRENT_MODIFICATION") {
        return fmt.Errorf("The consumer policy might have been changed from other toolings. Please try again: %w", err)
    }
    
    // 2. Handle 30-day active usage restrictions blocking removal
    if strings.Contains(err.Error(), "COMMON_SU_SERVICES_HAVE_USAGE") || strings.Contains(err.Error(), "COMMON_SU_SERVICES_HAVE_HIERARCHICAL_USAGE") {
         return fmt.Errorf("The service has been used in the last 30 days or was enabled in the past 3 days. To bypass this check and force removal, set check_usage_on_remove to false: %w", err)
    }
}
