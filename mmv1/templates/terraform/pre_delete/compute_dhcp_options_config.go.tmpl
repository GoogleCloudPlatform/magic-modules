// Compute DhcpOptionsConfig Delete fails if any network associations remain.
// Only clear associations automatically before deleting when deletion_policy is "FORCE".
// Otherwise let DELETE run so Compute Engine deletes unassociated configs or fails with an association error.
if deletionPolicy, _ := d.Get("deletion_policy").(string); deletionPolicy == "FORCE" {
	getRes, getErr := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   billingProject,
		RawURL:    url,
		UserAgent: userAgent,
		Timeout:   d.Timeout(schema.TimeoutDelete),
		Headers:   headers,
	})
	if getErr != nil {
		return transport_tpg.HandleNotFoundError(getErr, d, fmt.Sprintf("DhcpOptionsConfig %q", d.Id()))
	}
	if assocs, ok := getRes["associations"].(map[string]interface{}); ok && len(assocs) > 0 {
		clearUrl, err := transport_tpg.AddQueryParams(url, map[string]string{"updateMask": "associations"})
		if err != nil {
			return err
		}

		log.Printf("[DEBUG] Clearing associations before deleting DhcpOptionsConfig %q", d.Id())
		patchRes, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "PATCH",
			Project:   billingProject,
			RawURL:    clearUrl,
			UserAgent: userAgent,
			Body:      map[string]interface{}{},
			Timeout:   d.Timeout(schema.TimeoutDelete),
			Headers:   headers,
		})
		if err != nil {
			return fmt.Errorf("Error clearing associations before deleting DhcpOptionsConfig %q: %s", d.Id(), err)
		}

		err = ComputeOperationWaitTime(
			config, patchRes, project, "Clearing DhcpOptionsConfig associations", userAgent,
			d.Timeout(schema.TimeoutDelete))
		if err != nil {
			return fmt.Errorf("Error waiting to clear DhcpOptionsConfig associations %q: %s", d.Id(), err)
		}
	}
}
