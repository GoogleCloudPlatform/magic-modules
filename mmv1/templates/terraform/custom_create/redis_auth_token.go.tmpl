userAgent, err := tpgresource.GenerateUserAgentString(d, config.UserAgent)
if err != nil {
	return err
}

// --- Begin Custom Code: Unpack full cluster self-link and acquire per-user mutex lock ---
// If the user passed a full cluster resource ID (projects/{p}/locations/{r}/clusters/{c})
// instead of a short cluster name, extract project, region, and the short cluster name.
cluster := d.Get("cluster").(string)
if parts := regexp.MustCompile("projects/([^/]+)/locations/([^/]+)/clusters/([^/]+)").FindStringSubmatch(cluster); parts != nil {
	if d.Get("project") == "" {
		d.Set("project", parts[1])
	}
	if d.Get("region") == "" {
		d.Set("region", parts[2])
	}
	d.Set("cluster", parts[3])
}

// Serialize token operations per (cluster, user_id) because the backend transitions the parent
// TokenAuthUser to UPDATING during :addAuthToken and rejects concurrent token mutations.
lockName, err := tpgresource.ReplaceVars(d, config, "projects/{{"{{"}}project{{"}}" }}/locations/{{"{{"}}region{{"}}" }}/clusters/{{"{{"}}cluster{{"}}" }}/tokenAuthUsers/{{"{{"}}user_id{{"}}" }}")
if err != nil {
	return err
}
transport_tpg.MutexStore.Lock(lockName)
defer transport_tpg.MutexStore.Unlock(lockName)

requestedTokenId := ""
if v, ok := d.GetOk("token_id"); ok && v.(string) != "" {
	requestedTokenId = tpgresource.GetResourceNameFromSelfLink(v.(string))
}

listUrl, err := tpgresource.ReplaceVars(d, config, "{{"{{"}}RedisBasePath{{"}}" }}projects/{{"{{"}}project{{"}}" }}/locations/{{"{{"}}region{{"}}" }}/clusters/{{"{{"}}cluster{{"}}" }}/tokenAuthUsers/{{"{{"}}user_id{{"}}" }}/authTokens")
if err != nil {
	return err
}
// --- End Custom Code ---

url, err := tpgresource.ReplaceVars(d, config, "{{"{{"}}RedisBasePath{{"}}" }}projects/{{"{{"}}project{{"}}" }}/locations/{{"{{"}}region{{"}}" }}/clusters/{{"{{"}}cluster{{"}}" }}/tokenAuthUsers/{{"{{"}}user_id{{"}}" }}:addAuthToken")
if err != nil {
	return err
}

project, err := tpgresource.GetProject(d, config)
if err != nil {
	return fmt.Errorf("Error fetching project for AuthToken: %s", err)
}
billingProject := project
if parts := regexp.MustCompile(`projects\/([^\/]+)\/`).FindStringSubmatch(listUrl); parts != nil {
	billingProject = parts[1]
}
if bp, err := tpgresource.GetBillingProject(d, config); err == nil {
	billingProject = bp
}

// --- Begin Custom Code: Acquire existing AuthToken (e.g. initial version-1) if token_id is specified ---
// Creating a cluster (for "default") or a TokenAuthUser automatically provisions an initial
// "version-1" token on the server. When token_id is explicitly specified in configuration and
// matches an existing active token for the user, adopt that token into state instead of calling :addAuthToken.
if requestedTokenId != "" {
	res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   billingProject,
		RawURL:    listUrl,
		UserAgent: userAgent,
	})
	if err != nil {
		return fmt.Errorf("Error listing authTokens for %s: %s", listUrl, err)
	}
	if tokens, ok := res["authTokens"].([]interface{}); ok {
		for _, t := range tokens {
			tokenMap, ok := t.(map[string]interface{})
			if !ok {
				continue
			}
			name, _ := tokenMap["name"].(string)
			if tpgresource.GetResourceNameFromSelfLink(name) == requestedTokenId {
				d.SetId(name)
				if err := d.Set("name", name); err != nil {
					return fmt.Errorf("Error setting name: %s", err)
				}
				if err := d.Set("token_id", requestedTokenId); err != nil {
					return fmt.Errorf("Error setting token_id: %s", err)
				}
				log.Printf("[DEBUG] Acquired existing AuthToken %q", d.Id())
				return resourceRedisClusterAuthTokenRead(d, meta)
			}
		}
	}
}
// --- End Custom Code ---

res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
	Config:    config,
	Method:    "POST",
	Project:   billingProject,
	RawURL:    url,
	UserAgent: userAgent,
	Timeout:   d.Timeout(schema.TimeoutCreate),
})
if err != nil {
	return fmt.Errorf("Error creating AuthToken: %s", err)
}

err = RedisOperationWaitTime(
	config, res, project, "Creating AuthToken", userAgent,
	d.Timeout(schema.TimeoutCreate))
if err != nil {
	return fmt.Errorf("Error waiting to create AuthToken: %s", err)
}

// --- Begin Custom Code: Discover server-assigned token_id via ListAuthTokens ---
// The :addAuthToken LRO response returns the parent TokenAuthUser rather than the newly created
// AuthToken, and the server auto-assigns the sequential version-N ID. List the user's tokens
// after the LRO completes to determine the newly created token's name and token_id.
listRes, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
	Config:    config,
	Method:    "GET",
	Project:   billingProject,
	RawURL:    listUrl,
	UserAgent: userAgent,
})
if err != nil {
	return fmt.Errorf("Error listing authTokens for %s: %s", listUrl, err)
}

var matchedToken map[string]interface{}
if tokens, ok := listRes["authTokens"].([]interface{}); ok && len(tokens) > 0 {
	if requestedTokenId != "" {
		for _, t := range tokens {
			if tm, ok := t.(map[string]interface{}); ok {
				if name, ok := tm["name"].(string); ok && tpgresource.GetResourceNameFromSelfLink(name) == requestedTokenId {
					matchedToken = tm
					break
				}
			}
		}
		if matchedToken == nil {
			return fmt.Errorf("Created token %q not found in authTokens list", requestedTokenId)
		}
	} else {
		maxVersion := -1
		for _, t := range tokens {
			if tm, ok := t.(map[string]interface{}); ok {
				if name, ok := tm["name"].(string); ok {
					tokenId := tpgresource.GetResourceNameFromSelfLink(name)
					var vNum int
					if _, err := fmt.Sscanf(tokenId, "version-%d", &vNum); err == nil {
						if vNum > maxVersion {
							maxVersion = vNum
							matchedToken = tm
						}
					} else if matchedToken == nil {
						matchedToken = tm
					}
				}
			}
		}
		if matchedToken == nil {
			matchedToken = tokens[len(tokens)-1].(map[string]interface{})
		}
	}
} else {
	return fmt.Errorf("No authTokens returned after create for %s", listUrl)
}

tokenName, ok := matchedToken["name"].(string)
if !ok {
	return fmt.Errorf("AuthToken response missing name attribute")
}
tokenId := tpgresource.GetResourceNameFromSelfLink(tokenName)
d.SetId(tokenName)
if err := d.Set("name", tokenName); err != nil {
	return fmt.Errorf("Error setting name: %s", err)
}
if err := d.Set("token_id", tokenId); err != nil {
	return fmt.Errorf("Error setting token_id: %s", err)
}
// --- End Custom Code ---

return resourceRedisClusterAuthTokenRead(d, meta)
