userAgent, err := tpgresource.GenerateUserAgentString(d, config.UserAgent)
if err != nil {
	return err
}

if err := vertexAIPublisherModelConfigValidateScope(d); err != nil {
	return err
}
if err := vertexAIPublisherModelConfigSetRegion(d); err != nil {
	return fmt.Errorf("Error setting region: %s", err)
}

obj, updateMask, err := vertexAIPublisherModelConfigBuildRequest(d, config)
if err != nil {
	return err
}
if len(updateMask) == 0 {
	return fmt.Errorf("at least one of `inference_event_logging_config` or `logging_config` must be configured")
}

if err := vertexAIPublisherModelConfigSet(d, config, userAgent, obj, updateMask, "Creating", d.Timeout(schema.TimeoutCreate)); err != nil {
	return err
}

// Store the ID now
id, err := vertexAIPublisherModelConfigId(d, config)
if err != nil {
	return fmt.Errorf("Error constructing id: %s", err)
}
d.SetId(id)

log.Printf("[DEBUG] Finished creating PublisherModelConfig %q", d.Id())

return resourceVertexAIPublisherModelConfigRead(d, meta)
