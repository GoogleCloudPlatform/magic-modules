// vertexAIPublisherModelConfigRegionPlaceholder is the regional host placeholder used in the
// Vertex AI product base URL (https://{{"{{"}}region{{"}}"}}-aiplatform.googleapis.com/...).
const vertexAIPublisherModelConfigRegionPlaceholder = "{{"{{"}}region{{"}}"}}"

// vertexAIPublisherModelConfigIsProjectLevel reports whether the resource manages the
// project-wide default configuration (no location/publisher/model set).
func vertexAIPublisherModelConfigIsProjectLevel(d tpgresource.TerraformResourceData) bool {
	return d.Get("model").(string) == "" && d.Get("publisher").(string) == "" && d.Get("location").(string) == ""
}

// vertexAIPublisherModelConfigValidateScope ensures that location, publisher and model are
// either all set (per-model binding) or all unset (project-wide binding).
func vertexAIPublisherModelConfigValidateScope(d tpgresource.TerraformResourceData) error {
	location := d.Get("location").(string)
	publisher := d.Get("publisher").(string)
	model := d.Get("model").(string)
	allSet := location != "" && publisher != "" && model != ""
	noneSet := location == "" && publisher == "" && model == ""
	if !allSet && !noneSet {
		return fmt.Errorf("`location`, `publisher` and `model` must either all be set (per-model configuration) or all be unset (project-wide configuration); got location=%q publisher=%q model=%q", location, publisher, model)
	}
	// The project-wide configuration only stores enabled, sampling_rate, error_sampling_rate and
	// bigquery_destination; enable_otel_logging is silently dropped by the API, so reject it rather
	// than letting it look applied.
	if noneSet {
		if otel, ok := d.GetOk("logging_config.0.enable_otel_logging"); ok && otel.(bool) {
			return fmt.Errorf("`logging_config.enable_otel_logging` is not supported for the project-wide configuration; set it on a per-model configuration instead")
		}
	}
	return nil
}

// vertexAIPublisherModelConfigResourceName returns the API resource name used by
// setPublisherModelConfig / fetchPublisherModelConfig for the configured scope.
func vertexAIPublisherModelConfigResourceName(d tpgresource.TerraformResourceData, config *transport_tpg.Config) (string, error) {
	if err := vertexAIPublisherModelConfigValidateScope(d); err != nil {
		return "", err
	}
	project, err := tpgresource.GetProject(d, config)
	if err != nil {
		return "", fmt.Errorf("Error fetching project for PublisherModelConfig: %s", err)
	}
	if vertexAIPublisherModelConfigIsProjectLevel(d) {
		return fmt.Sprintf("projects/%s", project), nil
	}
	return fmt.Sprintf("projects/%s/locations/%s/publishers/%s/models/%s",
		project, d.Get("location").(string), d.Get("publisher").(string), d.Get("model").(string)), nil
}

// vertexAIPublisherModelConfigId returns the Terraform resource ID for the configured scope.
func vertexAIPublisherModelConfigId(d tpgresource.TerraformResourceData, config *transport_tpg.Config) (string, error) {
	name, err := vertexAIPublisherModelConfigResourceName(d, config)
	if err != nil {
		return "", err
	}
	return name + "/publisherModelConfig", nil
}

// vertexAIPublisherModelConfigSetRegion records the computed `region` attribute so the generated
// read URL template (which contains the product-level {{"{{"}}region{{"}}"}} placeholder) never depends on a
// provider-level region. The host is always rewritten from `location` before the request is sent.
func vertexAIPublisherModelConfigSetRegion(d *schema.ResourceData) error {
	region := d.Get("location").(string)
	if region == "" {
		region = "global"
	}
	return d.Set("region", region)
}

// vertexAIPublisherModelConfigBaseUrl resolves the Vertex AI base URL for a location.
// The project-wide binding and `global` use the global endpoint, `us`/`eu` use the
// regional endpoint (REP) hosts and any other value uses the regional host.
func vertexAIPublisherModelConfigBaseUrl(location string, config *transport_tpg.Config) string {
	baseUrl := transport_tpg.BaseUrl(Product, config)
	if !strings.Contains(baseUrl, vertexAIPublisherModelConfigRegionPlaceholder) {
		// Custom endpoint without a regional placeholder: use it as-is.
		return baseUrl
	}
	regionalHost := vertexAIPublisherModelConfigRegionPlaceholder + "-aiplatform."
	switch location {
	case "", "global":
		return strings.Replace(baseUrl, regionalHost, "aiplatform.", 1)
	case "us", "eu":
		return strings.Replace(baseUrl, regionalHost, "aiplatform."+location+".rep.", 1)
	default:
		return strings.Replace(baseUrl, vertexAIPublisherModelConfigRegionPlaceholder, location, 1)
	}
}

// vertexAIPublisherModelConfigUrl builds the full URL for a custom method (for example
// ":setPublisherModelConfig" or ":fetchPublisherModelConfig") on the configured scope.
func vertexAIPublisherModelConfigUrl(d tpgresource.TerraformResourceData, config *transport_tpg.Config, method string) (string, error) {
	name, err := vertexAIPublisherModelConfigResourceName(d, config)
	if err != nil {
		return "", err
	}
	return vertexAIPublisherModelConfigBaseUrl(d.Get("location").(string), config) + name + method, nil
}

// vertexAIPublisherModelConfigSet calls setPublisherModelConfig with the given config and
// update mask and waits for the resulting long-running operation. The API returns
// 409 ALREADY_EXISTS when the requested configuration matches the stored one; that is treated
// as success because the desired state is already in place.
func vertexAIPublisherModelConfigSet(d *schema.ResourceData, config *transport_tpg.Config, userAgent string, publisherModelConfig map[string]interface{}, updateMask []string, activity string, timeout time.Duration) error {
	url, err := vertexAIPublisherModelConfigUrl(d, config, ":setPublisherModelConfig")
	if err != nil {
		return err
	}
	project, err := tpgresource.GetProject(d, config)
	if err != nil {
		return fmt.Errorf("Error fetching project for PublisherModelConfig: %s", err)
	}
	billingProject := project
	// err == nil indicates that the billing_project value was found
	if bp, err := tpgresource.GetBillingProject(d, config); err == nil {
		billingProject = bp
	}

	body := map[string]interface{}{
		"publisherModelConfig": publisherModelConfig,
	}
	if len(updateMask) > 0 {
		body["updateMask"] = strings.Join(updateMask, ",")
	}
	log.Printf("[DEBUG] %s PublisherModelConfig %q: %#v", activity, url, body)

	res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "POST",
		Project:   billingProject,
		RawURL:    url,
		UserAgent: userAgent,
		Body:      body,
		Timeout:   timeout,
	})
	if err != nil {
		if transport_tpg.IsGoogleApiErrorWithCode(err, 409) {
			log.Printf("[DEBUG] PublisherModelConfig %q already matches the requested configuration (409 ALREADY_EXISTS); nothing to do", url)
			return nil
		}
		return fmt.Errorf("Error %s PublisherModelConfig: %s", strings.ToLower(activity), err)
	}

	return vertexAIPublisherModelConfigOperationWaitTime(config, res, project, d.Get("location").(string), activity+" PublisherModelConfig", userAgent, timeout)
}

// vertexAIPublisherModelConfigOperationWaiter polls setPublisherModelConfig operations. The
// operation name always lives under `locations/global` (also for regional and REP models), so
// the generic Vertex AI waiter would derive a non-existent `global-aiplatform` host; this waiter
// polls on the same endpoint the write was sent to instead.
type vertexAIPublisherModelConfigOperationWaiter struct {
	Config    *transport_tpg.Config
	UserAgent string
	Project   string
	Location  string
	tpgresource.CommonOperationWaiter
}

func (w *vertexAIPublisherModelConfigOperationWaiter) QueryOp() (interface{}, error) {
	if w == nil {
		return nil, fmt.Errorf("Cannot query operation, it's unset or nil.")
	}
	url := vertexAIPublisherModelConfigBaseUrl(w.Location, w.Config) + w.CommonOperationWaiter.Op.Name
	return transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    w.Config,
		Method:    "GET",
		Project:   w.Project,
		RawURL:    url,
		UserAgent: w.UserAgent,
	})
}

func vertexAIPublisherModelConfigOperationWaitTime(config *transport_tpg.Config, op map[string]interface{}, project, location, activity, userAgent string, timeout time.Duration) error {
	if val, ok := op["name"]; !ok || val == "" {
		// This was a synchronous call - there is no operation to wait for.
		return nil
	}
	w := &vertexAIPublisherModelConfigOperationWaiter{
		Config:    config,
		UserAgent: userAgent,
		Project:   project,
		Location:  location,
	}
	if err := w.CommonOperationWaiter.SetOp(op); err != nil {
		return err
	}
	return tpgresource.OperationWait(w, activity, timeout, config.PollInterval)
}

// vertexAIPublisherModelConfigBuildRequest expands the Terraform configuration into the
// publisherModelConfig request body and the matching update mask. Only blocks present in the
// configuration are sent so settings managed outside Terraform are preserved.
func vertexAIPublisherModelConfigBuildRequest(d *schema.ResourceData, config *transport_tpg.Config) (map[string]interface{}, []string, error) {
	obj := make(map[string]interface{})
	updateMask := []string{}

	inferenceEventLoggingConfigProp, err := expandVertexAIPublisherModelConfigInferenceEventLoggingConfig(d.Get("inference_event_logging_config"), d, config)
	if err != nil {
		return nil, nil, err
	}
	if _, ok := d.GetOk("inference_event_logging_config"); ok && !tpgresource.IsEmptyValue(reflect.ValueOf(inferenceEventLoggingConfigProp)) {
		obj["inferenceEventLoggingConfig"] = inferenceEventLoggingConfigProp
		updateMask = append(updateMask, "inferenceEventLoggingConfig")
	}

	loggingConfigProp, err := expandVertexAIPublisherModelConfigLoggingConfig(d.Get("logging_config"), d, config)
	if err != nil {
		return nil, nil, err
	}
	if _, ok := d.GetOk("logging_config"); ok && !tpgresource.IsEmptyValue(reflect.ValueOf(loggingConfigProp)) {
		obj["loggingConfig"] = loggingConfigProp
		updateMask = append(updateMask, "loggingConfig")
	}

	return obj, updateMask, nil
}

func vertexAIPublisherModelConfigBigqueryDestinationOutputUriDiffSuppress(_, old, new string, _ *schema.ResourceData) bool {
	return vertexAIPublisherModelConfigBigqueryDestinationOutputUriDiffSuppressLogic(old, new)
}

var vertexAIPublisherModelConfigAutoDatasetRe = regexp.MustCompile(`^publishers_[a-z0-9_]+_models_[a-z0-9_]+$`)

const vertexAIPublisherModelConfigDefaultTableId = "request_response_logging"

// The API canonicalizes the BigQuery destination to bq://project.dataset.table, auto-creating
// a dataset named publishers_<publisher>_models_<model> and/or a table named
// request_response_logging when the configuration only names a project or dataset.
func vertexAIPublisherModelConfigBigqueryDestinationOutputUriDiffSuppressLogic(old, new string) bool {
	if old == new {
		return true
	}

	o := strings.Split(old, ".")
	n := strings.Split(new, ".")

	// API always returns bq://project.dataset.table format path
	if len(o) != 3 || o[2] != vertexAIPublisherModelConfigDefaultTableId || o[0] != n[0] {
		return false
	}

	switch len(n) {
	case 1: // config has bq://project format path: dataset ID matches auto-generated format.
		return vertexAIPublisherModelConfigAutoDatasetRe.MatchString(o[1])
	case 2: // config has bq://project.dataset format path: compare dataset ID.
		return o[1] == n[1]
	default:
		return false
	}
}
