{{- if not (contains $.ProductMetadata.Compiler "terraformgoogleconversion") }}
import "errors"

// vertexAIPublisherModelConfigGlobalURL rewrites a URL built from the Vertex AI
// regional endpoint template (https://{{"{{"}}region{{"}}"}}-aiplatform.googleapis.com/)
// so that requests for the "global" location go to the non-regional endpoint.
// There is no global-aiplatform.googleapis.com host. URLs for regional
// locations (e.g. us-central1), and custom endpoints, are returned unchanged.
func vertexAIPublisherModelConfigGlobalURL(url string) string {
	return strings.Replace(url, "://global-aiplatform.googleapis.com/", "://aiplatform.googleapis.com/", 1)
}

// isVertexAIPublisherModelConfigAlreadyExistsError reports whether err is a
// Google API 409 ALREADY_EXISTS error returned by SetPublisherModelConfig when
// the target PublisherModelConfig already matches the stored configuration (on
// create, update, or delete). It does not match 409 ABORTED concurrency
// conflicts.
func isVertexAIPublisherModelConfigAlreadyExistsError(err error) bool {
	var gerr *googleapi.Error
	if !errors.As(err, &gerr) || gerr == nil || gerr.Code != http.StatusConflict {
		return false
	}
	return strings.Contains(gerr.Body, "ALREADY_EXISTS") || strings.Contains(strings.ToLower(gerr.Message), "already exists")
}

// waitForVertexAIPublisherModelConfigOp waits for the SetPublisherModelConfig
// LRO when one was returned. When SetPublisherModelConfig returned synchronous
// 409 ALREADY_EXISTS and the failure hook ignored it, res is nil and there is
// no operation to poll.
func waitForVertexAIPublisherModelConfigOp(d *schema.ResourceData, config *transport_tpg.Config, res map[string]interface{}, project, activity, userAgent string, timeout time.Duration) error {
	if res == nil {
		return nil
	}
	endpointLocation := tpgresource.LocationFromId(d.Id())
	return VertexAIOperationWaitTime(config, res, project, endpointLocation, activity, userAgent, timeout)
}
