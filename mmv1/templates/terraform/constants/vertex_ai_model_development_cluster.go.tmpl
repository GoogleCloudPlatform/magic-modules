func vertexAiModelDevelopmentClusterGkeVersionDiffSuppress(k, old, new string, d *schema.ResourceData) bool {
	if new == "-" {
		return true
	}
	if old == new {
		return true
	}
	if old == "" || new == "" {
		return false
	}

	newParts := strings.SplitN(new, "-", 2)
	newVer := newParts[0]
	hasNewSuffix := len(newParts) > 1
	newSuffix := ""
	if hasNewSuffix {
		newSuffix = newParts[1]
	}

	newDots := strings.Split(newVer, ".")
	if len(newDots) < 2 {
		return old == new
	}
	newMajor := newDots[0]
	newMinor := newDots[1]
	hasNewPatch := len(newDots) >= 3
	newPatch := ""
	if hasNewPatch {
		newPatch = newDots[2]
	}

	oldParts := strings.SplitN(old, "-", 2)
	oldVer := oldParts[0]
	hasOldSuffix := len(oldParts) > 1
	oldSuffix := ""
	if hasOldSuffix {
		oldSuffix = oldParts[1]
	}

	oldDots := strings.Split(oldVer, ".")
	if len(oldDots) < 2 {
		return old == new
	}
	oldMajor := oldDots[0]
	oldMinor := oldDots[1]
	hasOldPatch := len(oldDots) >= 3
	oldPatch := ""
	if hasOldPatch {
		oldPatch = oldDots[2]
	}

	if newMajor != oldMajor || newMinor != oldMinor {
		return false
	}

	if hasNewPatch {
		if !hasOldPatch || newPatch != oldPatch {
			return false
		}
	}

	if hasNewSuffix {
		if !hasOldSuffix || newSuffix != oldSuffix {
			return false
		}
	}

	return true
}
