func vertexAiModelDevelopmentClusterNodePoolVersionsConfigured(d vertexAiModelDevelopmentClusterGetter) bool {
	if d == nil {
		return false
	}
	rawConfig := d.GetRawConfig()
	if rawConfig.IsNull() {
		rawVersions, ok := d.GetOk("orchestrator_spec.0.kubernetes_spec.0.node_pool_versions")
		if !ok {
			return false
		}
		versionsMap, ok := rawVersions.(map[string]interface{})
		return ok && len(versionsMap) > 0
	}
	npv, err := cty.GetAttrPath("orchestrator_spec").IndexInt(0).GetAttr("kubernetes_spec").IndexInt(0).GetAttr("node_pool_versions").Apply(rawConfig)
	if err != nil || npv.IsNull() || !npv.IsKnown() {
		return false
	}
	return npv.CanIterateElements() && npv.LengthInt() > 0
}

func validateVertexAIModelDevelopmentClusterNodePoolVersions(d vertexAiModelDevelopmentClusterGetter) error {
	if !vertexAiModelDevelopmentClusterNodePoolVersionsConfigured(d) {
		return nil
	}
	rawVersions, ok := d.GetOk("orchestrator_spec.0.kubernetes_spec.0.node_pool_versions")
	if !ok {
		return nil
	}
	versionsMap, ok := rawVersions.(map[string]interface{})
	if !ok || len(versionsMap) == 0 {
		return nil
	}

	poolIDSet := make(map[string]struct{})
	if rawNodePools, ok := d.GetOk("node_pools"); ok {
		if npList, ok := rawNodePools.([]interface{}); ok {
			for _, item := range npList {
				if npMap, ok := item.(map[string]interface{}); ok {
					if id, ok := npMap["id"].(string); ok && id != "" {
						poolIDSet[id] = struct{}{}
					}
				}
			}
		}
	}

	var unknownPools []string
	for k := range versionsMap {
		if _, exists := poolIDSet[k]; !exists {
			unknownPools = append(unknownPools, k)
		}
	}
	if len(unknownPools) > 0 {
		sort.Strings(unknownPools)
		return fmt.Errorf("orchestrator_spec.0.kubernetes_spec.0.node_pool_versions contains unknown node pool ID(s) not present in the cluster's node pools: %s", strings.Join(unknownPools, ", "))
	}

	var missingPools []string
	for id := range poolIDSet {
		if _, exists := versionsMap[id]; !exists {
			missingPools = append(missingPools, id)
		}
	}
	if len(missingPools) > 0 {
		sort.Strings(missingPools)
		return fmt.Errorf("orchestrator_spec.0.kubernetes_spec.0.node_pool_versions must include all node pool IDs in the cluster; missing: %s", strings.Join(missingPools, ", "))
	}

	return nil
}

func vertexAiModelDevelopmentClusterNormalizeComputeRef(v string) string {
	v = strings.TrimSpace(v)
	if strings.HasPrefix(v, "https://") || strings.HasPrefix(v, "http://") {
		if idx := strings.Index(v, "projects/"); idx >= 0 {
			return v[idx:]
		}
	}
	return v
}

func vertexAiModelDevelopmentClusterSubnetworkRegion(v string) string {
	norm := vertexAiModelDevelopmentClusterNormalizeComputeRef(v)
	parts := strings.Split(norm, "/")
	if len(parts) == 6 && parts[0] == "projects" && parts[2] == "regions" && parts[4] == "subnetworks" {
		return parts[3]
	}
	return ""
}

func resourceVertexAIModelDevelopmentClusterCustomDiff(_ context.Context, diff *schema.ResourceDiff, meta interface{}) error {
	if v, ok := diff.GetOk("xmanager_config"); ok && len(v.([]interface{})) > 0 {
		if v2, ok2 := diff.GetOk("orchestrator_spec.0.kubernetes_spec"); !ok2 || len(v2.([]interface{})) == 0 {
			return fmt.Errorf("xmanager_config is only supported on clusters using the GKE orchestrator (orchestrator_spec.kubernetes_spec)")
		}
		if diff.NewValueKnown("xmanager_config.0.network") && diff.NewValueKnown("network.0.network") {
			xNet, okX := diff.GetOk("xmanager_config.0.network")
			cNet, okC := diff.GetOk("network.0.network")
			if okX && okC && xNet.(string) != "" && cNet.(string) != "" {
				if vertexAiModelDevelopmentClusterNormalizeComputeRef(xNet.(string)) != vertexAiModelDevelopmentClusterNormalizeComputeRef(cNet.(string)) {
					return fmt.Errorf("xmanager_config.network must match the cluster network.network")
				}
			}
		}
		if diff.NewValueKnown("xmanager_config.0.subnetwork") && diff.NewValueKnown("region") {
			xSub, okS := diff.GetOk("xmanager_config.0.subnetwork")
			cReg, okR := diff.GetOk("region")
			if okS && okR && xSub.(string) != "" && cReg.(string) != "" {
				if subRegion := vertexAiModelDevelopmentClusterSubnetworkRegion(xSub.(string)); subRegion != "" && subRegion != cReg.(string) {
					return fmt.Errorf("xmanager_config.subnetwork region %q must match the cluster region %q", subRegion, cReg.(string))
				}
			}
		}
	}
	if !vertexAiModelDevelopmentClusterNodePoolVersionsConfigured(diff) {
		return nil
	}
	if !diff.NewValueKnown("orchestrator_spec.0.kubernetes_spec.0.node_pool_versions") ||
		!diff.NewValueKnown("node_pools") {
		return nil
	}
	if rawNodePools, ok := diff.GetOk("node_pools"); ok {
		if npList, ok := rawNodePools.([]interface{}); ok {
			for i := range npList {
				if !diff.NewValueKnown(fmt.Sprintf("node_pools.%d.id", i)) {
					return nil
				}
			}
		}
	}
	return validateVertexAIModelDevelopmentClusterNodePoolVersions(diff)
}

func vertexAiModelDevelopmentClusterGetXmanagerStatus(d *schema.ResourceData, config *transport_tpg.Config, billingProject, userAgent, timeoutKey string) (clusterState string, xmState string, hasXm bool, err error) {
	clusterURL, err := tpgresource.ReplaceVars(d, config, transport_tpg.BaseUrl(Product, config)+"projects/{{"{{"}}project{{"}}"}}/locations/{{"{{"}}region{{"}}"}}/modelDevelopmentClusters/{{"{{"}}model_development_cluster_id{{"}}"}}")
	if err != nil {
		return "", "", false, err
	}
	res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   billingProject,
		RawURL:    clusterURL,
		UserAgent: userAgent,
		Timeout:   d.Timeout(timeoutKey),
	})
	if err != nil {
		return "", "", false, err
	}
	if cs, ok := res["clusterStatus"].(map[string]interface{}); ok {
		clusterState, _ = cs["state"].(string)
	}
	if runtime, ok := res["runtime"].(map[string]interface{}); ok {
		if xm, ok := runtime["xmanager"].(map[string]interface{}); ok && xm != nil {
			xmState, _ = xm["state"].(string)
			if xmState != "DELETED" {
				hasXm = true
			}
		}
	}
	return clusterState, xmState, hasXm, nil
}

func vertexAiModelDevelopmentClusterPrepareXmanagerTransition(d *schema.ResourceData, config *transport_tpg.Config, billingProject, userAgent, timeoutKey string, waitProvisioning bool) (clusterState string, xmState string, hasXm bool, err error) {
	clusterState, xmState, hasXm, err = vertexAiModelDevelopmentClusterGetXmanagerStatus(d, config, billingProject, userAgent, timeoutKey)
	if err != nil {
		if transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
			return "", "", false, nil
		}
		return "", "", false, err
	}
	needsWait := func(cs, xs string, present bool) bool {
		if cs == "PROVISIONING" || cs == "UPDATING" {
			return true
		}
		if !present {
			return false
		}
		if xs == "DELETING" || (waitProvisioning && xs == "PROVISIONING") {
			return true
		}
		return false
	}
	if !needsWait(clusterState, xmState, hasXm) {
		return clusterState, xmState, hasXm, nil
	}
	retryErr := tpgresource.Retry(d.Timeout(timeoutKey), config.SleepUnit, func() *retry.RetryError {
		cs, xs, present, pollErr := vertexAiModelDevelopmentClusterGetXmanagerStatus(d, config, billingProject, userAgent, timeoutKey)
		if pollErr != nil {
			if transport_tpg.IsGoogleApiErrorWithCode(pollErr, 404) {
				clusterState, xmState, hasXm = "", "", false
				return nil
			}
			return retry.NonRetryableError(pollErr)
		}
		clusterState, xmState, hasXm = cs, xs, present
		if needsWait(cs, xs, present) {
			return retry.RetryableError(fmt.Errorf("ModelDevelopmentCluster %q is in clusterState=%q, xmanagerState=%q", d.Id(), cs, xs))
		}
		return nil
	})
	if retryErr != nil {
		return clusterState, xmState, hasXm, retryErr
	}
	return clusterState, xmState, hasXm, nil
}

func vertexAiModelDevelopmentClusterUpdateXmanager(d *schema.ResourceData, config *transport_tpg.Config, billingProject, userAgent string, enable bool, timeoutKey string) error {
	project, err := tpgresource.GetProject(d, config)
	if err != nil {
		return err
	}
	timeout := d.Timeout(timeoutKey)

	if enable {
		v, ok := d.GetOk("xmanager_config")
		if !ok {
			return nil
		}
		configList, ok := v.([]interface{})
		if !ok || len(configList) == 0 {
			return nil
		}
		configMap, ok := configList[0].(map[string]interface{})
		if !ok {
			return nil
		}
		obj := make(map[string]interface{})
		instance := make(map[string]interface{})

		if network, ok := configMap["network"].(string); ok && network != "" {
			instance["network"] = vertexAiModelDevelopmentClusterNormalizeComputeRef(network)
		}
		if subnetwork, ok := configMap["subnetwork"].(string); ok && subnetwork != "" {
			instance["subnetwork"] = vertexAiModelDevelopmentClusterNormalizeComputeRef(subnetwork)
		}
		if xprof, ok := configMap["xprof_config"].([]interface{}); ok && len(xprof) > 0 {
			if xprofMap, ok := xprof[0].(map[string]interface{}); ok {
				xprofObj := make(map[string]interface{})
				if uri, ok := xprofMap["gcs_bucket_uri"].(string); ok && uri != "" {
					xprofObj["gcsBucketUri"] = uri
				}
				instance["xprofConfig"] = xprofObj
			}
		}
		obj["instance"] = instance

		url, err := tpgresource.ReplaceVars(d, config, transport_tpg.BaseUrl(Product, config)+"projects/{{"{{"}}project{{"}}"}}/locations/{{"{{"}}region{{"}}"}}/modelDevelopmentClusters/{{"{{"}}model_development_cluster_id{{"}}"}}:enableXmanager")
		if err != nil {
			return err
		}

		log.Printf("[DEBUG] Enabling Xmanager on ModelDevelopmentCluster %q: %#v", d.Id(), obj)
		res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "POST",
			Project:   billingProject,
			RawURL:    url,
			UserAgent: userAgent,
			Body:      obj,
			Timeout:   timeout,
		})
		if err != nil {
			return fmt.Errorf("Error enabling Xmanager: %s", err)
		}

		endpointLocation := tpgresource.LocationFromId(d.Id())
		err = VertexAIOperationWaitTime(
			config, res, project, endpointLocation, "Enabling Xmanager", userAgent,
			timeout)
		if err != nil {
			return fmt.Errorf("Error waiting to enable Xmanager: %s", err)
		}
	} else {
		url, err := tpgresource.ReplaceVars(d, config, transport_tpg.BaseUrl(Product, config)+"projects/{{"{{"}}project{{"}}"}}/locations/{{"{{"}}region{{"}}"}}/modelDevelopmentClusters/{{"{{"}}model_development_cluster_id{{"}}"}}:disableXmanager")
		if err != nil {
			return err
		}

		log.Printf("[DEBUG] Disabling Xmanager on ModelDevelopmentCluster %q", d.Id())
		res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "POST",
			Project:   billingProject,
			RawURL:    url,
			UserAgent: userAgent,
			Timeout:   timeout,
		})
		if err != nil {
			return fmt.Errorf("Error disabling Xmanager: %s", err)
		}

		endpointLocation := tpgresource.LocationFromId(d.Id())
		err = VertexAIOperationWaitTime(
			config, res, project, endpointLocation, "Disabling Xmanager", userAgent,
			timeout)
		if err != nil {
			return fmt.Errorf("Error waiting to disable Xmanager: %s", err)
		}
	}
	return nil
}
