{{- if not (contains $.ProductMetadata.Compiler "terraformgoogleconversion") }}
// vertexAIProjectPublisherModelConfigGlobalURL rewrites a URL built from the
// Vertex AI regional endpoint template (https://{{"{{"}}region{{"}}"}}-aiplatform.googleapis.com/)
// so that project-level PublisherModelConfig requests go to the non-regional
// endpoint, stripping the <region>- prefix substituted by ReplaceVars across
// standard, mTLS, and custom universe_domain hosts while leaving custom
// endpoints unchanged.
func vertexAIProjectPublisherModelConfigGlobalURL(d *schema.ResourceData, config *transport_tpg.Config, url string) string {
	if config == nil || config.CustomEndpoints[Product.CustomEndpointField] != "" {
		return url
	}
	if region, err := tpgresource.GetRegion(d, config); err == nil && region != "" {
		return strings.Replace(url, "://"+region+"-aiplatform.", "://aiplatform.", 1)
	}
	return url
}
{{- end }}
