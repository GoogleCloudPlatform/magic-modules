{{- if not (contains $.ProductMetadata.Compiler "terraformgoogleconversion") }}
import (
	neturl "net/url"

	tpgcompute "{{ $.ImportPath }}/services/compute"
)

// Clean up PSC forwarding rules and reserved internal addresses created by the Dataproc Metastore
// service agent in consumer subnetworks so that the subnetworks are not left in use after deletion.
func deleteDataprocMetastoreServicePscEndpoints(d *schema.ResourceData, config *transport_tpg.Config, billingProject, userAgent string) error {
	v, ok := d.GetOk("network_config.0.consumers")
	if !ok {
		return nil
	}
	consumers, ok := v.([]interface{})
	if !ok {
		return nil
	}

	computeBasePath := transport_tpg.BaseUrl(tpgcompute.Product, config)

	for _, itemRaw := range consumers {
		consumer, ok := itemRaw.(map[string]interface{})
		if !ok {
			continue
		}
		subnetwork, _ := consumer["subnetwork"].(string)
		if subnetwork == "" {
			continue
		}
		endpointUri, _ := consumer["endpoint_uri"].(string)
		if endpointUri == "" {
			continue
		}
		u, err := neturl.Parse(endpointUri)
		if err != nil {
			return fmt.Errorf("parsing consumer endpoint_uri %q for subnetwork %q: %w", endpointUri, subnetwork, err)
		}
		endpointIP := u.Hostname()
		if endpointIP == "" {
			continue
		}

		fv, err := tpgresource.ParseSubnetworkFieldValue(subnetwork, d, config)
		if err != nil {
			return fmt.Errorf("parsing consumer subnetwork %q: %w", subnetwork, err)
		}

		addressesUrl := fmt.Sprintf("%sprojects/%s/regions/%s/addresses?filter=name%%3Dmetastore-addr-*", computeBasePath, fv.Project, fv.Region)
		res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "GET",
			Project:   billingProject,
			RawURL:    addressesUrl,
			UserAgent: userAgent,
		})
		if err != nil {
			return fmt.Errorf("listing PSC addresses in %s/%s for subnetwork %q: %w", fv.Project, fv.Region, subnetwork, err)
		}

		items, ok := res["items"].([]interface{})
		if !ok {
			continue
		}

		subnetworkSuffix := fmt.Sprintf("/regions/%s/subnetworks/%s", fv.Region, fv.Name)
		for _, addrRaw := range items {
			addr, ok := addrRaw.(map[string]interface{})
			if !ok {
				continue
			}
			addrName, _ := addr["name"].(string)
			if !strings.HasPrefix(addrName, "metastore-addr-") {
				continue
			}
			addrSubnetwork, _ := addr["subnetwork"].(string)
			if !strings.HasSuffix(addrSubnetwork, subnetworkSuffix) {
				continue
			}
			addrIP, _ := addr["address"].(string)
			if addrIP != endpointIP {
				continue
			}

			if users, ok := addr["users"].([]interface{}); ok {
				for _, userRaw := range users {
					userURL, ok := userRaw.(string)
					if !ok || userURL == "" {
						continue
					}
					fwRuleName := tpgresource.GetResourceNameFromSelfLink(userURL)
					if !strings.HasPrefix(fwRuleName, "metastore-forwarding-rule-") {
						continue
					}
					fwRuleURL := fmt.Sprintf("%sprojects/%s/regions/%s/forwardingRules/%s", computeBasePath, fv.Project, fv.Region, fwRuleName)
					log.Printf("[DEBUG] Deleting Dataproc Metastore PSC forwarding rule %q", fwRuleURL)
					opRes, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
						Config:    config,
						Method:    "DELETE",
						Project:   billingProject,
						RawURL:    fwRuleURL,
						UserAgent: userAgent,
						Timeout:   d.Timeout(schema.TimeoutDelete),
					})
					if err != nil {
						if transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
							continue
						}
						return fmt.Errorf("deleting PSC forwarding rule %q for subnetwork %q: %w", fwRuleURL, subnetwork, err)
					}
					if err := tpgcompute.ComputeOperationWaitTime(
						config, opRes, fv.Project, "Deleting Dataproc Metastore PSC forwarding rule", userAgent,
						d.Timeout(schema.TimeoutDelete)); err != nil {
						return fmt.Errorf("waiting for PSC forwarding rule %q deletion for subnetwork %q: %w", fwRuleURL, subnetwork, err)
					}
				}
			}

			addrURL := fmt.Sprintf("%sprojects/%s/regions/%s/addresses/%s", computeBasePath, fv.Project, fv.Region, addrName)
			log.Printf("[DEBUG] Deleting Dataproc Metastore PSC address %q", addrURL)
			opRes, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
				Config:    config,
				Method:    "DELETE",
				Project:   billingProject,
				RawURL:    addrURL,
				UserAgent: userAgent,
				Timeout:   d.Timeout(schema.TimeoutDelete),
			})
			if err != nil {
				if transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
					continue
				}
				return fmt.Errorf("deleting PSC address %q for subnetwork %q: %w", addrURL, subnetwork, err)
			}
			if err := tpgcompute.ComputeOperationWaitTime(
				config, opRes, fv.Project, "Deleting Dataproc Metastore PSC address", userAgent,
				d.Timeout(schema.TimeoutDelete)); err != nil {
				return fmt.Errorf("waiting for PSC address %q deletion for subnetwork %q: %w", addrURL, subnetwork, err)
			}
		}
	}

	return nil
}
{{- end }}
