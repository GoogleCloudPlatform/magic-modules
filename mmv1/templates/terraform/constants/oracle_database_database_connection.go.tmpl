{{- if not $.ProductMetadata.IsTgcCompiler }}
// Retry when the Oracle Database API returns a transient 400 FAILED_PRECONDITION
// DATABASE_NETWORK_UNREACHABLE timeout while validating connectivity over PSC-I.
func IsOracleDatabaseConnectionNetworkUnreachableError(err error) (bool, string) {
	if gerr, ok := err.(*googleapi.Error); ok {
		if gerr.Code == 400 && (strings.Contains(gerr.Body, "DATABASE_NETWORK_UNREACHABLE") || strings.Contains(gerr.Body, "Cannot reach the database host or network: the connection attempt timed out") || strings.Contains(gerr.Message, "Cannot reach the database host or network: the connection attempt timed out")) {
			return true, "Waiting for Oracle database connection to be reachable"
		}
		return false, ""
	}
	if err != nil {
		errStr := err.Error()
		if strings.Contains(errStr, "DATABASE_NETWORK_UNREACHABLE") || strings.Contains(errStr, "Cannot reach the database host or network: the connection attempt timed out") {
			return true, "Waiting for Oracle database connection to be reachable"
		}
	}
	return false, ""
}
{{- end }}
