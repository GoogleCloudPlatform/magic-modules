// discoveryEngineDocumentImportParseCount parses an int64 count from
// ImportDocumentsMetadata, where proto3 JSON serializes non-zero int64 values
// as strings and omits zero values. Metadata is decoded with UseNumber, so
// unquoted numbers arrive as json.Number.
func discoveryEngineDocumentImportParseCount(v interface{}) (int64, string, error) {
	var s string
	switch c := v.(type) {
	case nil:
		return 0, "0", nil
	case string:
		s = c
	case json.Number:
		s = c.String()
	default:
		return 0, "", fmt.Errorf("unexpected type %T for count value %v", v, v)
	}
	if s == "" {
		return 0, "0", nil
	}
	n, err := strconv.ParseInt(s, 10, 64)
	if err != nil {
		return 0, "", err
	}
	return n, strconv.FormatInt(n, 10), nil
}

// discoveryEngineDocumentImportFormatErrorSamples renders up to limit
// ImportDocumentsResponse.errorSamples (google.rpc.Status) as a single
// human-readable string, noting how many additional samples were omitted.
func discoveryEngineDocumentImportFormatErrorSamples(samples []interface{}, limit int) string {
	if len(samples) == 0 || limit <= 0 {
		return ""
	}
	var formatted []string
	for i, item := range samples {
		if i >= limit {
			break
		}
		sampleMap, ok := item.(map[string]interface{})
		if !ok {
			formatted = append(formatted, fmt.Sprintf("%v", item))
			continue
		}
		code := sampleMap["code"]
		message, _ := sampleMap["message"].(string)
		if code != nil && message != "" {
			formatted = append(formatted, fmt.Sprintf("[code=%v] %s", code, message))
		} else if message != "" {
			formatted = append(formatted, message)
		} else {
			formatted = append(formatted, fmt.Sprintf("%v", sampleMap))
		}
	}
	if len(samples) > limit {
		formatted = append(formatted, fmt.Sprintf("... (%d more error sample(s))", len(samples)-limit))
	}
	return strings.Join(formatted, "; ")
}

// discoveryEngineDocumentImportWaitForCreate waits for the documents:import LRO
// to complete, records the operation name and ImportDocumentsMetadata counts in
// Terraform state, and returns an error if any documents failed to import
// (ImportDocuments completes the LRO with done=true and no top-level Op.Error
// even when 100% of documents fail).
func discoveryEngineDocumentImportWaitForCreate(d *schema.ResourceData, config *transport_tpg.Config, op map[string]interface{}, project, endpointLocation, userAgent string, timeout time.Duration) error {
	opName, _ := op["name"].(string)
	if opName == "" {
		return fmt.Errorf("Error importing DiscoveryEngine Documents: expected long-running operation name in response, got empty")
	}

	w, err := createDiscoveryEngineWaiter(config, op, project, endpointLocation, "Importing DiscoveryEngine Documents", userAgent)
	if err != nil {
		return err
	}
	if err := tpgresource.OperationWait(w, "Importing DiscoveryEngine Documents", timeout, config.PollInterval); err != nil {
		return fmt.Errorf("Error waiting to import DiscoveryEngine Documents: %s", err)
	}

	if w.CommonOperationWaiter.Op.Name != "" {
		opName = w.CommonOperationWaiter.Op.Name
	}
	if err := d.Set("operation", flattenDiscoveryEngineDocumentImportOperation(opName, d, config)); err != nil {
		return fmt.Errorf("Error setting operation: %s", err)
	}

	metaMap := make(map[string]interface{})
	if rawMeta := []byte(w.CommonOperationWaiter.Op.Metadata); len(rawMeta) > 0 {
		dec := json.NewDecoder(bytes.NewReader(rawMeta))
		dec.UseNumber()
		if err := dec.Decode(&metaMap); err != nil {
			return fmt.Errorf("Error decoding ImportDocumentsMetadata from operation %q: %s", opName, err)
		}
	}

	successCount, successStr, err := discoveryEngineDocumentImportParseCount(metaMap["successCount"])
	if err != nil {
		return fmt.Errorf("Error parsing successCount from ImportDocumentsMetadata: %s", err)
	}
	failureCount, failureStr, err := discoveryEngineDocumentImportParseCount(metaMap["failureCount"])
	if err != nil {
		return fmt.Errorf("Error parsing failureCount from ImportDocumentsMetadata: %s", err)
	}
	totalCount, totalStr, err := discoveryEngineDocumentImportParseCount(metaMap["totalCount"])
	if err != nil {
		return fmt.Errorf("Error parsing totalCount from ImportDocumentsMetadata: %s", err)
	}

	if err := d.Set("success_count", flattenDiscoveryEngineDocumentImportSuccessCount(successStr, d, config)); err != nil {
		return fmt.Errorf("Error setting success_count: %s", err)
	}
	if err := d.Set("failure_count", flattenDiscoveryEngineDocumentImportFailureCount(failureStr, d, config)); err != nil {
		return fmt.Errorf("Error setting failure_count: %s", err)
	}
	if err := d.Set("total_count", flattenDiscoveryEngineDocumentImportTotalCount(totalStr, d, config)); err != nil {
		return fmt.Errorf("Error setting total_count: %s", err)
	}

	respMap := make(map[string]interface{})
	if rawResp := []byte(w.CommonOperationWaiter.Op.Response); len(rawResp) > 0 {
		dec := json.NewDecoder(bytes.NewReader(rawResp))
		dec.UseNumber()
		if err := dec.Decode(&respMap); err != nil {
			return fmt.Errorf("Error decoding ImportDocumentsResponse from operation %q: %s", opName, err)
		}
	}

	errorSamples, _ := respMap["errorSamples"].([]interface{})
	errorGcsPrefix := ""
	if errCfg, ok := respMap["errorConfig"].(map[string]interface{}); ok {
		errorGcsPrefix, _ = errCfg["gcsPrefix"].(string)
	}

	if failureCount > 0 || len(errorSamples) > 0 {
		msg := fmt.Sprintf("Error importing DiscoveryEngine Documents (operation %q): %d document(s) failed out of %d total (%d succeeded)",
			opName, failureCount, totalCount, successCount)
		if sampleStr := discoveryEngineDocumentImportFormatErrorSamples(errorSamples, 3); sampleStr != "" {
			msg += fmt.Sprintf("; sample errors: %s", sampleStr)
		}
		if errorGcsPrefix != "" {
			msg += fmt.Sprintf("; full error details written to %s", errorGcsPrefix)
		}
		return fmt.Errorf("%s", msg)
	}

	log.Printf("[DEBUG] Imported DiscoveryEngine Documents via operation %q (success=%d, failure=%d, total=%d)",
		opName, successCount, failureCount, totalCount)
	return nil
}
