import (
	"net/url"
)

var (
	_ = url.PathUnescape
)

// tagsTagBindingParentFromName returns the decoded parent resource name from
// the percent-encoded parent segment of a TagBinding name
// (tagBindings/{encoded-parent}/{tag-value-name}). For example
// "%2F%2Fpubsub.googleapis.com%2Fprojects%2F123%2Ftopics%2Fa%2Bb" becomes
// "//pubsub.googleapis.com/projects/123/topics/a+b". If the segment is not
// valid percent-encoding it is returned unchanged.
func tagsTagBindingParentFromName(encodedParent string) string {
	parent, err := url.PathUnescape(encodedParent)
	if err != nil {
		return encodedParent
	}
	return parent
}
