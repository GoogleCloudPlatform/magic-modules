// Labels cannot be set in a create for PSC forwarding rules, so remove it from the CREATE request.
if targetStr, ok := targetProp.(string); ok {
  if strings.Contains(targetStr, "/serviceAttachments/") ||
      targetStr == "all-apis" ||
      targetStr == "vpc-sc" {
    if _, ok := obj["labels"]; ok {
      delete(obj, "labels")
    }
  }
}
