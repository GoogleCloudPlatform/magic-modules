// Assured Workloads long-running operations are polled with the billing
// project in X-Goog-User-Project (when user_project_override is enabled); the
// workload has no project of its own.
if bp, err := tpgresource.GetBillingProject(d, config); err == nil {
	project = bp
}
if v, ok := d.GetOk("workload_id"); ok && v.(string) != "" {
	url, err = transport_tpg.AddQueryParams(url, map[string]string{"workloadId": v.(string)})
	if err != nil {
		return err
	}
}
