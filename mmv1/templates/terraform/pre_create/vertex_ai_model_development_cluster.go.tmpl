if v, ok := d.GetOk("orchestrator_spec.0.kubernetes_spec.0.control_plane_version"); ok && v.(string) != "" {
	return fmt.Errorf("control_plane_version cannot be set on creation; clusters are created with the service default version and can be upgraded via update")
}
if v, ok := d.GetOk("orchestrator_spec.0.kubernetes_spec.0.node_pool_versions"); ok {
	if m, ok := v.(map[string]interface{}); ok && len(m) > 0 {
		return fmt.Errorf("node_pool_versions cannot be set on creation; node pools are created with the service default version and can be upgraded via update")
	}
}
