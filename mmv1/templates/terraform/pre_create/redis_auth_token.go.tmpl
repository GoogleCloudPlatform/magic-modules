// Guard condition: if token_id is explicitly specified, acquire the existing token
// (such as the initial "version-1" auto-created with the cluster or user) and return early.
// Never fall through to :addAuthToken when token_id is set, since :addAuthToken only
// mints server-assigned sequential version-N IDs.
if v, ok := d.GetOk("token_id"); ok && v.(string) != "" {
	if err := d.Set("token_id", tpgresource.GetResourceNameFromSelfLink(v.(string))); err != nil {
		return fmt.Errorf("Error setting token_id: %s", err)
	}
	id, err := tpgresource.ReplaceVars(d, config, "{{$.GetIdFormat}}")
	if err != nil {
		return fmt.Errorf("Error constructing id: %s", err)
	}
	d.SetId(id)
	log.Printf("[DEBUG] Acquiring existing AuthToken %q", d.Id())
	if err := resourceRedisClusterAuthTokenRead(d, meta); err != nil {
		d.SetId("")
		return err
	}
	if d.Id() == "" {
		return fmt.Errorf("AuthToken %q not found; token_id is server-generated and can only be set to acquire an existing token", id)
	}
	return nil
}
