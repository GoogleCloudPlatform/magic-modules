// The self_link interpolates parent into the query string without query
// escaping. Characters such as "+" that are valid in resource names (for
// example Pub/Sub topic names) have a special meaning in a query string, so
// the API would receive a different parent than the one used by Create.
// Rebuild the URL with AddQueryParams so parent is query-escaped.
url, err = transport_tpg.AddQueryParams(transport_tpg.BaseUrl(Product, config)+"tagBindings", map[string]string{
	"parent":   d.Get("parent").(string),
	"pageSize": "300",
})
if err != nil {
	return err
}
