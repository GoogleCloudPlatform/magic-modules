// fetchPublisherModelConfig always returns a `loggingConfig` block, even when request/response
// logging was never configured (for example `{"loggingConfig": {"bigqueryDestination": {}}}`
// for a project that only enabled inference request metadata logging). Only surface
// `logging_config` when it is managed in the configuration or actually enabled, so an
// unmanaged, disabled setting does not produce a permanent diff.
if _, managed := d.GetOk("logging_config"); !managed {
	if loggingConfig, ok := res["loggingConfig"].(map[string]interface{}); ok {
		if enabled, _ := loggingConfig["enabled"].(bool); !enabled {
			delete(res, "loggingConfig")
		}
	}
}
