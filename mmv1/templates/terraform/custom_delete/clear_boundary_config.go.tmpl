// Custom delete for google_resource_manager_boundary_config.
//
// BoundaryConfig is an API singleton: it always exists under its parent and has
// no Delete method. Rather than silently orphaning the configuration, a
// Terraform destroy clears the managed field (tagKey) via PATCH, returning the
// BoundaryConfig to its unconfigured state.
//
// Modeled on templates/terraform/custom_delete/clear_migration_center_settings.go.tmpl
// and the accessapproval/*Settings.yaml family. Unlike those, this resource is
// parented on an organization or folder rather than a project, so there is no
// `project` field to read; only an explicit billing_project is honoured.

billingProject := ""

if bp, err := tpgresource.GetBillingProject(d, config); err == nil {
	billingProject = bp
}

obj := make(map[string]interface{})
obj["tagKey"] = ""

url, err := tpgresource.ReplaceVars(d, config, fmt.Sprintf("%s%s", transport_tpg.BaseUrl(Product, config), "{{"{{"}}parent{{"}}"}}/boundaryConfig"))
if err != nil {
	return err
}

log.Printf("[DEBUG] Clearing BoundaryConfig %q: %#v", d.Id(), obj)
updateMask := []string{"tagKey"}

url, err = transport_tpg.AddQueryParams(url, map[string]string{"updateMask": strings.Join(updateMask, ",")})
if err != nil {
	return err
}

headers := make(http.Header)
res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
	Config:    config,
	Method:    "PATCH",
	Project:   billingProject,
	RawURL:    url,
	UserAgent: userAgent,
	Body:      obj,
	Timeout:   d.Timeout(schema.TimeoutDelete),
	Headers:   headers,
})

if err != nil {
	return fmt.Errorf("Error clearing BoundaryConfig %q: %w", d.Id(), err)
}

// UpdateBoundaryConfig returns a long-running operation, so wait for it to
// finish before considering the destroy complete. Otherwise a subsequent apply
// can race against the in-flight clear.
err = ResourceManagerV3OperationWaitTime(
	config, res, "Clearing BoundaryConfig", userAgent,
	d.Timeout(schema.TimeoutDelete))
if err != nil {
	return fmt.Errorf("Error waiting to clear BoundaryConfig %q: %w", d.Id(), err)
}

log.Printf("[DEBUG] Finished clearing BoundaryConfig %q: %#v", d.Id(), res)

d.SetId("")
return nil
