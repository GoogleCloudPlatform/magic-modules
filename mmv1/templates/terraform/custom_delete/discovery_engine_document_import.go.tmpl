{{- if not (contains $.ProductMetadata.Compiler "terraformgoogleconversion") }}
purgeOnDestroy := false
if v, ok := d.GetOk("purge_on_destroy"); ok {
	purgeOnDestroy = v.(bool)
}

if !purgeOnDestroy {
	log.Printf("[DEBUG] Skipping purge on destroy for %s", d.Id())
	return nil
}

log.Printf("[DEBUG] Purging documents for %s", d.Id())

url, err := tpgresource.ReplaceVars(d, config, transport_tpg.BaseUrl(Product, config)+"projects/{{"{{"}}project{{"}}"}}/locations/{{"{{"}}location{{"}}"}}/collections/{{"{{"}}collection_id{{"}}"}}/dataStores/{{"{{"}}data_store_id{{"}}"}}/branches/{{"{{"}}branch_id{{"}}"}}/documents:purge")
if err != nil {
	return err
}

project, err := tpgresource.GetProject(d, config)
if err != nil {
	return fmt.Errorf("Error fetching project for DocumentImport: %s", err)
}
billingProject := project
if bp, err := tpgresource.GetBillingProject(d, config); err == nil {
	billingProject = bp
}

body := map[string]interface{}{
	"filter": "*",
}

res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
	Config:    config,
	Method:    "POST",
	Project:   billingProject,
	RawURL:    url,
	UserAgent: userAgent,
	Body:      body,
	Timeout:   d.Timeout(schema.TimeoutDelete),
})
if err != nil {
	return transport_tpg.HandleNotFoundError(err, d, fmt.Sprintf("DiscoveryEngineDocumentImport %q", d.Id()))
}

endpointLocation := tpgresource.LocationFromId(d.Id())
err = DiscoveryEngineOperationWaitTime(
	config, res, project, endpointLocation, "Purging DiscoveryEngine Documents", userAgent,
	d.Timeout(schema.TimeoutDelete))
if err != nil {
	return fmt.Errorf("Error waiting to purge DiscoveryEngine Documents: %s", err)
}

log.Printf("[DEBUG] Finished purging documents for %s", d.Id())
return nil
{{- end }}
