d.SetId("")

// idpCredentials:add returns an Operation that is completed synchronously
// (done=true) with the IdpCredential as its response, or done=false with
// metadata.state=awaiting-multi-party-approval. The Operation has no name, so
// it cannot be polled. checkInboundSamlSsoProfileOperation is defined in the
// InboundSamlSsoProfile constants in this package.
var opRes map[string]interface{}
opRes, err = checkInboundSamlSsoProfileOperation(res, "creating InboundSamlSsoProfileIdpCredential")
if err != nil {
	return err
}

name, _ := opRes["name"].(string)
if name == "" {
	return fmt.Errorf("Error creating InboundSamlSsoProfileIdpCredential: operation response did not contain resource name")
}

if err = d.Set("name", name); err != nil {
	return fmt.Errorf("Error setting name: %w", err)
}
if err = d.Set("idp_credential_id", tpgresource.GetResourceNameFromSelfLink(name)); err != nil {
	return fmt.Errorf("Error setting idp_credential_id: %w", err)
}

id, err = tpgresource.ReplaceVars(d, config, "{{$.IdFormat}}")
if err != nil {
	return fmt.Errorf("Error constructing id: %w", err)
}
d.SetId(id)
