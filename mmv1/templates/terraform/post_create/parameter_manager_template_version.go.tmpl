// CreateTemplateVersion always creates the resource in ENABLED state; apply disabled=true via PATCH when set on create.
if v, ok := d.GetOk("disabled"); ok && v.(bool) {
	disableURL, err := tpgresource.ReplaceVars(d, config, transport_tpg.BaseUrl(Product, config)+"{{ $.SelfLinkUri }}")
	if err != nil {
		return err
	}
	disableURL, err = transport_tpg.AddQueryParams(disableURL, map[string]string{"updateMask": "disabled"})
	if err != nil {
		return err
	}
	_, err = transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "PATCH",
		Project:   billingProject,
		RawURL:    disableURL,
		UserAgent: userAgent,
		Body:      map[string]interface{}{"disabled": true},
		Timeout:   d.Timeout(schema.TimeoutCreate),
	})
	if err != nil {
		return fmt.Errorf("Error disabling {{ $.Name }} %q after create: %s", d.Id(), err)
	}
}
