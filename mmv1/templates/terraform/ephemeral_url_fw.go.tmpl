{{/*
  fwtransport.ReplaceVars (the shared URL-templating helper resource_fw.go.tmpl
  uses) resolves {{var}} placeholders by type-switching on the request object —
  resource.CreateRequest/UpdateRequest/ReadRequest/DeleteRequest — with no case
  for ephemeral.OpenRequest, so it isn't usable here. Instead, {{var}} placeholders
  in a resource's create_url/self_link are resolved at CODEGEN time (not runtime)
  into a plain fmt.Sprintf call, matching what both hand-written Phase 0 spikes
  did manually.
*/}}

{{/* Given a dict with "Resource" (the api.Resource, for ExtractIdentifiers) and
  "Url" (a URL template string containing {{var}} placeholders), emits that same
  string with every {{var}} replaced by %s — the fmt.Sprintf format string. */}}
{{- define "EphemeralUrlFormatFW" -}}
  {{- $url := .Url -}}
  {{- range $id := .Resource.ExtractIdentifiers .Url -}}
    {{- $url = replaceAll $url (printf "{{%s}}" $id) "%s" -}}
  {{- end -}}
{{- $url -}}
{{- end -}}

{{/* Given one {{var}} identifier name extracted from a URL template, emits the
  Go expression that supplies its value: the well-known project/region/zone
  locals already resolved earlier in Open(), or, for any other name, the
  corresponding top-level property's value straight from the parsed config. */}}
{{- define "EphemeralUrlArgFW" -}}
  {{- if eq . "project" -}}
project
  {{- else if eq . "region" -}}
region
  {{- else if eq . "zone" -}}
zone
  {{- else -}}
data.{{camelize . "upper"}}.ValueString()
  {{- end -}}
{{- end -}}
