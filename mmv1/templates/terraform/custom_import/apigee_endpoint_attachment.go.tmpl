		"organizations/{{"{{"}}org_name{{"}}"}}/endpointAttachments/{{"{{"}}endpoint_attachment_id{{"}}"}}",
		"organizations/{{"{{"}}org_name{{"}}"}}/{{"{{"}}endpoint_attachment_id{{"}}"}}")
