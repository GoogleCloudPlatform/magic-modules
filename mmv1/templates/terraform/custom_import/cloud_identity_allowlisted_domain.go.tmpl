config := meta.(*transport_tpg.Config)

// Accept either "allowlistedDomains/{id}" or a bare "{id}".
if err := tpgresource.ParseImportId([]string{"^(?P<name>allowlistedDomains/[^/]+)$", "^(?P<name>[^/]+)$"}, d, config); err != nil {
	return nil, err
}

name := d.Get("name").(string)
if !strings.HasPrefix(name, "allowlistedDomains/") {
	name = "allowlistedDomains/" + name
}
if err := d.Set("name", name); err != nil {
	return nil, fmt.Errorf("Error setting name: %w", err)
}
d.SetId(name)

return []*schema.ResourceData{d}, nil
