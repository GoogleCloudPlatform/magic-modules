// Delete returns a google.longrunning.Operation without an operation name that
// can be polled directly. When done is false, poll allowlistedDomains.list by
// domain until the domain is absent.
if opErr, ok := res["error"]; ok && opErr != nil {
	return fmt.Errorf("Error deleting AllowlistedDomain %q: %v", d.Id(), opErr)
}

if done, _ := res["done"].(bool); !done {
	domain, _ := d.Get("domain").(string)
	err = transport_tpg.PollingWaitTime(
		cloudIdentityAllowlistedDomainListPollRead(d, config, billingProject, userAgent, domain),
		cloudIdentityAllowlistedDomainPollCheckAbsence(domain),
		"Deleting AllowlistedDomain",
		d.Timeout(schema.TimeoutDelete),
		1,
	)
	if err != nil {
		return fmt.Errorf("Error waiting to delete AllowlistedDomain %q: %w", d.Id(), err)
	}
}
