// Individual keys are immutable in the API. Instead of replacing the whole keys map (which would
// require re-sending every existing CAK), send only the keys being added or removed, each as its own
// "keys.<name>" update-mask path. A path whose key is absent from the body removes that key.
// In-place changes to existing keys are rejected at plan time by the CustomizeDiff.
if d.HasChange("keys") {
	o, n := d.GetChange("keys")
	oldKeys := interconnectKeyGroupKeysByName(o)
	newKeys := interconnectKeyGroupKeysByName(n)
	allKeys, _ := obj["keys"].(map[string]interface{})

	keysBody := make(map[string]interface{})
	var keyPaths []string
	for name := range newKeys {
		if _, existed := oldKeys[name]; !existed {
			keyPaths = append(keyPaths, "keys."+name)
			if k, ok := allKeys[name]; ok {
				keysBody[name] = k
			}
		}
	}
	for name := range oldKeys {
		if _, kept := newKeys[name]; !kept {
			keyPaths = append(keyPaths, "keys."+name)
		}
	}
	sort.Strings(keyPaths)

	newMask := make([]string, 0, len(updateMask)+len(keyPaths))
	for _, p := range updateMask {
		if p != "keys" {
			newMask = append(newMask, p)
		}
	}
	updateMask = append(newMask, keyPaths...)

	if len(keysBody) > 0 {
		obj["keys"] = keysBody
	} else {
		delete(obj, "keys")
	}

	url, err = transport_tpg.AddQueryParams(url, map[string]string{"updateMask": strings.Join(updateMask, ",")})
	if err != nil {
		return err
	}
} else {
	// keys isn't in the update mask, so don't send any CAKs.
	delete(obj, "keys")
}
