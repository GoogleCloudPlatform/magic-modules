// The API models keys as a map keyed by key name; Terraform models them as a list (write-only
// arguments aren't allowed inside sets). cak_wo is write-only, so it's read from the raw
// configuration by key name instead of from v.
func expand{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d tpgresource.TerraformResourceData, config *transport_tpg.Config) (interface{}, error) {
	l, _ := v.([]interface{})
	if len(l) == 0 {
		return nil, nil
	}
	caks, _ := interconnectKeyGroupCaksFromConfig(d.GetRawConfig())
	keys := make(map[string]interface{}, len(l))
	for _, raw := range l {
		m, ok := raw.(map[string]interface{})
		if !ok {
			continue
		}
		name, _ := m["name"].(string)
		if name == "" {
			continue
		}
		key := map[string]interface{}{
			"name":      name,
			"startTime": m["start_time"],
			"ckn":       m["ckn"],
		}
		if cak := caks[name]; cak != "" {
			key["cak"] = cak
		}
		keys[name] = key
	}
	return keys, nil
}
