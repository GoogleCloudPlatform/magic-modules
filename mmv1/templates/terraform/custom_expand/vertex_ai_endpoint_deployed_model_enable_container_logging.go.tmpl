// Sends the negated value as disableContainerLogging. When the field is unset
// in config, nothing is sent so that the API default (logging enabled) applies.
func expand{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d tpgresource.TerraformResourceData, config *transport_tpg.Config) (interface{}, error) {
	rd, ok := d.(*schema.ResourceData)
	if !ok {
		return nil, nil
	}
	conf := rd.GetRawConfig()
	if conf.IsNull() || !conf.IsKnown() || !conf.Type().IsObjectType() || !conf.Type().HasAttribute("enable_container_logging") {
		return nil, nil
	}
	attr := conf.GetAttr("enable_container_logging")
	if !attr.IsKnown() || attr.IsNull() {
		return nil, nil
	}
	return !attr.True(), nil
}
