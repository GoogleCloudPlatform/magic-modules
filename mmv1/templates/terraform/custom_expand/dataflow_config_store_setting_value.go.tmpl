func expand{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d tpgresource.TerraformResourceData, config *transport_tpg.Config) (interface{}, error) {
	if v == nil {
		return nil, nil
	}
	l := v.([]interface{})
	if len(l) == 0 || l[0] == nil {
		return nil, nil
	}
	raw := l[0].(map[string]interface{})
	transformed := make(map[string]interface{})

	if d != nil {
{{- if not (contains $.ResourceMetadata.ProductMetadata.Compiler "terraformgoogleconversion") }}
		if rd, ok := d.(interface{ GetRawConfig() cty.Value }); ok {
			rawConfig := rd.GetRawConfig()
			if rawConfig.IsKnown() && !rawConfig.IsNull() && rawConfig.Type().IsObjectType() && rawConfig.Type().HasAttribute("value") {
				valueVal := rawConfig.GetAttr("value")
				if valueVal.IsKnown() && !valueVal.IsNull() && valueVal.LengthInt() > 0 {
					elem := valueVal.Index(cty.NumberIntVal(0))
					if elem.IsKnown() && !elem.IsNull() && elem.Type().IsObjectType() {
						if elem.Type().HasAttribute("string_value") {
							strAttr := elem.GetAttr("string_value")
							if strAttr.IsKnown() && !strAttr.IsNull() {
								transformed["stringValue"] = strAttr.AsString()
								return transformed, nil
							}
						}
						if elem.Type().HasAttribute("bool_value") {
							boolAttr := elem.GetAttr("bool_value")
							if boolAttr.IsKnown() && !boolAttr.IsNull() {
								transformed["boolValue"] = boolAttr.True()
								return transformed, nil
							}
						}
					}
				}
			}
		}
{{- end }}

		if s, ok := d.GetOk("value.0.string_value"); ok && s.(string) != "" {
			transformed["stringValue"] = s.(string)
			return transformed, nil
		}
		if b, exists := d.GetOkExists("value.0.bool_value"); exists {
			transformed["boolValue"] = b.(bool)
			return transformed, nil
		}
		return transformed, nil
	}

	if sv, ok := raw["string_value"].(string); ok && sv != "" {
		transformed["stringValue"] = sv
	} else if bv, ok := raw["bool_value"].(bool); ok {
		transformed["boolValue"] = bv
	}

	return transformed, nil
}
