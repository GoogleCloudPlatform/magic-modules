func expand{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d tpgresource.TerraformResourceData, config *transport_tpg.Config) (interface{}, error) {
	enforcement, ok := v.(int)
	if !ok {
		return nil, nil
	}
	if enforcement != 0 {
		return enforcement, nil
	}
{{- if not (contains $.ResourceMetadata.ProductMetadata.Compiler "terraformgoogleconversion") }}

	// Omitted enforcement must stay absent for serverless backends, which reject this field.
	// Explicit zero must reach the API instead of falling back to its default of 100.
	// A non-nil pointer survives the parent expander's empty-value filter and marshals as 0.
	if rd, ok := d.(*schema.ResourceData); ok {
		path := cty.GetAttrPath("outlier_detection").IndexInt(0).GetAttr("{{ underscore $.Name }}")
		if val, _ := rd.GetRawConfigAt(path); !val.IsNull() && val.IsKnown() {
			zero := int64(0)
			return &zero, nil
		}
	}
{{- end }}

	return nil, nil
}
