// The API can return nested settings objects that only contain default values
// even when the user never configured them (or after they were removed from
// config). If such an object only carries default values and the user hasn't
// configured the corresponding block, drop it so it doesn't cause a permadiff.
//
// isDefaultValue reports whether v is empty, or equal to the server default
// given in defaults. Map values are compared key by key, so keys missing from
// defaults must be empty.
var isDefaultValue func(v, defaults interface{}) bool
isDefaultValue = func(v, defaults interface{}) bool {
	switch t := v.(type) {
	case nil:
		return true
	case bool:
		return !t || t == defaults
	case string:
		return t == "" || t == defaults
	case float64:
		return t == 0 || t == defaults
	case []interface{}:
		for _, e := range t {
			if !isDefaultValue(e, nil) {
				return false
			}
		}
		return true
	case map[string]interface{}:
		defaultsMap, _ := defaults.(map[string]interface{})
		for k, e := range t {
			if !isDefaultValue(e, defaultsMap[k]) {
				return false
			}
		}
		return true
	}
	return false
}

// The API assigns contentCloudRegion when it isn't set.
endpointSettingsDefaults := map[string]interface{}{
	"contentCloudRegion": "US_CENTRAL",
}
if settings, ok := res["endpointSettings"]; ok {
	if _, configured := d.GetOk("endpoint_settings"); !configured && isDefaultValue(settings, endpointSettingsDefaults) {
		delete(res, "endpointSettings")
	}
}
{{- if ne $.TargetVersionName "ga" }}

// Once wildfireSettings has been set, the API keeps returning it with its
// default values after it is removed from config.
wildfireSettingsDefaults := map[string]interface{}{
	"wildfireRealtimeLookupDuration":      "1s",
	"wildfireRealtimeLookupTimeoutAction": "ALLOW",
	"wildfireInlineCloudAnalysisSettings": map[string]interface{}{
		"maxAnalysisDuration": "30s",
		"timeoutAction":       "ALLOW",
	},
}
if settings, ok := res["wildfireSettings"]; ok {
	if _, configured := d.GetOk("wildfire_settings"); !configured && isDefaultValue(settings, wildfireSettingsDefaults) {
		delete(res, "wildfireSettings")
	}
}
{{- end }}
return res, nil
