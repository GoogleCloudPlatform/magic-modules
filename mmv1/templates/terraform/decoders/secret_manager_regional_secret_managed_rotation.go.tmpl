// Managed rotation is a property of the regional secret. Treat the resource as gone if the secret no
// longer reports a managed rotation status (e.g. the secret was deleted and recreated).
rotation, ok := res["rotation"].(map[string]interface{})
if !ok {
	return nil, nil
}
if _, ok := rotation["managedRotationStatus"]; !ok {
	return nil, nil
}
return res, nil
