{{- else }}
		} else if v, ok := d.GetOkExists("{{ underscore $prop.Name }}"); !tpgresource.IsEmptyValue(reflect.ValueOf(v)) && (ok || !reflect.DeepEqual(v, {{ $prop.CamelizeProperty }}Prop)) {
