// Always force-send some attributes even if they were not modified. This works around extra API-side requirements.
obj["scope"] = d.Get("scope")
if d.Get("type") == "SECURE_WEB_GATEWAY" {
    obj["name"] = d.Get("name")
    obj["type"] = d.Get("type")
    if v := d.Get("routing_mode").(string); v != "" {
        obj["routingMode"] = v
    }
}
return obj, nil