	userLicense := make(map[string]interface{})

	if v, ok := obj["userPrincipal"].(string); ok && v != "" {
		userLicense["userPrincipal"] = v
	} else if v, ok := d.Get("user_principal").(string); ok && v != "" {
		userLicense["userPrincipal"] = v
	}
	// Always populate licenseConfig when configured: batchUpdateUserLicenses
	// unassigns the license whenever userLicenses[i].licenseConfig is empty,
	// even if licenseConfig is not listed in updateMask.
	if v, ok := obj["licenseConfig"].(string); ok && v != "" {
		userLicense["licenseConfig"] = v
	}
	if v, ok := obj["userProfile"].(string); ok && v != "" {
		userLicense["userProfile"] = v
	}

	var updateMask []string
	if d.Id() == "" {
		updateMask = []string{"licenseConfig", "userProfile"}
	} else {
		if d.HasChange("license_config") {
			updateMask = append(updateMask, "licenseConfig")
		}
		if d.HasChange("user_profile") {
			updateMask = append(updateMask, "userProfile")
		}
		if len(updateMask) == 0 {
			updateMask = []string{"licenseConfig", "userProfile"}
		}
	}

	// On Create and Update, always send deleteUnassignedUserLicenses: false so
	// omitting or clearing license_config retains the unassigned user license
	// record in NO_LICENSE state rather than deleting the user license record.
	// Record deletion on destroy is controlled by delete_unassigned_user_licenses
	// during Delete.
	req := map[string]interface{}{
		"inlineSource": map[string]interface{}{
			"userLicenses": []interface{}{userLicense},
			"updateMask":   strings.Join(updateMask, ","),
		},
		"deleteUnassignedUserLicenses": false,
	}
	return req, nil
