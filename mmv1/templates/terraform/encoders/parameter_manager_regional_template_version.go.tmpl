// Template is a URL parameter only, so extract project and location (if full resource name) and normalize to short template_id.
if v, ok := d.GetOk("template"); ok {
	if templateStr, ok := v.(string); ok {
		if parts := regexp.MustCompile(`^projects/([^/\s]+)/locations/([^/\s]+)/templates/([^/\s]+)$`).FindStringSubmatch(templateStr); len(parts) == 4 {
			if dProject, ok := d.Get("project").(string); ok && dProject != "" && dProject != parts[1] {
				return nil, fmt.Errorf("project field value (%s) does not match project of regional template (%s)", dProject, parts[1])
			}
			if dLocation, ok := d.Get("location").(string); ok && dLocation != "" && dLocation != parts[2] {
				return nil, fmt.Errorf("location field value (%s) does not match location of regional template (%s)", dLocation, parts[2])
			}
			if err := d.Set("project", parts[1]); err != nil {
				return nil, fmt.Errorf("Error setting project: %s", err)
			}
			if err := d.Set("location", parts[2]); err != nil {
				return nil, fmt.Errorf("Error setting location: %s", err)
			}
			if err := d.Set("template", parts[3]); err != nil {
				return nil, fmt.Errorf("Error setting template: %s", err)
			}
		} else if strings.Contains(templateStr, "/") {
			return nil, fmt.Errorf("invalid template %q: expected template_id or projects/{project}/locations/{location}/templates/{template_id}", templateStr)
		} else if dLocation, ok := d.Get("location").(string); !ok || dLocation == "" {
			return nil, fmt.Errorf("location must be set when providing only regional template name")
		}
	}
}
return obj, nil
