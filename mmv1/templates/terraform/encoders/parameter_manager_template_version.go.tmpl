// Template is a URL parameter only, so extract project (if full resource name) and normalize to short template_id.
if v, ok := d.GetOk("template"); ok {
	if templateStr, ok := v.(string); ok {
		if parts := regexp.MustCompile(`^projects/([^/\s]+)/locations/global/templates/([^/\s]+)$`).FindStringSubmatch(templateStr); len(parts) == 3 {
			if dProject, ok := d.Get("project").(string); ok && dProject != "" && dProject != parts[1] {
				return nil, fmt.Errorf("project field value (%s) does not match project of template (%s)", dProject, parts[1])
			}
			if err := d.Set("project", parts[1]); err != nil {
				return nil, fmt.Errorf("Error setting project: %s", err)
			}
			if err := d.Set("template", parts[2]); err != nil {
				return nil, fmt.Errorf("Error setting template: %s", err)
			}
		} else if strings.Contains(templateStr, "/") {
			return nil, fmt.Errorf("invalid template %q: expected template_id or projects/{project}/locations/global/templates/{template_id}", templateStr)
		}
	}
}
return obj, nil
