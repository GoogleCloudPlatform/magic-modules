if d.Get("region").(string) == "" {
	endpoint := d.Get("endpoint").(string)
	region := tpgresource.GetRegionFromRegionalSelfLink(endpoint)
	if region == "" || region == endpoint {
		return nil, fmt.Errorf("Cannot determine region from endpoint %q", endpoint)
	}
	if err := d.Set("region", region); err != nil {
		return nil, fmt.Errorf("Error setting region: %s", err)
	}
}

if _, ok := d.GetOk("automatic_resources"); ok {
	if _, exists := obj["automaticResources"]; !exists {
		obj["automaticResources"] = map[string]interface{}{}
	}
}
if _, ok := d.GetOk("dedicated_resources.0.machine_spec"); ok {
	if resources, ok := obj["dedicatedResources"].(map[string]interface{}); ok {
		if _, exists := resources["machineSpec"]; !exists {
			resources["machineSpec"] = map[string]interface{}{}
		}
	}
}

deployedModel := obj
deployedModel["id"] = d.Get("deployed_model_id")
delete(deployedModel, "deployedModelId")
delete(deployedModel, "endpoint")
delete(deployedModel, "region")
return map[string]interface{}{"deployedModel": deployedModel}, nil
