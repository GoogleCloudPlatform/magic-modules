// resourceTagsTagKeyResourceV0 describes the schema as it was at version 0.
//
// This is an explicit copy rather than a derivation from ResourceTagsTagKey: the live resource
// references resourceTagsTagKeyResourceV0 in its StateUpgraders block, so delegating to it here
// would recurse infinitely. The purpose_data change alters how the field is read and expanded, not
// the schema shape, so the two schemas currently describe the same fields - but this copy must stay
// frozen at version 0 and must NOT be updated when the live schema changes.
func resourceTagsTagKeyResourceV0() *schema.Resource {
	return &schema.Resource{
		Timeouts: &schema.ResourceTimeout{
			Create: schema.DefaultTimeout(20 * time.Minute),
			Update: schema.DefaultTimeout(20 * time.Minute),
			Delete: schema.DefaultTimeout(20 * time.Minute),
		},

		Schema: map[string]*schema.Schema{
			"name": {
				Type:     schema.TypeString,
				Computed: true,
			},
			"parent": {
				Type:     schema.TypeString,
				Required: true,
				ForceNew: true,
			},
			"short_name": {
				Type:     schema.TypeString,
				Required: true,
				ForceNew: true,
			},
			"namespaced_name": {
				Type:     schema.TypeString,
				Computed: true,
			},
			"description": {
				Type:     schema.TypeString,
				Optional: true,
			},
			"create_time": {
				Type:     schema.TypeString,
				Computed: true,
			},
			"update_time": {
				Type:     schema.TypeString,
				Computed: true,
			},
			"purpose": {
				Type:     schema.TypeString,
				Optional: true,
				ForceNew: true,
			},
			"purpose_data": {
				Type:     schema.TypeMap,
				Optional: true,
				ForceNew: true,
				Elem:     &schema.Schema{Type: schema.TypeString},
			},
			"allowed_values_regex": {
				Type:     schema.TypeString,
				Optional: true,
			},
			"deletion_policy": {
				Type:     schema.TypeString,
				Optional: true,
				Computed: true,
			},
		},
	}
}

// ResourceTagsTagKeyUpgradeV0 rewrites `purpose_data.network` from the short form
// ("{project}/{network_name}") to the self-link-with-id form the API returns
// ("https://www.googleapis.com/compute/{compute_version}/projects/{projectId}/global/networks/{networkId}").
//
// The expander rejects the short form, and purpose_data is immutable, so without this migration any
// existing state written in the short form would force a destroy-and-recreate of the tag key - which
// orphans every tag binding using it. This migration rewrites the value in place so the user only
// has to update their config.
//
// The migration is best-effort and never fails. Resolving the short form needs a Compute networks
// lookup, which can fail for reasons unrelated to this change (the network was deleted, or the
// caller lacks compute.networks.get). Returning an error from a state upgrader would block every
// subsequent plan on the resource, so on any failure the value is left as-is.
//
// NOTE: on failure this is silent. These log lines only reach the user when TF_LOG is set, because
// provider output is filtered by level by default. A caller lacking compute.networks.get therefore
// sees the short form left in state, which surfaces as a replacement diff. Granting
// compute.networks.get resolves it.
func ResourceTagsTagKeyUpgradeV0(ctx context.Context, rawState map[string]interface{}, meta interface{}) (map[string]interface{}, error) {
	log.Printf("[DEBUG] Attributes before migration: %#v", rawState)

	purposeData, ok := rawState["purpose_data"].(map[string]interface{})
	if !ok || purposeData == nil {
		return rawState, nil
	}
	transformed := make(map[string]interface{}, len(purposeData))
	for k, v := range purposeData {
		transformed[k] = v
	}
	network, ok := transformed["network"].(string)
	if !ok {
		return rawState, nil
	}

	// Only the two-segment "{project}/{network_name}" short form needs resolving; anything else
	// (including the canonical self link) is already in the form the API returns.
	parts := strings.Split(network, "/")
	if len(parts) != 2 {
		return rawState, nil
	}

	project, name := parts[0], parts[1]
	if project == "" || name == "" {
		log.Printf("[WARN] could not parse purpose_data.network %q while upgrading state to schema version 1; leaving it unchanged", network)
		return rawState, nil
	}

	config := meta.(*transport_tpg.Config)

	// Resolve the endpoint the same way the generated read does: BaseUrl honours
	// compute_custom_endpoint rather than assuming the public API. The billing project is taken from
	// the provider config, which is what GetBillingProject falls back to for this resource (it has no
	// billing_project field of its own). The user agent cannot be refined here because
	// GenerateUserAgentString needs a ResourceData to read provider meta, which a state upgrader
	// does not have.
	url := fmt.Sprintf("%sprojects/%s/global/networks/%s", transport_tpg.BaseUrl(tpgcompute.Product, config), project, name)
	res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   config.BillingProject,
		RawURL:    url,
		UserAgent: config.UserAgent,
	})
	if err != nil {
		log.Printf("[WARN] could not resolve purpose_data.network %q while upgrading state to schema version 1: %s; leaving it unchanged", network, err)
		return rawState, nil
	}
	selfLink, hasSelfLink := res["selfLink"].(string)
	if !hasSelfLink || selfLink == "" {
		log.Printf("[WARN] network %q returned no selfLink while upgrading state to schema version 1; leaving purpose_data.network unchanged", network)
		return rawState, nil
	}
	transformed["network"] = selfLink
	rawState["purpose_data"] = transformed

	log.Printf("[DEBUG] Attributes after migration: %#v", rawState)

	return rawState, nil
}
