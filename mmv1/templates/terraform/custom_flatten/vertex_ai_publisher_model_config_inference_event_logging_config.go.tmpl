func flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d *schema.ResourceData, config *transport_tpg.Config) interface{} {
	// The API omits the block (or returns STATE_UNSPECIFIED) when inference request metadata
	// logging has never been enabled; both mean DISABLED. Only surface the block when it is
	// present in the configuration so an unmanaged setting does not produce a diff.
	_, managed := d.GetOk("inference_event_logging_config")
	state := ""
	if v != nil {
		if original, ok := v.(map[string]interface{}); ok {
			if s, ok := original["state"].(string); ok {
				state = s
			}
		}
	}
	if state == "" || state == "STATE_UNSPECIFIED" {
		if !managed {
			return nil
		}
		state = "DISABLED"
	}
	return []interface{}{
		map[string]interface{}{
			"state": state,
		},
	}
}
