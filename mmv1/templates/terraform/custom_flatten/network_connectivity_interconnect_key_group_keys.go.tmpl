// Converts the API's keys map back into a list. Keys already in state keep their position (so
// reordering in config never causes a diff) and keep their configured formatting when the API value
// is equivalent; keys only known to the API are appended in name order. The CAK is never returned by
// the API and cak_wo is write-only, so it's never set here.
func flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d *schema.ResourceData, config *transport_tpg.Config) interface{} {
	apiKeys, ok := v.(map[string]interface{})
	if !ok || len(apiKeys) == 0 {
		return nil
	}

	flattenKey := func(name string, apiKey interface{}, prior map[string]interface{}) map[string]interface{} {
		k, _ := apiKey.(map[string]interface{})
		startTime, _ := k["startTime"].(string)
		ckn, _ := k["ckn"].(string)
		if prior != nil {
			if p, _ := prior["start_time"].(string); interconnectKeyGroupSameTime(p, startTime) {
				startTime = p
			}
			if p, _ := prior["ckn"].(string); strings.EqualFold(p, ckn) {
				ckn = p
			}
		}
		if n, _ := k["name"].(string); n != "" {
			name = n
		}
		return map[string]interface{}{
			"name":       name,
			"start_time": startTime,
			"ckn":        ckn,
		}
	}

	transformed := make([]interface{}, 0, len(apiKeys))
	seen := make(map[string]bool, len(apiKeys))
	prior, _ := d.Get("keys").([]interface{})
	for _, raw := range prior {
		p, ok := raw.(map[string]interface{})
		if !ok {
			continue
		}
		name, _ := p["name"].(string)
		apiKey, found := apiKeys[name]
		if !found || seen[name] {
			continue
		}
		transformed = append(transformed, flattenKey(name, apiKey, p))
		seen[name] = true
	}

	remaining := make([]string, 0, len(apiKeys))
	for name := range apiKeys {
		if !seen[name] {
			remaining = append(remaining, name)
		}
	}
	sort.Strings(remaining)
	for _, name := range remaining {
		transformed = append(transformed, flattenKey(name, apiKeys[name], nil))
	}
	return transformed
}
