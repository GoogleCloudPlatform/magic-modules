func flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d *schema.ResourceData, config *transport_tpg.Config) interface{} {
	if v == nil {
		return nil
	}
	if m, ok := v.(map[string]interface{}); ok {
		// The Vertex AI EvaluationRun API injects `pipeline_id` into `metadata` on read.
		// Strip `pipeline_id` unless the user explicitly configured it to avoid perpetual drift.
		hasUserMetadata := false
		var userMap map[string]interface{}
		if d != nil {
			if raw, ok := d.GetOk("metadata"); ok {
				if rawStr, ok := raw.(string); ok && rawStr != "" {
					hasUserMetadata = true
					_ = json.Unmarshal([]byte(rawStr), &userMap)
				}
			}
		}
		if _, userHasPipelineID := userMap["pipeline_id"]; !userHasPipelineID {
			delete(m, "pipeline_id")
		}
		if len(m) == 0 && !hasUserMetadata {
			return nil
		}
	}
	b, err := json.Marshal(v)
	if err != nil {
		log.Printf("[ERROR] failed to marshal schema to JSON: %v", err)
	}
	return string(b)
}
