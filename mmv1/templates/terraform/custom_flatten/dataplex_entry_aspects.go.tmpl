func flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}Aspect(v interface{}, d *schema.ResourceData, config *transport_tpg.Config) interface{} {
  if v == nil {
    return nil
  }
  original := v.(map[string]interface{})
  if len(original) == 0 {
    return nil
  }
  transformed := make(map[string]interface{})
  transformed["aspect_type"] =
    flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}AspectAspectType(original["aspectType"], d, config)
  transformed["path"] =
    flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}AspectPath(original["path"], d, config)
  transformed["create_time"] =
    flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}AspectCreateTime(original["createTime"], d, config)
  transformed["update_time"] =
    flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}AspectUpdateTime(original["updateTime"], d, config)
  transformed["data"] =
    flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}AspectData(original["data"], d, config)
  return []interface{}{transformed}
}

