resource "google_dialogflow_tool" "{{$.PrimaryResourceId}}" {
  location     = "global"
  tool_id      = "{{index $.ResourceIdVars "tool_key"}}"
  tool_key     = "{{index $.ResourceIdVars "tool_key"}}"
  display_name = "basic-tool"
  description  = "A basic tool with OpenAPI spec"
  action_confirmation_requirement = {
    "searchAction" = "NOT_REQUIRED"
  }
  open_api_spec {
    text_schema = <<EOF
openapi: 3.0.0
info:
  title: {{index $.ResourceIdVars "tool_key"}}
  version: 1.0.0
paths:
  /search:
    get:
      summary: Search function
      operationId: searchAction
      responses:
        '200':
          description: OK
EOF
  }
}
