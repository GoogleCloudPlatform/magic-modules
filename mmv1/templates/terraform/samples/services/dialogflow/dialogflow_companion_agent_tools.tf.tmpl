resource "google_ces_app" "app" {
  location     = "us"
  app_id       = "{{index $.ResourceIdVars "app_id"}}"
  display_name = "{{index $.ResourceIdVars "app_display_name"}}"

  time_zone_settings {
    time_zone = "America/Los_Angeles"
  }
}

resource "google_ces_tool" "tool_1" {
  location       = "us"
  app            = google_ces_app.app.name
  tool_id        = "{{index $.ResourceIdVars "tool_id_1"}}"
  execution_type = "SYNCHRONOUS"

  python_function {
    name        = "lookup_order"
    python_code = "def lookup_order(order_id: str) -> str: return order_id"
  }
}

resource "google_ces_toolset" "toolset_1" {
  location       = "us"
  app            = google_ces_app.app.name
  toolset_id     = "{{index $.ResourceIdVars "toolset_id_1"}}"
  display_name   = "{{index $.ResourceIdVars "toolset_display_name_1"}}"
  execution_type = "SYNCHRONOUS"

  open_api_toolset {
    open_api_schema = <<-EOT
      openapi: 3.0.0
      info:
        title: Order API
        version: 1.0.0
      servers:
        - url: https://api.example.com/v1
      paths:
        /orders:
          get:
            operationId: getOrder
            parameters:
              - name: order_id
                in: query
                required: true
                schema:
                  type: string
            responses:
              '200':
                description: OK
    EOT
  }
}

resource "google_dialogflow_companion_agent" "{{$.PrimaryResourceId}}" {
  location           = "us"
  companion_agent_id = "{{index $.ResourceIdVars "companion_agent_id"}}"
  display_name       = "{{index $.ResourceIdVars "display_name"}}"
  description        = "{{index $.Vars "description"}}"

  ces_tool_specs {
    ces_tool                 = google_ces_tool.tool_1.id
    confirmation_requirement = "NOT_REQUIRED"
    proactive_enabled        = true
    reactive_enabled         = false
    parameter_overrides {
      parameter_name        = "order_id"
      context_reference_key = "order_context"
      field_path            = "order.id"
    }
  }

  toolset_tools {
    toolset                  = google_ces_toolset.toolset_1.id
    operation_id             = "getOrder"
    confirmation_requirement = "NOT_REQUIRED"
    proactive_enabled        = false
    reactive_enabled         = true
    parameter_overrides {
      parameter_name        = "order_id"
      context_reference_key = "order_context"
      field_path            = "order.id"
    }
  }
}
