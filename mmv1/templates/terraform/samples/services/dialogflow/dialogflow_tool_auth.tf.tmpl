resource "google_dialogflow_tool" "{{$.PrimaryResourceId}}" {
  location     = "{{index $.ResourceIdVars "location"}}"
  tool_key     = "{{index $.ResourceIdVars "tool_key"}}"
  display_name = "auth-tool"
  description  = "A tool with OpenAPI spec and API Key Auth"

  open_api_spec {
    text_schema = <<EOF
openapi: 3.0.0
info:
  title: Test Tool
  version: 1.0.0
paths:
  /search:
    get:
      summary: Search function
      operationId: searchAction
      responses:
        '200':
          description: OK
EOF
    authentication {
      api_key_config {
        key_name         = "X-API-KEY"
        api_key          = "secret-key"
        request_location = "HEADER"
      }
    }
  }
}
