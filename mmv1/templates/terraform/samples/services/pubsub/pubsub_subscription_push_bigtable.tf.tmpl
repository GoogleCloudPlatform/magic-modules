resource "google_bigtable_instance" "{{$.PrimaryResourceId}}" {
  name = "{{index $.ResourceIdVars "instance_name"}}"

  cluster {
    cluster_id = "{{index $.ResourceIdVars "instance_name"}}"
    zone       = "us-central1-b"
    num_nodes  = 1
  }

  deletion_protection = false
}

resource "google_bigtable_app_profile" "{{$.PrimaryResourceId}}" {
  instance       = google_bigtable_instance.{{$.PrimaryResourceId}}.name
  app_profile_id = "{{index $.ResourceIdVars "app_profile_id"}}"

  single_cluster_routing {
    cluster_id = "{{index $.ResourceIdVars "instance_name"}}"
  }

  ignore_warnings = true
}

resource "google_bigtable_table" "{{$.PrimaryResourceId}}" {
  name          = "{{index $.ResourceIdVars "table_name"}}"
  instance_name = google_bigtable_instance.{{$.PrimaryResourceId}}.name

  column_family {
    family = "data"
  }

  column_family {
    family = "pubsub_metadata"
  }
}

resource "google_pubsub_topic" "{{$.PrimaryResourceId}}" {
  name = "{{index $.ResourceIdVars "topic_name"}}"
}

resource "google_pubsub_subscription" "{{$.PrimaryResourceId}}" {
  name  = "{{index $.ResourceIdVars "subscription_name"}}"
  topic = google_pubsub_topic.{{$.PrimaryResourceId}}.id

  bigtable_config {
    table          = google_bigtable_table.{{$.PrimaryResourceId}}.id
    app_profile_id = google_bigtable_app_profile.{{$.PrimaryResourceId}}.app_profile_id
    write_metadata = true

    column_family_mapping {
      delimited_key {
        key_fields = ["user_id", "event_id"]
        # base64 encoding of "#"
        delimiter  = "Iw=="
      }
    }
  }
}
