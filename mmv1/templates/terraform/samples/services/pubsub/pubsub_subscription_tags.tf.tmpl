resource "google_pubsub_topic" "{{$.PrimaryResourceId}}" {
  name = "{{index $.ResourceIdVars "topic_name"}}"
}

resource "google_pubsub_subscription" "{{$.PrimaryResourceId}}" {
  name  = "{{index $.ResourceIdVars "subscription_name"}}"
  topic = google_pubsub_topic.{{$.PrimaryResourceId}}.id
  tags = {
    (data.google_tags_tag_key.tag_key.namespaced_name) = data.google_tags_tag_value.tag_value.short_name
  }
}

data "google_project" "project" {}

data "google_tags_tag_key" "tag_key" {
  parent     = data.google_project.project.id
  short_name = "{{index $.ResourceIdVars "tag_key"}}"
}

data "google_tags_tag_value" "tag_value" {
  parent     = data.google_tags_tag_key.tag_key.id
  short_name = "{{index $.ResourceIdVars "tag_value"}}"
}
