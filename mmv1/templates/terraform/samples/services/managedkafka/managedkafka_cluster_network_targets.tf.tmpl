resource "google_managed_kafka_cluster" "{{$.PrimaryResourceId}}" {
  cluster_id = "{{index $.ResourceIdVars "cluster_id"}}"
  location = "us-central1"
  capacity_config {
    vcpu_count = 3
    memory_bytes = 3221225472
  }
  gcp_config {
    access_config {
      network_configs {
        subnet = "projects/${data.google_project.project.number}/regions/us-central1/subnetworks/default"
        # In a Shared VPC topology, create the Private Service Connect endpoints
        # and the private DNS zone in the cluster's (service) project instead of
        # the network's (host) project.
        psc_resource_target = "PSC_CLUSTER_PROJECT"
        dns_zone_target     = "DNS_ZONE_CLUSTER_PROJECT"
      }
    }
  }
  rebalance_config {
    mode = "AUTO_REBALANCE_ON_SCALE_UP"
  }
}

data "google_project" "project" {
}
