resource "google_cloud_run_v2_instance" "{{$.PrimaryResourceId}}" {
  name                             = "{{index $.ResourceIdVars "cloud_run_instance_name"}}"
  location                         = "us-east4"
  encryption_key                   = "{{index $.ResourceIdVars "kms_key_name"}}"
  encryption_key_revocation_action = "SHUTDOWN"
  encryption_key_shutdown_duration = "3600s"

  containers {
    image = "us-docker.pkg.dev/cloudrun/container/hello"
  }
}
