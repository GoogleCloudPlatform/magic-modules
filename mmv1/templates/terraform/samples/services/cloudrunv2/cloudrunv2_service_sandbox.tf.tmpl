resource "google_cloud_run_v2_service" "{{$.PrimaryResourceId}}" {
  name     = "{{index $.ResourceIdVars "cloud_run_service_name"}}"
  location = "us-central1"
  deletion_protection = false
  launch_stage = "BETA"
  template {
    containers {
      image = "us-docker.pkg.dev/cloudrun/container/hello"
      sandbox_launcher = true
      volume_mounts {
        name = "empty-dir-volume"
        mount_path = "/mnt"
      }
    }
    sandboxes {
      resources {
        limits = {
          cpu    = "2"
          memory = "2Gi"
        }
      }
      templates {
        name  = "hello"
        image = "us-docker.pkg.dev/cloudrun/container/hello"
        command = ["/bin/sh"]
        args = ["-c", "echo hello"]
        env {
          name = "PORT"
          value = "9000"
        }
        volume_mounts {
          name = "empty-dir-volume"
          mount_path = "/mnt"
        }
      }
    }
    volumes {
      name = "empty-dir-volume"
      empty_dir {
        medium = "MEMORY"
        size_limit = "256Mi"
      }
    }
  }
}
