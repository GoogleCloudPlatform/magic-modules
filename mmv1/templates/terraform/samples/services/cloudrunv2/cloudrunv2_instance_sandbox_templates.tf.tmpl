resource "google_cloud_run_v2_instance" "{{$.PrimaryResourceId}}" {
  name         = "{{index $.ResourceIdVars "cloud_run_instance_name"}}"
  location     = "us-west4"
  launch_stage = "BETA"

  containers {
    image            = "us-docker.pkg.dev/cloudrun/container/hello"
    sandbox_launcher = {{index $.Vars "sandbox_launcher"}}
    volume_mounts {
      name       = "empty-dir-volume"
      mount_path = "/mnt"
    }
  }
  sandboxes {
    templates {
      name    = "{{index $.Vars "sandbox_name"}}"
      image   = "us-docker.pkg.dev/cloudrun/container/hello"
      command = {{index $.Vars "command"}}
      args    = {{index $.Vars "args"}}
      env {
        name  = "PORT"
        value = "{{index $.Vars "env_value"}}"
      }
      volume_mounts {
        name       = "empty-dir-volume"
        mount_path = "/mnt"
        sub_path   = "{{index $.Vars "sub_path"}}"
      }
      working_dir = "{{index $.Vars "working_dir"}}"
    }
  }
  volumes {
    name = "empty-dir-volume"
    empty_dir {
      medium     = "MEMORY"
      size_limit = "256Mi"
    }
  }
}
