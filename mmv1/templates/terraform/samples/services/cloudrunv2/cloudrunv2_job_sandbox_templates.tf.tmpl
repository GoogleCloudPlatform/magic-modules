resource "google_cloud_run_v2_job" "{{$.PrimaryResourceId}}" {
  name                = "{{index $.ResourceIdVars "cloud_run_job_name"}}"
  location            = "us-central1"
  deletion_protection = false
  launch_stage        = "BETA"

  template {
    template {
      containers {
        image            = "us-docker.pkg.dev/cloudrun/container/job"
        sandbox_launcher = true
        volume_mounts {
          name       = "empty-dir-volume"
          mount_path = "/mnt"
        }
      }
      sandboxes {
        templates {
          name    = "{{index $.Vars "sandbox_name"}}"
          image   = "us-docker.pkg.dev/cloudrun/container/hello"
          command = {{index $.Vars "command"}}
          args    = {{index $.Vars "args"}}
          env {
            name  = "PORT"
            value = "{{index $.Vars "env_value"}}"
          }
          volume_mounts {
            name       = "empty-dir-volume"
            mount_path = "/mnt"
            sub_path   = "{{index $.Vars "sub_path"}}"
          }
          working_dir = "{{index $.Vars "working_dir"}}"
        }
      }
      volumes {
        name = "empty-dir-volume"
        empty_dir {
          medium     = "MEMORY"
          size_limit = "256Mi"
        }
      }
    }
  }
}
