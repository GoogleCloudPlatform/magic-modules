resource "google_agent_identity_auth_provider" "{{$.PrimaryResourceId}}" {
  location         = "us-central1"
  auth_provider_id = "{{index $.ResourceIdVars "auth_provider_id"}}"
  description      = "Cross-App Access auth provider"

  auth_provider_type_params {
    xaa_auth_provider {
      additional_parameters = {
        prompt = "consent"
      }
      client_secret_auth {
        client_id     = "test-client-id"
        client_secret = "test-client-secret"
      }
      custom_issuer {
        token_url = "https://auth.example.com/token"
        issuer    = "https://auth.example.com"
      }
      id_token_input {
        id_jag_auth_provider = "projects/{{index $.TestEnvVars "project"}}/locations/us-central1/authProviders/idp-provider"
        id_jag_additional_claims = jsonencode({
          env = "test"
        })
      }
    }
  }
}
