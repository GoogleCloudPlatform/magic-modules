resource "google_design_center_catalog_template_revision" "{{$.PrimaryResourceId}}" {
  project                              = "{{index $.Vars "project"}}"
  location                             = "us-central1"
  space                                = "{{index $.Vars "space"}}"
  catalog                              = "{{index $.Vars "catalog"}}"
  catalog_template                     = "{{index $.Vars "catalog_template"}}"
  revision_id                          = "{{index $.ResourceIdVars "revision_id"}}"
  description                          = "Example application catalog template revision"
  type                                 = "STANDARD_APPLICATION_TEMPLATE"
  application_template_revision_source = "{{index $.Vars "application_template_revision"}}"

  annotations = {
    environment = "test"
    team        = "platform"
  }
}
