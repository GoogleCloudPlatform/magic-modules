resource "google_design_center_connection" "example" {
  project                   = "{{index $.Vars "project"}}"
  location                  = "us-central1"
  space                     = "{{index $.Vars "space"}}"
  application_template      = "{{index $.Vars "application_template"}}"
  component                 = "{{index $.Vars "component"}}"
  connection_id             = "{{index $.ResourceIdVars "connection_id"}}"
  destination_component_uri = "{{index $.Vars "destination_component_uri"}}"

  source_component_parameters {
    key   = "service_account_project_roles"
    value = jsonencode(["roles/cloudsql.client", "roles/cloudsql.instanceUser"])
  }

  destination_component_parameters {
    key = "iam_users"
    value = jsonencode([
      {
        id    = "updated-sa"
        email = "updated-sa@{{index $.Vars "project"}}.iam.gserviceaccount.com"
        type  = "CLOUD_IAM_SERVICE_ACCOUNT"
      },
    ])
  }
}
