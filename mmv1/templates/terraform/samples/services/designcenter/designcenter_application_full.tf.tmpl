resource "google_design_center_application" "example" {
  project            = "{{index $.Vars "project"}}"
  location           = "us-central1"
  space              = "{{index $.Vars "space"}}"
  application_id     = "{{index $.ResourceIdVars "application_id"}}"
  display_name       = "Example Application"
  description        = "Managed by Terraform"
  deployment_region  = "us-central1"
  deployment_project = "{{index $.Vars "project"}}"
  service_account    = "{{index $.Vars "service_account"}}"

  source {
    application_template_revision = "{{index $.Vars "application_template_revision_uri"}}"
  }

  scope {
    type = "REGIONAL"
  }

  app_parameters {
    key   = "project_id"
    value = jsonencode("{{index $.Vars "project"}}")
  }

  attributes {
    criticality {
      type = "HIGH"
    }

    environment {
      type = "STAGING"
    }

    developer_owners {
      display_name = "Example Developer"
      email        = "developer@example.com"
    }

    operator_owners {
      display_name = "Example Operator"
      email        = "operator@example.com"
    }

    business_owners {
      display_name = "Example Business Owner"
      email        = "business@example.com"
    }
  }

  deployment_target {
    gke_deployment_target {
      cluster_self_link                   = "projects/{{index $.Vars "project"}}/locations/us-central1/clusters/example-cluster"
      namespace                           = "example-namespace"
      kubernetes_service_account          = "default"
      kubernetes_service_account_creation = true
    }
  }
}
