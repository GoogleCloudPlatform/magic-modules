resource "google_alloydb_instance" "{{$.PrimaryResourceId}}" {
  cluster           = google_alloydb_cluster.{{$.PrimaryResourceId}}.name
  instance_id       = "{{index $.ResourceIdVars "alloydb_instance_name"}}"
  instance_type     = "PRIMARY"
  availability_type = "ZONAL"

  machine_config {
    cpu_count = 2
  }
}

resource "google_alloydb_cluster" "{{$.PrimaryResourceId}}" {
  cluster_id = "{{index $.ResourceIdVars "alloydb_cluster_name"}}"
  location   = "us-central1"

  initial_user {
    password = "{{index $.ResourceIdVars "alloydb_cluster_name"}}"
  }
  psc_config {
    psc_enabled = true
  }

  continuous_backup_config {
    enabled = false
  }

  deletion_protection = false
}
