resource "google_alloydb_instance" "default" {
  provider      = google-beta
  cluster       = google_alloydb_cluster.default.name
  instance_id   = "{{index $.ResourceIdVars "alloydb_instance_name"}}"
  instance_type = "PRIMARY"

  # IAM group authentication requires both flags to be enabled on the instance.
  database_flags = {
    "alloydb.iam_authentication"       = "on"
    "alloydb.iam_group_authentication" = "on"
  }
}

resource "google_alloydb_cluster" "default" {
  provider   = google-beta
  cluster_id = "{{index $.ResourceIdVars "alloydb_cluster_name"}}"
  location   = "us-central1"
  network_config {
    network = data.google_compute_network.default.id
  }
  initial_user {
    password = "{{index $.ResourceIdVars "alloydb_cluster_pass"}}"
  }

  deletion_protection = false
}

data "google_compute_network" "default" {
  provider = google-beta
  name     = "{{index $.ResourceIdVars "network_name"}}"
}

resource "google_alloydb_user" "{{$.PrimaryResourceId}}" {
  provider  = google-beta
  cluster   = google_alloydb_cluster.default.name
  user_id   = "{{index $.ResourceIdVars "alloydb_user_name"}}"
  user_type = "ALLOYDB_IAM_GROUP"

  database_roles = ["alloydbiamuser"]
  depends_on     = [google_alloydb_instance.default]
}
