resource "google_database_migration_service_connection_profile" "{{$.PrimaryResourceId}}" {
  location              = "us-central1"
  connection_profile_id = "{{index $.ResourceIdVars "profile"}}"
  display_name          = "{{index $.ResourceIdVars "profile"}}-display"
  labels = {
    foo = "bar"
  }
  postgresql {
    host     = "10.20.30.40"
    port     = 5432
    username = "{{index $.ResourceIdVars "sqldb_user"}}"
    password = "{{index $.ResourceIdVars "sqldb_pass"}}"
    database = "postgres"
    ssl {
      type = "REQUIRED"
      ssl_flags = {
        server_certificate_hostname = "{{index $.Vars "ssl_hostname"}}"
      }
    }
  }
}
