resource "google_model_armor_template" "template-filter-config" {
  location    = "{{index $.ResourceIdVars "location"}}"
  template_id = "{{index $.ResourceIdVars "templateId"}}"

  filter_config {
    rai_settings {
      rai_filters {
        filter_type      = "{{index $.ResourceIdVars "filter_config_rai_settings_rai_filters_0_filter_type"}}"
        confidence_level = "{{index $.ResourceIdVars "filter_config_rai_settings_rai_filters_0_confidence_level"}}"
      }
    }
    sdp_settings {
      basic_config {
          filter_enforcement = "{{index $.ResourceIdVars "filter_config_sdp_settings_basic_config_filter_enforcement"}}"
      }
    }
    pi_and_jailbreak_filter_settings {
      filter_enforcement = "{{index $.ResourceIdVars "filter_config_pi_and_jailbreak_filter_settings_filter_enforcement"}}"
      confidence_level   = "{{index $.ResourceIdVars "filter_config_pi_and_jailbreak_filter_settings_confidence_level"}}"
    }
    malicious_uri_filter_settings {
      filter_enforcement = "{{index $.ResourceIdVars "filter_config_malicious_uri_filter_settings_filter_enforcement"}}"
    }
    filter_rule_settings {
      rule_sets {
        filter_types = ["PROMPT_INJECTION_AND_JAILBREAK", "RESPONSIBLE_AI"]
        rules {
          exclusion_rule {
            matching_scope = "MATCHING_SCOPE_PARTIAL_MATCH"
            dictionary {
              word_list {
                words = ["allowphrase1", "allowphrase2"]
              }
            }
          }
        }
        rules {
          exclusion_rule {
            matching_scope = "MATCHING_SCOPE_FULL_MATCH"
            regex {
              pattern = "^safe_pattern_[0-9]+$"
            }
          }
        }
      }
    }
  }
  template_metadata {
    multi_language_detection {
    enable_multi_language_detection        = {{index $.ResourceIdVars "template_metadata_multi_language_detection_enable_multi_language_detection"}}
    }
  }
}