resource "google_workbench_instance" "{{$.PrimaryResourceId}}" {
  name = "{{index $.ResourceIdVars "instance_name"}}"
  location = "us-east1-b"

  gce_setup {
    machine_type = "n4-standard-2"
    container_image {
      repository = "us-docker.pkg.dev/deeplearning-platform-release/gcr.io/base-cu113.py310"
      tag = "latest"
    }
  }
}
