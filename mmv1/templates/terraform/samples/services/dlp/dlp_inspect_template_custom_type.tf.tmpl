resource "google_data_loss_prevention_inspect_template" "{{$.PrimaryResourceId}}" {
	parent = "projects/{{index $.TestEnvVars "project"}}"
	description = "My description"
	display_name = "display_name"

	inspect_config {
		custom_info_types {
			info_type {
				name = "MY_CUSTOM_TYPE"
			}

			likelihood = "UNLIKELY"

			regex {
				pattern = "test*"
			}
		}

		custom_info_types {
			info_type {
				name = "MY_METADATA_KV_TYPE"
			}

			likelihood = "POSSIBLE"

			metadata_key_value_expression {
				key_regex   = "key.*"
				value_regex = "val.*"
			}
		}

		info_types {
			name = "EMAIL_ADDRESS"
		}

		info_types {
			name = "OBJECT_TYPE/PERSON"
		}

		info_types {
			name = "OBJECT_TYPE/PERSON/PASSPORT"
		}

		min_likelihood = "UNLIKELY"
		rule_set {
			info_types {
				name = "EMAIL_ADDRESS"
			}
			rules {
				exclusion_rule {
					regex {
						pattern = ".+@example.com"
					}
					matching_type = "MATCHING_TYPE_FULL_MATCH"
				}
			}
		}

		rule_set {
			info_types {
				name = "OBJECT_TYPE/PERSON"
			}
			rules {
				exclusion_rule {
					matching_type = "MATCHING_TYPE_RULE_SPECIFIC"
					exclude_by_image_findings {
						info_types {
							name    = "OBJECT_TYPE/PERSON/PASSPORT"
							version = "latest"
							sensitivity_score {
								score = "SENSITIVITY_LOW"
							}
						}
						image_containment_type {
							fully_inside {}
						}
					}
				}
			}
		}

		rule_set {
			info_types {
				name = "MY_CUSTOM_TYPE"
			}
			rules {
				hotword_rule {
					hotword_regex {
						pattern = "example*"
					}
					proximity {
						window_before = 50
					}
					likelihood_adjustment {
						fixed_likelihood = "VERY_LIKELY"
					}
				}
			}
		}

		limits {
			max_findings_per_item    = 10
			max_findings_per_request = 50
		}
	}
}
