resource "google_compute_network" "network" {
  name                    = "{{index $.ResourceIdVars "network_name"}}"
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "subnetwork" {
  name          = "{{index $.ResourceIdVars "subnetwork_name"}}"
  network       = google_compute_network.network.id
  ip_cidr_range = "10.0.0.0/24"
  region        = "us-central1"
}

resource "google_compute_subnetwork" "proxy_subnetwork" {
  name          = "{{index $.ResourceIdVars "proxy_subnetwork_name"}}"
  network       = google_compute_network.network.id
  ip_cidr_range = "10.0.1.0/24"
  region        = "us-central1"
  purpose       = "REGIONAL_MANAGED_PROXY"
  role          = "ACTIVE"
}

resource "google_dns_outbound_endpoint" "{{$.PrimaryResourceId}}" {
  name        = "{{index $.ResourceIdVars "outbound_endpoint_name"}}"
  location    = "us-central1"
  network     = google_compute_network.network.id
  subnetwork  = google_compute_subnetwork.subnetwork.id
  endpoint_ip = "10.0.0.10"
  description = "{{index $.Vars "description"}}"
  labels = {
    env = "{{index $.Vars "env"}}"
  }
  annotations = {
    owner = "{{index $.Vars "owner"}}"
  }

  depends_on = [
    google_compute_subnetwork.proxy_subnetwork
  ]
}
