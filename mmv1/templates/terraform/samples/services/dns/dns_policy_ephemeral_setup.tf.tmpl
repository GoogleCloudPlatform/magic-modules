resource "google_compute_network" "ephemeral" {
  name                    = "{{index $.ResourceIdVars "network_name"}}"
  auto_create_subnetworks  = false
}

resource "google_dns_policy" "source" {
  name           = "{{index $.ResourceIdVars "policy_name"}}"
  description    = "Ephemeral GET regression fixture"
  enable_logging = true

  alternative_name_server_config {
    target_name_servers {
      ipv4_address    = "172.16.1.10"
      forwarding_path = "private"
    }
    target_name_servers {
      ipv4_address    = "172.16.1.20"
      forwarding_path = "private"
    }
  }

  networks {
    network_url = google_compute_network.ephemeral.id
  }
}
