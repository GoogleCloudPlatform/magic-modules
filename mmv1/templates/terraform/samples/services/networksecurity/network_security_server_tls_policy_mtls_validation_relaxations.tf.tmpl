resource "google_network_security_server_tls_policy" "{{$.PrimaryResourceId}}" {
  name        = "{{index $.ResourceIdVars "resource_name"}}"
  description = "ServerTlsPolicy with mTLS validation relaxations"
  location    = "global"
  allow_open  = "false"

  mtls_policy {
    client_validation_mode = "ALLOW_VALIDATION_RELAXATIONS"
    client_validation_relaxations = [
      "ALLOW_MISSING_EKU",
      "ALLOW_SHA1_HASHING",
      "ALLOW_EXPIRED_LEAF_CERTIFICATE",
    ]
    client_validation_trust_config = google_certificate_manager_trust_config.default.id
  }

  labels = {
    foo = "bar"
  }
}

resource "google_certificate_manager_trust_config" "default" {
  name        = "{{index $.ResourceIdVars "trust_config_name"}}"
  description = "sample trust config description"
  location    = "global"

  trust_stores {
    trust_anchors {
      pem_certificate = file("test-fixtures/ca_cert.pem")
    }
    intermediate_cas {
      pem_certificate = file("test-fixtures/ca_cert.pem")
    }
  }

  labels = {
    foo = "bar"
  }
}
