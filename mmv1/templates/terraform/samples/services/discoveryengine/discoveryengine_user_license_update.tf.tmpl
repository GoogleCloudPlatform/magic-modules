resource "google_discovery_engine_license_config" "basic" {
  location          = "global"
  license_config_id = "{{index $.ResourceIdVars "license_config_id"}}"
  license_count     = 50
  subscription_tier = "SUBSCRIPTION_TIER_NOTEBOOK_LM"
  start_date {
    year  = 2099
    month = 1
    day   = 1
  }
  end_date {
    year  = 2100
    month = 1
    day   = 1
  }
  subscription_term = "SUBSCRIPTION_TERM_ONE_YEAR"
}

resource "google_discovery_engine_license_config" "secondary" {
  location          = "global"
  license_config_id = "{{index $.ResourceIdVars "license_config_id_2"}}"
  license_count     = 50
  subscription_tier = "SUBSCRIPTION_TIER_NOTEBOOK_LM"
  start_date {
    year  = 2099
    month = 1
    day   = 1
  }
  end_date {
    year  = 2100
    month = 1
    day   = 1
  }
  subscription_term = "SUBSCRIPTION_TERM_ONE_YEAR"
}

resource "google_discovery_engine_user_store" "basic" {
  location = google_discovery_engine_license_config.basic.location
}

resource "google_discovery_engine_user_license" "{{$.PrimaryResourceId}}" {
  location                        = google_discovery_engine_user_store.basic.location
  user_store_id                   = google_discovery_engine_user_store.basic.user_store_id
  user_principal                  = "{{index $.ResourceIdVars "user_principal_id"}}@example.com"
  license_config                  = google_discovery_engine_license_config.secondary.name
  user_profile                    = "Updated User"
  delete_unassigned_user_licenses = false
}
