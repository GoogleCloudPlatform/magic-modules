resource "google_secure_source_manager_instance" "instance" {
    location = "asia-east1"
    instance_id = "{{index $.ResourceIdVars "instance_id"}}"

    # Prevent accidental deletions.
    deletion_policy = "{{index $.ResourceIdVars "deletion_policy"}}"
}

resource "google_service_account" "sa" {
    account_id   = "{{index $.ResourceIdVars "sa_id"}}"
    display_name = "Test Service Account"
}

resource "google_secure_source_manager_repository" "repository" {
    repository_id = "{{index $.ResourceIdVars "repository_id"}}"
    instance = google_secure_source_manager_instance.instance.name
    location = google_secure_source_manager_instance.instance.location
    service_account = google_service_account.sa.email

    # Prevent accidental deletions.
    deletion_policy = "{{index $.ResourceIdVars "deletion_policy"}}"
}

resource "google_secure_source_manager_hook" "{{$.PrimaryResourceId}}" {
    hook_id = "{{index $.ResourceIdVars "hook_id"}}"
    location = google_secure_source_manager_repository.repository.location
    repository_id = google_secure_source_manager_repository.repository.repository_id
    target_uri = "{{index $.Vars "target_uri"}}"
    sensitive_query_string = "{{index $.Vars "sensitive_query_string"}}"
    disabled = {{index $.Vars "disabled"}}
    service_account_auth = {{index $.Vars "service_account_auth"}}
    push_option {
        branch_filter = "{{index $.Vars "branch_filter"}}"
    }
    events = ["PUSH", "PULL_REQUEST", "PULL_REQUEST_COMMENT"]
}
