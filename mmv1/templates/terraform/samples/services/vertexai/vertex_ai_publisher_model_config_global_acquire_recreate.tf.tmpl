# Creating tf_test_acquired with state = "ENABLED" on ("global", "google", "gemini-2.0-flash-lite-001")
# while remote has state = "DISABLED" acquires and updates the singleton via 200 OK LRO.
resource "google_vertex_ai_publisher_model_config" "{{$.PrimaryResourceId}}" {
  provider  = google-beta
  region    = "global"
  publisher = "google"
  model     = "gemini-2.0-flash-001"

  inference_event_logging_config {
    state = "ENABLED"
  }
}

resource "google_vertex_ai_publisher_model_config" "tf_test_acquired" {
  provider  = google-beta
  region    = "global"
  publisher = "google"
  model     = "gemini-2.0-flash-lite-001"

  inference_event_logging_config {
    state = "ENABLED"
  }

  depends_on = [google_vertex_ai_publisher_model_config.{{$.PrimaryResourceId}}]
}
