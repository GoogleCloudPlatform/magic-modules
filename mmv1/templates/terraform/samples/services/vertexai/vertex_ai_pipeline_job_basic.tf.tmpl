resource "google_storage_bucket" "bucket" {
  name                        = "{{index $.ResourceIdVars "storage_bucket"}}"
  location                    = "us-central1"
  uniform_bucket_level_access = true
  force_destroy               = true
}

resource "google_vertex_ai_pipeline_job" "{{$.PrimaryResourceId}}" {
  display_name          = "{{index $.ResourceIdVars "pipeline_job_id"}}"
  pipeline_job_id       = "{{index $.ResourceIdVars "pipeline_job_id"}}"
  region                = "us-central1"
  preflight_validations = false
  deletion_policy       = "FORCE"

  pipeline_spec = jsonencode({
    components = {
      comp-hello-world = {
        executorLabel = "exec-hello-world"
        inputDefinitions = {
          parameters = {
            text = {
              parameterType = "STRING"
            }
          }
        }
      }
    }
    deploymentSpec = {
      executors = {
        exec-hello-world = {
          container = {
            args = [
              "--text",
              "{{ "{{" }}$.inputs.parameters['text']{{ "}}" }}"
            ]
            command = [
              "sh",
              "-c",
              "echo \"$0\""
            ]
            image = "python:3.11"
          }
        }
      }
    }
    pipelineInfo = {
      name = "hello-world-pipeline"
    }
    root = {
      dag = {
        tasks = {
          hello-world = {
            cachingOptions = {
              enableCache = true
            }
            componentRef = {
              name = "comp-hello-world"
            }
            inputs = {
              parameters = {
                text = {
                  componentInputParameter = "text"
                }
              }
            }
            taskInfo = {
              name = "hello-world"
            }
          }
        }
      }
      inputDefinitions = {
        parameters = {
          text = {
            defaultValue  = "Hello World"
            isOptional    = true
            parameterType = "STRING"
          }
        }
      }
    }
    schemaVersion = "2.1.0"
    sdkVersion    = "kfp-2.7.0"
  })

  runtime_config {
    gcs_output_directory = "gs://${google_storage_bucket.bucket.name}/output"
    failure_policy       = "PIPELINE_FAILURE_POLICY_FAIL_FAST"
    parameter_values = {
      text = "Hello Vertex AI"
    }
  }

  labels = {
    env = "test"
  }
}
