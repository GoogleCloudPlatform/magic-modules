resource "google_vertex_ai_evaluation_item" "evaluation_item" {
  region               = "us-central1"
  display_name         = "{{index $.ResourceIdVars "item_display_name"}}"
  evaluation_item_type = "REQUEST"
  evaluation_request {
    prompt {
      text = "hello"
    }
  }
}

resource "google_vertex_ai_evaluation_set" "{{$.PrimaryResourceId}}" {
  region       = "us-central1"
  display_name = "{{index $.ResourceIdVars "display_name"}}"
  evaluation_items = [
    google_vertex_ai_evaluation_item.evaluation_item.id,
  ]
  metadata = jsonencode({
    "env" = "test"
  })
}
