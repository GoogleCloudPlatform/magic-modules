# Removing tf_test_abandoned with deletion_policy = "ABANDON" leaves remote state = "DISABLED"
# on ("global", "google", "gemini-2.0-flash-lite-001"), verified after apply via postcondition.
resource "google_vertex_ai_publisher_model_config" "{{$.PrimaryResourceId}}" {
  provider  = google-beta
  region    = "global"
  publisher = "google"
  model     = "gemini-2.0-flash-001"

  inference_event_logging_config {
    state = "DISABLED"
  }
}

data "google_vertex_ai_publisher_model_config" "tf_test_check" {
  provider  = google-beta
  region    = "global"
  publisher = "google"
  model     = "gemini-2.0-flash-lite-001"

  depends_on = [google_vertex_ai_publisher_model_config.{{$.PrimaryResourceId}}]

  lifecycle {
    postcondition {
      condition     = self.inference_event_logging_config[0].state == "DISABLED"
      error_message = "Expected abandoned global PublisherModelConfig to retain state = DISABLED."
    }
  }
}
