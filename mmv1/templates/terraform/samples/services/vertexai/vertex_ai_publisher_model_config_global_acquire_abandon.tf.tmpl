# Primary resource updates in place across steps for MMv1's generated update/import checks,
# while tf_test_abandoned seeds ("global", "google", "gemini-2.0-flash-lite-001") with
# state = "DISABLED" and deletion_policy = "ABANDON".
resource "google_vertex_ai_publisher_model_config" "{{$.PrimaryResourceId}}" {
  provider  = google-beta
  region    = "global"
  publisher = "google"
  model     = "gemini-2.0-flash-001"

  inference_event_logging_config {
    state = "ENABLED"
  }
}

resource "google_vertex_ai_publisher_model_config" "tf_test_abandoned" {
  provider        = google-beta
  region          = "global"
  publisher       = "google"
  model           = "gemini-2.0-flash-lite-001"
  deletion_policy = "ABANDON"

  inference_event_logging_config {
    state = "DISABLED"
  }

  depends_on = [google_vertex_ai_publisher_model_config.{{$.PrimaryResourceId}}]
}
