resource "google_vertex_ai_publisher_model_config" "{{$.PrimaryResourceId}}" {
  provider = google-beta

  location  = "global"
  publisher = "google"
  model     = "gemini-3.5-flash"

  # Structured per-request metadata in Cloud Logging
  # (aiplatform.googleapis.com/inference_request).
  inference_event_logging_config {
    state = "ENABLED"
  }

  # Raw request/response payloads in BigQuery.
  logging_config {
    enabled             = true
    sampling_rate       = 0.5
    error_sampling_rate = 1
    enable_otel_logging = false

    bigquery_destination {
      output_uri = "bq://${data.google_project.project.project_id}.${google_bigquery_dataset.{{$.PrimaryResourceId}}.dataset_id}"
    }
  }
}

resource "google_bigquery_dataset" "{{$.PrimaryResourceId}}" {
  provider = google-beta

  dataset_id                 = "{{index $.ResourceIdVars "dataset_id"}}"
  friendly_name              = "Vertex AI request/response logs"
  location                   = "US"
  delete_contents_on_destroy = true
}

data "google_project" "project" {
  provider = google-beta
}
