resource "google_compute_network" "net" {
  provider                = google-beta
  name                    = "{{index $.ResourceIdVars "network_name"}}"
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "subnet" {
  provider                 = google-beta
  name                     = "{{index $.ResourceIdVars "subnetwork_name"}}"
  ip_cidr_range            = "10.0.0.0/24"
  region                   = "us-east1"
  network                  = google_compute_network.net.id
  private_ip_google_access = true
}

resource "google_compute_subnetwork" "subnet_alt" {
  provider                 = google-beta
  name                     = "{{index $.ResourceIdVars "subnetwork_alt_name"}}"
  ip_cidr_range            = "10.0.1.0/24"
  region                   = "us-east1"
  network                  = google_compute_network.net.id
  private_ip_google_access = true
}

resource "google_compute_firewall" "internal" {
  provider      = google-beta
  name          = "{{index $.ResourceIdVars "firewall_name"}}"
  network       = google_compute_network.net.name
  direction     = "INGRESS"
  source_ranges = ["10.0.0.0/24", "10.0.1.0/24"]

  allow {
    protocol = "tcp"
    ports    = ["0-65535"]
  }
  allow {
    protocol = "udp"
    ports    = ["0-65535"]
  }
  allow {
    protocol = "icmp"
  }
}

resource "google_storage_bucket" "bucket" {
  provider      = google-beta
  name          = "{{index $.ResourceIdVars "bucket_name"}}"
  location      = "US"
  force_destroy = true
}

resource "google_storage_bucket" "bucket_alt" {
  provider      = google-beta
  name          = "{{index $.ResourceIdVars "bucket_alt_name"}}"
  location      = "US"
  force_destroy = true
}

resource "google_secret_manager_secret" "secret" {
  provider  = google-beta
  secret_id = "{{index $.ResourceIdVars "secret_id"}}"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "secret_version" {
  provider    = google-beta
  secret      = google_secret_manager_secret.secret.id
  secret_data = "secret-one"
}

resource "google_secret_manager_secret_version" "secret_version_alt" {
  provider    = google-beta
  secret      = google_secret_manager_secret.secret.id
  secret_data = "secret-two"
}

resource "google_vertex_ai_model_development_cluster" "{{$.PrimaryResourceId}}" {
  provider                     = google-beta
  region                       = "us-east1"
  model_development_cluster_id = "{{index $.ResourceIdVars "model_development_cluster_id"}}"
  display_name                 = "tftest-gke-xm"
  deletion_policy              = "DELETE"
  depends_on                   = [google_compute_firewall.internal]

  labels = {
    env = "dev"
  }

  network {
    network    = google_compute_network.net.id
    subnetwork = google_compute_subnetwork.subnet.id
  }

  orchestrator_spec {
    kubernetes_spec {
      node_pool_ids                  = ["cpu1"]
      enable_ip_alias                = true
      public_access_endpoint_enabled = true
      control_plane_version          = "-"
      node_pool_versions = {
        cpu1 = "-"
      }
    }
  }

  node_pools {
    id                 = "cpu1"
    zone               = "us-east1-b"
    provisioning_model = "ON_DEMAND"

    boot_disk {
      boot_disk_size_gb = 100
      boot_disk_type    = "pd-standard"
    }

    machine_spec {
      machine_type = "n2-standard-4"
    }

    scaling_spec {
      min_node_count = 1
      max_node_count = 2
    }
  }

  xmanager_config {
    network    = google_compute_network.net.self_link
    subnetwork = google_compute_subnetwork.subnet_alt.id
    xprof_config {
      gcs_bucket_uri = "gs://${google_storage_bucket.bucket_alt.name}"
    }
    auth_config {
      allowed_domains = {{index $.Vars "allowed_domains"}}
      allowed_emails  = {{index $.Vars "allowed_emails"}}
      oauth_client {
        id             = "67890.apps.googleusercontent.com"
        secret_version = google_secret_manager_secret_version.secret_version_alt.name
      }
    }
  }
}
