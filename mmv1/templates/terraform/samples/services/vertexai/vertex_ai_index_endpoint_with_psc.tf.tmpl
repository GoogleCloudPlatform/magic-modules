resource "google_vertex_ai_index_endpoint" "{{$.PrimaryResourceId}}" {
  display_name = "{{index $.ResourceIdVars "index_endpoint_display_name"}}"
  description  = "A sample vertex endpoint"
  region       = "us-central1"
  labels       = {
    label-one = "value-one"
  }

  private_service_connect_config {
    enable_private_service_connect = {{index $.Vars "enable_private_service_connect"}}
    project_allowlist              = {{index $.Vars "project_allowlist"}}
  }
}

data "google_project" "project" {}
