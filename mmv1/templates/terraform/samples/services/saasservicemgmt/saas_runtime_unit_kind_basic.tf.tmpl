resource "google_saas_runtime_saas" "example_saas" {
  saas_id  = "{{index $.ResourceIdVars "saas_name"}}"
  location = "us-east1"

  locations {
    name = "us-east1"
  }
}

resource "google_saas_runtime_unit_kind" "cluster_unit_kind" {
  location = "us-east1"
  unit_kind_id = "{{index $.ResourceIdVars "cluster_unitkind_name"}}"
  saas = google_saas_runtime_saas.example_saas.id
  default_release = "projects/{{index $.TestEnvVars "project"}}/locations/us-east1/releases/{{index $.ResourceIdVars "release_name"}}"
}

resource "google_saas_runtime_unit_kind" "{{$.PrimaryResourceId}}" {
  location = "us-east1"
  unit_kind_id = "{{index $.ResourceIdVars "app_unitkind_name"}}"
  saas = google_saas_runtime_saas.example_saas.id

  dependencies {
    unit_kind = google_saas_runtime_unit_kind.cluster_unit_kind.id
    alias     = "cluster"
  }
}
