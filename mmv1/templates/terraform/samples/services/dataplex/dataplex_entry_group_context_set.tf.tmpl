resource "google_dataplex_entry_group" "{{$.PrimaryResourceId}}" {
  provider = google-beta
  entry_group_id = "{{index $.ResourceIdVars "entry_group_name"}}"
  project = "{{index $.TestEnvVars "project_name"}}"
  location = "us-central1"

  labels = { "tag": "test-tf" }
  display_name = "terraform context set entry group"
  description = "context set entry group created by Terraform"
  type = "context-set"
}
