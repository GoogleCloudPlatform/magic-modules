resource "google_compute_region_url_map" "{{$.PrimaryResourceId}}" {
  provider = google-beta

  region = "us-central1"

  name        = "{{index $.ResourceIdVars "region_url_map_name"}}"
  description = "a description"

  default_service = google_compute_region_backend_bucket.default.id

  host_rule {
    hosts        = ["mysite.com"]
    path_matcher = "allpaths"
  }

  path_matcher {
    name            = "allpaths"
    default_service = google_compute_region_backend_bucket.default.id

    path_rule {
      paths   = ["/static/*"]
      service = google_compute_region_backend_bucket.default.id
    }
  }
}

resource "google_compute_region_backend_bucket" "default" {
  provider = google-beta

  name                  = "{{index $.ResourceIdVars "backend_bucket_name"}}"
  region                = "us-central1"
  bucket_name           = google_storage_bucket.default.name
  load_balancing_scheme = "INTERNAL_MANAGED"
}

resource "google_storage_bucket" "default" {
  provider = google-beta

  name                        = "{{index $.ResourceIdVars "bucket_name"}}"
  location                    = "US-CENTRAL1"
  force_destroy               = true
  uniform_bucket_level_access = true
}
