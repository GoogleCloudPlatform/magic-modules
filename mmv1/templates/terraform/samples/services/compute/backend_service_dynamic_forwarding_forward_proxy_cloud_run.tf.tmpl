resource "google_compute_backend_service" "{{$.PrimaryResourceId}}" {
  provider              = google-beta
  name                  = "{{index $.ResourceIdVars "backend_service_name"}}"
  load_balancing_scheme = "INTERNAL_MANAGED"
  protocol              = "HTTP2"
  dynamic_forwarding {
    forward_proxy {
      enabled    = true
      proxy_mode = "CLOUD_RUN"
    }
  }
}
