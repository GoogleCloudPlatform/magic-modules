resource "google_compute_network" "net1" {
  provider = google-beta

  name                    = "{{index $.ResourceIdVars "network_name_1"}}"
  auto_create_subnetworks = false
}

resource "google_compute_network" "net2" {
  provider = google-beta

  name                    = "{{index $.ResourceIdVars "network_name_2"}}"
  auto_create_subnetworks = false
}

resource "google_compute_dhcp_options_config" "{{$.PrimaryResourceId}}" {
  provider = google-beta

  name   = "{{index $.ResourceIdVars "dhcp_options_config_name"}}"
  region = "us-central1"
}
