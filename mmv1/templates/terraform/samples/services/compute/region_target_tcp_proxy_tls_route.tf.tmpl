resource "google_compute_region_target_tcp_proxy" "{{$.PrimaryResourceId}}" {
  name                  = "{{index $.ResourceIdVars "region_target_tcp_proxy_name"}}"
  region                = "{{index $.Vars "region"}}"
  load_balancing_scheme = "EXTERNAL_MANAGED"
}

resource "google_compute_region_backend_service" "{{$.PrimaryResourceId}}" {
  name        = "{{index $.ResourceIdVars "region_backend_service_name"}}"
  protocol    = "TCP"
  timeout_sec = 10
  region      = "{{index $.Vars "region"}}"

  health_checks         = [google_compute_region_health_check.{{$.PrimaryResourceId}}.id]
  load_balancing_scheme = "EXTERNAL_MANAGED"
}

resource "google_compute_region_health_check" "{{$.PrimaryResourceId}}" {
  name               = "{{index $.ResourceIdVars "health_check_name"}}"
  region             = "{{index $.Vars "region"}}"
  timeout_sec        = 1
  check_interval_sec = 1
  tcp_health_check {
    port = "80"
  }
}

resource "google_network_services_tls_route" "{{$.PrimaryResourceId}}" {
  name     = "{{index $.ResourceIdVars "tls_route_name"}}"
  location = "{{index $.Vars "region"}}"

  target_proxies = [
    google_compute_region_target_tcp_proxy.{{$.PrimaryResourceId}}.self_link
  ]

  rules {
    matches {
      sni_host = ["example.com"]
    }
    action {
      destinations {
        service_name = google_compute_region_backend_service.{{$.PrimaryResourceId}}.self_link
      }
    }
  }
}
