resource "google_bigquery_dataset" "{{$.PrimaryResourceId}}" {
  dataset_id                  = "{{index $.ResourceIdVars "dataset_id"}}"
  friendly_name               = "test"
  description                 = "This is a test description"
  location                    = "EU"
  default_table_expiration_ms = 3600000
  max_time_travel_hours       = "{{index $.Vars "max_time_travel_hours"}}"
  is_case_insensitive         = {{index $.Vars "is_case_insensitive"}}
  default_collation           = "{{index $.Vars "default_collation"}}"

  labels = {
    env = "default"
  }

  access {
    role          = "{{index $.Vars "owner_role"}}"
    user_by_email = google_service_account.bqowner.email
  }

  access {
    role   = "READER"
    domain = "hashicorp.com"
  }
}

resource "google_service_account" "bqowner" {
  account_id = "{{index $.ResourceIdVars "account_name"}}"
}
