resource "google_project" "project" {
  provider        = "google-beta"
  project_id      = "tf-test%{random_suffix}"
  name            = "tf-test%{random_suffix}"
  org_id          = "%{org_id}"
  billing_account = "%{billing_account}"
  deletion_policy = "DELETE"
}

resource "google_project_service" "observability_api" {
  provider           = "google-beta"
  project            = google_project.project.project_id
  service            = "observability.googleapis.com"
  disable_on_destroy = false
}

# Explicitly chain service enablement to ensure deterministic sequential execution in VCR testing
resource "google_project_service" "bigquery_api" {
  provider           = "google-beta"
  project            = google_project.project.project_id
  service            = "bigquery.googleapis.com"
  disable_on_destroy = false

  depends_on = [
    google_project_service.observability_api
  ]
}

# Actively force the creation of the Service Agent identity
resource "google_project_service_identity" "observability_sa" {
  provider = "google-beta"
  project  = google_project.project.project_id
  service  = "observability.googleapis.com"

  depends_on = [
    google_project_service.observability_api
  ]
}

# Short buffer for the new identity to propagate to global IAM indexes
resource "time_sleep" "wait_for_sa_propagation" {
  create_duration = "30s"
  depends_on      = [
    google_project_service_identity.observability_sa
  ]
}

resource "google_project_iam_member" "observability_sa_service_agent" {
  provider = "google-beta"
  project  = google_project.project.project_id
  role     = "roles/observability.serviceAgent"
  member   = "serviceAccount:${google_project_service_identity.observability_sa.email}"

  depends_on = [
    time_sleep.wait_for_sa_propagation
  ]
}

resource "google_observability_bucket" "bucket" {
  provider     = "google-beta"
  bucket_id    = "_Trace"
  location     = "us-east1"
  project      = google_project.project.project_id
  display_name = "Bucket for Link"
  description  = "Bucket for Link Test"

  depends_on = [
    google_project_iam_member.observability_sa_service_agent
  ]
}

resource "google_observability_link" "link" {
  provider     = "google-beta"
  bucket       = google_observability_bucket.bucket.bucket_id
  dataset      = "Spans"
  location     = "us-east1"
  project      = google_project.project.project_id
  link_id      = "my_link"
  display_name = "%{display_name}"
  description  = "%{description}"

  depends_on = [
    google_project_iam_member.observability_sa_service_agent,
    google_project_service.bigquery_api,
  ]
}
