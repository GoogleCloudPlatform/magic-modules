resource "google_agentic_applications_analyst_agent_persona" "{{$.PrimaryResourceId}}" {
  location                 = "us"
  analyst_agent_persona_id = "tf-acc-full-{{index .Vars "random_suffix"}}"
  display_name             = "Full Test Analyst Persona Updated"
  display_description      = "Updated full analyst agent persona description"
  customer_context         = ["Sample customer context for testing", "Updated customer context"]
  model_description        = "Updated model description"
  role                     = "ANALYST_ROLE_GENERIC_FINANCE_ANALYST"

  artifact_examples {
    resource {
      display_label     = "sample_raw_file"
      model_description = "Updated artifact resource model description"
      use_rag           = false
      raw_file_resource {
        file_title   = "example_doc_updated.txt"
        file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
        mime_type    = "text/plain"
      }
    }
  }

  artifacts_config {
    document_generation_options {
      export_format = "EXPORT_FORMAT_UNSPECIFIED"
      document_examples {
        resource {
          display_label     = "doc_example_raw"
          model_description = "Updated doc raw description"
          use_rag           = false
          raw_file_resource {
            file_title   = "doc_updated.txt"
            file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
            mime_type    = "text/plain"
          }
        }
      }
    }
    slide_generation_options {
      export_format = "EXPORT_FORMAT_UNSPECIFIED"
      slide_examples {
        resource {
          display_label     = "slide_example_raw"
          model_description = "Updated slide raw description"
          use_rag           = false
          raw_file_resource {
            file_title   = "slide_updated.txt"
            file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
            mime_type    = "text/plain"
          }
        }
      }
    }
    visualization_options {
      visualization_examples {
        visualization_type = "VISUALIZATION_TYPE_UNSPECIFIED"
        resource {
          display_label     = "viz_example_raw"
          model_description = "Updated viz raw description"
          use_rag           = false
          raw_file_resource {
            file_title   = "viz_updated.txt"
            file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
            mime_type    = "text/plain"
          }
        }
      }
    }
  }

  external_data_sources {
    enabled = true
  }

  mcp_data_sources {
    server_url      = "https://mcp.example.com"
    display_name    = "Updated MCP Source"
    description     = "Updated MCP data source description"
    enabled         = true
    prompt          = "Use this server for updated queries"
    api_key_name    = "x-api-key"
    client_id       = "sample-client-id"
    oauth_token_url = "https://example.com/oauth/token"
  }

  resources {
    display_label     = "sample_raw_file_full"
    model_description = "Updated Resource model description"
    use_rag           = false
    raw_file_resource {
      file_title   = "financial_summary_updated.txt"
      file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
      mime_type    = "text/plain"
    }
  }

  skills {
    skill_id    = "finance_analysis_skill"
    description = "Updated skill description for finance analysis"
    content     = "# Finance Analysis\nAnalyze financial data updated."
    references {
      reference_id = "ref_1"
      content      = "Updated Reference content for skill"
    }
  }

  tables {
    name        = "sample_table"
    description = "Updated table description"
    columns {
      name        = "column_1"
      description = "First column description updated"
      data_type   = "STRING"
    }
  }
}
