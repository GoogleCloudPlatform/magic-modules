resource "google_agentic_applications_analyst_agent_persona" "{{$.PrimaryResourceId}}" {
  location                 = "us"
  analyst_agent_persona_id = "tf-acc-test-{{index .Vars "random_suffix"}}"
  display_name             = "Full Test Analyst Persona"
  display_description      = "Sample full analyst agent persona description"
  customer_context         = ["Sample customer context for testing"]
  model_description        = "Sample model description"
  role                     = "ANALYST_ROLE_GENERIC_FINANCE_ANALYST"
  gemini_enterprise_engine = "projects/scottspin/locations/global/collections/default_collection/engines/my_engine"

  artifact_examples {
    resource {
      display_label     = "sample_raw_file"
      model_description = "Sample artifact resource model description"
      use_rag           = false
      raw_file_resource {
        file_title   = "example_doc.txt"
        file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
        mime_type    = "text/plain"
      }
    }
  }

  artifact_examples {
    resource {
      display_label     = "sample_bq"
      model_description = "Sample BQ model description"
      use_rag           = false
      bigquery_resource {
        bigquery_dataset    = "my_dataset"
        bigquery_table      = "my_table"
        column_descriptions = { "col1" = "desc1" }
      }
    }
  }

  artifact_examples {
    resource {
      display_label     = "sample_f1"
      model_description = "Sample F1 model description"
      use_rag           = false
      f1_resource {
        f1_table = "projects/scottspin/locations/global/instances/my_inst/databases/my_db/tables/my_table"
      }
    }
  }

  artifact_examples {
    resource {
      display_label     = "sample_gcs"
      model_description = "Sample GCS model description"
      use_rag           = false
      google_cloud_storage_resource {
        google_cloud_storage_object = "gs://my-bucket/my-file.txt"
        file_extension_restrictions = ["txt"]
      }
    }
  }

  artifact_examples {
    resource {
      display_label     = "sample_gdrive"
      model_description = "Sample GDrive model description"
      use_rag           = false
      google_drive_resource {
        file_reference              = "https://drive.google.com/file/d/12345"
        file_extension_restrictions = ["txt"]
      }
    }
  }

  artifacts_config {
    document_generation_options {
      export_format = "EXPORT_FORMAT_UNSPECIFIED"
      document_examples {
        resource {
          display_label     = "doc_example"
          model_description = "Sample doc description"
          use_rag           = false
          raw_file_resource {
            file_title   = "doc.txt"
            file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
            mime_type    = "text/plain"
          }
          bigquery_resource {
            bigquery_dataset    = "my_dataset"
            bigquery_table      = "my_table"
            column_descriptions = { "col1" = "desc1" }
          }
          f1_resource {
            f1_table = "projects/scottspin/locations/global/instances/my_inst/databases/my_db/tables/my_table"
          }
          google_cloud_storage_resource {
            google_cloud_storage_object = "gs://my-bucket/my-file.txt"
            file_extension_restrictions = ["txt"]
          }
          google_drive_resource {
            file_reference              = "https://drive.google.com/file/d/12345"
            file_extension_restrictions = ["txt"]
          }
        }
      }
    }
    slide_generation_options {
      export_format = "EXPORT_FORMAT_UNSPECIFIED"
      slide_examples {
        resource {
          display_label     = "slide_example"
          model_description = "Sample slide description"
          use_rag           = false
          raw_file_resource {
            file_title   = "slide.txt"
            file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
            mime_type    = "text/plain"
          }
          bigquery_resource {
            bigquery_dataset    = "my_dataset"
            bigquery_table      = "my_table"
            column_descriptions = { "col1" = "desc1" }
          }
          f1_resource {
            f1_table = "projects/scottspin/locations/global/instances/my_inst/databases/my_db/tables/my_table"
          }
          google_cloud_storage_resource {
            google_cloud_storage_object = "gs://my-bucket/my-file.txt"
            file_extension_restrictions = ["txt"]
          }
          google_drive_resource {
            file_reference              = "https://drive.google.com/file/d/12345"
            file_extension_restrictions = ["txt"]
          }
        }
      }
    }
    visualization_options {
      visualization_examples {
        visualization_type = "VISUALIZATION_TYPE_UNSPECIFIED"
        resource {
          display_label     = "viz_example"
          model_description = "Sample viz description"
          use_rag           = false
          raw_file_resource {
            file_title   = "viz.txt"
            file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
            mime_type    = "text/plain"
          }
          bigquery_resource {
            bigquery_dataset    = "my_dataset"
            bigquery_table      = "my_table"
            column_descriptions = { "col1" = "desc1" }
          }
          f1_resource {
            f1_table = "projects/scottspin/locations/global/instances/my_inst/databases/my_db/tables/my_table"
          }
          google_cloud_storage_resource {
            google_cloud_storage_object = "gs://my-bucket/my-file.txt"
            file_extension_restrictions = ["txt"]
          }
          google_drive_resource {
            file_reference              = "https://drive.google.com/file/d/12345"
            file_extension_restrictions = ["txt"]
          }
        }
      }
    }
  }

  external_data_sources {
    data_source = "projects/scottspin/datasets/my_dataset/tables/my_table"
    enabled     = true
  }

  mcp_data_sources {
    server_url      = "https://mcp.example.com"
    display_name    = "Sample MCP Source"
    description     = "Sample MCP data source description"
    enabled         = true
    prompt          = "Use this server for queries"
    api_key         = "sample-api-key"
    api_key_name    = "x-api-key"
    client_id       = "sample-client-id"
    client_secret   = "sample-client-secret"
    oauth_token_url = "https://example.com/oauth/token"
  }

  resources {
    display_label     = "sample_raw_file_full"
    model_description = "Resource model description"
    use_rag           = false
    raw_file_resource {
      file_title   = "financial_summary.txt"
      file_content = "UTEgUmV2ZW51ZTogMTAwTQ=="
      mime_type    = "text/plain"
    }
  }

  resources {
    display_label     = "sample_bq_resource"
    model_description = "BigQuery resource description"
    use_rag           = false
    bigquery_resource {
      bigquery_dataset    = "my_dataset"
      bigquery_table      = "my_table"
      column_descriptions = { "col1" = "desc1" }
    }
  }

  resources {
    display_label     = "sample_f1_resource"
    model_description = "F1 resource description"
    use_rag           = false
    f1_resource {
      f1_table = "projects/scottspin/locations/global/instances/my_inst/databases/my_db/tables/my_table"
    }
  }

  resources {
    display_label     = "sample_gcs_resource"
    model_description = "GCS resource description"
    use_rag           = false
    google_cloud_storage_resource {
      google_cloud_storage_object = "gs://my-bucket/my-file.txt"
      file_extension_restrictions = ["txt"]
    }
  }

  resources {
    display_label     = "sample_gdrive_resource"
    model_description = "GDrive resource description"
    use_rag           = false
    google_drive_resource {
      file_reference              = "https://drive.google.com/file/d/12345"
      file_extension_restrictions = ["txt"]
    }
  }

  skills {
    skill_id    = "finance_analysis_skill"
    description = "Skill for finance analysis"
    content     = "# Finance Analysis\nAnalyze financial data."
    references {
      reference_id = "ref_1"
      content      = "Reference content for skill"
    }
  }

  tables {
    name        = "sample_table"
    description = "Sample table description"
    columns {
      name        = "column_1"
      description = "First column description"
      data_type   = "STRING"
    }
  }
}
