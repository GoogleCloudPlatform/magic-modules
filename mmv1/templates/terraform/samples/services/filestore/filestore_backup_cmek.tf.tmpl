resource "google_filestore_instance" "instance" {
  name     = "{{index $.ResourceIdVars "instance_name"}}"
  location = "us-central1-b"
  tier     = "ZONAL"

  file_shares {
    capacity_gb = 1024
    name        = "share1"
  }

  networks {
    network = "default"
    modes   = ["MODE_IPV4"]
  }
}

resource "google_filestore_backup" "{{$.PrimaryResourceId}}" {
  name              = "{{index $.ResourceIdVars "backup_name"}}"
  location          = "us-central1"
  description       = "This is a CMEK-encrypted filestore backup for the test instance"
  source_instance   = google_filestore_instance.instance.id
  source_file_share = "share1"
  kms_key_name      = "{{index $.ResourceIdVars "kms_key_name"}}"
}
