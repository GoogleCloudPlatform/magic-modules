provider "google" {
  user_project_override = true
  billing_project       = "{{index $.TestEnvVars "billing_project"}}"
}

resource "google_project" "target" {
  project_id      = "{{index $.ResourceIdVars "project_id"}}"
  name            = "{{index $.ResourceIdVars "project_id"}}"
  org_id          = "{{index $.TestEnvVars "org_id"}}"
  billing_account = "{{index $.TestEnvVars "billing_account"}}"
  deletion_policy = "DELETE"
}

resource "google_assured_workloads_v2_workload" "{{$.PrimaryResourceId}}" {
  organization = "{{index $.TestEnvVars "org_id"}}"
  location     = "us-east4"
  workload_id  = "{{index $.ResourceIdVars "workload_id"}}"
  description  = "US Data Boundary workload"

  resource_config {
    existing_project = "projects/${google_project.target.number}"
  }

  framework {
    framework         = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/frameworks/builtin-us-data-boundary"
    major_revision_id = 62
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-apigee-regulatory-settings"
    cloud_control_revision = 2
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-backup-dr-regulatory-settings"
    cloud_control_revision = 6
    enforcement_mode       = "DETECTIVE"
    parameters {
      name = "framework"
      parameter_value {
        string_value = "US_REGIONAL_DATA_BOUNDARY"
      }
    }
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-cloud-logging-regulatory-settings"
    cloud_control_revision = 10
    enforcement_mode       = "DETECTIVE"
    parameters {
      name = "framework"
      parameter_value {
        string_value = "US_REGIONAL_DATA_BOUNDARY"
      }
    }
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-cloud-logging-storage-locations"
    cloud_control_revision = 5
    enforcement_mode       = "DETECTIVE"
    parameters {
      name = "cloudLoggingStorageLocations"
      parameter_value {
        string_list_value {
          values = ["us-central1", "us-central2", "us-east4", "us-east1", "us-west1", "us-west4", "us-west3", "us-west2", "us-south1", "us-east5"]
        }
      }
    }
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-cloud-monitoring-regulatory-settings"
    cloud_control_revision = 2
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-dataplex-regulatory-settings"
    cloud_control_revision = 10
    enforcement_mode       = "DETECTIVE"
    parameters {
      name = "framework"
      parameter_value {
        string_value = "US_REGIONAL_DATA_BOUNDARY"
      }
    }
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-disable-global-cloud-armor"
    cloud_control_revision = 4
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-disable-pubsub-subscription-transforms"
    cloud_control_revision = 6
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-disable-pubsub-topic-transforms"
    cloud_control_revision = 6
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-disable-spanner-multi-region"
    cloud_control_revision = 4
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-enable-spanner-advanced-service-controls"
    cloud_control_revision = 2
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-enforce-service-usage-restrictions"
    cloud_control_revision = 5
    enforcement_mode       = "DETECTIVE"
    parameters {
      name = "serviceUsage"
      parameter_value {
        oneof_value {
          name = "allowedServices"
          parameter_value {
            string_list_value {
              values = ["accessapproval.googleapis.com", "accesscontextintelligence.googleapis.com", "accesscontextmanager.googleapis.com", "aiplatform.googleapis.com", "alloydb.googleapis.com", "anthosconfigmanagement.googleapis.com", "anthosidentityservice.googleapis.com", "apigee.googleapis.com", "apphub.googleapis.com", "artifactregistry.googleapis.com", "assuredworkloads.googleapis.com", "auditmanager.googleapis.com", "backupdr.googleapis.com", "bigquery.googleapis.com", "bigqueryconnection.googleapis.com", "bigquerydatapolicy.googleapis.com", "bigquerydatatransfer.googleapis.com", "bigquerymigration.googleapis.com", "bigqueryreservation.googleapis.com", "bigquerystorage.googleapis.com", "bigtable.googleapis.com", "bigtableadmin.googleapis.com", "binaryauthorization.googleapis.com", "certificatemanager.googleapis.com", "chronicle.googleapis.com", "chronicleservicemanager.googleapis.com", "cloudasset.googleapis.com", "cloudbuild.googleapis.com", "clouddeploy.googleapis.com", "cloudfunctions.googleapis.com", "cloudkms.googleapis.com", "cloudresourcemanager.googleapis.com", "cloudscheduler.googleapis.com", "cloudsecuritycompliance.googleapis.com", "cloudtasks.googleapis.com", "cloudtrace.googleapis.com", "composer.googleapis.com", "compute.googleapis.com", "config.googleapis.com", "connectgateway.googleapis.com", "connectors.googleapis.com", "contactcenterinsights.googleapis.com", "container.googleapis.com", "containerfilesystem.googleapis.com", "containersecurity.googleapis.com", "containerthreatdetection.googleapis.com", "databasecenter.googleapis.com", "dataflow.googleapis.com", "dataform.googleapis.com", "datafusion.googleapis.com", "datalineage.googleapis.com", "datapipelines.googleapis.com", "dataplex.googleapis.com", "dataproc-control.googleapis.com", "dataproc.googleapis.com", "datastore.googleapis.com", "datastudio.googleapis.com", "dialogflow.googleapis.com", "discoveryengine.googleapis.com", "dlp.googleapis.com", "dns.googleapis.com", "documentai.googleapis.com", "domains.googleapis.com", "essentialcontacts.googleapis.com", "eventarc.googleapis.com", "file.googleapis.com", "firebaserules.googleapis.com", "firestore.googleapis.com", "gkebackup.googleapis.com", "gkeconnect.googleapis.com", "gkehub.googleapis.com", "iam.googleapis.com", "iap.googleapis.com", "logging.googleapis.com", "looker.googleapis.com", "managedkafka.googleapis.com", "mesh.googleapis.com", "meshca.googleapis.com", "meshconfig.googleapis.com", "modelarmor.googleapis.com", "monitoring.googleapis.com", "netapp.googleapis.com", "networkconnectivity.googleapis.com", "networksecurity.googleapis.com", "networkservices.googleapis.com", "notebooks.googleapis.com", "opsconfigmonitoring.googleapis.com", "orgpolicy.googleapis.com", "osconfig.googleapis.com", "oslogin.googleapis.com", "policytroubleshooter.googleapis.com", "privateca.googleapis.com", "privilegedaccessmanager.googleapis.com", "pubsub.googleapis.com", "redis.googleapis.com", "resourcesettings.googleapis.com", "run.googleapis.com", "secretmanager.googleapis.com", "securesourcemanager.googleapis.com", "securitycenter.googleapis.com", "securitycentermanagement.googleapis.com", "securityposture.googleapis.com", "servicedirectory.googleapis.com", "servicehealth.googleapis.com", "servicemanagement.googleapis.com", "servicenetworking.googleapis.com", "spanner.googleapis.com", "speech.googleapis.com", "sqladmin.googleapis.com", "stackdriver.googleapis.com", "storage.googleapis.com", "storagetransfer.googleapis.com", "texttospeech.googleapis.com", "trafficdirector.googleapis.com", "vision.googleapis.com", "vpcaccess.googleapis.com", "webrisk.googleapis.com", "websecurityscanner.googleapis.com", "workflowexecutions.googleapis.com", "workflows.googleapis.com", "workstations.googleapis.com"]
            }
          }
        }
      }
    }
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-firestore-disable-enhanced-text-search"
    cloud_control_revision = 3
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-gemini-enterprise-agent-platform-allow-all-compliant-apis"
    cloud_control_revision = 3
    enforcement_mode       = "DETECTIVE"
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-looker-regulatory-settings"
    cloud_control_revision = 7
    enforcement_mode       = "DETECTIVE"
    parameters {
      name = "framework"
      parameter_value {
        string_value = "US_REGIONAL_DATA_BOUNDARY"
      }
    }
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-restrict-resource-locations"
    cloud_control_revision = 9
    enforcement_mode       = "DETECTIVE"
    parameters {
      name = "locations"
      parameter_value {
        oneof_value {
          name = "allowedLocations"
          parameter_value {
            string_list_value {
              values = ["us-locations", "us-central1", "us-central2", "us-east4", "us-east1", "us-west1", "us-west4", "us-west3", "us-west2", "us-south1", "us-east5"]
            }
          }
        }
      }
    }
  }

  cloud_control_configs {
    cloud_control          = "organizations/{{index $.TestEnvVars "org_id"}}/locations/us-east4/cloudControls/builtin-restrict-tls-versions"
    cloud_control_revision = 2
    enforcement_mode       = "DETECTIVE"
    parameters {
      name = "deniedTlsVersions"
      parameter_value {
        string_list_value {
          values = ["TLS_VERSION_1", "TLS_VERSION_1_1"]
        }
      }
    }
  }
}
