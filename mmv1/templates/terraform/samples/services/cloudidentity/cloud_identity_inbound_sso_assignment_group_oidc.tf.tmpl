resource "google_cloud_identity_group" "group" {
  display_name         = "{{index $.ResourceIdVars "id_group"}}"
  initial_group_config = "WITH_INITIAL_OWNER"
  parent               = "customers/{{index $.TestEnvVars "cust_id"}}"

  group_key {
    id = "{{index $.ResourceIdVars "id_group"}}@{{index $.TestEnvVars "org_domain"}}"
  }

  labels = {
    "cloudidentity.googleapis.com/groups.discussion_forum" = ""
  }
}

resource "google_cloud_identity_group" "group_secondary" {
  display_name         = "{{index $.ResourceIdVars "id_group"}}-secondary"
  initial_group_config = "WITH_INITIAL_OWNER"
  parent               = "customers/{{index $.TestEnvVars "cust_id"}}"

  group_key {
    id = "{{index $.ResourceIdVars "id_group"}}-secondary@{{index $.TestEnvVars "org_domain"}}"
  }

  labels = {
    "cloudidentity.googleapis.com/groups.discussion_forum" = ""
  }
}

resource "google_cloud_identity_inbound_saml_sso_profile" "saml_profile" {
  customer     = "customers/{{index $.TestEnvVars "cust_id"}}"
  display_name = "{{index $.ResourceIdVars "display_name"}}"

  idp_config {
    entity_id                  = "https://idp.example.com/{{index $.ResourceIdVars "display_name"}}"
    single_sign_on_service_uri = "https://idp.example.com/sso"
  }
}

resource "tls_private_key" "idp_signing_key" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "tls_self_signed_cert" "idp_signing_cert" {
  private_key_pem = tls_private_key.idp_signing_key.private_key_pem

  subject {
    common_name = "idp.example.com"
  }

  validity_period_hours = 8760

  allowed_uses = [
    "digital_signature",
  ]
}

resource "google_cloud_identity_inbound_saml_sso_profile_idp_credential" "idp_credential" {
  inbound_saml_sso_profile_id = google_cloud_identity_inbound_saml_sso_profile.saml_profile.inbound_saml_sso_profile_id
  pem_data                    = tls_self_signed_cert.idp_signing_cert.cert_pem
}

resource "google_cloud_identity_inbound_oidc_sso_profile" "oidc_profile" {
  customer     = "customers/{{index $.TestEnvVars "cust_id"}}"
  display_name = "{{index $.ResourceIdVars "display_name"}}-oidc"

  idp_config {
    issuer_uri = "https://idp.example.com"
  }

  rp_config {
    client_id     = "test-client-id"
    client_secret = "test-client-secret"
  }
}

resource "google_cloud_identity_inbound_sso_assignment" "{{$.PrimaryResourceId}}" {
  customer     = "customers/{{index $.TestEnvVars "cust_id"}}"
  target_group = google_cloud_identity_group.group.name
  rank         = 2
  sso_mode     = "OIDC_SSO"

  oidc_sso_info {
    inbound_oidc_sso_profile = google_cloud_identity_inbound_oidc_sso_profile.oidc_profile.name
  }

  depends_on = [google_cloud_identity_inbound_saml_sso_profile_idp_credential.idp_credential]
}

resource "google_cloud_identity_inbound_sso_assignment" "secondary_assignment" {
  customer     = "customers/{{index $.TestEnvVars "cust_id"}}"
  target_group = google_cloud_identity_group.group_secondary.name
  rank         = 1
  sso_mode     = "SSO_OFF"

  depends_on = [google_cloud_identity_inbound_sso_assignment.{{$.PrimaryResourceId}}]
}
