# Global Secret with OTHER_DB_CREDENTIALS type
# Note: CLOUD_SQL_DB_CREDENTIALS is only supported for regional secrets with managed rotation.

resource "google_secret_manager_secret" "{{$.PrimaryResourceId}}" {
  secret_id = "{{index $.ResourceIdVars "secret_id"}}"

  # Set the secret type - global secrets support:
  # UNSPECIFIED, OTHER_DB_CREDENTIALS, ACCESS_KEY, CERTIFICATE, OTHER
  secret_type = "OTHER_DB_CREDENTIALS"

  replication {
    auto {}
  }
}
