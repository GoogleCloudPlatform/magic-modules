resource "google_integrations_auth_config" "{{$.PrimaryResourceId}}" {
    location = "us-east4"
    display_name = "{{index $.ResourceIdVars "auth_config_name"}}"
    description = "Test auth config created via terraform"
    decrypted_credential {
        credential_type = "OAUTH2_AUTHORIZATION_CODE"
        oauth2_authorization_code {
            client_id = "Kf7utRvgr95oGO5YMmhFOLo8"
            client_secret = "D-XXFDDMLrg2deDgczzHTBwC3p16wRK1rdKuuoFdWqO0wliJ"
            scope = "photo offline_access"
            auth_endpoint = "https://authorization-server.com/authorize"
            token_endpoint = "https://authorization-server.com/token"
            apply_reauth_policy = true
            request_type = "REQUEST_BODY"
            auth_params {
                entries {
                    key {
                        literal_value {
                            string_value = "auth-key"
                        }
                    }
                    value {
                        literal_value {
                            string_value = "auth-value"
                        }
                    }
                }
            }
            token_params {
                entries {
                    key {
                        literal_value {
                            string_value = "token-key"
                        }
                    }
                    value {
                        literal_value {
                            string_value = "token-value"
                        }
                    }
                }
            }
        }
    }
}