resource "google_memorystore_instance" "{{$.PrimaryResourceId}}-instance" {
  instance_id                 = "{{index $.ResourceIdVars "instance_name"}}"
  shard_count                 = 1
  node_type                   = "SHARED_CORE_NANO"
  location                    = "europe-west4"
  authorization_mode          = "TOKEN_AUTH"
  deletion_protection_enabled = false
}

resource "google_memorystore_auth_token" "{{$.PrimaryResourceId}}" {
  instance                    = google_memorystore_instance.{{$.PrimaryResourceId}}-instance.instance_id
  user_id                     = "default"
  location                    = "europe-west4"
}
