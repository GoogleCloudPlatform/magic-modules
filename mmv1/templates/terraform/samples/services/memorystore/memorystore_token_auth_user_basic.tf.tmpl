resource "google_memorystore_instance" "default" {
  provider                    = google-beta
  instance_id                 = "tf-test-memorystore-instance-{{index $.ResourceIdVars "instance_name"}}"
  shard_count                 = 1
  location                    = "us-central1"
  authorization_mode          = "TOKEN_AUTH"
  transit_encryption_mode     = "SERVER_AUTHENTICATION"
  deletion_protection_enabled = false
}

resource "google_memorystore_token_auth_user" "{{$.PrimaryResourceId}}" {
  provider = google-beta
  instance = google_memorystore_instance.default.name
  user_id  = "test-user"
}
