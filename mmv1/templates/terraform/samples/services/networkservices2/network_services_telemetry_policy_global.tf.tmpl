resource "google_network_services_telemetry_policy" "{{$.PrimaryResourceId}}" {
  provider = google-beta
  name     = "{{index $.ResourceIdVars "resource_name"}}"
  location = "global"
  labels   = {
    foo = "bar"
  }

  telemetry_target {
    resources = [
      "//run.googleapis.com/projects/{{index $.TestEnvVars "project"}}/locations/us-central1/services/my-service"
    ]
  }
}
