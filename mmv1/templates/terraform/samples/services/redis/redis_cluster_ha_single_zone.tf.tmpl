resource "google_redis_cluster" "{{$.PrimaryResourceId}}" {
  name           = "{{index $.ResourceIdVars "cluster_name"}}"
  shard_count    = 1
  psc_configs {
    network = google_compute_network.consumer_net.id
  }
  region = "us-east4"
  node_type = "REDIS_SHARED_CORE_NANO"
  zone_distribution_config {
    mode = "SINGLE_ZONE"
    zone = "us-east4-a"
  }
  maintenance_policy {
    weekly_maintenance_window {
      day = "MONDAY"
      start_time {
        hours = 1
        minutes = 0
        seconds = 0
        nanos = 0
      }
    }
  }
  deletion_protection_enabled = {{index $.ResourceIdVars "deletion_protection_enabled"}}
  depends_on = [
    google_network_connectivity_service_connection_policy.default
  ]

}

resource "google_network_connectivity_service_connection_policy" "default" {
  name = "{{index $.ResourceIdVars "policy_name"}}"
  location = "us-east4"
  service_class = "gcp-memorystore-redis"
  description   = "my basic service connection policy"
  network = google_compute_network.consumer_net.id
  psc_config {
    subnetworks = [google_compute_subnetwork.consumer_subnet.id]
  }
}

resource "google_compute_subnetwork" "consumer_subnet" {
  name          = "{{index $.ResourceIdVars "subnet_name"}}"
  ip_cidr_range = "10.0.0.248/29"
  region        = "us-east4"
  network       = google_compute_network.consumer_net.id
}

resource "google_compute_network" "consumer_net" {
  name                    = "{{index $.ResourceIdVars "network_name"}}"
  auto_create_subnetworks = false
}
