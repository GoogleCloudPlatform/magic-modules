resource "google_redis_instance" "{{$.PrimaryResourceId}}" {
  name           = "{{index $.ResourceIdVars "instance_name"}}"
  memory_size_gb = 1
  region         = "{{index $.TestEnvVars "region"}}"
  deletion_protection = false

  lifecycle {
    prevent_destroy = {{index $.ResourceIdVars "prevent_destroy"}}
  }
}
