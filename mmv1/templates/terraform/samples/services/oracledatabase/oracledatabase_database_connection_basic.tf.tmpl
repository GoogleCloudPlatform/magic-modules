resource "google_oracle_database_database_connection" "{{$.PrimaryResourceId}}" {
  database_connection_id = "{{index $.ResourceIdVars "database_connection_id"}}"
  location               = "us-east4"
  connection_string      = "dbhost.example.com:1521/ORCL"
  odb_network            = "projects/{{index $.ResourceIdVars "project"}}/locations/us-east4/odbNetworks/default-odb-network"
  labels = {
    env = "test"
  }
}
