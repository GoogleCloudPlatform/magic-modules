type timeoutRoundTripper struct {
	timeout  time.Duration
	internal http.RoundTripper
}

func (t *timeoutRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
	ctx, cancel := context.WithTimeout(req.Context(), t.timeout)
	defer cancel()
	return t.internal.RoundTrip(req.WithContext(ctx))
}

// ctxRoundTripper attaches ctx to every outgoing request.
type ctxRoundTripper struct {
	ctx      context.Context
	internal http.RoundTripper
}

func (t *ctxRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
	return t.internal.RoundTrip(req.WithContext(t.ctx))
}

// cancelAfterNRoundTripper calls cancel once n responses have been fully
// received. The response body is buffered before cancelling so that callers
// can still read it after the request context is done.
type cancelAfterNRoundTripper struct {
	n        int32
	calls    int32
	cancel   context.CancelFunc
	internal http.RoundTripper
}

func (t *cancelAfterNRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
	resp, err := t.internal.RoundTrip(req)
	if atomic.AddInt32(&t.calls, 1) < t.n || err != nil {
		return resp, err
	}
	body, readErr := io.ReadAll(resp.Body)
	resp.Body.Close()
	if readErr != nil {
		return nil, readErr
	}
	resp.Body = io.NopCloser(bytes.NewReader(body))
	t.cancel()
	return resp, nil
}

type httpTestIamUpdater struct {
	resourceId string
	url        string
	client     *http.Client
}

func (u *httpTestIamUpdater) GetResourceIamPolicy() (*cloudresourcemanager.Policy, error) {
	req, err := http.NewRequest("POST", u.url+":getIamPolicy", nil)
	if err != nil {
		return nil, err
	}
	res, err := u.client.Do(req)
	if err != nil {
		return nil, err
	}
	defer googleapi.CloseBody(res)
	if err := googleapi.CheckResponse(res); err != nil {
		return nil, err
	}
	var p cloudresourcemanager.Policy
	if err := json.NewDecoder(res.Body).Decode(&p); err != nil {
		return nil, err
	}
	return &p, nil
}

func (u *httpTestIamUpdater) SetResourceIamPolicy(policy *cloudresourcemanager.Policy) error {
	body, err := json.Marshal(policy)
	if err != nil {
		return err
	}
	req, err := http.NewRequest("POST", u.url+":setIamPolicy", bytes.NewReader(body))
	if err != nil {
		return err
	}
	res, err := u.client.Do(req)
	if err != nil {
		return err
	}
	defer googleapi.CloseBody(res)
	return googleapi.CheckResponse(res)
}

func (u *httpTestIamUpdater) GetResourceId() string   { return u.resourceId }
func (u *httpTestIamUpdater) GetMutexKey() string     { return "iam-test-" + u.resourceId }
