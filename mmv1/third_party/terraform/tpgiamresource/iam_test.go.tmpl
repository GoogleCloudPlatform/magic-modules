		res := newTestIamMemberResource(updater)
		d := schema.TestResourceDataRaw(t, res.Schema, map[string]interface{}{
			"bucket": "b/tf-test-bucket",
			"role":   "roles/storage.objectViewer",
			"member": "user:first@example.com",
		})
		d.SetId("b/tf-test-bucket/roles/storage.objectViewer/user:first@example.com")

		if err := res.Delete(d, &transport_tpg.Config{}); err != nil {
			t.Fatalf("unexpected Delete error: %v", err)
		}
		if updater.lastSet == nil {
			t.Fatal("expected SetResourceIamPolicy to be called during Delete")
		}
		if updater.lastSet.Version != 1 {
