					},
				}: {"user-1": {}},
			},
		},
{{- end }}
	}

	for _, tc := range testCases {
		got := createIamBindingsMap(tc.input)
		if !reflect.DeepEqual(got, tc.expect) {
			t.Errorf("Unexpected value for createIamBindingsMap(%s).\nActual: %#v\nExpected: %#v\n",
				DebugPrintBindings(tc.input), got, tc.expect)
		}
	}
}

func TestIamMember_MemberDiffSuppress(t *testing.T) {
	type IamMemberTestcase struct {
		name  string
		old   string
		new   string
		equal bool
	}
	var iamMemberTestcases = []IamMemberTestcase{
		{
			name:  "control",
			old:   "somevalue",
			new:   "somevalue",
			equal: true,
		},
		{
			name:  "principal same casing",
			old:   "principal:someValueHere",
			new:   "principal:someValueHere",
			equal: true,
		},
		{
			name:  "principal not same casing",
			old:   "principal:somevalueHere",
			new:   "principal:someValuehere",
			equal: false,
		},
		{
			name:  "principalSet same casing",
			old:   "principalSet:someValueHere",
			new:   "principalSet:someValueHere",
			equal: true,
		},
		{
			name:  "principalSet not same casing",
			old:   "principalSet:somevalueHere",
			new:   "principalSet:someValuehere",
			equal: false,
		},
		{
			name:  "principalHierarchy same casing",
			old:   "principalHierarchy:someValueHere",
			new:   "principalHierarchy:someValueHere",
			equal: true,
		},
		{
			name:  "principalHierarchy not same casing",
			old:   "principalHierarchy:somevalueHere",
			new:   "principalHierarchy:someValuehere",
			equal: false,
		},
		{
			name:  "serviceAccount same casing",
			old:   "serviceAccount:same@case.com",
			new:   "serviceAccount:same@case.com",
			equal: true,
		},
		{
			name:  "serviceAccount diff casing",
			old:   "serviceAccount:sAme@casE.com",
			new:   "serviceAccount:same@case.com",
			equal: true,
		},
		{
			name:  "random diff",
			old:   "serviasfsfljJKLSD",
			new:   "servicsFDJKLSFJdfjdlkfsf",
			equal: false,
		},
	}

	for _, testcase := range iamMemberTestcases {
		areEqual := iamMemberCaseDiffSuppress("", testcase.old, testcase.new, &schema.ResourceData{})
		if areEqual != testcase.equal {
			t.Errorf("Testcase %s failed: expected equality to be %t but got %t", testcase.name, testcase.equal, areEqual)
		}
	}
}

type mockIamMemberUpdater struct {
	mu         sync.Mutex
	resourceId string
	policy     *cloudresourcemanager.Policy
	onSet      func(incoming *cloudresourcemanager.Policy) (*cloudresourcemanager.Policy, error)
	lastSet    *cloudresourcemanager.Policy
}

func cloneTestIamPolicy(p *cloudresourcemanager.Policy) (*cloudresourcemanager.Policy, error) {
	if p == nil {
		return nil, nil
	}
	b, err := json.Marshal(p)
	if err != nil {
		return nil, err
	}
	var cloned cloudresourcemanager.Policy
	if err := json.Unmarshal(b, &cloned); err != nil {
		return nil, err
	}
	return &cloned, nil
}

func (u *mockIamMemberUpdater) GetResourceIamPolicy() (*cloudresourcemanager.Policy, error) {
	u.mu.Lock()
	defer u.mu.Unlock()
	return cloneTestIamPolicy(u.policy)
}

func (u *mockIamMemberUpdater) SetResourceIamPolicy(policy *cloudresourcemanager.Policy) error {
	u.mu.Lock()
	defer u.mu.Unlock()
	incomingCopy, err := cloneTestIamPolicy(policy)
	if err != nil {
		return err
	}
	u.lastSet = incomingCopy
	if u.onSet != nil {
		next, err := u.onSet(incomingCopy)
		if err != nil {
			return err
		}
		u.policy = next
		return nil
	}
	u.policy = incomingCopy
	return nil
}

func (u *mockIamMemberUpdater) GetResourceId() string   { return u.resourceId }
func (u *mockIamMemberUpdater) GetMutexKey() string     { return "iam-member-test-" + u.resourceId }
func (u *mockIamMemberUpdater) DescribeResource() string { return fmt.Sprintf("bucket %q", u.resourceId) }

func newTestIamMemberResource(updater *mockIamMemberUpdater) *schema.Resource {
	parentSchema := map[string]*schema.Schema{
		"bucket": {
			Type:     schema.TypeString,
			Required: true,
			ForceNew: true,
		},
	}
	newUpdater := func(d tpgresource.TerraformResourceData, _ *transport_tpg.Config) (ResourceIamUpdater, error) {
		return updater, nil
	}
	idParser := func(d *schema.ResourceData, _ *transport_tpg.Config) error {
		return d.Set("bucket", d.Id())
	}
	return ResourceIamMember(parentSchema, newUpdater, idParser)
}

func TestResourceIamMemberRead_MergesDuplicateRoleAndConditionBindings(t *testing.T) {
	t.Run("finds conditional member in subsequent binding with same role and condition", func(t *testing.T) {
		cond := &cloudresourcemanager.Expr{
			Title:       "conditional_object_readers",
			Description: "Allow approved readers to read bucket objects.",
			Expression:  "resource.name.startsWith('projects/_/buckets/tf-test-bucket/objects/')",
		}
		updater := &mockIamMemberUpdater{
			resourceId: "read-split-cond",
			policy: &cloudresourcemanager.Policy{
				Version: IamPolicyVersion,
				Etag:    "etag-split",
				Bindings: []*cloudresourcemanager.Binding{
					{
						Role:      "roles/storage.objectViewer",
						Members:   []string{"user:first@example.com"},
						Condition: cond,
					},
					{
						Role:      "roles/storage.objectViewer",
						Members:   []string{"user:reader@example.com"},
						Condition: cond,
					},
				},
			},
		}

		res := newTestIamMemberResource(updater)
		d := schema.TestResourceDataRaw(t, res.Schema, map[string]interface{}{
			"bucket": "b/tf-test-bucket",
			"role":   "roles/storage.objectViewer",
			"member": "user:reader@example.com",
			"condition": []interface{}{
				map[string]interface{}{
					"title":       cond.Title,
					"description": cond.Description,
					"expression":  cond.Expression,
				},
			},
		})
		d.SetId("b/tf-test-bucket/roles/storage.objectViewer/user:reader@example.com/" + conditionKeyFromCondition(cond).String())

		if err := res.Read(d, &transport_tpg.Config{}); err != nil {
			t.Fatalf("unexpected Read error: %v", err)
		}
		if d.Id() == "" {
			t.Fatal("expected Read to retain resource ID when member is in second matching conditional binding, got empty ID")
		}
		if got := d.Get("member").(string); got != "user:reader@example.com" {
			t.Fatalf("expected member %q, got %q", "user:reader@example.com", got)
		}
		if got := d.Get("etag").(string); got != "etag-split" {
			t.Fatalf("expected etag %q, got %q", "etag-split", got)
		}
	})

	t.Run("preserves case sensitivity for IAM principal identifiers", func(t *testing.T) {
		aliceUpper := "principal://iam.googleapis.com/projects/12345/locations/global/workloadIdentityPools/tf-test-pool/subject/Alice"
		aliceLower := "principal://iam.googleapis.com/projects/12345/locations/global/workloadIdentityPools/tf-test-pool/subject/alice"

		updaterOnlyUpper := &mockIamMemberUpdater{
			resourceId: "read-case-sensitive-missing",
			policy: &cloudresourcemanager.Policy{
				Version: IamPolicyVersion,
				Etag:    "etag-cs-1",
				Bindings: []*cloudresourcemanager.Binding{
					{
						Role:    "roles/storage.objectViewer",
						Members: []string{aliceUpper},
					},
				},
			},
		}
		resMissing := newTestIamMemberResource(updaterOnlyUpper)
		dMissing := schema.TestResourceDataRaw(t, resMissing.Schema, map[string]interface{}{
			"bucket": "b/tf-test-bucket",
			"role":   "roles/storage.objectViewer",
			"member": aliceLower,
		})
		dMissing.SetId("b/tf-test-bucket/roles/storage.objectViewer/" + aliceLower)

		if err := resMissing.Read(dMissing, &transport_tpg.Config{}); err != nil {
			t.Fatalf("unexpected Read error: %v", err)
		}
		if dMissing.Id() != "" {
			t.Fatalf("expected Read to clear ID when case-sensitive principal %q is absent (only %q present), got ID %q", aliceLower, aliceUpper, dMissing.Id())
		}

		updaterBoth := &mockIamMemberUpdater{
			resourceId: "read-case-sensitive-both",
			policy: &cloudresourcemanager.Policy{
				Version: IamPolicyVersion,
				Etag:    "etag-cs-2",
				Bindings: []*cloudresourcemanager.Binding{
					{
						Role:    "roles/storage.objectViewer",
						Members: []string{aliceUpper, aliceLower},
					},
				},
			},
		}
		resBoth := newTestIamMemberResource(updaterBoth)
		dBoth := schema.TestResourceDataRaw(t, resBoth.Schema, map[string]interface{}{
			"bucket": "b/tf-test-bucket",
			"role":   "roles/storage.objectViewer",
			"member": aliceLower,
		})
		dBoth.SetId("b/tf-test-bucket/roles/storage.objectViewer/" + aliceLower)

		if err := resBoth.Read(dBoth, &transport_tpg.Config{}); err != nil {
			t.Fatalf("unexpected Read error: %v", err)
		}
		if got := dBoth.Get("member").(string); got != aliceLower {
			t.Fatalf("expected exact case-sensitive principal %q, got %q", aliceLower, got)
		}
	})
}

