package vertexai
{{- if ne $.TargetVersionName "ga" }}

import (
	"fmt"
	"testing"

	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
)

func TestUnitModelDevelopmentCluster_NodePools_NotForceNew(t *testing.T) {
	t.Parallel()

	r := ResourceVertexAIModelDevelopmentCluster()
	nodePoolsSchema, ok := r.Schema["node_pools"]
	if !ok {
		t.Fatal("expected 'node_pools' field in ResourceVertexAIModelDevelopmentCluster schema")
	}

	elemResource, ok := nodePoolsSchema.Elem.(*schema.Resource)
	if !ok {
		t.Fatalf("expected node_pools.Elem to be *schema.Resource, got %T", nodePoolsSchema.Elem)
	}

	// Verify that neither node_pools nor any of its nested fields have ForceNew set to true,
	// ensuring that adding, removing, or reordering node_pools does not trigger resource replacement.
	var assertNoForceNew func(path string, s *schema.Schema)
	assertNoForceNew = func(path string, s *schema.Schema) {
		if s.ForceNew {
			t.Errorf("expected field %q to have ForceNew=false, but got ForceNew=true", path)
		}
		if nestedRes, ok := s.Elem.(*schema.Resource); ok && nestedRes != nil {
			for name, childSchema := range nestedRes.Schema {
				assertNoForceNew(fmt.Sprintf("%s.%s", path, name), childSchema)
			}
		}
	}

	assertNoForceNew("node_pools", nodePoolsSchema)
	for name, childSchema := range elemResource.Schema {
		assertNoForceNew(fmt.Sprintf("node_pools.%s", name), childSchema)
	}
}
{{- end }}
