func testModelDevelopmentClusterResourceData(t *testing.T, res *schema.Resource, stateMap, configMap map[string]interface{}) *schema.ResourceData {
	t.Helper()
	sm := schema.InternalMap(res.Schema)
	var s *terraform.InstanceState
	if stateMap != nil {
		stateDiff, err := sm.Diff(context.Background(), nil, terraform.NewResourceConfigRaw(stateMap), nil, nil, true)
		if err != nil {
			t.Fatalf("error creating state diff: %v", err)
		}
		stateData, err := sm.Data(nil, stateDiff)
		if err != nil {
			t.Fatalf("error creating state data: %v", err)
		}
		stateData.SetId("projects/test-project/locations/us-central1/modelDevelopmentClusters/test-cluster")
		s = stateData.State()
	}
	diff, err := sm.Diff(context.Background(), s, terraform.NewResourceConfigRaw(configMap), nil, nil, false)
	if err != nil {
		t.Fatalf("error creating config diff: %v", err)
	}
	d, err := sm.Data(s, diff)
	if err != nil {
		t.Fatalf("error creating resource data: %v", err)
	}
	return d
}

func TestUnitVertexAIModelDevelopmentCluster_SchemaKubernetesSpec(t *testing.T) {
	t.Parallel()
	res := ResourceVertexAIModelDevelopmentCluster()
	orchestratorSpecSchema, ok := res.Schema["orchestrator_spec"]
	if !ok {
		t.Fatalf("orchestrator_spec missing from schema")
	}
	orchestratorResource, ok := orchestratorSpecSchema.Elem.(*schema.Resource)
	if !ok {
		t.Fatalf("orchestrator_spec Elem is not *schema.Resource")
	}

	slurmSchema, ok := orchestratorResource.Schema["slurm_spec"]
	if !ok {
		t.Fatalf("slurm_spec missing from orchestrator_spec schema")
	}
	if len(slurmSchema.ConflictsWith) == 0 {
		t.Errorf("expected slurm_spec to have ConflictsWith configured, got %v", slurmSchema.ConflictsWith)
	}

	k8sSchema, ok := orchestratorResource.Schema["kubernetes_spec"]
	if !ok {
		t.Fatalf("kubernetes_spec missing from orchestrator_spec schema")
	}
	if len(k8sSchema.ConflictsWith) == 0 {
		t.Errorf("expected kubernetes_spec to have ConflictsWith configured, got %v", k8sSchema.ConflictsWith)
	}

	k8sResource, ok := k8sSchema.Elem.(*schema.Resource)
	if !ok {
		t.Fatalf("kubernetes_spec Elem is not *schema.Resource")
	}

	// Verify node_pool_ids
	npIds, ok := k8sResource.Schema["node_pool_ids"]
	if !ok {
		t.Fatalf("node_pool_ids missing from kubernetes_spec schema")
	}
	if !npIds.ForceNew {
		t.Errorf("node_pool_ids must be ForceNew (immutable)")
	}

	// Verify enable_ip_alias
	ipAlias, ok := k8sResource.Schema["enable_ip_alias"]
	if !ok {
		t.Fatalf("enable_ip_alias missing from kubernetes_spec schema")
	}
	if !ipAlias.ForceNew {
		t.Errorf("enable_ip_alias must be ForceNew (immutable)")
	}

	// Verify public_access_endpoint_enabled
	pae, ok := k8sResource.Schema["public_access_endpoint_enabled"]
	if !ok {
		t.Fatalf("public_access_endpoint_enabled missing from kubernetes_spec schema")
	}
	if !pae.ForceNew {
		t.Errorf("public_access_endpoint_enabled must be ForceNew (immutable)")
	}

	// Verify control_plane_version
	cpv, ok := k8sResource.Schema["control_plane_version"]
	if !ok {
		t.Fatalf("control_plane_version missing from kubernetes_spec schema")
	}
	if !cpv.Computed || !cpv.Optional {
		t.Errorf("control_plane_version must be Computed and Optional, got Computed=%v Optional=%v", cpv.Computed, cpv.Optional)
	}
	if cpv.DiffSuppressFunc == nil {
		t.Errorf("control_plane_version must have DiffSuppressFunc configured")
	}

	// Verify node_pool_versions
	npv, ok := k8sResource.Schema["node_pool_versions"]
	if !ok {
		t.Fatalf("node_pool_versions missing from kubernetes_spec schema")
	}
	if !npv.Computed || !npv.Optional {
		t.Errorf("node_pool_versions must be Computed and Optional, got Computed=%v Optional=%v", npv.Computed, npv.Optional)
	}
	if npv.DiffSuppressFunc == nil {
		t.Errorf("node_pool_versions must have DiffSuppressFunc configured")
	}
}

func TestUnitVertexAIModelDevelopmentCluster_GkeVersionDiffSuppress(t *testing.T) {
	t.Parallel()

	cases := []struct {
		name       string
		k          string
		old        string
		new        string
		cpState    string
		cpConfig   string
		suppressed bool
	}{
		{
			name:       "control_plane_version service default wildcard matches non-empty old",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "-",
			suppressed: true,
		},
		{
			name:       "control_plane_version service default wildcard does not suppress empty old",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "",
			new:        "-",
			suppressed: false,
		},
		{
			name:       "node_pool_versions wildcard suppresses when matching control_plane_version",
			k:          "orchestrator_spec.0.kubernetes_spec.0.node_pool_versions.cpu1",
			old:        "1.35.8-gke.1796000",
			new:        "-",
			cpState:    "1.35.8-gke.1796000",
			cpConfig:   "1.35.8-gke.1796000",
			suppressed: true,
		},
		{
			name:       "node_pool_versions wildcard suppresses when control_plane_version config is wildcard and state matches",
			k:          "orchestrator_spec.0.kubernetes_spec.0.node_pool_versions.cpu1",
			old:        "1.35.8-gke.1796000",
			new:        "-",
			cpState:    "1.35.8-gke.1796000",
			cpConfig:   "-",
			suppressed: true,
		},
		{
			name:       "node_pool_versions wildcard does not suppress when control_plane_version is upgrading",
			k:          "orchestrator_spec.0.kubernetes_spec.0.node_pool_versions.cpu1",
			old:        "1.35.8-gke.1796000",
			new:        "-",
			cpState:    "1.35.8-gke.1796000",
			cpConfig:   "1.36",
			suppressed: false,
		},
		{
			name:       "node_pool_versions wildcard does not suppress when node pool lags behind control_plane_version",
			k:          "orchestrator_spec.0.kubernetes_spec.0.node_pool_versions.cpu1",
			old:        "1.34.1-gke.100",
			new:        "-",
			cpState:    "1.35.8-gke.1796000",
			cpConfig:   "1.35.8-gke.1796000",
			suppressed: false,
		},
		{
			name:       "node_pool_versions wildcard does not suppress when node pool patch lags and control_plane_version config is minor prefix",
			k:          "orchestrator_spec.0.kubernetes_spec.0.node_pool_versions.cpu1",
			old:        "1.35.1-gke.100",
			new:        "-",
			cpState:    "1.35.8-gke.1796000",
			cpConfig:   "1.35",
			suppressed: false,
		},
		{
			name:       "node_pool_versions wildcard suppresses when node pool matches state control_plane_version and config is minor prefix",
			k:          "orchestrator_spec.0.kubernetes_spec.0.node_pool_versions.cpu1",
			old:        "1.35.8-gke.1796000",
			new:        "-",
			cpState:    "1.35.8-gke.1796000",
			cpConfig:   "1.35",
			suppressed: true,
		},
		{
			name:       "node_pool_versions wildcard does not suppress when ResourceData is nil",
			k:          "orchestrator_spec.0.kubernetes_spec.0.node_pool_versions.cpu1",
			old:        "1.35.8-gke.1796000",
			new:        "-",
			suppressed: false,
		},
		{
			name:       "major and minor match without patch in config",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "1.35",
			suppressed: true,
		},
		{
			name:       "minor mismatch",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "1.36",
			suppressed: false,
		},
		{
			name:       "major mismatch",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "2.35",
			suppressed: false,
		},
		{
			name:       "major minor patch match without gke suffix in config",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "1.35.8",
			suppressed: true,
		},
		{
			name:       "patch mismatch",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "1.35.7",
			suppressed: false,
		},
		{
			name:       "full version and gke suffix match",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "1.35.8-gke.1796000",
			suppressed: true,
		},
		{
			name:       "gke suffix mismatch",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "1.35.8-gke.1000",
			suppressed: false,
		},
		{
			name:       "empty old value",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "",
			new:        "1.35",
			suppressed: false,
		},
		{
			name:       "empty new value",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "1.35.8-gke.1796000",
			new:        "",
			suppressed: false,
		},
		{
			name:       "both empty",
			k:          "orchestrator_spec.0.kubernetes_spec.0.control_plane_version",
			old:        "",
			new:        "",
			suppressed: true,
		},
	}

	res := ResourceVertexAIModelDevelopmentCluster()
	for _, tc := range cases {
		tc := tc
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()
			var d *schema.ResourceData
			if tc.cpState != "" || tc.cpConfig != "" {
				stateMap := map[string]interface{}{
					"orchestrator_spec": []interface{}{
						map[string]interface{}{
							"kubernetes_spec": []interface{}{
								map[string]interface{}{
									"control_plane_version": tc.cpState,
								},
							},
						},
					},
				}
				configMap := map[string]interface{}{
					"orchestrator_spec": []interface{}{
						map[string]interface{}{
							"kubernetes_spec": []interface{}{
								map[string]interface{}{
									"control_plane_version": tc.cpConfig,
								},
							},
						},
					},
				}
				d = testModelDevelopmentClusterResourceData(t, res, stateMap, configMap)
			}
			got := vertexAiModelDevelopmentClusterGkeVersionDiffSuppress(tc.k, tc.old, tc.new, d)
			if got != tc.suppressed {
				t.Errorf("vertexAiModelDevelopmentClusterGkeVersionDiffSuppress(%q, %q, %q) = %v, want %v", tc.k, tc.old, tc.new, got, tc.suppressed)
			}
		})
	}
}

func TestUnitVertexAIModelDevelopmentCluster_NodePoolVersionsExpandFlatten(t *testing.T) {
	t.Parallel()

	// Test expand
	input := map[string]interface{}{
		"pool-1": "1.30.5-gke.1014001",
		"pool-2": "1.31",
	}
	expanded, err := expandVertexAIModelDevelopmentClusterOrchestratorSpecKubernetesSpecNodePoolVersions(input, nil, nil)
	if err != nil {
		t.Fatalf("unexpected error during expand: %v", err)
	}
	expectedExpanded := map[string]interface{}{
		"pool-1": map[string]interface{}{"version": "1.30.5-gke.1014001"},
		"pool-2": map[string]interface{}{"version": "1.31"},
	}
	if !reflect.DeepEqual(expanded, expectedExpanded) {
		t.Errorf("expand mismatch: got %#v, want %#v", expanded, expectedExpanded)
	}

	// Test expand nil / empty
	if expNil, err := expandVertexAIModelDevelopmentClusterOrchestratorSpecKubernetesSpecNodePoolVersions(nil, nil, nil); err != nil || expNil != nil {
		t.Errorf("expected expand(nil) to return nil, nil; got %#v, %v", expNil, err)
	}
	if expEmpty, err := expandVertexAIModelDevelopmentClusterOrchestratorSpecKubernetesSpecNodePoolVersions(map[string]interface{}{}, nil, nil); err != nil || expEmpty != nil {
		t.Errorf("expected expand({}) to return nil, nil; got %#v, %v", expEmpty, err)
	}

	// Test flatten
	apiResp := map[string]interface{}{
		"pool-1": map[string]interface{}{"version": "1.30.5-gke.1014001"},
		"pool-2": map[string]interface{}{"version": "1.31"},
	}
	flattened := flattenVertexAIModelDevelopmentClusterOrchestratorSpecKubernetesSpecNodePoolVersions(apiResp, nil, nil)
	expectedFlattened := map[string]interface{}{
		"pool-1": "1.30.5-gke.1014001",
		"pool-2": "1.31",
	}
	if !reflect.DeepEqual(flattened, expectedFlattened) {
		t.Errorf("flatten mismatch: got %#v, want %#v", flattened, expectedFlattened)
	}

	// Test flatten nil
	if flatNil := flattenVertexAIModelDevelopmentClusterOrchestratorSpecKubernetesSpecNodePoolVersions(nil, nil, nil); flatNil != nil {
		t.Errorf("expected flatten(nil) to return nil; got %#v", flatNil)
	}
}

func TestUnitVertexAIModelDevelopmentCluster_ValidateNodePoolVersions(t *testing.T) {
	t.Parallel()
	res := ResourceVertexAIModelDevelopmentCluster()

	t.Run("missing node pool ID", func(t *testing.T) {
		t.Parallel()
		d := schema.TestResourceDataRaw(t, res.Schema, map[string]interface{}{
			"orchestrator_spec": []interface{}{
				map[string]interface{}{
					"kubernetes_spec": []interface{}{
						map[string]interface{}{
							"node_pool_ids": []interface{}{"pool-1", "pool-2"},
							"node_pool_versions": map[string]interface{}{
								"pool-1": "1.30",
							},
						},
					},
				},
			},
		})
		err := validateVertexAIModelDevelopmentClusterNodePoolVersions(d)
		if err == nil {
			t.Fatalf("expected error for missing node pool ID, got nil")
		}
		if !strings.Contains(err.Error(), "must include all node pool IDs") || !strings.Contains(err.Error(), "pool-2") {
			t.Errorf("unexpected error message: %v", err)
		}
	})

	t.Run("unknown node pool ID", func(t *testing.T) {
		t.Parallel()
		d := schema.TestResourceDataRaw(t, res.Schema, map[string]interface{}{
			"orchestrator_spec": []interface{}{
				map[string]interface{}{
					"kubernetes_spec": []interface{}{
						map[string]interface{}{
							"node_pool_ids": []interface{}{"pool-1"},
							"node_pool_versions": map[string]interface{}{
								"pool-1":       "1.30",
								"pool-unknown": "1.30",
							},
						},
					},
				},
			},
		})
		err := validateVertexAIModelDevelopmentClusterNodePoolVersions(d)
		if err == nil {
			t.Fatalf("expected error for unknown node pool ID, got nil")
		}
		if !strings.Contains(err.Error(), "unknown node pool ID") || !strings.Contains(err.Error(), "pool-unknown") {
			t.Errorf("unexpected error message: %v", err)
		}
	})

	t.Run("valid matching node pool IDs", func(t *testing.T) {
		t.Parallel()
		d := schema.TestResourceDataRaw(t, res.Schema, map[string]interface{}{
			"orchestrator_spec": []interface{}{
				map[string]interface{}{
					"kubernetes_spec": []interface{}{
						map[string]interface{}{
							"node_pool_ids": []interface{}{"pool-1", "pool-2"},
							"node_pool_versions": map[string]interface{}{
								"pool-1": "1.30",
								"pool-2": "-",
							},
						},
					},
				},
			},
		})
		if err := validateVertexAIModelDevelopmentClusterNodePoolVersions(d); err != nil {
			t.Fatalf("unexpected validation error: %v", err)
		}
	})

	t.Run("top-level node_pools takes precedence over kubernetes_spec.node_pool_ids", func(t *testing.T) {
		t.Parallel()
		d := schema.TestResourceDataRaw(t, res.Schema, map[string]interface{}{
			"node_pools": []interface{}{
				map[string]interface{}{
					"id":   "pool-1",
					"zone": "us-central1-a",
					"machine_spec": []interface{}{
						map[string]interface{}{"machine_type": "n2-standard-4"},
					},
				},
				map[string]interface{}{
					"id":   "pool-2",
					"zone": "us-central1-a",
					"machine_spec": []interface{}{
						map[string]interface{}{"machine_type": "n2-standard-4"},
					},
				},
			},
			"orchestrator_spec": []interface{}{
				map[string]interface{}{
					"kubernetes_spec": []interface{}{
						map[string]interface{}{
							"node_pool_ids": []interface{}{"pool-1"},
							"node_pool_versions": map[string]interface{}{
								"pool-1": "-",
								"pool-2": "-",
							},
						},
					},
				},
			},
		})
		if err := validateVertexAIModelDevelopmentClusterNodePoolVersions(d); err != nil {
			t.Fatalf("expected top-level node_pools IDs to be accepted, got error: %v", err)
		}
	})
}

