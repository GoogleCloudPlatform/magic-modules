func TestUnitVertexAIModelDevelopmentCluster_PreUpdate_UpdateMaskGKE(t *testing.T) {
	t.Parallel()

	var capturedMask string
	var capturedBody map[string]interface{}

	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method == "PATCH" {
			capturedMask = r.URL.Query().Get("updateMask")
			body, _ := io.ReadAll(r.Body)
			_ = json.Unmarshal(body, &capturedBody)
		}
		w.Header().Set("Content-Type", "application/json")
		w.Write([]byte(`{"name": "projects/test-project/locations/us-central1/operations/op1", "done": true, "response": {}}`))
	}))
	defer server.Close()

	res := ResourceVertexAIModelDevelopmentCluster()
	d := schema.TestResourceDataRaw(t, res.Schema, map[string]interface{}{
		"model_development_cluster_id": "test-cluster",
		"region":                       "us-central1",
		"display_name":                 "initial-name",
		"deletion_policy":              "DELETE",
		"orchestrator_spec": []interface{}{
			map[string]interface{}{
				"kubernetes_spec": []interface{}{
					map[string]interface{}{
						"control_plane_version": "1.30",
					},
				},
			},
		},
	})
	d.SetId("projects/test-project/locations/us-central1/modelDevelopmentClusters/test-cluster")
	d.Set("orchestrator_spec", []interface{}{
		map[string]interface{}{
			"kubernetes_spec": []interface{}{
				map[string]interface{}{
					"control_plane_version": "1.31",
				},
			},
		},
	})

	config := &transport_tpg.Config{
		Project: "test-project",
		Region:  "us-central1",
		Client:  server.Client(),
		CustomEndpoints: map[string]string{
			Product.CustomEndpointField: server.URL + "/",
		},
	}

	err := resourceVertexAIModelDevelopmentClusterUpdate(d, config)
	if err != nil {
		t.Fatalf("unexpected error during update: %v", err)
	}

	if !strings.Contains(capturedMask, "orchestrator_spec.kubernetes_spec.control_plane_version") {
		t.Errorf("expected updateMask to contain orchestrator_spec.kubernetes_spec.control_plane_version, got %q", capturedMask)
	}
	if strings.Contains(capturedMask, "slurm_spec") {
		t.Errorf("expected updateMask not to contain slurm_spec, got %q", capturedMask)
	}
}

