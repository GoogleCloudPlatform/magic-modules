{{- if ne $.TargetVersionName "ga" -}}
package vertexai_test

import (
	"testing"

	"github.com/hashicorp/terraform-plugin-testing/helper/resource"
	"github.com/hashicorp/terraform-provider-google/google/acctest"
	_ "github.com/hashicorp/terraform-provider-google/google/services/bigquery"
)

func TestAccDataSourceVertexAIPublisherModelConfig_basic(t *testing.T) {
	t.Parallel()

	context := map[string]interface{}{
		"random_suffix": acctest.RandString(t, 10),
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		CheckDestroy:             testAccCheckVertexAIPublisherModelConfigDestroyProducer(t),
		Steps: []resource.TestStep{
			{
				Config: testAccDataSourceVertexAIPublisherModelConfig_basic(context),
				Check: resource.ComposeTestCheckFunc(
					acctest.CheckDataSourceStateMatchesResourceStateWithIgnores(
						"data.google_vertex_ai_publisher_model_config.tf_test_config",
						"google_vertex_ai_publisher_model_config.tf_test_config",
						[]string{},
					),
				),
			},
			{
				ResourceName:      "google_vertex_ai_publisher_model_config.tf_test_config",
				ImportState:       true,
				ImportStateVerify: true,
			},
		},
	})
}

func TestAccDataSourceVertexAIPublisherModelConfig_global(t *testing.T) {
	t.Parallel()

	context := map[string]interface{}{
		// Initializes vcrSource for VCR .seed / cassette discovery even though random_suffix is unused in HCL.
		"random_suffix": acctest.RandString(t, 10),
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		CheckDestroy:             testAccCheckVertexAIPublisherModelConfigDestroyProducer(t),
		Steps: []resource.TestStep{
			{
				Config: testAccDataSourceVertexAIPublisherModelConfig_global(context),
				Check: resource.ComposeTestCheckFunc(
					acctest.CheckDataSourceStateMatchesResourceStateWithIgnores(
						"data.google_vertex_ai_publisher_model_config.tf_test_config",
						"google_vertex_ai_publisher_model_config.tf_test_config",
						[]string{},
					),
				),
			},
			{
				ResourceName:      "google_vertex_ai_publisher_model_config.tf_test_config",
				ImportState:       true,
				ImportStateVerify: true,
			},
		},
	})
}

func testAccDataSourceVertexAIPublisherModelConfig_basic(context map[string]interface{}) string {
	return acctest.Nprintf(`
resource "google_bigquery_dataset" "tf_test_logs" {
  provider                   = google-beta
  dataset_id                 = "tf_test_pmc_ds_%{random_suffix}"
  location                   = "US"
  delete_contents_on_destroy = true
}

resource "google_vertex_ai_publisher_model_config" "tf_test_config" {
  provider  = google-beta
  region    = "us-central1"
  publisher = "google"
  model     = "gemini-2.5-pro"

  inference_event_logging_config {
    state = "ENABLED"
  }

  logging_config {
    enabled             = true
    sampling_rate       = 0.5
    error_sampling_rate = 0.25
    enable_otel_logging = true

    bigquery_destination {
      output_uri = "bq://${google_bigquery_dataset.tf_test_logs.project}.${google_bigquery_dataset.tf_test_logs.dataset_id}.request_response_logs"
    }
  }
}

data "google_vertex_ai_publisher_model_config" "tf_test_config" {
  provider  = google-beta
  project   = google_vertex_ai_publisher_model_config.tf_test_config.project
  region    = google_vertex_ai_publisher_model_config.tf_test_config.region
  publisher = google_vertex_ai_publisher_model_config.tf_test_config.publisher
  model     = google_vertex_ai_publisher_model_config.tf_test_config.model
}
`, context)
}

func testAccDataSourceVertexAIPublisherModelConfig_global(context map[string]interface{}) string {
	return acctest.Nprintf(`
resource "google_vertex_ai_publisher_model_config" "tf_test_config" {
  provider  = google-beta
  region    = "global"
  publisher = "anthropic"
  model     = "claude-3-5-haiku"

  inference_event_logging_config {
    state = "ENABLED"
  }

  claude_feature_config {
    advanced_ai_enabled = false
  }
}

data "google_vertex_ai_publisher_model_config" "tf_test_config" {
  provider  = google-beta
  project   = google_vertex_ai_publisher_model_config.tf_test_config.project
  region    = google_vertex_ai_publisher_model_config.tf_test_config.region
  publisher = google_vertex_ai_publisher_model_config.tf_test_config.publisher
  model     = google_vertex_ai_publisher_model_config.tf_test_config.model
}
`, context)
}
