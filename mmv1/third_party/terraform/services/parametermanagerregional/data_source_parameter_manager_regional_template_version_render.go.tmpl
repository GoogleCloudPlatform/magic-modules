package parametermanagerregional
{{- if ne $.TargetVersionName "ga" }}

import (
	"encoding/base64"
	"fmt"
	"net/http"
	"net/url"
	"regexp"
	"strings"

	"github.com/hashicorp/terraform-provider-google/google/registry"
	"github.com/hashicorp/terraform-provider-google/google/tpgresource"
	transport_tpg "github.com/hashicorp/terraform-provider-google/google/transport"

	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
)

var parameterManagerRegionalTemplateReferenceRegex = regexp.MustCompile(`^projects/([^/\s]+)/locations/([^/\s]+)/templates/([^/\s]+)$`)

func DataSourceParameterManagerRegionalTemplateVersionRender() *schema.Resource {
	return &schema.Resource{
		Read: dataSourceParameterManagerRegionalTemplateVersionRenderRead,
		Schema: map[string]*schema.Schema{
			"project": {
				Type:     schema.TypeString,
				Optional: true,
				Computed: true,
			},
			"location": {
				Type:     schema.TypeString,
				Optional: true,
				Computed: true,
			},
			"template": {
				Type:     schema.TypeString,
				Required: true,
			},
			"template_version_id": {
				Type:     schema.TypeString,
				Required: true,
			},
			"parameter_version": {
				Type:     schema.TypeString,
				Required: true,
			},
			"template_data": {
				Type:      schema.TypeString,
				Computed:  true,
				Sensitive: true,
			},
			"rendered_template_data": {
				Type:      schema.TypeString,
				Computed:  true,
				Sensitive: true,
			},
			"name": {
				Type:     schema.TypeString,
				Computed: true,
			},
			"template_format": {
				Type:     schema.TypeString,
				Computed: true,
			},
		},
		UseJSONNumber: true,
	}
}

func resolveParameterManagerRegionalTemplateReference(d *schema.ResourceData, config *transport_tpg.Config) (string, string, string, error) {
	dTemplate, ok := d.Get("template").(string)
	if !ok {
		return "", "", "", fmt.Errorf("wrong type for template field (%T), expected string", d.Get("template"))
	}
	if dTemplate == "" {
		return "", "", "", fmt.Errorf("template field cannot be empty")
	}

	parts := parameterManagerRegionalTemplateReferenceRegex.FindStringSubmatch(dTemplate)
	if len(parts) == 4 {
		project := parts[1]
		location := parts[2]
		if dProject, ok := d.Get("project").(string); !ok {
			return "", "", "", fmt.Errorf("wrong type for project (%T), expected string", d.Get("project"))
		} else if dProject != "" && dProject != project {
			return "", "", "", fmt.Errorf("project field value (%s) does not match project of regional template (%s).", dProject, project)
		}
		if dLocation, ok := d.Get("location").(string); !ok {
			return "", "", "", fmt.Errorf("wrong type for location (%T), expected string", d.Get("location"))
		} else if dLocation != "" && dLocation != location {
			return "", "", "", fmt.Errorf("location field value (%s) does not match location of regional template (%s).", dLocation, location)
		}
		return project, location, parts[3], nil
	}

	if strings.ContainsAny(dTemplate, "/ \t\n\r") {
		return "", "", "", fmt.Errorf("invalid template reference (%s), expected template_id or projects/{project}/locations/{location}/templates/{template_id}", dTemplate)
	}

	dLocation, ok := d.Get("location").(string)
	if !ok {
		return "", "", "", fmt.Errorf("wrong type for location (%T), expected string", d.Get("location"))
	}
	if dLocation == "" {
		return "", "", "", fmt.Errorf("location must be set when providing only regional template name")
	}

	project, err := tpgresource.GetProject(d, config)
	if err != nil {
		return "", "", "", fmt.Errorf("error fetching project for regional template: %s", err)
	}
	return project, dLocation, dTemplate, nil
}

func dataSourceParameterManagerRegionalTemplateVersionRenderRead(d *schema.ResourceData, meta interface{}) error {
	config := meta.(*transport_tpg.Config)
	userAgent, err := tpgresource.GenerateUserAgentString(d, config.UserAgent)
	if err != nil {
		return err
	}

	project, location, templateID, err := resolveParameterManagerRegionalTemplateReference(d, config)
	if err != nil {
		return err
	}
	if err := d.Set("project", project); err != nil {
		return fmt.Errorf("error setting project: %s", err)
	}
	if err := d.Set("location", location); err != nil {
		return fmt.Errorf("error setting location: %s", err)
	}

	dTemplateVersionId, ok := d.Get("template_version_id").(string)
	if !ok {
		return fmt.Errorf("wrong type for template version id field (%T), expected string", d.Get("template_version_id"))
	}

	dParameterVersion, ok := d.Get("parameter_version").(string)
	if !ok {
		return fmt.Errorf("wrong type for parameter version field (%T), expected string", d.Get("parameter_version"))
	}

	endpointBase, err := tpgresource.ReplaceVars(d, config, transport_tpg.BaseUrl(Product, config))
	if err != nil {
		return err
	}
	if strings.Contains(endpointBase, "{{"{{"}}location{{"}}"}}") {
		return fmt.Errorf("failed to qualify endpoint for a resource with a regionalized endpoint %s", endpointBase)
	}

	baseURL := fmt.Sprintf("%sprojects/%s/locations/%s/templates/%s/versions/%s:render",
		endpointBase,
		url.PathEscape(project),
		url.PathEscape(location),
		url.PathEscape(templateID),
		url.PathEscape(dTemplateVersionId),
	)

	reqURL, err := transport_tpg.AddQueryParams(baseURL, map[string]string{
		"parameter_version": dParameterVersion,
	})
	if err != nil {
		return err
	}

	billingProject := project
	if bp, err := tpgresource.GetBillingProject(d, config); err == nil {
		billingProject = bp
	}

	headers := make(http.Header)
	regionalTemplateVersion, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   billingProject,
		RawURL:    reqURL,
		UserAgent: userAgent,
		Headers:   headers,
	})
	if err != nil {
		return fmt.Errorf("error retrieving rendered parameter manager regional template version: %s", err.Error())
	}

	nameStr, ok := regionalTemplateVersion["templateVersion"].(string)
	if !ok || nameStr == "" {
		return fmt.Errorf("read response didn't contain critical fields. Read may not have succeeded.")
	}

	if err := d.Set("name", nameStr); err != nil {
		return fmt.Errorf("error reading regionalTemplateVersion: %s", err)
	}

	if templateFormat, ok := regionalTemplateVersion["templateFormat"].(string); ok {
		if err := d.Set("template_format", templateFormat); err != nil {
			return fmt.Errorf("error setting template_format: %s", err)
		}
	}

	if payloadMap, ok := regionalTemplateVersion["payload"].(map[string]interface{}); ok && payloadMap != nil {
		if dataStr, ok := payloadMap["data"].(string); ok {
			templateData, err := base64.StdEncoding.DecodeString(dataStr)
			if err != nil {
				return fmt.Errorf("error decoding parameter manager regional template version data: %s", err.Error())
			}
			if err := d.Set("template_data", string(templateData)); err != nil {
				return fmt.Errorf("error setting template_data: %s", err)
			}
		}
	}

	if renderedPayloadStr, ok := regionalTemplateVersion["renderedPayload"].(string); ok {
		renderedTemplateData, err := base64.StdEncoding.DecodeString(renderedPayloadStr)
		if err != nil {
			return fmt.Errorf("error decoding parameter manager regional template version rendered payload data: %s", err.Error())
		}
		if err := d.Set("rendered_template_data", string(renderedTemplateData)); err != nil {
			return fmt.Errorf("error setting rendered_template_data: %s", err)
		}
	}

	d.SetId(fmt.Sprintf("%s?parameter_version=%s", nameStr, dParameterVersion))
	return nil
}

func init() {
	registry.Schema{
		Name:        "google_parameter_manager_regional_template_version_render",
		ProductName: "parametermanagerregional",
		Type:        registry.SchemaTypeDataSource,
		Schema:      DataSourceParameterManagerRegionalTemplateVersionRender(),
	}.Register()
}
