func TestAccDataSourceParameterManagerRegionalTemplateVersionRender_basic(t *testing.T) {
	t.Parallel()

	context := map[string]interface{}{
		"random_suffix": acctest.RandString(t, 10),
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		CheckDestroy: func(s *terraform.State) error {
			if err := testAccCheckParameterManagerRegionalRegionalTemplateVersionDestroyProducer(t)(s); err != nil {
				return err
			}
			if err := testAccCheckParameterManagerRegionalRegionalTemplateDestroyProducer(t)(s); err != nil {
				return err
			}
			return testAccCheckParameterManagerRegionalRegionalParameterDestroyProducer(t)(s)
		},
		Steps: []resource.TestStep{
			{
				Config: testAccParameterManagerRegionalTemplateVersionRender_basic(context),
				Check: resource.ComposeTestCheckFunc(
					// YAML render using full .id on template (omitting location so location extraction is verified) and parameter_version #1
					resource.TestCheckResourceAttrPair(
						"data.google_parameter_manager_regional_template_version_render.rendered_by_id", "name",
						"google_parameter_manager_regional_template_version.tmpl_ver", "name",
					),
					resource.TestCheckResourceAttrPair(
						"data.google_parameter_manager_regional_template_version_render.rendered_by_id", "template",
						"google_parameter_manager_regional_template.tmpl", "id",
					),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_by_id", "location", "us-central1"),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_by_id", "template_format", "TEMPLATE_FORMAT_YAML"),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_by_id", "template_data", "database:\n  host: {{"{{"}}.host{{"}}"}}\n  port: {{"{{"}}.port{{"}}"}}\n"),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_by_id", "rendered_template_data", "database:\n  host: 10.0.0.1\n  port: 5432\n"),
					// YAML render of the SAME regional template_version against parameter_version #2 using short .template_id + location
					resource.TestCheckResourceAttrPair(
						"data.google_parameter_manager_regional_template_version_render.rendered_by_short_name", "name",
						"google_parameter_manager_regional_template_version.tmpl_ver", "name",
					),
					resource.TestCheckResourceAttrPair(
						"data.google_parameter_manager_regional_template_version_render.rendered_by_short_name", "template",
						"google_parameter_manager_regional_template.tmpl", "template_id",
					),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_by_short_name", "location", "us-central1"),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_by_short_name", "template_format", "TEMPLATE_FORMAT_YAML"),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_by_short_name", "template_data", "database:\n  host: {{"{{"}}.host{{"}}"}}\n  port: {{"{{"}}.port{{"}}"}}\n"),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_by_short_name", "rendered_template_data", "database:\n  host: 10.0.0.2\n  port: 6432\n"),
					testAccCheckDataSourceParameterManagerRegionalTemplateVersionRenderDistinctIDs(
						"data.google_parameter_manager_regional_template_version_render.rendered_by_id",
						"data.google_parameter_manager_regional_template_version_render.rendered_by_short_name",
					),
					// JSON format render
					resource.TestCheckResourceAttrPair(
						"data.google_parameter_manager_regional_template_version_render.rendered_json", "name",
						"google_parameter_manager_regional_template_version.tmpl_json_ver", "name",
					),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_json", "template_format", "TEMPLATE_FORMAT_JSON"),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_json", "template_data", "{\"host\":\"{{"{{"}}.host{{"}}"}}\",\"port\":{{"{{"}}.port{{"}}"}}}"),
					resource.TestCheckResourceAttr("data.google_parameter_manager_regional_template_version_render.rendered_json", "rendered_template_data", "{\"host\":\"10.0.0.1\",\"port\":5432}"),
				),
			},
			{
				Config:      testAccParameterManagerRegionalTemplateVersionRender_disabled(context),
				ExpectError: regexp.MustCompile("(?i)disabled"),
			},
		},
	})
}

func testAccCheckDataSourceParameterManagerRegionalTemplateVersionRenderDistinctIDs(first, second string) resource.TestCheckFunc {
	return func(s *terraform.State) error {
		rs1, ok := s.RootModule().Resources[first]
		if !ok {
			return fmt.Errorf("data source not found: %s", first)
		}
		rs2, ok := s.RootModule().Resources[second]
		if !ok {
			return fmt.Errorf("data source not found: %s", second)
		}
		if rs1.Primary.ID == "" || rs2.Primary.ID == "" {
			return fmt.Errorf("expected non-empty data source IDs, got %q and %q", rs1.Primary.ID, rs2.Primary.ID)
		}
		if rs1.Primary.ID == rs2.Primary.ID {
			return fmt.Errorf("expected distinct IDs when rendering against different parameter_versions, both got %q", rs1.Primary.ID)
		}
		return nil
	}
}

