package alloydb_test
{{- if ne $.TargetVersionName "ga" }}

import (
	"testing"

	"github.com/hashicorp/terraform-plugin-testing/helper/resource"
	"github.com/hashicorp/terraform-plugin-testing/plancheck"
	"github.com/hashicorp/terraform-provider-google/google/acctest"
	_ "github.com/hashicorp/terraform-provider-google/google/services/alloydb"
)

func TestAccAlloydbCluster_expressUpgrade(t *testing.T) {
	t.Parallel()

	suffix := acctest.RandString(t, 10)
	expressContext := map[string]interface{}{
		"random_suffix":   suffix,
		"express_enabled": true,
		"cluster_env":     "express",
	}
	upgradedContext := map[string]interface{}{
		"random_suffix":   suffix,
		"express_enabled": false,
		"cluster_env":     "upgraded",
	}
	downgradeContext := map[string]interface{}{
		"random_suffix":   suffix,
		"express_enabled": true,
		"cluster_env":     "upgraded",
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		ExternalProviders: map[string]resource.ExternalProvider{
			"time": {},
		},
		CheckDestroy: resource.ComposeTestCheckFunc(
			testAccCheckAlloydbInstanceDestroyProducer(t),
			testAccCheckAlloydbClusterDestroyProducer(t),
		),
		Steps: []resource.TestStep{
			{
				// Create an AlloyDB Express cluster and primary instance, then wait 10 minutes
				// for AlloyDB Express background instance setup to complete before Day-2 updates.
				Config: testAccAlloydbCluster_expressConfig(expressContext),
				Check: resource.ComposeTestCheckFunc(
					resource.TestCheckResourceAttr("google_alloydb_cluster.default", "express_config.0.enabled", "true"),
					resource.TestCheckResourceAttr("data.google_alloydb_cluster.default", "express_config.0.enabled", "true"),
				),
			},
			{
				ResourceName:            "google_alloydb_cluster.default",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: []string{"deletion_protection", "initial_user", "cluster_id", "location", "labels", "terraform_labels"},
			},
			{
				// Omitting the express_config block must not change an Express cluster.
				Config: testAccAlloydbCluster_expressConfigOmitted(expressContext),
				Check: resource.ComposeTestCheckFunc(
					resource.TestCheckResourceAttr("google_alloydb_cluster.default", "express_config.0.enabled", "true"),
					resource.TestCheckResourceAttr("data.google_alloydb_cluster.default", "express_config.0.enabled", "true"),
				),
			},
			{
				// Upgrade the Express cluster to a standard cluster and update labels in the same apply.
				// express_config has to be the only field in its update request.
				Config: testAccAlloydbCluster_expressConfig(upgradedContext),
				Check: resource.ComposeTestCheckFunc(
					resource.TestCheckResourceAttr("google_alloydb_cluster.default", "express_config.0.enabled", "false"),
					resource.TestCheckResourceAttr("google_alloydb_cluster.default", "labels.env", "upgraded"),
					resource.TestCheckResourceAttr("data.google_alloydb_cluster.default", "express_config.0.enabled", "false"),
				),
			},
			{
				ResourceName:            "google_alloydb_cluster.default",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: []string{"deletion_protection", "initial_user", "cluster_id", "location", "labels", "terraform_labels"},
			},
			{
				// A standard cluster can't be converted back to an Express cluster, so enabling
				// express_config again plans a replacement.
				Config:             testAccAlloydbCluster_expressConfig(downgradeContext),
				PlanOnly:           true,
				ExpectNonEmptyPlan: true,
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PostApplyPreRefresh: []plancheck.PlanCheck{
						plancheck.ExpectResourceAction("google_alloydb_cluster.default", plancheck.ResourceActionReplace),
					},
				},
			},
		},
	})
}

func testAccAlloydbCluster_expressConfig(context map[string]interface{}) string {
	return acctest.Nprintf(`
resource "google_alloydb_cluster" "default" {
  provider         = google-beta
  cluster_id       = "tf-test-alloydb-cluster%{random_suffix}"
  location         = "europe-west2"
  database_version = "POSTGRES_18"

  labels = {
    env = "%{cluster_env}"
  }

  psc_config {
    psc_enabled = true
  }

  express_config {
    enabled = %{express_enabled}
  }

  initial_user {
    password = "TfTest1!Alloydb%{random_suffix}"
  }

  deletion_protection = false
}

resource "google_alloydb_instance" "default" {
  provider      = google-beta
  cluster       = google_alloydb_cluster.default.name
  instance_id   = "tf-test-alloydb-instance%{random_suffix}"
  instance_type = "PRIMARY"
}

resource "time_sleep" "wait_10_mins" {
  depends_on = [google_alloydb_instance.default]

  create_duration = "600s"
}

data "google_alloydb_cluster" "default" {
  provider   = google-beta
  cluster_id = google_alloydb_cluster.default.cluster_id
  location   = google_alloydb_cluster.default.location
  depends_on = [time_sleep.wait_10_mins]
}
`, context)
}

