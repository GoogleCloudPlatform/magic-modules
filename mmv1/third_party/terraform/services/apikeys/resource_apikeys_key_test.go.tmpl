func testAccApikeysKey_androidKey(context map[string]interface{}, packageName, sha1Fingerprint string) string {
	context["package_name"] = packageName
	context["sha1_fingerprint"] = sha1Fingerprint
	return acctest.Nprintf(`
resource "google_apikeys_key" "primary" {
  name         = "tf-test-key%{random_suffix}"
  display_name = "sample-key"

  restrictions {
    android_key_restrictions {
      allowed_applications {
        package_name     = "%{package_name}"
        sha1_fingerprint = "%{sha1_fingerprint}"
      }
    }

    api_targets {
      service = "translate.googleapis.com"
      methods = ["GET*"]
    }
  }
}
`, context)
}

