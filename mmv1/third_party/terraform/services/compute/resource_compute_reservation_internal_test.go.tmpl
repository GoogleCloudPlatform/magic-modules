func TestComputeReservationUpdate_betaProjectsAndEmergentMaintenance(t *testing.T) {
	t.Parallel()

	r := ResourceComputeReservation()
	makeCfg := func(shareType string, projects []interface{}, em bool) map[string]interface{} {
		return map[string]interface{}{
			"name":                        "my-res",
			"zone":                        "us-central1-a",
			"project":                     "my-project",
			"enable_emergent_maintenance": em,
			"specific_reservation": []interface{}{map[string]interface{}{
				"count":               1,
				"instance_properties": []interface{}{map[string]interface{}{"machine_type": "n2-standard-2"}},
			}},
			"share_settings": []interface{}{map[string]interface{}{
				"share_type": shareType,
				"projects":   projects,
			}},
		}
	}

	_, reqs, cfg := newReservationTestServer(t)
	d := buildReservationUpdateData(
		t,
		r.Schema,
		makeCfg("LOCAL", []interface{}{}, true),
		makeCfg("SPECIFIC_PROJECTS", []interface{}{"new-guest-proj"}, false),
	)
	if err := r.Update(d, cfg); err != nil {
		t.Fatalf("Update failed: %v", err)
	}

	const resPath = "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res"
	const zoneLink = "projects/my-project/global/zones/us-central1-a"
	want := []recordedReservationReq{
		{
			method: http.MethodPatch,
			path:   resPath,
			paths:  []string{"shareSettings.projects", "shareSettings.shareType"},
			body: map[string]interface{}{
				"name": "my-res",
				"zone": zoneLink,
				"shareSettings": map[string]interface{}{
					"shareType": "SPECIFIC_PROJECTS",
					"projects":  []interface{}{"new-guest-proj"},
				},
			},
		},
		{
			method: http.MethodPatch,
			path:   resPath,
			paths:  []string{"enableEmergentMaintenance"},
			body: map[string]interface{}{
				"name":                      "my-res",
				"zone":                      zoneLink,
				"enableEmergentMaintenance": false,
			},
		},
	}
	if !reflect.DeepEqual(*reqs, want) {
		t.Fatalf("recorded requests mismatch:\ngot:  %#v\nwant: %#v", *reqs, want)
	}
}
