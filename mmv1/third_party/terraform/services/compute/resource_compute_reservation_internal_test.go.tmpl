var registerResourceManagerOnce sync.Once

func ensureResourceManagerRegistered() {
	registerResourceManagerOnce.Do(func() {
		for _, p := range registry.ListProducts() {
			if p.Name == "resourcemanager" {
				return
			}
		}
		registry.Product{
			Name:                 "resourcemanager",
			BaseUrl:              "https://cloudresourcemanager.googleapis.com/v1/",
			CustomEndpointField:  "resource_manager_custom_endpoint",
			CustomEndpointEnvVar: "GOOGLE_RESOURCE_MANAGER_CUSTOM_ENDPOINT",
		}.Register()
	})
}

type recordedReservationReq struct {
	method     string
	path       string
	paths      []string
	updateMask string
	body       map[string]interface{}
}

func cloneSchemaWithoutForceNew(src map[string]*schema.Schema) map[string]*schema.Schema {
	dst := make(map[string]*schema.Schema, len(src))
	for k, v := range src {
		cp := *v
		cp.ForceNew = false
		if sub, ok := cp.Elem.(*schema.Resource); ok {
			subCp := *sub
			subCp.Schema = cloneSchemaWithoutForceNew(sub.Schema)
			cp.Elem = &subCp
		}
		dst[k] = &cp
	}
	return dst
}

func buildReservationUpdateData(t *testing.T, s map[string]*schema.Schema, oldCfg, newCfg map[string]interface{}) *schema.ResourceData {
	t.Helper()
	initDiff, err := schema.InternalMap(s).Diff(context.Background(), nil, terraform.NewResourceConfigRaw(oldCfg), nil, nil, true)
	if err != nil {
		t.Fatalf("initial diff error: %v", err)
	}
	initData, err := schema.InternalMap(s).Data(nil, initDiff)
	if err != nil {
		t.Fatalf("initial data error: %v", err)
	}
	initData.SetId("projects/my-project/zones/us-central1-a/reservations/my-res")

	diff, err := schema.InternalMap(s).Diff(context.Background(), initData.State(), terraform.NewResourceConfigRaw(newCfg), nil, nil, false)
	if err != nil {
		t.Fatalf("update diff error: %v", err)
	}
	if diff.RequiresNew() {
		t.Fatalf("expected in-place update, got RequiresNew: %#v", diff.Attributes)
	}
	d, err := schema.InternalMap(s).Data(initData.State(), diff)
	if err != nil {
		t.Fatalf("update data error: %v", err)
	}
	return d
}

func newReservationTestServer(t *testing.T) (*httptest.Server, *[]recordedReservationReq, *transport_tpg.Config) {
	t.Helper()
	ensureResourceManagerRegistered()
	var reqs []recordedReservationReq
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		switch {
		case (req.Method == http.MethodPatch && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res") ||
			(req.Method == http.MethodPost && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res/resize"):
			var body map[string]interface{}
			_ = json.NewDecoder(req.Body).Decode(&body)
			reqs = append(reqs, recordedReservationReq{
				method:     req.Method,
				path:       req.URL.Path,
				paths:      req.URL.Query()["paths"],
				updateMask: req.URL.Query().Get("updateMask"),
				body:       body,
			})
			_, _ = w.Write([]byte(`{"name":"op-1","zone":"projects/my-project/zones/us-central1-a","status":"DONE"}`))
		case req.Method == http.MethodGet && req.URL.Path == "/v1/projects/old-guest-proj":
			_, _ = w.Write([]byte(`{"projectId":"old-guest-proj","projectNumber":"111111111","lifecycleState":"ACTIVE"}`))
		case req.Method == http.MethodGet && req.URL.Path == "/v1/projects/new-guest-proj":
			_, _ = w.Write([]byte(`{"projectId":"new-guest-proj","projectNumber":"222222222","lifecycleState":"ACTIVE"}`))
		case req.Method == http.MethodGet && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/operations/op-1":
			_, _ = w.Write([]byte(`{"name":"op-1","zone":"projects/my-project/zones/us-central1-a","status":"DONE"}`))
		case req.Method == http.MethodGet && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res":
			_, _ = w.Write([]byte(`{
				"name": "my-res",
				"zone": "projects/my-project/zones/us-central1-a",
				"specificReservationRequired": false,
				"specificReservation": {"count": "2", "instanceProperties": {"machineType": "n2-standard-2"}},
				"shareSettings": {"shareType": "SPECIFIC_PROJECTS", "projectMap": {"222222222": {"projectId": "222222222"}}},
				"reservationSharingPolicy": {"serviceShareType": "ALLOW_ALL"}
			}`))
		case req.Method == http.MethodGet && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res/reservationBlocks":
			_, _ = w.Write([]byte(`{}`))
		default:
			http.NotFound(w, req)
		}
	}))
	t.Cleanup(server.Close)
	cfg := &transport_tpg.Config{
		Context:      context.Background(),
		Client:       server.Client(),
		Project:      "my-project",
		Zone:         "us-central1-a",
		PollInterval: time.Millisecond,
		CustomEndpoints: map[string]string{
			"compute_custom_endpoint":          server.URL + "/compute/v1/",
			"resource_manager_custom_endpoint": server.URL + "/v1/",
		},
	}
	return server, &reqs, cfg
}

func TestComputeReservationUpdate_pathsAndMultiFieldIsolation(t *testing.T) {
	t.Parallel()

	r := ResourceComputeReservation()
	editableSchema := cloneSchemaWithoutForceNew(r.Schema)

	oldCfg := map[string]interface{}{
		"name":    "my-res",
		"zone":    "us-central1-a",
		"project": "my-project",
		"specific_reservation": []interface{}{map[string]interface{}{
			"count":               1,
			"instance_properties": []interface{}{map[string]interface{}{"machine_type": "n2-standard-2"}},
		}},
		"share_settings": []interface{}{map[string]interface{}{
			"share_type": "SPECIFIC_PROJECTS",
			"project_map": []interface{}{
				map[string]interface{}{"id": "old-guest-proj", "project_id": "old-guest-proj"},
			},
		}},
		"delete_after_duration": []interface{}{map[string]interface{}{"seconds": "3600"}},
		"reservation_sharing_policy": []interface{}{map[string]interface{}{
			"service_share_type": "DISALLOW_ALL",
		}},
	}
	newCfg := map[string]interface{}{
		"name":    "my-res",
		"zone":    "us-central1-a",
		"project": "my-project",
		"specific_reservation": []interface{}{map[string]interface{}{
			"count":               2,
			"instance_properties": []interface{}{map[string]interface{}{"machine_type": "n2-standard-2"}},
		}},
		"share_settings": []interface{}{map[string]interface{}{
			"share_type": "SPECIFIC_PROJECTS",
			"project_map": []interface{}{
				map[string]interface{}{"id": "new-guest-proj", "project_id": "new-guest-proj"},
			},
		}},
		"reservation_sharing_policy": []interface{}{map[string]interface{}{
			"service_share_type": "ALLOW_ALL",
		}},
	}

	_, reqs, cfg := newReservationTestServer(t)
	d := buildReservationUpdateData(t, editableSchema, oldCfg, newCfg)
	if err := r.Update(d, cfg); err != nil {
		t.Fatalf("Update failed: %v", err)
	}

	const resPath = "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res"
	const zoneLink = "projects/my-project/global/zones/us-central1-a"
	want := []recordedReservationReq{
		{
			method: http.MethodPatch,
			path:   resPath,
			paths:  []string{"shareSettings.projectMap.111111111"},
			body: map[string]interface{}{
				"name":          "my-res",
				"zone":          zoneLink,
				"shareSettings": map[string]interface{}{"shareType": "SPECIFIC_PROJECTS", "projectMap": map[string]interface{}{}},
			},
		},
		{
			method: http.MethodPatch,
			path:   resPath,
			paths:  []string{"shareSettings.projectMap.new-guest-proj"},
			body: map[string]interface{}{
				"name": "my-res",
				"zone": zoneLink,
				"shareSettings": map[string]interface{}{
					"shareType":  "SPECIFIC_PROJECTS",
					"projectMap": map[string]interface{}{"new-guest-proj": map[string]interface{}{"projectId": "new-guest-proj"}},
				},
			},
		},
		{
			method: http.MethodPatch,
			path:   resPath,
			paths:  []string{"deleteAfterDuration"},
			body:   map[string]interface{}{"name": "my-res", "zone": zoneLink},
		},
		{
			method: http.MethodPatch,
			path:   resPath,
			paths:  []string{"reservationSharingPolicy.serviceShareType"},
			body: map[string]interface{}{
				"name":                     "my-res",
				"zone":                     zoneLink,
				"reservationSharingPolicy": map[string]interface{}{"serviceShareType": "ALLOW_ALL"},
			},
		},
		{
			method: http.MethodPost,
			path:   resPath + "/resize",
			body:   map[string]interface{}{"specificSkuCount": float64(2)},
		},
	}

	if !reflect.DeepEqual(*reqs, want) {
		t.Fatalf("recorded requests mismatch:\ngot:  %#v\nwant: %#v", *reqs, want)
	}
}

func TestComputeReservationUpdate_shareTypeAndProjectMapTransitions(t *testing.T) {
	t.Parallel()

	r := ResourceComputeReservation()
	editableSchema := cloneSchemaWithoutForceNew(r.Schema)
	const resPath = "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res"
	const zoneLink = "projects/my-project/global/zones/us-central1-a"

	baseReservationCfg := func(share map[string]interface{}) map[string]interface{} {
		return map[string]interface{}{
			"name":    "my-res",
			"zone":    "us-central1-a",
			"project": "my-project",
			"specific_reservation": []interface{}{map[string]interface{}{
				"count":               1,
				"instance_properties": []interface{}{map[string]interface{}{"machine_type": "n2-standard-2"}},
			}},
			"share_settings": []interface{}{share},
		}
	}

	t.Run("sharedToLocal_withOmittedProjectId", func(t *testing.T) {
		_, reqs, cfg := newReservationTestServer(t)
		oldShare := map[string]interface{}{
			"share_type": "SPECIFIC_PROJECTS",
			"project_map": []interface{}{
				// Omit optional project_id to verify fallback to id.
				map[string]interface{}{"id": "old-guest-proj"},
			},
		}
{{- if ne $.TargetVersionName "ga" }}
		// Simulate GCE Beta GET populating shareSettings.projects alongside projectMap in state.
		oldShare["projects"] = []interface{}{"111111111"}
{{- end }}
		oldCfg := baseReservationCfg(oldShare)
		newCfg := baseReservationCfg(map[string]interface{}{
			"share_type": "LOCAL",
		})

		d := buildReservationUpdateData(t, editableSchema, oldCfg, newCfg)
		if err := r.Update(d, cfg); err != nil {
			t.Fatalf("Update failed: %v", err)
		}

		want := []recordedReservationReq{
			{
				method: http.MethodPatch,
				path:   resPath,
				paths:  []string{"shareSettings.projectMap.111111111", "shareSettings.shareType"},
				body: map[string]interface{}{
					"name":          "my-res",
					"zone":          zoneLink,
					"shareSettings": map[string]interface{}{"shareType": "LOCAL", "projectMap": map[string]interface{}{}},
				},
			},
		}
		if !reflect.DeepEqual(*reqs, want) {
			t.Fatalf("recorded requests mismatch:\ngot:  %#v\nwant: %#v", *reqs, want)
		}
	})

	t.Run("localToShared_withProjectMap", func(t *testing.T) {
		_, reqs, cfg := newReservationTestServer(t)
		oldCfg := baseReservationCfg(map[string]interface{}{
			"share_type": "LOCAL",
		})
		newCfg := baseReservationCfg(map[string]interface{}{
			"share_type": "SPECIFIC_PROJECTS",
			"project_map": []interface{}{
				map[string]interface{}{"id": "new-guest-proj", "project_id": "new-guest-proj"},
			},
		})

		d := buildReservationUpdateData(t, editableSchema, oldCfg, newCfg)
		if err := r.Update(d, cfg); err != nil {
			t.Fatalf("Update failed: %v", err)
		}

		want := []recordedReservationReq{
			{
				method: http.MethodPatch,
				path:   resPath,
				paths:  []string{"shareSettings.projectMap.new-guest-proj", "shareSettings.shareType"},
				body: map[string]interface{}{
					"name": "my-res",
					"zone": zoneLink,
					"shareSettings": map[string]interface{}{
						"shareType":  "SPECIFIC_PROJECTS",
						"projectMap": map[string]interface{}{"new-guest-proj": map[string]interface{}{"projectId": "new-guest-proj"}},
					},
				},
			},
		}
		if !reflect.DeepEqual(*reqs, want) {
			t.Fatalf("recorded requests mismatch:\ngot:  %#v\nwant: %#v", *reqs, want)
		}
	})

	t.Run("shareTypeOnly_withoutProjectMapChanges", func(t *testing.T) {
		_, reqs, cfg := newReservationTestServer(t)
		oldCfg := baseReservationCfg(map[string]interface{}{
			"share_type": "SPECIFIC_PROJECTS",
		})
		newCfg := baseReservationCfg(map[string]interface{}{
			"share_type": "LOCAL",
		})

		d := buildReservationUpdateData(t, editableSchema, oldCfg, newCfg)
		if err := r.Update(d, cfg); err != nil {
			t.Fatalf("Update failed: %v", err)
		}

		want := []recordedReservationReq{
			{
				method: http.MethodPatch,
				path:   resPath,
				paths:  []string{"shareSettings.shareType"},
				body: map[string]interface{}{
					"name":          "my-res",
					"zone":          zoneLink,
					"shareSettings": map[string]interface{}{"shareType": "LOCAL"},
				},
			},
		}
		if !reflect.DeepEqual(*reqs, want) {
			t.Fatalf("recorded requests mismatch:\ngot:  %#v\nwant: %#v", *reqs, want)
		}
	})
}

func TestComputeReservation_enableEmergentMaintenanceCustomizeDiffAndUpdate(t *testing.T) {
	t.Parallel()

	r := ResourceComputeReservation()
	meta := &transport_tpg.Config{
		Project: "my-project",
		Zone:    "us-central1-a",
	}

	makeCfg := func(em bool) map[string]interface{} {
		return map[string]interface{}{
			"name":                        "my-res",
			"zone":                        "us-central1-a",
			"project":                     "my-project",
			"enable_emergent_maintenance": em,
			"specific_reservation": []interface{}{map[string]interface{}{
				"count":               1,
				"instance_properties": []interface{}{map[string]interface{}{"machine_type": "n2-standard-2"}},
			}},
		}
	}

	buildStateWithDeploymentType := func(t *testing.T, deploymentType string, em bool) *terraform.InstanceState {
		t.Helper()
		initDiff, err := schema.InternalMap(r.Schema).Diff(context.Background(), nil, terraform.NewResourceConfigRaw(makeCfg(em)), computeReservationEnableEmergentMaintenanceForceNew, meta, true)
		if err != nil {
			t.Fatalf("initial diff error: %v", err)
		}
		initData, err := schema.InternalMap(r.Schema).Data(nil, initDiff)
		if err != nil {
			t.Fatalf("initial data error: %v", err)
		}
		initData.SetId("projects/my-project/zones/us-central1-a/reservations/my-res")
		if err := initData.Set("deployment_type", deploymentType); err != nil {
			t.Fatalf("failed setting deployment_type: %v", err)
		}
		return initData.State()
	}

	for _, tc := range []struct {
		name           string
		deploymentType string
	}{
		{name: "emptyDeploymentType", deploymentType: ""},
		{name: "unspecifiedDeploymentType", deploymentType: "DEPLOYMENT_TYPE_UNSPECIFIED"},
	} {
		t.Run(tc.name+"_forcesNew", func(t *testing.T) {
			state := buildStateWithDeploymentType(t, tc.deploymentType, true)
			diff, err := schema.InternalMap(r.Schema).Diff(context.Background(), state, terraform.NewResourceConfigRaw(makeCfg(false)), computeReservationEnableEmergentMaintenanceForceNew, meta, true)
			if err != nil {
				t.Fatalf("update diff error: %v", err)
			}
			if !diff.RequiresNew() {
				t.Fatalf("expected ForceNew when deployment_type=%q, got in-place diff: %#v", tc.deploymentType, diff.Attributes)
			}
			attrDiff, ok := diff.Attributes["enable_emergent_maintenance"]
			if !ok || !attrDiff.RequiresNew {
				t.Fatalf("expected enable_emergent_maintenance RequiresNew=true, got %#v", attrDiff)
			}
		})
	}

	t.Run("readReturnedValues_trueAndFalseAndOmitted", func(t *testing.T) {
		var getPayload map[string]interface{}
		ensureResourceManagerRegistered()
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
			w.Header().Set("Content-Type", "application/json")
			switch {
			case req.Method == http.MethodGet && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res":
				_ = json.NewEncoder(w).Encode(getPayload)
			case req.Method == http.MethodGet && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res/reservationBlocks":
				_, _ = w.Write([]byte(`{}`))
			default:
				http.NotFound(w, req)
			}
		}))
		t.Cleanup(server.Close)
		cfg := &transport_tpg.Config{
			Context:      context.Background(),
			Client:       server.Client(),
			Project:      "my-project",
			Zone:         "us-central1-a",
			PollInterval: time.Millisecond,
			CustomEndpoints: map[string]string{
				"compute_custom_endpoint":          server.URL + "/compute/v1/",
				"resource_manager_custom_endpoint": server.URL + "/v1/",
			},
		}

		basePayload := func() map[string]interface{} {
			return map[string]interface{}{
				"name":                        "my-res",
				"zone":                        "projects/my-project/zones/us-central1-a",
				"specificReservationRequired": false,
				"specificReservation":         map[string]interface{}{"count": "1", "instanceProperties": map[string]interface{}{"machineType": "n2-standard-2"}},
			}
		}

		// 1. Extended Reservation returning enableEmergentMaintenance=true on fresh import/read.
		d := r.Data(nil)
		d.SetId("projects/my-project/zones/us-central1-a/reservations/my-res")
		_ = d.Set("project", "my-project")
		_ = d.Set("zone", "us-central1-a")
		_ = d.Set("name", "my-res")

		getPayload = basePayload()
		getPayload["deploymentType"] = "DENSE"
		getPayload["enableEmergentMaintenance"] = true
		if err := r.Read(d, cfg); err != nil {
			t.Fatalf("Read(true) failed: %v", err)
		}
		if got := d.Get("enable_emergent_maintenance"); got != true {
			t.Fatalf("expected enable_emergent_maintenance=true from GET response, got %#v", got)
		}
		if got := d.Get("deployment_type"); got != "DENSE" {
			t.Fatalf("expected deployment_type=\"DENSE\" from GET response, got %#v", got)
		}

		// 2. Extended Reservation returning explicit enableEmergentMaintenance=false overwrites prior true.
		getPayload = basePayload()
		getPayload["deploymentType"] = "DENSE"
		getPayload["enableEmergentMaintenance"] = false
		if err := r.Read(d, cfg); err != nil {
			t.Fatalf("Read(false) failed: %v", err)
		}
		if got := d.Get("enable_emergent_maintenance"); got != false {
			t.Fatalf("expected enable_emergent_maintenance=false from GET response, got %#v", got)
		}

		// 3. Standard reservation omitting enableEmergentMaintenance preserves configured true in state.
		stdState := buildStateWithDeploymentType(t, "", true)
		stdData := r.Data(stdState)
		getPayload = basePayload()
		if err := r.Read(stdData, cfg); err != nil {
			t.Fatalf("Read(omitted) failed: %v", err)
		}
		if got := stdData.Get("enable_emergent_maintenance"); got != true {
			t.Fatalf("expected enable_emergent_maintenance=true preserved when omitted on standard GET, got %#v", got)
		}
	})

	t.Run("denseDeploymentType_updatesInPlaceViaPaths", func(t *testing.T) {
		ensureResourceManagerRegistered()
		var reqs []recordedReservationReq
		serverEM := true
		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
			w.Header().Set("Content-Type", "application/json")
			switch {
			case req.Method == http.MethodPatch && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res":
				var body map[string]interface{}
				_ = json.NewDecoder(req.Body).Decode(&body)
				if em, ok := body["enableEmergentMaintenance"].(bool); ok {
					serverEM = em
				}
				reqs = append(reqs, recordedReservationReq{
					method:     req.Method,
					path:       req.URL.Path,
					paths:      req.URL.Query()["paths"],
					updateMask: req.URL.Query().Get("updateMask"),
					body:       body,
				})
				_, _ = w.Write([]byte(`{"name":"op-1","zone":"projects/my-project/zones/us-central1-a","status":"DONE"}`))
			case req.Method == http.MethodGet && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/operations/op-1":
				_, _ = w.Write([]byte(`{"name":"op-1","zone":"projects/my-project/zones/us-central1-a","status":"DONE"}`))
			case req.Method == http.MethodGet && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res":
				_ = json.NewEncoder(w).Encode(map[string]interface{}{
					"name":                        "my-res",
					"zone":                        "projects/my-project/zones/us-central1-a",
					"deploymentType":              "DENSE",
					"enableEmergentMaintenance":   serverEM,
					"specificReservationRequired": false,
					"specificReservation":         map[string]interface{}{"count": "1", "instanceProperties": map[string]interface{}{"machineType": "n2-standard-2"}},
				})
			case req.Method == http.MethodGet && req.URL.Path == "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res/reservationBlocks":
				_, _ = w.Write([]byte(`{}`))
			default:
				http.NotFound(w, req)
			}
		}))
		t.Cleanup(server.Close)
		cfg := &transport_tpg.Config{
			Context:      context.Background(),
			Client:       server.Client(),
			Project:      "my-project",
			Zone:         "us-central1-a",
			PollInterval: time.Millisecond,
			CustomEndpoints: map[string]string{
				"compute_custom_endpoint":          server.URL + "/compute/v1/",
				"resource_manager_custom_endpoint": server.URL + "/v1/",
			},
		}

		// Transition 1: true -> false in place, verifying Read stores returned false.
		state := buildStateWithDeploymentType(t, "DENSE", true)
		diff, err := schema.InternalMap(r.Schema).Diff(context.Background(), state, terraform.NewResourceConfigRaw(makeCfg(false)), computeReservationEnableEmergentMaintenanceForceNew, cfg, true)
		if err != nil {
			t.Fatalf("update diff (true->false) error: %v", err)
		}
		if diff.RequiresNew() {
			t.Fatalf("expected in-place update when deployment_type=DENSE, got RequiresNew: %#v", diff.Attributes)
		}
		d, err := schema.InternalMap(r.Schema).Data(state, diff)
		if err != nil {
			t.Fatalf("update data error: %v", err)
		}
		if err := r.Update(d, cfg); err != nil {
			t.Fatalf("Update(true->false) failed: %v", err)
		}
		if got := d.Get("enable_emergent_maintenance"); got != false {
			t.Fatalf("expected post-update Read to set enable_emergent_maintenance=false, got %#v", got)
		}

		// Transition 2: false -> true in place, verifying Read stores returned true.
		diff2, err := schema.InternalMap(r.Schema).Diff(context.Background(), d.State(), terraform.NewResourceConfigRaw(makeCfg(true)), computeReservationEnableEmergentMaintenanceForceNew, cfg, true)
		if err != nil {
			t.Fatalf("update diff (false->true) error: %v", err)
		}
		if diff2.RequiresNew() {
			t.Fatalf("expected in-place update when deployment_type=DENSE, got RequiresNew: %#v", diff2.Attributes)
		}
		d2, err := schema.InternalMap(r.Schema).Data(d.State(), diff2)
		if err != nil {
			t.Fatalf("update data (false->true) error: %v", err)
		}
		if err := r.Update(d2, cfg); err != nil {
			t.Fatalf("Update(false->true) failed: %v", err)
		}
		if got := d2.Get("enable_emergent_maintenance"); got != true {
			t.Fatalf("expected post-update Read to set enable_emergent_maintenance=true, got %#v", got)
		}

		const resPath = "/compute/v1/projects/my-project/zones/us-central1-a/reservations/my-res"
		const zoneLink = "projects/my-project/global/zones/us-central1-a"
		want := []recordedReservationReq{
			{
				method: http.MethodPatch,
				path:   resPath,
				paths:  []string{"enableEmergentMaintenance"},
				body: map[string]interface{}{
					"name":                      "my-res",
					"zone":                      zoneLink,
					"enableEmergentMaintenance": false,
				},
			},
			{
				method: http.MethodPatch,
				path:   resPath,
				paths:  []string{"enableEmergentMaintenance"},
				body: map[string]interface{}{
					"name":                      "my-res",
					"zone":                      zoneLink,
					"enableEmergentMaintenance": true,
				},
			},
		}
		if !reflect.DeepEqual(reqs, want) {
			t.Fatalf("recorded requests mismatch:\ngot:  %#v\nwant: %#v", reqs, want)
		}
	})
}
