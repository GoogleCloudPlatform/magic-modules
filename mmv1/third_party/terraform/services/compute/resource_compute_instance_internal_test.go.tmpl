func TestComputeInstanceMapSecurityPoliciesCreate(t *testing.T) {
	t.Parallel()

	accessCfg := []interface{}{map[string]interface{}{"network_tier": "PREMIUM"}}

	t.Run("dynamic NIC at index 0 returns error", func(t *testing.T) {
		d := &tpgresource.ResourceDataMock{
			FieldsInSchema: map[string]interface{}{
				"network_interface": []interface{}{
					map[string]interface{}{
						"vlan":              2,
						"access_config":     accessCfg,
						"ipv6_access_config": []interface{}{},
						"security_policy":   "sp-1",
					},
				},
			},
		}
		_, err := computeInstanceMapSecurityPoliciesCreate(d, nil)
		if err == nil {
			t.Fatalf("expected error when dynamic NIC is at index 0 without parent NIC")
		}
	})

	t.Run("maps regular and dynamic NIC names accurately", func(t *testing.T) {
		d := &tpgresource.ResourceDataMock{
			FieldsInSchema: map[string]interface{}{
				"network_interface": []interface{}{
					map[string]interface{}{
						"vlan":              0,
						"access_config":     accessCfg,
						"ipv6_access_config": []interface{}{},
						"security_policy":   "sp-1",
					},
					map[string]interface{}{
						"vlan":              2,
						"access_config":     accessCfg,
						"ipv6_access_config": []interface{}{},
						"security_policy":   "sp-1",
					},
					map[string]interface{}{
						"vlan":              0,
						"access_config":     accessCfg,
						"ipv6_access_config": []interface{}{},
						"security_policy":   "sp-2",
					},
				},
			},
		}
		got, err := computeInstanceMapSecurityPoliciesCreate(d, nil)
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		want := map[string][]string{
			"sp-1": {"nic0", "nic0.2"},
			"sp-2": {"nic1"},
		}
		if !reflect.DeepEqual(got, want) {
			t.Fatalf("got %v, want %v", got, want)
		}
	})
}

