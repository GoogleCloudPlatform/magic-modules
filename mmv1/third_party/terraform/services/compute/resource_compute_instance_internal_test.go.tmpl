					map[string]interface{}{
						"name":              "nic1",
						"vlan":              0,
						"access_config":     accessCfg,
						"ipv6_access_config": []interface{}{},
						"security_policy":   "sp-1",
					},
					map[string]interface{}{
						"name":              "nic0.2",
						"parent_nic_name":   "nic0",
						"vlan":              2,
						"access_config":     accessCfg,
						"ipv6_access_config": []interface{}{},
						"security_policy":   "sp-2",
					},
					map[string]interface{}{
						"name":              "",
						"parent_nic_name":   "",
						"vlan":              3,
						"access_config":     accessCfg,
						"ipv6_access_config": []interface{}{},
						"security_policy":   "sp-2",
					},
				},
			},
		}
		got, err := computeInstanceMapSecurityPoliciesUpdate(d, nil)
		if err != nil {
			t.Fatalf("unexpected error: %v", err)
		}
		want := map[string][]string{
			"":     {"nic0"},
			"sp-1": {"nic1"},
			"sp-2": {"nic0.2", "nic0.3"},
		}
		if !reflect.DeepEqual(got, want) {
			t.Fatalf("got %v, want %v", got, want)
		}
	})
}
