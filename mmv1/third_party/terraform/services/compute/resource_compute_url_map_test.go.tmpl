type roundTripFunc func(*http.Request) (*http.Response, error)

func (f roundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) {
	return f(req)
}

func TestUnitComputeUrlMap_apiVersionHeader(t *testing.T) {
	t.Parallel()

	const expectedApiVersion = "2026-11-01"

	t.Run("RuntimeCRUD", func(t *testing.T) {
		var mu sync.Mutex
		type recordedReq struct {
			Method     string
			Path       string
			ApiVersion string
		}
		var urlMapRequests []recordedReq
		methodCounts := map[string]int{}

		storedUrlMap := map[string]interface{}{
			"id":             "12345",
			"name":           "test-url-map",
			"defaultService": "https://www.googleapis.com/compute/v1/projects/test-project/global/backendServices/default-bs",
			"selfLink":       "https://www.googleapis.com/compute/v1/projects/test-project/global/urlMaps/test-url-map",
		}

		assertFourImageOptimizationPolicies := func(body map[string]interface{}, method string) {
			t.Helper()
			dra, _ := body["defaultRouteAction"].(map[string]interface{})
			if iop, ok := dra["imageOptimizationPolicy"].(map[string]interface{}); !ok || iop["queryParameterInterpretation"] == nil {
				t.Errorf("%s /urlMaps body missing defaultRouteAction.imageOptimizationPolicy: %#v", method, body["defaultRouteAction"])
			}
			pms, _ := body["pathMatchers"].([]interface{})
			if len(pms) == 0 {
				t.Errorf("%s /urlMaps body missing pathMatchers", method)
				return
			}
			pm0, _ := pms[0].(map[string]interface{})
			pmDra, _ := pm0["defaultRouteAction"].(map[string]interface{})
			if iop, ok := pmDra["imageOptimizationPolicy"].(map[string]interface{}); !ok || iop["queryParameterInterpretation"] == nil {
				t.Errorf("%s /urlMaps body missing pathMatchers[0].defaultRouteAction.imageOptimizationPolicy: %#v", method, pm0["defaultRouteAction"])
			}
			prs, _ := pm0["pathRules"].([]interface{})
			if len(prs) == 0 {
				t.Errorf("%s /urlMaps body missing pathMatchers[0].pathRules", method)
			} else {
				pr0, _ := prs[0].(map[string]interface{})
				prRa, _ := pr0["routeAction"].(map[string]interface{})
				if iop, ok := prRa["imageOptimizationPolicy"].(map[string]interface{}); !ok || iop["queryParameterInterpretation"] == nil {
					t.Errorf("%s /urlMaps body missing pathMatchers[0].pathRules[0].routeAction.imageOptimizationPolicy: %#v", method, pr0["routeAction"])
				}
			}
			rrs, _ := pm0["routeRules"].([]interface{})
			if len(rrs) == 0 {
				t.Errorf("%s /urlMaps body missing pathMatchers[0].routeRules", method)
			} else {
				rr0, _ := rrs[0].(map[string]interface{})
				rrRa, _ := rr0["routeAction"].(map[string]interface{})
				if iop, ok := rrRa["imageOptimizationPolicy"].(map[string]interface{}); !ok || iop["queryParameterInterpretation"] == nil {
					t.Errorf("%s /urlMaps body missing pathMatchers[0].routeRules[0].routeAction.imageOptimizationPolicy: %#v", method, rr0["routeAction"])
				}
			}
		}

		client := &http.Client{
			Transport: roundTripFunc(func(req *http.Request) (*http.Response, error) {
				mu.Lock()
				defer mu.Unlock()

				path := req.URL.Path
				if strings.Contains(path, "/global/operations/") {
					return &http.Response{
						StatusCode: http.StatusOK,
						Header:     http.Header{"Content-Type": []string{"application/json"}},
						Body:       io.NopCloser(strings.NewReader(`{"name":"op-1","status":"DONE"}`)),
					}, nil
				}

				if strings.Contains(path, "/global/urlMaps") {
					gotVer := req.Header.Get("X-Goog-Api-Version")
					urlMapRequests = append(urlMapRequests, recordedReq{
						Method:     req.Method,
						Path:       path,
						ApiVersion: gotVer,
					})
					methodCounts[req.Method]++

					if req.Method == http.MethodPost || req.Method == http.MethodPut {
						if req.Body != nil {
							var body map[string]interface{}
							if err := json.NewDecoder(req.Body).Decode(&body); err == nil {
								assertFourImageOptimizationPolicies(body, req.Method)
								for k, v := range body {
									storedUrlMap[k] = v
								}
							}
						}
						return &http.Response{
							StatusCode: http.StatusOK,
							Header:     http.Header{"Content-Type": []string{"application/json"}},
							Body:       io.NopCloser(strings.NewReader(`{"name":"op-1","status":"DONE"}`)),
						}, nil
					}

					if req.Method == http.MethodGet {
						b, _ := json.Marshal(storedUrlMap)
						return &http.Response{
							StatusCode: http.StatusOK,
							Header:     http.Header{"Content-Type": []string{"application/json"}},
							Body:       io.NopCloser(bytes.NewReader(b)),
						}, nil
					}

					if req.Method == http.MethodDelete {
						return &http.Response{
							StatusCode: http.StatusOK,
							Header:     http.Header{"Content-Type": []string{"application/json"}},
							Body:       io.NopCloser(strings.NewReader(`{"name":"op-1","status":"DONE"}`)),
						}, nil
					}
				}

				return &http.Response{
					StatusCode: http.StatusNotFound,
					Header:     http.Header{"Content-Type": []string{"application/json"}},
					Body:       io.NopCloser(strings.NewReader(`{"error":{"code":404,"message":"not found"}}`)),
				}, nil
			}),
		}

		config := &transport_tpg.Config{
			Project:   "test-project",
			UserAgent: "terraform-provider-google-unit-test",
			Client:    client,
		}

		res := tpgcompute.ResourceComputeUrlMap()

		rawConfig := func(desc, defaultQpi, pmDefaultQpi, pathRuleQpi, routeRuleQpi string) map[string]interface{} {
			return map[string]interface{}{
				"name":            "test-url-map",
				"description":     desc,
				"default_service": "https://www.googleapis.com/compute/v1/projects/test-project/global/backendServices/default-bs",
				"default_route_action": []interface{}{
					map[string]interface{}{
						"image_optimization_policy": []interface{}{
							map[string]interface{}{
								"query_parameter_interpretation": defaultQpi,
							},
						},
					},
				},
				"path_matcher": []interface{}{
					map[string]interface{}{
						"name":            "allpaths",
						"default_service": "https://www.googleapis.com/compute/v1/projects/test-project/global/backendServices/default-bs",
						"default_route_action": []interface{}{
							map[string]interface{}{
								"image_optimization_policy": []interface{}{
									map[string]interface{}{
										"query_parameter_interpretation": pmDefaultQpi,
									},
								},
							},
						},
						"path_rule": []interface{}{
							map[string]interface{}{
								"paths":   []interface{}{"/images/*"},
								"service": "https://www.googleapis.com/compute/v1/projects/test-project/global/backendServices/default-bs",
								"route_action": []interface{}{
									map[string]interface{}{
										"image_optimization_policy": []interface{}{
											map[string]interface{}{
												"query_parameter_interpretation": pathRuleQpi,
											},
										},
									},
								},
							},
						},
						"route_rules": []interface{}{
							map[string]interface{}{
								"priority": 1,
								"service":  "https://www.googleapis.com/compute/v1/projects/test-project/global/backendServices/default-bs",
								"route_action": []interface{}{
									map[string]interface{}{
										"image_optimization_policy": []interface{}{
											map[string]interface{}{
												"query_parameter_interpretation": routeRuleQpi,
											},
										},
									},
								},
							},
						},
					},
				},
			}
		}

		// 1. Create (POST + trailing GET)
		dCreate := schema.TestResourceDataRaw(t, res.Schema, rawConfig("initial", "ENABLED", "DISABLED", "ENABLED", "DISABLED"))
		if err := res.Create(dCreate, config); err != nil {
			t.Fatalf("Create failed: %v", err)
		}

		// 2. Read (GET)
		if err := res.Read(dCreate, config); err != nil {
			t.Fatalf("Read failed: %v", err)
		}

		// 3. Update (PUT + trailing GET)
		dUpdate := schema.TestResourceDataRaw(t, res.Schema, rawConfig("updated", "DISABLED", "ENABLED", "DISABLED", "ENABLED"))
		dUpdate.SetId(dCreate.Id())
		if err := res.Update(dUpdate, config); err != nil {
			t.Fatalf("Update failed: %v", err)
		}

		// 4. Delete (DELETE)
		if err := res.Delete(dUpdate, config); err != nil {
			t.Fatalf("Delete failed: %v", err)
		}

		for _, m := range []string{http.MethodPost, http.MethodGet, http.MethodPut, http.MethodDelete} {
			if methodCounts[m] == 0 {
				t.Errorf("expected at least one %s request to /global/urlMaps, got 0", m)
			}
		}

		for i, r := range urlMapRequests {
			if r.ApiVersion != expectedApiVersion {
				t.Errorf("request #%d (%s %s) had X-Goog-Api-Version=%q, want %q", i, r.Method, r.Path, r.ApiVersion, expectedApiVersion)
			}
		}
	})

	t.Run("StaticAST", func(t *testing.T) {
		fset := token.NewFileSet()
		file, err := parser.ParseFile(fset, "resource_compute_url_map.go", nil, 0)
		if err != nil {
			t.Fatalf("failed to parse resource_compute_url_map.go: %v", err)
		}

		sendRequestCalls := 0
		sendRequestOptsLiterals := 0

		checkSendRequestOptionsLit := func(comp *ast.CompositeLit) {
			sendRequestOptsLiterals++
			var foundApiVersion bool
			var gotVal string
			for _, elt := range comp.Elts {
				kv, ok := elt.(*ast.KeyValueExpr)
				if !ok {
					continue
				}
				ident, ok := kv.Key.(*ast.Ident)
				if !ok || ident.Name != "ApiVersion" {
					continue
				}
				foundApiVersion = true
				if bl, ok := kv.Value.(*ast.BasicLit); ok && bl.Kind == token.STRING {
					gotVal = strings.Trim(bl.Value, "\"`")
				}
			}
			pos := fset.Position(comp.Pos())
			if !foundApiVersion {
				t.Errorf("%s: transport_tpg.SendRequestOptions composite literal is missing ApiVersion field", pos)
			} else if gotVal != expectedApiVersion {
				t.Errorf("%s: transport_tpg.SendRequestOptions has ApiVersion=%q, want %q", pos, gotVal, expectedApiVersion)
			}
		}

		ast.Inspect(file, func(n ast.Node) bool {
			switch node := n.(type) {
			case *ast.CompositeLit:
				if sel, ok := node.Type.(*ast.SelectorExpr); ok {
					if pkgIdent, ok := sel.X.(*ast.Ident); ok && pkgIdent.Name == "transport_tpg" && sel.Sel.Name == "SendRequestOptions" {
						checkSendRequestOptionsLit(node)
					}
				}
			case *ast.CallExpr:
				if sel, ok := node.Fun.(*ast.SelectorExpr); ok {
					if pkgIdent, ok := sel.X.(*ast.Ident); ok && pkgIdent.Name == "transport_tpg" && sel.Sel.Name == "SendRequest" {
						sendRequestCalls++
						if len(node.Args) != 1 {
							t.Errorf("%s: unexpected arg count to transport_tpg.SendRequest: %d", fset.Position(node.Pos()), len(node.Args))
							return true
						}
						if _, ok := node.Args[0].(*ast.CompositeLit); !ok {
							t.Errorf("%s: transport_tpg.SendRequest argument must be an inline transport_tpg.SendRequestOptions composite literal", fset.Position(node.Pos()))
						}
					}
				}
			}
			return true
		})

		if sendRequestCalls < 4 {
			t.Errorf("expected at least 4 transport_tpg.SendRequest calls in resource_compute_url_map.go (Create, Read, Update, Delete), found %d", sendRequestCalls)
		}
		if sendRequestOptsLiterals != sendRequestCalls {
			t.Errorf("mismatch between SendRequestOptions literals (%d) and SendRequest calls (%d)", sendRequestOptsLiterals, sendRequestCalls)
		}
	})
}
