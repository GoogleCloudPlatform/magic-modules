import (
	"reflect"
	"testing"
)

func TestAdjustInstanceFromMachineImageWorkloadIdentityConfig(t *testing.T) {
	t.Parallel()

	defaultSA := []interface{}{map[string]interface{}{"email": "default"}}

	cases := map[string]struct {
		instanceBody      map[string]interface{}
		miRes             map[string]interface{}
		hasServiceAccount bool
		wantBody          map[string]interface{}
	}{
		"normal_machine_image_injects_default_sa": {
			instanceBody: map[string]interface{}{"name": "vm"},
			miRes:        map[string]interface{}{"instanceProperties": map[string]interface{}{}},
			wantBody: map[string]interface{}{
				"name":            "vm",
				"serviceAccounts": defaultSA,
			},
		},
		"inherit_agent_identity_skips_default_sa_and_clears_captured_spiffe_id": {
			instanceBody: map[string]interface{}{"name": "vm"},
			miRes: map[string]interface{}{
				"instanceProperties": map[string]interface{}{
					"workloadIdentityConfig": map[string]interface{}{
						"identity":                   "spiffe://example.org/ns/default/sa/agent",
						"identityType":               "AGENT_IDENTITY",
						"identityCertificateEnabled": true,
					},
				},
			},
			wantBody: map[string]interface{}{
				"name": "vm",
				"workloadIdentityConfig": map[string]interface{}{
					"identity": "",
				},
			},
		},
		"override_agent_identity_mi_to_service_account_injects_default_sa_and_resets_cert": {
			instanceBody: map[string]interface{}{
				"name": "vm",
				"workloadIdentityConfig": map[string]interface{}{
					"identityType": "SERVICE_ACCOUNT",
				},
			},
			miRes: map[string]interface{}{
				"instanceProperties": map[string]interface{}{
					"workloadIdentityConfig": map[string]interface{}{
						"identity":                   "spiffe://example.org/ns/default/sa/agent",
						"identityType":               "AGENT_IDENTITY",
						"identityCertificateEnabled": true,
					},
				},
			},
			wantBody: map[string]interface{}{
				"name":            "vm",
				"serviceAccounts": defaultSA,
				"workloadIdentityConfig": map[string]interface{}{
					"identity":                   "",
					"identityType":               "SERVICE_ACCOUNT",
					"identityCertificateEnabled": false,
				},
			},
		},
		"override_sa_mi_to_agent_identity_clears_inherited_service_accounts": {
			instanceBody: map[string]interface{}{
				"name": "vm",
				"workloadIdentityConfig": map[string]interface{}{
					"identityType": "AGENT_IDENTITY",
				},
			},
			miRes: map[string]interface{}{
				"instanceProperties": map[string]interface{}{
					"serviceAccounts": []interface{}{
						map[string]interface{}{"email": "mi-sa@example.iam.gserviceaccount.com"},
					},
					"workloadIdentityConfig": map[string]interface{}{
						"identity":                   "ns/p/sa/id",
						"identityCertificateEnabled": false,
					},
				},
			},
			wantBody: map[string]interface{}{
				"name":            "vm",
				"serviceAccounts": []interface{}{},
				"workloadIdentityConfig": map[string]interface{}{
					"identity":                   "",
					"identityType":               "AGENT_IDENTITY",
					"identityCertificateEnabled": true,
				},
			},
		},
		"override_agent_identity_cert_disabled_clears_captured_spiffe_id": {
			instanceBody: map[string]interface{}{
				"name": "vm",
				"workloadIdentityConfig": map[string]interface{}{
					"identityCertificateEnabled": false,
				},
			},
			miRes: map[string]interface{}{
				"instanceProperties": map[string]interface{}{
					"workloadIdentityConfig": map[string]interface{}{
						"identity":                   "spiffe://example.org/ns/default/sa/agent",
						"identityType":               "AGENT_IDENTITY",
						"identityCertificateEnabled": true,
					},
				},
			},
			wantBody: map[string]interface{}{
				"name": "vm",
				"workloadIdentityConfig": map[string]interface{}{
					"identity":                   "",
					"identityCertificateEnabled": false,
				},
			},
		},
	}

	for name, tc := range cases {
		tc := tc
		t.Run(name, func(t *testing.T) {
			t.Parallel()
			adjustInstanceFromMachineImageWorkloadIdentityConfig(tc.instanceBody, tc.miRes, tc.hasServiceAccount)
			if !reflect.DeepEqual(tc.instanceBody, tc.wantBody) {
				t.Fatalf("adjustInstanceFromMachineImageWorkloadIdentityConfig() =\n%#v\nwant:\n%#v", tc.instanceBody, tc.wantBody)
			}
		})
	}
}
{{- end }}
