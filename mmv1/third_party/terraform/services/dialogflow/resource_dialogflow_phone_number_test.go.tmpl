func testAccCheckDialogflowPhoneNumberAbandonAndCleanup(t *testing.T) func(s *terraform.State) error {
	return func(s *terraform.State) error {
		for name, rs := range s.RootModule().Resources {
			if rs.Type != "google_dialogflow_phone_number" {
				continue
			}
			if strings.HasPrefix(name, "data.") {
				continue
			}

			config := acctest.GoogleProviderConfig(t)
			listUrl, err := tpgresource.ReplaceVarsForTest(config, rs, transport_tpg.BaseUrl(dialogflow.Product, config)+"projects/{{"{{"}}project{{"}}"}}/locations/{{"{{"}}location{{"}}"}}/phoneNumbers?pageSize=1000")
			if err != nil {
				return err
			}
			deleteUrl, err := tpgresource.ReplaceVarsForTest(config, rs, transport_tpg.BaseUrl(dialogflow.Product, config)+"{{"{{"}}name{{"}}"}}")
			if err != nil {
				return err
			}

			billingProject := ""
			if config.BillingProject != "" {
				billingProject = config.BillingProject
			}

			location := rs.Primary.Attributes["location"]
			universeDomain := config.UniverseDomain
			qualify := func(rawUrl string) string {
				if universeDomain != "" && universeDomain != "googleapis.com" {
					rawUrl = strings.Replace(rawUrl, "googleapis.com", universeDomain, 1)
				}
				if strings.HasPrefix(rawUrl, "https://dialogflow") {
					if location != "" && location != "global" {
						rawUrl = strings.Replace(rawUrl, "https://dialogflow", fmt.Sprintf("https://%s-dialogflow", location), 1)
					}
				}
				return rawUrl
			}
			listUrl = qualify(listUrl)
			deleteUrl = qualify(deleteUrl)

			res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
				Config:    config,
				Method:    "GET",
				Project:   billingProject,
				RawURL:    listUrl,
				UserAgent: config.UserAgent,
			})
			if err != nil {
				return fmt.Errorf("Error listing phone numbers to verify ABANDON behavior: %s", err)
			}

			expectedName := rs.Primary.Attributes["name"]
			foundActive := false
			if items, ok := res["phoneNumbers"].([]interface{}); ok {
				for _, itemRaw := range items {
					item, ok := itemRaw.(map[string]interface{})
					if !ok {
						continue
					}
					if item["name"] == expectedName && item["lifecycleState"] == "ACTIVE" {
						foundActive = true
						break
					}
				}
			}
			if !foundActive {
				return fmt.Errorf("Expected DialogflowPhoneNumber %s with deletion_policy=ABANDON to remain ACTIVE after destroy, but it was not found in %#v", expectedName, res)
			}

			// Clean up the abandoned phone number so the test does not leak quota.
			_, err = transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
				Config:    config,
				Method:    "DELETE",
				Project:   billingProject,
				RawURL:    deleteUrl,
				UserAgent: config.UserAgent,
			})
			if err != nil {
				return fmt.Errorf("Error cleaning up abandoned DialogflowPhoneNumber %s: %s", expectedName, err)
			}
		}

		return nil
	}
}
