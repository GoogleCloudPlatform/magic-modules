func TestAccDialogflowPhoneNumber_createWithBindingsAndAbandon(t *testing.T) {
	t.Parallel()

	randomSuffix := acctest.RandString(t, 10)

	context := map[string]interface{}{
		"app_display_name": "tf-test-my-app" + randomSuffix,
		"app_id":           "tf-test-app-id" + randomSuffix,
		"profile_name":     "tf-test-dialogflow-profile" + randomSuffix,
		"trunk_name":       "tf-test-dialogflow-trunk" + randomSuffix,
		"random_suffix":    randomSuffix,
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		CheckDestroy:             testAccCheckDialogflowPhoneNumberAbandonAndCleanup(t),
		Steps: []resource.TestStep{
			{
				Config: testAccDialogflowPhoneNumber_createWithBindingsStep1(context),
			},
			{
				ResourceName:            "google_dialogflow_phone_number.bound_phone_number",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: []string{"location", "deletion_policy"},
			},
			{
				Config: testAccDialogflowPhoneNumber_unbindProfileStep2(context),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: []plancheck.PlanCheck{
						plancheck.ExpectResourceAction("google_dialogflow_phone_number.bound_phone_number", plancheck.ResourceActionUpdate),
					},
				},
			},
			{
				ResourceName:            "google_dialogflow_phone_number.bound_phone_number",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: []string{"location", "deletion_policy"},
			},
		},
	})
}

func testAccDialogflowPhoneNumber_createWithBindingsStep1(context map[string]interface{}) string {
	return acctest.Nprintf(`
resource "google_ces_app" "ces_app_for_agent" {
  provider     = google-beta
  app_id       = "%{app_id}"
  location     = "us"
  display_name = "%{app_display_name}"
  time_zone_settings {
    time_zone = "America/Los_Angeles"
  }
}

resource "google_dialogflow_conversation_profile" "profile" {
  provider           = google-beta
  location           = "us-central1"
  display_name       = "%{profile_name}"
  language_code      = "en-US"
  use_bidi_streaming = true

  automated_agent_config {
    agent = google_ces_app.ces_app_for_agent.id
  }

  sip_config {
    allow_virtual_agent_interaction = true
    create_conversation_on_the_fly  = true
  }
}

resource "google_dialogflow_sip_trunk" "trunk" {
  provider     = google-beta
  location     = "us-central1"
  display_name = "%{trunk_name}"
  expected_hostname = [
    "%{trunk_name}.example.com"
  ]
}

resource "google_dialogflow_phone_number" "bound_phone_number" {
  provider             = google-beta
  location             = "us-central1"
  description          = "Phone number created with initial bindings and abandon policy"
  conversation_profile = google_dialogflow_conversation_profile.profile.name

  allowed_sip_trunks {
    sip_trunks  = [google_dialogflow_sip_trunk.trunk.name]
    carrier_ids = ["carrier-1"]
  }

  phone_number_spec {
    country_code         = 1
    preferred_area_codes = ["256"]
  }

  deletion_policy = "ABANDON"
}
`, context)
}

