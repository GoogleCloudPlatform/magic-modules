package parametermanager
{{- if ne $.TargetVersionName "ga" }}

import (
	"encoding/base64"
	"fmt"
	"net/http"
	"net/url"
	"regexp"
	"strings"

	"github.com/hashicorp/terraform-provider-google/google/registry"
	"github.com/hashicorp/terraform-provider-google/google/tpgresource"
	transport_tpg "github.com/hashicorp/terraform-provider-google/google/transport"

	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
)

var parameterManagerTemplateReferenceRegex = regexp.MustCompile(`^projects/([^/\s]+)/locations/global/templates/([^/\s]+)$`)

func DataSourceParameterManagerTemplateVersionRender() *schema.Resource {
	return &schema.Resource{
		Read: dataSourceParameterManagerTemplateVersionRenderRead,
		Schema: map[string]*schema.Schema{
			"project": {
				Type:     schema.TypeString,
				Optional: true,
				Computed: true,
			},
			"template": {
				Type:     schema.TypeString,
				Required: true,
			},
			"template_version_id": {
				Type:     schema.TypeString,
				Required: true,
			},
			"parameter_version": {
				Type:     schema.TypeString,
				Required: true,
			},
			"template_data": {
				Type:      schema.TypeString,
				Computed:  true,
				Sensitive: true,
			},
			"rendered_template_data": {
				Type:      schema.TypeString,
				Computed:  true,
				Sensitive: true,
			},
			"name": {
				Type:     schema.TypeString,
				Computed: true,
			},
			"template_format": {
				Type:     schema.TypeString,
				Computed: true,
			},
		},
		UseJSONNumber: true,
	}
}

func resolveParameterManagerTemplateReference(d *schema.ResourceData, config *transport_tpg.Config) (string, string, error) {
	dTemplate, ok := d.Get("template").(string)
	if !ok {
		return "", "", fmt.Errorf("wrong type for template field (%T), expected string", d.Get("template"))
	}
	if dTemplate == "" {
		return "", "", fmt.Errorf("template field cannot be empty")
	}

	parts := parameterManagerTemplateReferenceRegex.FindStringSubmatch(dTemplate)
	if len(parts) == 3 {
		project := parts[1]
		if dProject, ok := d.Get("project").(string); !ok {
			return "", "", fmt.Errorf("wrong type for project (%T), expected string", d.Get("project"))
		} else if dProject != "" && dProject != project {
			return "", "", fmt.Errorf("project field value (%s) does not match project of template (%s).", dProject, project)
		}
		return project, parts[2], nil
	}

	if strings.ContainsAny(dTemplate, "/ \t\n\r") {
		return "", "", fmt.Errorf("invalid template reference (%s), expected template_id or projects/{project}/locations/global/templates/{template_id}", dTemplate)
	}

	project, err := tpgresource.GetProject(d, config)
	if err != nil {
		return "", "", fmt.Errorf("error fetching project for template: %s", err)
	}
	return project, dTemplate, nil
}

func dataSourceParameterManagerTemplateVersionRenderRead(d *schema.ResourceData, meta interface{}) error {
	config := meta.(*transport_tpg.Config)
	userAgent, err := tpgresource.GenerateUserAgentString(d, config.UserAgent)
	if err != nil {
		return err
	}

	project, templateID, err := resolveParameterManagerTemplateReference(d, config)
	if err != nil {
		return err
	}
	if err := d.Set("project", project); err != nil {
		return fmt.Errorf("error setting project: %s", err)
	}

	dTemplateVersionId, ok := d.Get("template_version_id").(string)
	if !ok {
		return fmt.Errorf("wrong type for template version id field (%T), expected string", d.Get("template_version_id"))
	}

	dParameterVersion, ok := d.Get("parameter_version").(string)
	if !ok {
		return fmt.Errorf("wrong type for parameter version field (%T), expected string", d.Get("parameter_version"))
	}

	baseURL := fmt.Sprintf("%sprojects/%s/locations/global/templates/%s/versions/%s:render",
		transport_tpg.BaseUrl(Product, config),
		url.PathEscape(project),
		url.PathEscape(templateID),
		url.PathEscape(dTemplateVersionId),
	)

	reqURL, err := transport_tpg.AddQueryParams(baseURL, map[string]string{
		"parameter_version": dParameterVersion,
	})
	if err != nil {
		return err
	}

	billingProject := project
	if bp, err := tpgresource.GetBillingProject(d, config); err == nil {
		billingProject = bp
	}

	headers := make(http.Header)
	templateVersion, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   billingProject,
		RawURL:    reqURL,
		UserAgent: userAgent,
		Headers:   headers,
	})
	if err != nil {
		return fmt.Errorf("error retrieving rendered parameter manager template version: %s", err.Error())
	}

	nameStr, ok := templateVersion["templateVersion"].(string)
	if !ok || nameStr == "" {
		return fmt.Errorf("read response didn't contain critical fields. Read may not have succeeded.")
	}

	if err := d.Set("name", nameStr); err != nil {
		return fmt.Errorf("error reading templateVersion: %s", err)
	}

	if templateFormat, ok := templateVersion["templateFormat"].(string); ok {
		if err := d.Set("template_format", templateFormat); err != nil {
			return fmt.Errorf("error setting template_format: %s", err)
		}
	}

	if payloadMap, ok := templateVersion["payload"].(map[string]interface{}); ok && payloadMap != nil {
		if dataStr, ok := payloadMap["data"].(string); ok {
			templateData, err := base64.StdEncoding.DecodeString(dataStr)
			if err != nil {
				return fmt.Errorf("error decoding parameter manager template version data: %s", err.Error())
			}
			if err := d.Set("template_data", string(templateData)); err != nil {
				return fmt.Errorf("error setting template_data: %s", err)
			}
		}
	}

	if renderedPayloadStr, ok := templateVersion["renderedPayload"].(string); ok {
		renderedTemplateData, err := base64.StdEncoding.DecodeString(renderedPayloadStr)
		if err != nil {
			return fmt.Errorf("error decoding parameter manager template version rendered payload data: %s", err.Error())
		}
		if err := d.Set("rendered_template_data", string(renderedTemplateData)); err != nil {
			return fmt.Errorf("error setting rendered_template_data: %s", err)
		}
	}

	d.SetId(fmt.Sprintf("%s?parameter_version=%s", nameStr, dParameterVersion))
	return nil
}

func init() {
	registry.Schema{
		Name:        "google_parameter_manager_template_version_render",
		ProductName: "parametermanager",
		Type:        registry.SchemaTypeDataSource,
		Schema:      DataSourceParameterManagerTemplateVersionRender(),
	}.Register()
}
{{- end }}
