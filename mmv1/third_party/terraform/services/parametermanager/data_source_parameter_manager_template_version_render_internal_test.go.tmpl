package parametermanager
{{- if ne $.TargetVersionName "ga" }}

import (
	"strings"
	"testing"

	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
	transport_tpg "github.com/hashicorp/terraform-provider-google/google/transport"
)

func TestUnitDataSourceParameterManagerTemplateVersionRender_resolveTemplateReference(t *testing.T) {
	t.Parallel()

	cases := []struct {
		name           string
		raw            map[string]interface{}
		providerProj   string
		wantProject    string
		wantTemplateID string
		wantTemplate   string
		wantErrSubstr  string
	}{
		{
			name: "short template_id with provider project",
			raw: map[string]interface{}{
				"template":            "my-template",
				"template_version_id": "v1",
				"parameter_version":   "projects/default-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:   "default-proj",
			wantProject:    "default-proj",
			wantTemplateID: "my-template",
			wantTemplate:   "my-template",
		},
		{
			name: "short template_id with explicit project override",
			raw: map[string]interface{}{
				"project":             "explicit-proj",
				"template":            "my-template",
				"template_version_id": "v1",
				"parameter_version":   "projects/explicit-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:   "default-proj",
			wantProject:    "explicit-proj",
			wantTemplateID: "my-template",
			wantTemplate:   "my-template",
		},
		{
			name: "full global template resource name preserves template in state",
			raw: map[string]interface{}{
				"template":            "projects/tmpl-proj/locations/global/templates/my-template",
				"template_version_id": "v1",
				"parameter_version":   "projects/tmpl-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:   "default-proj",
			wantProject:    "tmpl-proj",
			wantTemplateID: "my-template",
			wantTemplate:   "projects/tmpl-proj/locations/global/templates/my-template",
		},
		{
			name: "full global template resource name with matching explicit project",
			raw: map[string]interface{}{
				"project":             "tmpl-proj",
				"template":            "projects/tmpl-proj/locations/global/templates/my-template",
				"template_version_id": "v1",
				"parameter_version":   "projects/tmpl-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:   "default-proj",
			wantProject:    "tmpl-proj",
			wantTemplateID: "my-template",
			wantTemplate:   "projects/tmpl-proj/locations/global/templates/my-template",
		},
		{
			name: "project mismatch between explicit project and full template reference",
			raw: map[string]interface{}{
				"project":             "other-proj",
				"template":            "projects/tmpl-proj/locations/global/templates/my-template",
				"template_version_id": "v1",
				"parameter_version":   "projects/tmpl-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:  "default-proj",
			wantErrSubstr: "project field value (other-proj) does not match project of template (tmpl-proj)",
		},
		{
			name: "unanchored prefix in template reference rejected",
			raw: map[string]interface{}{
				"template":            "extra/projects/tmpl-proj/locations/global/templates/my-template",
				"template_version_id": "v1",
				"parameter_version":   "projects/tmpl-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:  "default-proj",
			wantErrSubstr: "invalid template reference",
		},
		{
			name: "template version path passed to template field rejected",
			raw: map[string]interface{}{
				"template":            "projects/tmpl-proj/locations/global/templates/my-template/versions/v1",
				"template_version_id": "v1",
				"parameter_version":   "projects/tmpl-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:  "default-proj",
			wantErrSubstr: "invalid template reference",
		},
		{
			name: "regional location in global template reference rejected",
			raw: map[string]interface{}{
				"template":            "projects/tmpl-proj/locations/us-central1/templates/my-template",
				"template_version_id": "v1",
				"parameter_version":   "projects/tmpl-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:  "default-proj",
			wantErrSubstr: "invalid template reference",
		},
		{
			name: "missing project when using short template_id",
			raw: map[string]interface{}{
				"template":            "my-template",
				"template_version_id": "v1",
				"parameter_version":   "projects/tmpl-proj/locations/global/parameters/p1/versions/v1",
			},
			providerProj:  "",
			wantErrSubstr: "error fetching project for template",
		},
	}

	for _, tc := range cases {
		tc := tc
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()
			d := schema.TestResourceDataRaw(t, DataSourceParameterManagerTemplateVersionRender().Schema, tc.raw)
			cfg := &transport_tpg.Config{Project: tc.providerProj}

			gotProject, gotTemplateID, err := resolveParameterManagerTemplateReference(d, cfg)
			if tc.wantErrSubstr != "" {
				if err == nil {
					t.Fatalf("expected error containing %q, got nil (project=%q, templateID=%q)", tc.wantErrSubstr, gotProject, gotTemplateID)
				}
				if !strings.Contains(err.Error(), tc.wantErrSubstr) {
					t.Fatalf("expected error containing %q, got %q", tc.wantErrSubstr, err.Error())
				}
				return
			}
			if err != nil {
				t.Fatalf("unexpected error: %v", err)
			}
			if gotProject != tc.wantProject {
				t.Errorf("project = %q, want %q", gotProject, tc.wantProject)
			}
			if gotTemplateID != tc.wantTemplateID {
				t.Errorf("templateID = %q, want %q", gotTemplateID, tc.wantTemplateID)
			}
			if gotStateTemplate := d.Get("template").(string); gotStateTemplate != tc.wantTemplate {
				t.Errorf("d.Get(\"template\") = %q, want %q", gotStateTemplate, tc.wantTemplate)
			}
		})
	}
}
{{- end }}
