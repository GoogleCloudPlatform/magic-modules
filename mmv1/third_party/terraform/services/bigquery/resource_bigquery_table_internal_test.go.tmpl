func TestUnitBigQueryDataTable_schemaIsChangeable(t *testing.T) {
	t.Parallel()
	for _, testcase := range testUnitBigQueryDataTableIsChangeableTestCases {
		testcase.check(t)
	}
}

func TestUnitBigQueryDataTable_schemaIsChangeableNested(t *testing.T) {
	t.Parallel()
	// Only top level column drops are changeable
	customNestedValues := map[string]bool{"arraySizeDecreases": false, "typeModeReqToNullAndColumnDropped": false}
	for _, testcase := range testUnitBigQueryDataTableIsChangeableTestCases {
		changeable := testcase.changeable
		if overrideValue, ok := customNestedValues[testcase.name]; ok {
			changeable = overrideValue
		}

		testcaseNested := &testUnitBigQueryDataTableJSONChangeableTestCase{
			testcase.name + "Nested",
			fmt.Sprintf("[{\"name\": \"someValue\", \"type\" : \"INTEGER\", \"fields\" : %s }]", testcase.jsonOld),
			fmt.Sprintf("[{\"name\": \"someValue\", \"type\" : \"INT64\", \"fields\" : %s }]", testcase.jsonNew),
			testcase.isExternalTable,
			changeable,
			nil,
		}
		testcaseNested.check(t)
	}
}

func TestMergeDataPoliciesIntoMap_DataPolicyList(t *testing.T) {
	t.Parallel()

	old := []interface{}{
		map[string]interface{}{
			"name": "col1",
			"dataPolicyList": map[string]interface{}{
				"dataPolicies": []interface{}{map[string]interface{}{"name": "p1"}},
			},
			"dataPolicies": []interface{}{map[string]interface{}{"name": "p1"}},
		},
		map[string]interface{}{
			"name": "col2",
			"dataPolicyList": map[string]interface{}{
				"dataPolicies": []interface{}{map[string]interface{}{"name": "p2"}},
			},
			"dataPolicies": []interface{}{map[string]interface{}{"name": "p2"}},
		},
		map[string]interface{}{
			"name": "col3",
			"dataPolicyList": map[string]interface{}{
				"dataPolicies": []interface{}{map[string]interface{}{"name": "p3"}},
			},
			"dataPolicies": []interface{}{map[string]interface{}{"name": "p3"}},
		},
		map[string]interface{}{
			"name":           "col4",
			"dataPolicyList": map[string]interface{}{},
		},
	}
	new := []interface{}{
		map[string]interface{}{"name": "col1"}, // Policy omitted -> should merge from old
		map[string]interface{}{
			"name":           "col2",
			"dataPolicyList": map[string]interface{}{}, // Explicitly empty map -> should NOT merge from old
		},
		map[string]interface{}{
			"name": "col3",
			"dataPolicyList": map[string]interface{}{
				"dataPolicies": []interface{}{}, // Explicitly empty slice -> should NOT merge from old
			},
		},
		map[string]interface{}{"name": "col4"}, // Old has empty dataPolicyList -> should NOT merge empty map
	}

	mergeDataPoliciesIntoMap(old, new)

	col1 := new[0].(map[string]interface{})
	if _, ok := col1["dataPolicyList"]; !ok {
		t.Errorf("col1: expected dataPolicyList to be merged when omitted in new")
	}

	col2 := new[1].(map[string]interface{})
	if dpList, ok := col2["dataPolicyList"].(map[string]interface{}); !ok || len(dpList) != 0 {
		t.Errorf("col2: expected explicitly empty dataPolicyList map to remain empty, got %v", col2["dataPolicyList"])
	}
	if _, ok := col2["dataPolicies"]; ok {
		t.Errorf("col2: expected dataPolicies not to be merged when dataPolicyList is explicitly specified, got %v", col2["dataPolicies"])
	}

	col3 := new[2].(map[string]interface{})
	if dpList, ok := col3["dataPolicyList"].(map[string]interface{}); !ok {
		t.Errorf("col3: expected dataPolicyList map, got %v", col3["dataPolicyList"])
	} else if dpSlice, ok := dpList["dataPolicies"].([]interface{}); !ok || len(dpSlice) != 0 {
		t.Errorf("col3: expected explicitly empty dataPolicies slice to remain empty, got %v", dpList["dataPolicies"])
	}
	if _, ok := col3["dataPolicies"]; ok {
		t.Errorf("col3: expected dataPolicies not to be merged when dataPolicyList is explicitly specified, got %v", col3["dataPolicies"])
	}

	col4 := new[3].(map[string]interface{})
	if _, ok := col4["dataPolicyList"]; ok {
		t.Errorf("col4: expected empty dataPolicyList in old not to be merged into new, got %v", col4["dataPolicyList"])
	}
}

func TestClearRemovedDataPoliciesFromMap(t *testing.T) {
	t.Parallel()

	old := []interface{}{
		map[string]interface{}{
			"name": "col1",
			"dataPolicyList": map[string]interface{}{
				"dataPolicies": []interface{}{map[string]interface{}{"name": "p1"}},
			},
		},
		map[string]interface{}{
			"name":           "col2",
			"dataPolicyList": map[string]interface{}{}, // Already empty on backend
		},
		map[string]interface{}{
			"name": "col3", // Never had policies
		},
		map[string]interface{}{
			"name": "col4",
			"dataPolicies": []interface{}{map[string]interface{}{"name": "p4"}},
		},
		map[string]interface{}{
			"name": "nested_col",
			"fields": []interface{}{
				map[string]interface{}{
					"name": "sub1",
					"dataPolicyList": map[string]interface{}{
						"dataPolicies": []interface{}{map[string]interface{}{"name": "p1"}},
					},
				},
			},
		},
	}

	new := []interface{}{
		map[string]interface{}{"name": "col1"}, // Removed in authoritative mode -> should inject empty dataPolicyList: {}
		map[string]interface{}{"name": "col2"}, // Was already empty -> should NOT inject
		map[string]interface{}{"name": "col3"}, // Never had policies -> should NOT inject
		map[string]interface{}{
			"name":         "col4",
			"dataPolicies": []interface{}{}, // Explicit empty legacy slice -> should normalize to dataPolicyList: {}
		},
		map[string]interface{}{
			"name": "nested_col",
			"fields": []interface{}{
				map[string]interface{}{"name": "sub1"}, // Removed nested policy -> should inject empty dataPolicyList: {}
			},
		},
	}

	clearRemovedDataPoliciesFromMap(old, new)

	col1 := new[0].(map[string]interface{})
	if dpList, ok := col1["dataPolicyList"].(map[string]interface{}); !ok || len(dpList) != 0 {
		t.Errorf("col1: expected empty dataPolicyList map to be injected for authoritative removal, got %v", col1["dataPolicyList"])
	}

	col2 := new[1].(map[string]interface{})
	if _, ok := col2["dataPolicyList"]; ok {
		t.Errorf("col2: expected no dataPolicyList injection when old was already empty, got %v", col2["dataPolicyList"])
	}

	col3 := new[2].(map[string]interface{})
	if _, ok := col3["dataPolicyList"]; ok {
		t.Errorf("col3: expected no dataPolicyList injection when old had no policies, got %v", col3["dataPolicyList"])
	}

	col4 := new[3].(map[string]interface{})
	if _, ok := col4["dataPolicies"]; ok {
		t.Errorf("col4: expected empty legacy dataPolicies key to be deleted, got %v", col4["dataPolicies"])
	}
	if dpList, ok := col4["dataPolicyList"].(map[string]interface{}); !ok || len(dpList) != 0 {
		t.Errorf("col4: expected empty dataPolicyList map after normalizing empty dataPolicies slice, got %v", col4["dataPolicyList"])
	}

	nested := new[4].(map[string]interface{})["fields"].([]interface{})[0].(map[string]interface{})
	if dpList, ok := nested["dataPolicyList"].(map[string]interface{}); !ok || len(dpList) != 0 {
		t.Errorf("nested.sub1: expected empty dataPolicyList map to be injected for authoritative removal, got %v", nested["dataPolicyList"])
	}
}

func TestMergeDataPoliciesIntoMap(t *testing.T) {
	t.Parallel()

	old := []interface{}{
		map[string]interface{}{
			"name":         "col1",
			"dataPolicies": []interface{}{map[string]interface{}{"name": "p1"}},
		},
	}
	new := []interface{}{
		map[string]interface{}{"name": "col1"}, // Policy missing here
	}

	mergeDataPoliciesIntoMap(old, new)

	updatedField := new[0].(map[string]interface{})
	if _, ok := updatedField["dataPolicies"]; !ok {
		t.Errorf("dataPolicies were not merged into the map")
	}
}
