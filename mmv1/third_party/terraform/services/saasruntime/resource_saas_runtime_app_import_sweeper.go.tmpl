// GA promotion: remove the `ne ga` template guard around this file in the same
// change that promotes Saas to GA. Saas.yaml sweeper.dependencies lists
// SaasRuntimeAppImport; if the guard hides this sweeper in GA, the GA sweeper
// run fails with "has dependency ... not found" and aborts every GA sweeper.
func init() {
	sweeper.AddTestSweepersLegacy("SaasRuntimeAppImport", testSweepSaasRuntimeAppImport)
}

// testSweepSaasRuntimeAppImport deletes the UnitKinds and Releases that the service
// creates when a test Saas imports an Application Design Center template, in the
// sweep region and in global, and then the global Saas copies. After a successful
// import the service replicates the Saas, its UnitKinds and Releases to global;
// none of them are managed by Terraform, and a Saas cannot be deleted while
// UnitKinds reference it. A generated sweeper can't do this: UnitKind.saas is a
// full resource name, Releases have no saas field, and the deletes must be
// ordered. The sweep region's own Saas resources are left to the generated
// `google_saas_runtime_saas` sweeper, which runs after this one (Saas.yaml
// sweeper.dependencies). A UnitKind that other UnitKinds depend on is retried
// after the rest of its location's UnitKinds. Other failed deletes (e.g. an
// import still RUNNING, or UnitKind deletes not yet effective) are logged and
// retried on the next sweep.
func testSweepSaasRuntimeAppImport(region string) error {
	// After a successful import the service also replicates the UnitKinds and
	// Releases to locations/global, so sweep that location too.
	for _, location := range []string{region, "global"} {
		if err := testSweepSaasRuntimeAppImportLocation(location); err != nil {
			return err
		}
		if region == "global" {
			break
		}
	}
	return testSweepSaasRuntimeGlobalSaasCopies(region)
}

// testSweepSaasRuntimeGlobalSaasCopies deletes the global Saas copies of test Saas
// resources. The generated Saas sweeper only covers the sweep region.
func testSweepSaasRuntimeGlobalSaasCopies(region string) error {
	config, err := sweeper.SharedConfigForRegion(region)
	if err != nil {
		log.Printf("[INFO][SWEEPER_LOG] error getting shared config for region: %s", err)
		return err
	}
	if err := config.LoadAndValidate(context.Background()); err != nil {
		log.Printf("[INFO][SWEEPER_LOG] error loading: %s", err)
		return err
	}

	baseUrl := transport_tpg.BaseUrl(Product, config)
	saasList, err := listSaasRuntimeSweeperItems(config, fmt.Sprintf("%sprojects/%s/locations/global/saas", baseUrl, config.Project), "saas")
	if err != nil {
		log.Printf("[INFO][SWEEPER_LOG] error listing global Saas: %s", err)
		return nil
	}
	log.Printf("[INFO][SWEEPER_LOG] Found %d Saas in global", len(saasList))

	nonPrefixCount := 0
	for _, s := range saasList {
		name, _ := s["name"].(string)
		if name == "" || !sweeper.IsSweepableTestResource(tpgresource.GetResourceNameFromSelfLink(name)) {
			nonPrefixCount++
			continue
		}
		if _, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "DELETE",
			Project:   config.Project,
			RawURL:    baseUrl + name,
			UserAgent: config.UserAgent,
		}); err != nil {
			log.Printf("[INFO][SWEEPER_LOG] Error deleting global Saas %s (retried on the next sweep): %s", name, err)
		} else {
			log.Printf("[INFO][SWEEPER_LOG] Sent delete request for global Saas %s", name)
		}
	}
	if nonPrefixCount > 0 {
		log.Printf("[INFO][SWEEPER_LOG] %d global Saas were non-sweepable and skipped.", nonPrefixCount)
	}
	return nil
}

func testSweepSaasRuntimeAppImportLocation(region string) error {
	resourceName := "SaasRuntimeAppImport"
	log.Printf("[INFO][SWEEPER_LOG] Starting sweeper for %s", resourceName)

	config, err := sweeper.SharedConfigForRegion(region)
	if err != nil {
		log.Printf("[INFO][SWEEPER_LOG] error getting shared config for region: %s", err)
		return err
	}

	err = config.LoadAndValidate(context.Background())
	if err != nil {
		log.Printf("[INFO][SWEEPER_LOG] error loading: %s", err)
		return err
	}

	baseUrl := transport_tpg.BaseUrl(Product, config)
	locationUrl := fmt.Sprintf("%sprojects/%s/locations/%s", baseUrl, config.Project, region)

	unitKinds, err := listSaasRuntimeSweeperItems(config, locationUrl+"/unitKinds", "unitKinds")
	if err != nil {
		log.Printf("[INFO][SWEEPER_LOG] error listing UnitKinds: %s", err)
		return nil
	}
	log.Printf("[INFO][SWEEPER_LOG] Found %d UnitKinds in %s", len(unitKinds), region)

	deleteUnitKind := func(name string) error {
		_, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "DELETE",
			Project:   config.Project,
			RawURL:    baseUrl + name,
			UserAgent: config.UserAgent,
		})
		return err
	}
	// UnitKinds whose delete failed because other UnitKinds depend on them.
	var dependedOn []string

	nonPrefixCount := 0
	for _, uk := range unitKinds {
		name, _ := uk["name"].(string)
		saas, _ := uk["saas"].(string)
		if name == "" || !sweeper.IsSweepableTestResource(tpgresource.GetResourceNameFromSelfLink(saas)) {
			nonPrefixCount++
			continue
		}

		// Releases block UnitKind deletion, and the default release can't be deleted.
		if dr, _ := uk["defaultRelease"].(string); dr != "" {
			_, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
				Config:    config,
				Method:    "PATCH",
				Project:   config.Project,
				RawURL:    baseUrl + name + "?updateMask=defaultRelease",
				UserAgent: config.UserAgent,
				Body:      map[string]interface{}{"defaultRelease": ""},
			})
			if err != nil {
				log.Printf("[INFO][SWEEPER_LOG] Error clearing defaultRelease of %s: %s", name, err)
				continue
			}
		}

		filter := url.QueryEscape(fmt.Sprintf("unit_kind=%q", name))
		releases, err := listSaasRuntimeSweeperItems(config, locationUrl+"/releases?filter="+filter, "releases")
		if err != nil {
			log.Printf("[INFO][SWEEPER_LOG] Error listing Releases of %s: %s", name, err)
			continue
		}
		for _, r := range releases {
			rn, _ := r["name"].(string)
			if rn == "" {
				continue
			}
			if _, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
				Config:    config,
				Method:    "DELETE",
				Project:   config.Project,
				RawURL:    baseUrl + rn,
				UserAgent: config.UserAgent,
			}); err != nil {
				log.Printf("[INFO][SWEEPER_LOG] Error deleting Release %s: %s", rn, err)
			} else {
				log.Printf("[INFO][SWEEPER_LOG] Sent delete request for Release %s", rn)
			}
		}

		if err := deleteUnitKind(name); err != nil {
			if isSaasRuntimeUnitKindDependencyError(err) {
				dependedOn = append(dependedOn, name)
			}
			log.Printf("[INFO][SWEEPER_LOG] Error deleting UnitKind %s: %s", name, err)
		} else {
			log.Printf("[INFO][SWEEPER_LOG] Sent delete request for UnitKind %s", name)
		}
	}

	// Retry the UnitKinds that others depend on, now that the dependents'
	// deletes have been sent. UnitKind deletion isn't immediate, so wait
	// between passes.
	for pass := 1; pass <= 5 && len(dependedOn) > 0; pass++ {
		time.Sleep(10 * time.Second)
		var still []string
		for _, name := range dependedOn {
			if err := deleteUnitKind(name); err != nil {
				if isSaasRuntimeUnitKindDependencyError(err) {
					still = append(still, name)
				}
				log.Printf("[INFO][SWEEPER_LOG] Error deleting UnitKind %s (retry pass %d): %s", name, pass, err)
			} else {
				log.Printf("[INFO][SWEEPER_LOG] Sent delete request for UnitKind %s (retry pass %d)", name, pass)
			}
		}
		dependedOn = still
	}
	if len(dependedOn) > 0 {
		log.Printf("[INFO][SWEEPER_LOG] %d UnitKinds still have dependents; retried on the next sweep.", len(dependedOn))
	}

	if nonPrefixCount > 0 {
		log.Printf("[INFO][SWEEPER_LOG] %d UnitKinds were non-sweepable and skipped.", nonPrefixCount)
	}

	return nil
}

// isSaasRuntimeUnitKindDependencyError reports whether a UnitKind delete was
// rejected because another UnitKind depends on it.
func isSaasRuntimeUnitKindDependencyError(err error) bool {
	return strings.Contains(err.Error(), "with a dependency on UnitKind")
}

// listSaasRuntimeSweeperItems lists all pages of a SaaS Runtime collection.
func listSaasRuntimeSweeperItems(config *transport_tpg.Config, listUrl, key string) ([]map[string]interface{}, error) {
	var items []map[string]interface{}
	pageToken := ""
	for {
		u := listUrl
		if pageToken != "" {
			u, _ = transport_tpg.AddQueryParams(u, map[string]string{"pageToken": pageToken})
		}
		res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "GET",
			Project:   config.Project,
			RawURL:    u,
			UserAgent: config.UserAgent,
		})
		if err != nil {
			return nil, err
		}
		if l, ok := res[key].([]interface{}); ok {
			for _, i := range l {
				if m, ok := i.(map[string]interface{}); ok {
					items = append(items, m)
				}
			}
		}
		pageToken, _ = res["nextPageToken"].(string)
		if pageToken == "" {
			return items, nil
		}
	}
}
