func TestAccSaasRuntimeSaas_update(t *testing.T) {
	t.Parallel()
	resourcemanager.BootstrapIamMembers(t, []resourcemanager.IamMember{
		{
			Member: "serviceAccount:service-{project_number}@gcp-sa-saasservicemgmt.iam.gserviceaccount.com",
			Role:   "roles/saasservicemgmt.serviceAgent",
		},
	})

	context := map[string]interface{}{
		"random_suffix": acctest.RandString(t, 10),
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		Steps: []resource.TestStep{
			{
				Config: testAccSaasRuntimeSaas_basic(context),
			},
			{
				ResourceName:      "google_saas_runtime_saas.example",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{
					"annotations", "labels", "location", "saas_id", "terraform_labels",
					// etag and update_time are refreshed by the service's asynchronous
					// reconciliation after Create/Update returns.
					"etag", "update_time",
					// Set asynchronously by the service after Create.
					"blueprint_repo",
					// Set asynchronously by the service after Create.
					"state",
					// Set asynchronously by the service after Create.
					"conditions",
				},
			},
			{
				Config: testAccSaasRuntimeSaas_update(context),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: []plancheck.PlanCheck{
						plancheck.ExpectResourceAction("google_saas_runtime_saas.example", plancheck.ResourceActionUpdate),
					},
				},
			},
			{
				ResourceName:      "google_saas_runtime_saas.example",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{
					"annotations", "labels", "location", "saas_id", "terraform_labels",
					// etag and update_time are refreshed by the service's asynchronous
					// reconciliation after Create/Update returns.
					"etag", "update_time",
					// Set asynchronously by the service after Create.
					"blueprint_repo",
					// Set asynchronously by the service after Create.
					"state",
					// Set asynchronously by the service after Create.
					"conditions",
				},
			},
		},
	})
}

