// TestAccSaasRuntimeSaas_applicationTemplateUpdate imports the bootstrapped ADC
// composite template "tf-bootstrap-composite" (revisions r-1 and r-2, one
// component "sa-comp-1") from Space "tf-bootstrap-space" in the test project.
func TestAccSaasRuntimeSaas_applicationTemplateUpdate(t *testing.T) {
	t.Parallel()
	resourcemanager.BootstrapIamMembers(t, []resourcemanager.IamMember{
		{
			Member: "serviceAccount:service-{project_number}@gcp-sa-saasservicemgmt.iam.gserviceaccount.com",
			Role:   "roles/saasservicemgmt.serviceAgent",
		},
	})

	project := envvar.GetTestProjectFromEnv()
	template := fmt.Sprintf("projects/%s/locations/us-central1/spaces/tf-bootstrap-space/applicationTemplates/tf-bootstrap-composite", project)
	suffix := acctest.RandString(t, 10)
	saasName := fmt.Sprintf("projects/%s/locations/us-central1/saas/tf-test-app-saas%s", project, suffix)

	context := map[string]interface{}{
		"random_suffix": suffix,
		"template":      template,
		"revision":      template + "/revisions/r-1",
	}
	contextUpdate := map[string]interface{}{
		"random_suffix": suffix,
		"template":      template,
		"revision":      template + "/revisions/r-2",
	}

	importStateVerifyIgnore := []string{
		// Same as TestAccSaasRuntimeSaas_update.
		"annotations", "labels", "location", "saas_id", "terraform_labels",
		// Defensive: the service may write these asynchronously after the
		// import (not seen in 4 runs).
		"etag", "update_time", "conditions",
		// Output only and set by the server while an import runs.
		"application_template.0.sync_operation",
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck: func() {
			acctest.AccTestPreCheck(t)
			testAccSaasRuntimeSaasCheckAdcFixture(t, template+"/revisions/r-1")
		},
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		CheckDestroy:             testAccCheckSaasRuntimeSaasDestroyProducer(t),
		Steps: []resource.TestStep{
			{
				Config: testAccSaasRuntimeSaas_applicationTemplate(context),
				Check:  resource.TestCheckResourceAttr("google_saas_runtime_saas.example", "state", "STATE_ACTIVE"),
			},
			{
				ResourceName:            "google_saas_runtime_saas.example",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: importStateVerifyIgnore,
			},
			{
				Config: testAccSaasRuntimeSaas_applicationTemplate(contextUpdate),
				ConfigPlanChecks: resource.ConfigPlanChecks{
					PreApply: []plancheck.PlanCheck{
						plancheck.ExpectResourceAction("google_saas_runtime_saas.example", plancheck.ResourceActionUpdate),
					},
				},
				Check: resource.ComposeTestCheckFunc(
					resource.TestCheckResourceAttr("google_saas_runtime_saas.example", "state", "STATE_ACTIVE"),
					testAccCheckSaasRuntimeSaasImportedReleases(t, saasName, "sa-comp-1"),
				),
			},
			{
				ResourceName:            "google_saas_runtime_saas.example",
				ImportState:             true,
				ImportStateVerify:       true,
				ImportStateVerifyIgnore: importStateVerifyIgnore,
			},
			{
				// The imported UnitKinds and Releases aren't managed by Terraform and
				// block the deletion of the Saas, so delete them before destroy.
				PreConfig: func() { testAccSaasRuntimeSaasDeleteImportedResources(t, saasName) },
				Config:    testAccSaasRuntimeSaas_applicationTemplate(contextUpdate),
			},
		},
	})
}

