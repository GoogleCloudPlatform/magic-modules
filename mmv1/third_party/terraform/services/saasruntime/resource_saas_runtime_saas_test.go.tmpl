// testAccSaasRuntimeSaasCheckAdcFixture fails the test when the bootstrapped ADC
// template revision is missing or inaccessible. The fixture is created once per
// test project (b/571467075, Detailed instructions step 1). The test must fail, not
// skip, without it. In PreCheck the config from acctest.GoogleProviderConfig(t)
// isn't VCR-wrapped yet, so this GET runs live and unrecorded, also in replay.
func testAccSaasRuntimeSaasCheckAdcFixture(t *testing.T, revision string) {
	config := acctest.GoogleProviderConfig(t)
	_, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   config.Project,
		RawURL:    "https://designcenter.googleapis.com/v1/" + revision,
		UserAgent: config.UserAgent,
	})
	if err != nil {
		t.Fatalf("ADC fixture missing or inaccessible: see b/571467075, Detailed instructions step 1: %s", err)
	}
}

// testAccSaasRuntimeSaasImportedUnitKinds lists the UnitKinds that reference the Saas.
func testAccSaasRuntimeSaasImportedUnitKinds(config *transport_tpg.Config, saasName string) ([]map[string]interface{}, error) {
	location := strings.SplitN(saasName, "/saas/", 2)[0]
	u := transport_tpg.BaseUrl(saasruntime.Product, config) + location + "/unitKinds?filter=" + url.QueryEscape(fmt.Sprintf("saas=%q", saasName))
	return testAccSaasRuntimeListAll(config, u, "unitKinds")
}

// testAccSaasRuntimeUnitKindReleases lists the Releases of a UnitKind.
func testAccSaasRuntimeUnitKindReleases(config *transport_tpg.Config, unitKind string) ([]map[string]interface{}, error) {
	location := strings.SplitN(unitKind, "/unitKinds/", 2)[0]
	u := transport_tpg.BaseUrl(saasruntime.Product, config) + location + "/releases?filter=" + url.QueryEscape(fmt.Sprintf("unit_kind=%q", unitKind))
	return testAccSaasRuntimeListAll(config, u, "releases")
}

func testAccSaasRuntimeListAll(config *transport_tpg.Config, listUrl, key string) ([]map[string]interface{}, error) {
	var items []map[string]interface{}
	pageToken := ""
	for {
		u := listUrl
		if pageToken != "" {
			u, _ = transport_tpg.AddQueryParams(u, map[string]string{"pageToken": pageToken})
		}
		res, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "GET",
			Project:   config.Project,
			RawURL:    u,
			UserAgent: config.UserAgent,
		})
		if err != nil {
			return nil, err
		}
		if l, ok := res[key].([]interface{}); ok {
			for _, i := range l {
				if m, ok := i.(map[string]interface{}); ok {
					items = append(items, m)
				}
			}
		}
		pageToken, _ = res["nextPageToken"].(string)
		if pageToken == "" {
			return items, nil
		}
	}
}

// testAccCheckSaasRuntimeSaasImportedReleases checks that the import created
// Releases whose applicationTemplateComponent.component is the expected root
// module. This is a service-level check: the Release field is output only.
func testAccCheckSaasRuntimeSaasImportedReleases(t *testing.T, saasName, component string) resource.TestCheckFunc {
	return func(s *terraform.State) error {
		config := acctest.GoogleProviderConfig(t)
		unitKinds, err := testAccSaasRuntimeSaasImportedUnitKinds(config, saasName)
		if err != nil {
			return err
		}
		if len(unitKinds) == 0 {
			return fmt.Errorf("no imported UnitKinds found for Saas %s", saasName)
		}
		for _, uk := range unitKinds {
			name, _ := uk["name"].(string)
			releases, err := testAccSaasRuntimeUnitKindReleases(config, name)
			if err != nil {
				return err
			}
			if len(releases) == 0 {
				return fmt.Errorf("no Releases found for imported UnitKind %s", name)
			}
			for _, r := range releases {
				atc, _ := r["applicationTemplateComponent"].(map[string]interface{})
				if got, _ := atc["component"].(string); got != component {
					return fmt.Errorf("Release %v has applicationTemplateComponent.component %q, want %q", r["name"], got, component)
				}
			}
		}
		return nil
	}
}

// testAccSaasRuntimeSaasDeleteImportedResources deletes the UnitKinds that the
// import created for the Saas, and their Releases. After a successful import the
// service also replicates the Saas, its UnitKinds and Releases to
// locations/global. Deleting the regional Saas doesn't remove those copies, so
// this deletes them too, including the global Saas copy. Retries poll at
// config.PollInterval (10s live, 10ms in VCR replay).
func testAccSaasRuntimeSaasDeleteImportedResources(t *testing.T, saasName string) {
	config := acctest.GoogleProviderConfig(t)
	baseUrl := transport_tpg.BaseUrl(saasruntime.Product, config)
	// retryUntil retries f at config.PollInterval until it returns nil or
	// timeout elapses. ok is wrapped in "pending" errors so Retry keeps polling.
	retryUntil := func(timeout time.Duration, f func() error) error {
		return transport_tpg.Retry(transport_tpg.RetryOptions{
			Timeout:      timeout,
			PollInterval: config.PollInterval,
			RetryFunc:    f,
			ErrorRetryPredicates: []transport_tpg.RetryErrorPredicateFunc{
				func(err error) (bool, string) {
					if strings.HasPrefix(err.Error(), "pending: ") {
						return true, "pending"
					}
					return false, ""
				},
			},
		})
	}
	send := func(method, u string, body map[string]interface{}) error {
		_, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    method,
			Project:   config.Project,
			RawURL:    u,
			UserAgent: config.UserAgent,
			Body:      body,
		})
		return err
	}

	parts := strings.SplitN(saasName, "/locations/", 2)
	globalSaas := parts[0] + "/locations/global/" + strings.SplitN(parts[1], "/", 2)[1]

	for _, saas := range []string{saasName, globalSaas} {
		unitKinds, err := testAccSaasRuntimeSaasImportedUnitKinds(config, saas)
		if err != nil {
			t.Fatalf("Error listing imported UnitKinds: %s", err)
		}
		for _, uk := range unitKinds {
			name, _ := uk["name"].(string)
			if err := send("PATCH", baseUrl+name+"?updateMask=defaultRelease", map[string]interface{}{"defaultRelease": ""}); err != nil && !transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
				t.Fatalf("Error clearing defaultRelease of %s: %s", name, err)
			}
			releases, err := testAccSaasRuntimeUnitKindReleases(config, name)
			if err != nil {
				t.Fatalf("Error listing Releases of %s: %s", name, err)
			}
			for _, r := range releases {
				rn, _ := r["name"].(string)
				if err := send("DELETE", baseUrl+rn, nil); err != nil && !transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
					t.Fatalf("Error deleting Release %s: %s", rn, err)
				}
			}
			// Release deletion may take a moment to unblock the UnitKind deletion.
			if err := retryUntil(2*time.Minute, func() error {
				if err := send("DELETE", baseUrl+name, nil); err != nil && !transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
					return fmt.Errorf("pending: %s", err)
				}
				return nil
			}); err != nil {
				t.Fatalf("Error deleting UnitKind %s: %s", name, err)
			}
			if err := retryUntil(3*time.Minute, func() error {
				if err := send("GET", baseUrl+name, nil); !transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
					return fmt.Errorf("pending: UnitKind %s still exists", name)
				}
				return nil
			}); err != nil {
				t.Fatalf("UnitKind %s still exists after deletion: %s", name, err)
			}
		}
	}

	// Terraform deletes the regional Saas; delete the global copy here.
	if err := retryUntil(2*time.Minute, func() error {
		if err := send("DELETE", baseUrl+globalSaas, nil); err != nil && !transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
			return fmt.Errorf("pending: %s", err)
		}
		return nil
	}); err != nil {
		t.Fatalf("Error deleting Saas %s: %s", globalSaas, err)
	}
}
