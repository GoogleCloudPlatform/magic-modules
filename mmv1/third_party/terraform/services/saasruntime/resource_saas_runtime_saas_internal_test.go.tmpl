import (
	"fmt"
	"testing"

	"google.golang.org/api/googleapi"
)

func TestIsSaasRuntimeSaasImportRunningError(t *testing.T) {
	t.Parallel()

	const reason = "waiting for Saas application template import to finish"
	cases := map[string]struct {
		err            error
		expected       bool
		expectedReason string
	}{
		"delete while RUNNING": {
			err:            &googleapi.Error{Code: 400, Message: `cannot delete SaaS "projects/p/locations/us-central1/saas/s" because it is in RUNNING state`},
			expected:       true,
			expectedReason: reason,
		},
		"template update while RUNNING": {
			err:            &googleapi.Error{Code: 400, Message: "Cannot update application template or revision when state is RUNNING failed precondition"},
			expected:       true,
			expectedReason: reason,
		},
		"wrapped delete while RUNNING": {
			err:            fmt.Errorf(`Error when reading or editing Saas: googleapi: Error 400: cannot delete SaaS "x" because it is in RUNNING state`),
			expected:       true,
			expectedReason: reason,
		},
		"other 400": {
			err: &googleapi.Error{Code: 400, Message: "Some other 400 error"},
		},
		"nil": {},
	}
	for tn, tc := range cases {
		t.Run(tn, func(t *testing.T) {
			got, gotReason := IsSaasRuntimeSaasImportRunningError(tc.err)
			if got != tc.expected || gotReason != tc.expectedReason {
				t.Errorf("IsSaasRuntimeSaasImportRunningError(%v) = (%v, %q), want (%v, %q)", tc.err, got, gotReason, tc.expected, tc.expectedReason)
			}
		})
	}
}
