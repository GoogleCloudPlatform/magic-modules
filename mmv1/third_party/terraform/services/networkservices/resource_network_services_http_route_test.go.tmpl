package networkservices_test
{{- if ne $.TargetVersionName "ga" }}

import (
	"fmt"
	"github.com/hashicorp/terraform-provider-google/google/acctest"
	_ "github.com/hashicorp/terraform-provider-google/google/services/networkservices"
	_ "github.com/hashicorp/terraform-provider-google/google/services/compute"
	"testing"

	"github.com/hashicorp/terraform-plugin-testing/helper/resource"
)

func TestAccNetworkServicesHttpRoute_update(t *testing.T) {
	t.Parallel()

	httpRouteName := fmt.Sprintf("tf-test-http-route-%s", acctest.RandString(t, 10))
	httpServiceName := fmt.Sprintf("tf-test-http-service-%s", acctest.RandString(t, 10))
	httpHealthCheckName := fmt.Sprintf("tf-test-http-healthcheck-%s", acctest.RandString(t, 10))

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:     func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderFactories(t),
		CheckDestroy: testAccCheckNetworkServicesHttpRouteDestroyProducer(t),
		Steps: []resource.TestStep{
			{
				Config: testAccNetworkServicesHttpRoute_basic(httpRouteName),
			},
			{
				ResourceName:      "google_network_services_http_route.foobar",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{"labels", "terraform_labels"},
			},
			{
				Config: testAccNetworkServicesHttpRoute_update(httpRouteName, httpServiceName, httpHealthCheckName),
			},
			{
				ResourceName:      "google_network_services_http_route.foobar",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{"labels", "terraform_labels"},
			},
		},
	})
}

func testAccNetworkServicesHttpRoute_basic(httpRouteName string) string {
	return fmt.Sprintf(`
resource "google_network_services_http_route" "foobar" {
  name                   = "%s"
  description             = "my description"
  hostnames               = ["example"]
  rules                   {
    matches {
      query_parameters {
        query_parameter = "key"
        exact_match = "value"
      }
      full_path_match = "example"
    }
  }
}
`, httpRouteName)
}

func testAccNetworkServicesHttpRoute_update(httpRouteName string, httpServiceName string, httpHealthCheckName string) string {
	return fmt.Sprintf(`
resource "google_compute_backend_service" "foo" {
  name                  = "%s"
  load_balancing_scheme = "INTERNAL_SELF_MANAGED"
  health_checks         = [google_compute_health_check.bar.id]
}

resource "google_compute_health_check" "bar" {
  name = "%s"

  http_health_check {
    port = 80
  }
}

resource "google_network_services_http_route" "foobar" {
  name        = "%s"
  description = "update description"
  labels      = {
    foo = "bar"
  }
  hostnames               = ["example"]
  rules                   {
    matches {
      query_parameters {
        query_parameter = "key"
        exact_match = "value"
      }
      full_path_match = "example"
    }
    action {
      destinations {
        service_name = google_compute_backend_service.foo.id
        weight = 1
        request_header_modifier {
          set = { "version": "1" }
          add = { "minor-version": "1" }
          remove = ["arg"]
        }
        response_header_modifier {
          set = { "version": "1" }
          add = { "minor-version": "1" }
          remove = ["removearg"]
        }
      }
      request_mirror_policy {
        destination {
          service_name = google_compute_backend_service.foo.id
        }
        mirror_percent = 33.3
      }
    }
  }
  rules                   {
    matches {
      prefix_match = "/maintenance"
    }
    action {
      direct_response {
        status = 503
        string_body = "down for maintenance"
      }
    }
  }
}
`, httpServiceName, httpHealthCheckName, httpRouteName)
}

{{ end }}
