func TestAccDatastreamConnectionProfile_dataverse(t *testing.T) {
	t.Parallel()

	context := map[string]interface{}{
		"random_suffix": acctest.RandString(t, 10),
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		CheckDestroy:             testAccCheckDatastreamConnectionProfileDestroyProducer(t),
		Steps: []resource.TestStep{
			{
				Config: testAccDatastreamConnectionProfile_dataverseBasic(context),
			},
			{
				ResourceName:      "google_datastream_connection_profile.default",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{
					"create_without_validation",
					"location",
					"connection_profile_id",
					// raw_value is input-only and omitted by the Datastream API on GET responses.
					"dataverse_profile.0.oauth_client_credentials.0.client_secret.0.raw_value",
				},
			},
			{
				Config: testAccDatastreamConnectionProfile_dataverseUpdate(context),
			},
			{
				ResourceName:      "google_datastream_connection_profile.default",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{
					"create_without_validation",
					"location",
					"connection_profile_id",
				},
			},
		},
	})
}

func testAccDatastreamConnectionProfile_dataverseBasic(context map[string]interface{}) string {
	return acctest.Nprintf(`
resource "google_datastream_connection_profile" "default" {
  provider                  = google-beta
  display_name              = "tf-dataverse-profile"
  location                  = "us-central1"
  connection_profile_id     = "tf-test-dv-cp-%{random_suffix}"
  create_without_validation = true

  dataverse_profile {
    tenant_id       = "00000000-0000-0000-0000-000000000000"
    environment_url = "org123.crm.dynamics.com"
    oauth_client_credentials {
      client_id = "11111111-1111-1111-1111-111111111111"
      client_secret {
        raw_value = "my-raw-client-secret"
      }
    }
  }
}
`, context)
}

func testAccDatastreamConnectionProfile_dataverseUpdate(context map[string]interface{}) string {
	return acctest.Nprintf(`
data "google_project" "project" {
  provider = google-beta
}

resource "google_secret_manager_secret" "dv_secret" {
  provider  = google-beta
  project   = data.google_project.project.project_id
  secret_id = "tf-test-dv-secret-%{random_suffix}"
  replication {
    auto {}
  }
}

resource "google_secret_manager_secret_version" "dv_secret_version" {
  provider    = google-beta
  secret      = google_secret_manager_secret.dv_secret.id
  secret_data = "my-secret-value"
}

resource "google_datastream_connection_profile" "default" {
  provider                  = google-beta
  display_name              = "tf-dataverse-profile-updated"
  location                  = "us-central1"
  connection_profile_id     = "tf-test-dv-cp-%{random_suffix}"
  create_without_validation = true

  dataverse_profile {
    tenant_id       = "22222222-2222-2222-2222-222222222222"
    environment_url = "org456.crm.dynamics.com"
    oauth_client_credentials {
      client_id = "33333333-3333-3333-3333-333333333333"
      client_secret {
        secret_version = google_secret_manager_secret_version.dv_secret_version.id
      }
    }
  }

  depends_on = [
    google_secret_manager_secret_version.dv_secret_version,
  ]
}
`, context)
}

