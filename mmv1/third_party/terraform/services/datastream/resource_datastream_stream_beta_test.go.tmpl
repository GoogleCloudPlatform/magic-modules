package datastream_test
{{- if ne $.TargetVersionName "ga" }}

import (
	"testing"

	"github.com/hashicorp/terraform-plugin-testing/helper/resource"
	"github.com/hashicorp/terraform-provider-google/google/acctest"
	_ "github.com/hashicorp/terraform-provider-google/google/services/datastream"
	_ "github.com/hashicorp/terraform-provider-google/google/services/storage"
)

func TestAccDatastreamStream_saasSources(t *testing.T) {
	t.Parallel()

	context := map[string]interface{}{
		"random_suffix": acctest.RandString(t, 10),
	}

	acctest.VcrTest(t, resource.TestCase{
		PreCheck:                 func() { acctest.AccTestPreCheck(t) },
		ProtoV5ProviderFactories: acctest.ProtoV5ProviderBetaFactories(t),
		CheckDestroy:             testAccCheckDatastreamStreamDestroyProducer(t),
		Steps: []resource.TestStep{
			{
				Config: testAccDatastreamStream_dataverseSource(context),
			},
			{
				ResourceName:      "google_datastream_stream.default",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{
					"create_without_validation",
					"location",
					"stream_id",
				},
			},
			{
				Config: testAccDatastreamStream_sfmcSource(context),
			},
			{
				ResourceName:      "google_datastream_stream.default",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{
					"create_without_validation",
					"location",
					"stream_id",
				},
			},
			{
				Config: testAccDatastreamStream_serviceNowSource(context),
			},
			{
				ResourceName:      "google_datastream_stream.default",
				ImportState:       true,
				ImportStateVerify: true,
				ImportStateVerifyIgnore: []string{
					"create_without_validation",
					"location",
					"stream_id",
				},
			},
		},
	})
}

func testAccDatastreamStream_dataverseSource(context map[string]interface{}) string {
	return acctest.Nprintf(`
resource "google_datastream_connection_profile" "dv_source" {
  provider                  = google-beta
  display_name              = "tf-dv-source"
  location                  = "us-central1"
  connection_profile_id     = "tf-test-dv-src-%{random_suffix}"
  create_without_validation = true

  dataverse_profile {
    tenant_id       = "00000000-0000-0000-0000-000000000000"
    environment_url = "org123.crm.dynamics.com"
    oauth_client_credentials {
      client_id = "11111111-1111-1111-1111-111111111111"
      client_secret {
        raw_value = "raw-secret"
      }
    }
  }
}

resource "google_storage_bucket" "bucket" {
  provider                    = google-beta
  name                        = "tf-test-saas-gcs-bucket-%{random_suffix}"
  location                    = "US"
  uniform_bucket_level_access = true
}

resource "google_datastream_connection_profile" "gcs_destination" {
  provider                  = google-beta
  display_name              = "tf-gcs-dest"
  location                  = "us-central1"
  connection_profile_id     = "tf-test-saas-dst-%{random_suffix}"
  create_without_validation = true

  gcs_profile {
    bucket    = google_storage_bucket.bucket.name
    root_path = "/path"
  }
}

resource "google_datastream_stream" "default" {
  provider                  = google-beta
  display_name              = "tf-dataverse-stream"
  location                  = "us-central1"
  stream_id                 = "tf-test-saas-stream-%{random_suffix}"
  create_without_validation = true

  source_config {
    source_connection_profile = google_datastream_connection_profile.dv_source.id
    dataverse_source_config {
      polling_interval = "600s"
      include_objects {
        objects {
          object_name = "account"
          properties {
            property_name = "accountid"
            primary_key   = true
          }
          properties {
            property_name = "name"
          }
        }
      }
      exclude_objects {
        objects {
          object_name = "account"
          properties {
            property_name = "telephone1"
          }
        }
      }
    }
  }

  destination_config {
    destination_connection_profile = google_datastream_connection_profile.gcs_destination.id
    gcs_destination_config {
      path = "/mydata"
      avro_file_format {}
    }
  }

  backfill_all {
    saas_excluded_objects {
      objects {
        object_name = "account"
        properties {
          property_name = "address"
          properties {
            property_name = "location"
            properties {
              property_name = "zip_code"
              primary_key   = false
            }
          }
        }
      }
    }
  }
}
`, context)
}

