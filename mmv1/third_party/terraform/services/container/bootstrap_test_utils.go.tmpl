package container

import (
	"fmt"
	"log"
	"testing"
	"time"

	"github.com/hashicorp/terraform-provider-google/google/envvar"
	tpgcompute "github.com/hashicorp/terraform-provider-google/google/services/compute"
	transport_tpg "github.com/hashicorp/terraform-provider-google/google/transport"
)

const SharedGKEClusterPrefix = "tf-bootstrap-gke-"

// BootstrapSharedGKECluster returns the ID of a shared GKE cluster in us-east1,
// creating it if it hasn't been created in the test project yet.
func BootstrapSharedGKECluster(t *testing.T, testId string) string {
	project := envvar.GetTestProjectFromEnv()
	location := "us-east1"
	clusterName := SharedGKEClusterPrefix + testId
	parent := fmt.Sprintf("projects/%s/locations/%s", project, location)
	clusterId := fmt.Sprintf("%s/clusters/%s", parent, clusterName)

	config := transport_tpg.BootstrapConfig(t)
	if config == nil {
		return ""
	}

	baseUrl := transport_tpg.BaseUrl(Product, config)
	clusterURL := fmt.Sprintf("%s%s", baseUrl, clusterId)
	createURL := fmt.Sprintf("%s%s/clusters", baseUrl, parent)

	getCluster := func() (map[string]interface{}, error) {
		return transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "GET",
			Project:   project,
			RawURL:    clusterURL,
			UserAgent: config.UserAgent,
		})
	}

	log.Printf("[DEBUG] Getting shared test GKE cluster %q", clusterId)
	cluster, err := getCluster()
	if err == nil && cluster != nil && (cluster["status"] == "ERROR" || cluster["status"] == "DEGRADED") {
		log.Printf("[DEBUG] Shared test GKE cluster %q is in %v state (%v), deleting before recreating", clusterId, cluster["status"], cluster["statusMessage"])
		delOp, delErr := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "DELETE",
			Project:   project,
			RawURL:    clusterURL,
			UserAgent: config.UserAgent,
		})
		if delErr == nil {
			err = ContainerOperationWait(config, delOp, project, location, "deleting unhealthy shared test GKE cluster", config.UserAgent, 30*time.Minute)
			if err != nil {
				t.Fatalf("Error waiting for unhealthy shared test GKE cluster %q deletion: %s", clusterId, err)
			}
		} else if !transport_tpg.IsGoogleApiErrorWithCode(delErr, 404) && !transport_tpg.IsGoogleApiErrorWithCode(delErr, 409) && !transport_tpg.IsGoogleApiErrorWithCode(delErr, 400) {
			t.Fatalf("Error deleting unhealthy shared test GKE cluster %q: %s", clusterId, delErr)
		}
		cluster, err = getCluster()
	}

	stopDeadline := time.Now().Add(30 * time.Minute)
	for err == nil && cluster != nil && cluster["status"] == "STOPPING" {
		if time.Now().After(stopDeadline) {
			t.Fatalf("Timed out waiting for shared test GKE cluster %q deletion to finish", clusterId)
		}
		log.Printf("[DEBUG] Shared test GKE cluster %q is in status STOPPING, waiting 15s for deletion...", clusterId)
		time.Sleep(15 * time.Second)
		cluster, err = getCluster()
	}

	if err != nil && transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
		log.Printf("[DEBUG] GKE cluster %q not found, bootstrapping", clusterId)

		networkName := tpgcompute.BootstrapSharedTestNetwork(t, testId)
		subnetworkName := tpgcompute.BootstrapSubnetInRegion(t, testId, networkName, location, "10.79.0.0/20")

		req := map[string]interface{}{
			"cluster": map[string]interface{}{
				"name":             clusterName,
				"locations":        []string{"us-east1-b"},
				"initialNodeCount": 1,
				"nodeConfig": map[string]interface{}{
					"machineType": "n4-standard-2",
				},
				"workloadIdentityConfig": map[string]interface{}{
					"workloadPool": fmt.Sprintf("%s.svc.id.goog", project),
				},
				"addonsConfig": map[string]interface{}{
					"gkeBackupAgentConfig": map[string]interface{}{
						"enabled": true,
					},
				},
				"network":    networkName,
				"subnetwork": subnetworkName,
			},
		}

		op, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "POST",
			Project:   project,
			RawURL:    createURL,
			UserAgent: config.UserAgent,
			Body:      req,
		})
		if err != nil {
			if !transport_tpg.IsGoogleApiErrorWithCode(err, 409) {
				t.Fatalf("Error bootstrapping shared test GKE cluster %q: %s", clusterId, err)
			}
			log.Printf("[DEBUG] GKE cluster %q creation already in progress, waiting for readiness", clusterId)
		} else {
			log.Printf("[DEBUG] Waiting for GKE cluster %q creation to finish", clusterId)
			err = ContainerOperationWait(config, op, project, location, "bootstrapping shared test GKE cluster", config.UserAgent, 30*time.Minute)
			if err != nil {
				t.Fatalf("Error waiting for shared test GKE cluster %q creation: %s", clusterId, err)
			}
		}

		cluster, err = getCluster()
	}

	if err != nil {
		t.Fatalf("Error getting shared test GKE cluster %q: %s", clusterId, err)
	}
	if cluster == nil {
		t.Fatalf("Error getting shared test GKE cluster %q: is nil", clusterId)
	}

	deadline := time.Now().Add(30 * time.Minute)
	for cluster["status"] == "PROVISIONING" || cluster["status"] == "RECONCILING" {
		if time.Now().After(deadline) {
			t.Fatalf("Timed out waiting for shared test GKE cluster %q to leave status %v", clusterId, cluster["status"])
		}
		log.Printf("[DEBUG] Shared test GKE cluster %q is in status %v, waiting 15s...", clusterId, cluster["status"])
		time.Sleep(15 * time.Second)
		cluster, err = getCluster()
		if err != nil {
			t.Fatalf("Error getting shared test GKE cluster %q while waiting for readiness: %s", clusterId, err)
		}
	}

	if cluster["status"] != "RUNNING" {
		t.Fatalf("Shared test GKE cluster %q is in unexpected status %v: %v", clusterId, cluster["status"], cluster["statusMessage"])
	}

	return clusterId
}
