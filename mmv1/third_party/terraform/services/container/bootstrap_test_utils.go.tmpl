package container

import (
	"fmt"
	"log"
	"strings"
	"testing"
	"time"

{{- if eq $.TargetVersionName "ga" }}
	"google.golang.org/api/container/v1"
{{- else }}
	container "google.golang.org/api/container/v1beta1"
{{- end }}

	"github.com/hashicorp/terraform-provider-google/google/envvar"
	tpgcompute "github.com/hashicorp/terraform-provider-google/google/services/compute"
	transport_tpg "github.com/hashicorp/terraform-provider-google/google/transport"
)

const SharedGKEClusterPrefix = "tf-bootstrap-gke-"

// BootstrapSharedGKECluster returns the ID of a shared GKE cluster in us-east1,
// creating it if it hasn't been created in the test project yet.
func BootstrapSharedGKECluster(t *testing.T, testId string) string {
	return BootstrapSharedGKEClusterInLocation(t, testId, "us-east1")
}

// BootstrapSharedGKEClusterInLocation returns the ID of a shared GKE cluster in
// the specified location, creating it if it hasn't been created in the test project yet.
func BootstrapSharedGKEClusterInLocation(t *testing.T, testId, location string) string {
	project := envvar.GetTestProjectFromEnv()
	clusterName := SharedGKEClusterPrefix + testId
	parent := fmt.Sprintf("projects/%s/locations/%s", project, location)
	clusterId := fmt.Sprintf("%s/clusters/%s", parent, clusterName)

	config := transport_tpg.BootstrapConfig(t)
	if config == nil {
		return ""
	}

	client := NewClient(config, config.UserAgent)

	log.Printf("[DEBUG] Getting shared test GKE cluster %q", clusterId)
	cluster, err := client.Projects.Locations.Clusters.Get(clusterId).Do()
	if err != nil && transport_tpg.IsGoogleApiErrorWithCode(err, 404) {
		log.Printf("[DEBUG] GKE cluster %q not found, bootstrapping", clusterId)

		region := location
		if parts := strings.Split(location, "-"); len(parts) == 3 {
			region = strings.Join(parts[:2], "-")
		}

		networkName := tpgcompute.BootstrapSharedTestNetwork(t, testId)
		subnetworkName := tpgcompute.BootstrapSubnetInRegion(t, testId, networkName, region, "10.79.0.0/20")

		req := &container.CreateClusterRequest{
			Cluster: &container.Cluster{
				Name:             clusterName,
				InitialNodeCount: 1,
				NodeConfig: &container.NodeConfig{
					MachineType: "n4-standard-2",
				},
				WorkloadIdentityConfig: &container.WorkloadIdentityConfig{
					WorkloadPool: fmt.Sprintf("%s.svc.id.goog", project),
				},
				AddonsConfig: &container.AddonsConfig{
					GkeBackupAgentConfig: &container.GkeBackupAgentConfig{
						Enabled: true,
					},
				},
				DeletionProtection: false,
				Network:            networkName,
				Subnetwork:         subnetworkName,
			},
		}

		op, err := client.Projects.Locations.Clusters.Create(parent, req).Do()
		if err != nil {
			if !transport_tpg.IsGoogleApiErrorWithCode(err, 409) {
				t.Fatalf("Error bootstrapping shared test GKE cluster %q: %s", clusterId, err)
			}
			log.Printf("[DEBUG] GKE cluster %q creation already in progress, waiting for readiness", clusterId)
		} else {
			log.Printf("[DEBUG] Waiting for GKE cluster %q creation to finish", clusterId)
			err = ContainerOperationWait(config, op, project, location, "bootstrapping shared test GKE cluster", config.UserAgent, 30*time.Minute)
			if err != nil {
				t.Fatalf("Error waiting for shared test GKE cluster %q creation: %s", clusterId, err)
			}
		}

		cluster, err = client.Projects.Locations.Clusters.Get(clusterId).Do()
	}

	if err != nil {
		t.Fatalf("Error getting shared test GKE cluster %q: %s", clusterId, err)
	}
	if cluster == nil {
		t.Fatalf("Error getting shared test GKE cluster %q: is nil", clusterId)
	}

	deadline := time.Now().Add(30 * time.Minute)
	for cluster.Status == "PROVISIONING" || cluster.Status == "RECONCILING" {
		if time.Now().After(deadline) {
			t.Fatalf("Timed out waiting for shared test GKE cluster %q to leave status %s", clusterId, cluster.Status)
		}
		log.Printf("[DEBUG] Shared test GKE cluster %q is in status %s, waiting 15s...", clusterId, cluster.Status)
		time.Sleep(15 * time.Second)
		cluster, err = client.Projects.Locations.Clusters.Get(clusterId).Do()
		if err != nil {
			t.Fatalf("Error getting shared test GKE cluster %q while waiting for readiness: %s", clusterId, err)
		}
	}

	return clusterId
}
