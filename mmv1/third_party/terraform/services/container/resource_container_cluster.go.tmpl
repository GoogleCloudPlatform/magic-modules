func expandAdditionalIpRangesConfigs(configured interface{}, d *schema.ResourceData, c *transport_tpg.Config) ([]map[string]interface{}, error) {
	l := configured.([]interface{})
	if len(l) == 0 || l[0] == nil {
		return nil, nil
	}
	var additionalIpRangesConfig []map[string]interface{}
	for _, rawConfig := range l {
		config := rawConfig.(map[string]interface{})
		subnetwork, err := tpgresource.ParseSubnetworkFieldValue(config["subnetwork"].(string), d, c)
		if err != nil {
			return nil, err
		}
		item := map[string]interface{}{}
		if rel := subnetwork.RelativeLink(); rel != "" {
			item["subnetwork"] = rel
		}
		if prn := expandPodIpv4RangeNames(config["pod_ipv4_range_names"]); len(prn) > 0 {
			item["podIpv4RangeNames"] = prn
		}
		if status, ok := config["status"].(string); ok && status != "" {
			item["status"] = status
		}
		additionalIpRangesConfig = append(additionalIpRangesConfig, item)
	}

	return additionalIpRangesConfig, nil
}

func expandIPAllocationPolicy(configured interface{}, d *schema.ResourceData, networkingMode string, autopilot bool, c *transport_tpg.Config) (map[string]interface{}, []map[string]interface{}, error) {
	l := configured.([]interface{})
	if len(l) == 0 || l[0] == nil {
		if networkingMode == "VPC_NATIVE" {
			return nil, nil, nil
		}
		return map[string]interface{}{
			"useIpAliases": false,
			"useRoutes":    true,
			"stackType":    "IPV4",
		}, nil, nil
	}

	config := l[0].(map[string]interface{})
	stackType := config["stack_type"].(string)

	// We expand and return additional_ip_ranges_config separately because
	// this field is OUTPUT_ONLY for ClusterCreate RPCs. Instead, during the
	// Terraform Create flow, we follow the CreateCluster (without
	// additional_ip_ranges_config populated) with an UpdateCluster (_with_
	// additional_ip_ranges_config populated).
	additionalIpRangesConfigs, err := expandAdditionalIpRangesConfigs(config["additional_ip_ranges_config"], d, c)
	if err != nil {
		return nil, nil, err
	}

	res := map[string]interface{}{
		"useIpAliases": networkingMode == "VPC_NATIVE" || networkingMode == "",
	}
	if v, ok := config["cluster_ipv4_cidr_block"].(string); ok && v != "" {
		res["clusterIpv4CidrBlock"] = v
	}
	if v, ok := config["services_ipv4_cidr_block"].(string); ok && v != "" {
		res["servicesIpv4CidrBlock"] = v
	}
	if v, ok := config["cluster_secondary_range_name"].(string); ok && v != "" {
		res["clusterSecondaryRangeName"] = v
	}
	if v, ok := config["services_secondary_range_name"].(string); ok && v != "" {
		res["servicesSecondaryRangeName"] = v
	}
	if networkingMode == "ROUTES" {
		res["useRoutes"] = true
	}
	if stackType != "" {
		res["stackType"] = stackType
	}
	if sub := expandPodCidrOverprovisionConfig(config["pod_cidr_overprovision_config"]); sub != nil {
		res["podCidrOverprovisionConfig"] = sub
	}
	if sub := expandAutoIpamConfig(config["auto_ipam_config"]); sub != nil {
		res["autoIpamConfig"] = sub
	}
	if sub := expandNetworkTierConfig(config["network_tier_config"]); sub != nil {
