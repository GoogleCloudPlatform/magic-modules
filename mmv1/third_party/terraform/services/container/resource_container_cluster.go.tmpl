func flattenFleet(v interface{}) []map[string]interface{} {
	c, _ := v.(map[string]interface{})
	if c == nil {
		return nil
	}

	// Parse membership_id and membership_location from full membership name.
	var membership_id, membership_location string
	membership, _ := c["membership"].(string)
	membershipRE := regexp.MustCompile(`^(//[a-zA-Z0-9\.\-]+)?/?projects/([^/]+)/locations/([a-zA-Z0-9\-]+)/memberships/([^/]+)$`)
	if match := membershipRE.FindStringSubmatch(membership); match != nil {
		membership_id = match[4]
		membership_location = match[3]
	}

	return []map[string]interface{}{
		{
			"project":             c["project"],
			"membership":          membership,
			"membership_id":       membership_id,
			"membership_location": membership_location,
			"pre_registered":      c["preRegistered"],
			"membership_type":     c["membershipType"],
		},
	}
}

func flattenUserManagedKeysConfig(c map[string]interface{}) []map[string]interface{} {
	if c == nil {
		return nil
	}
	clusterCa, _ := c["clusterCa"].(string)
	etcdApiCa, _ := c["etcdApiCa"].(string)
	etcdPeerCa, _ := c["etcdPeerCa"].(string)
	aggregationCa, _ := c["aggregationCa"].(string)
	controlPlaneDiskEncryptionKey, _ := c["controlPlaneDiskEncryptionKey"].(string)
	gkeopsEtcdBackupEncryptionKey, _ := c["gkeopsEtcdBackupEncryptionKey"].(string)
	f := map[string]interface{}{
		"cluster_ca":                        clusterCa,
		"etcd_api_ca":                       etcdApiCa,
		"etcd_peer_ca":                      etcdPeerCa,
		"aggregation_ca":                    aggregationCa,
		"control_plane_disk_encryption_key": controlPlaneDiskEncryptionKey,
		"gkeops_etcd_backup_encryption_key": gkeopsEtcdBackupEncryptionKey,
	}
	allEmpty := true
	for _, v := range f {
		if v.(string) != "" {
			allEmpty = false
		}
	}
	if sk, ok := c["serviceAccountSigningKeys"].([]interface{}); ok && len(sk) != 0 {
		f["service_account_signing_keys"] = schema.NewSet(schema.HashString, sk)
		allEmpty = false
	} else if sk, ok := c["serviceAccountSigningKeys"].([]string); ok && len(sk) != 0 {
		f["service_account_signing_keys"] = schema.NewSet(schema.HashString, tpgresource.ConvertStringArrToInterface(sk))
		allEmpty = false
	}
	if vk, ok := c["serviceAccountVerificationKeys"].([]interface{}); ok && len(vk) != 0 {
		f["service_account_verification_keys"] = schema.NewSet(schema.HashString, vk)
		allEmpty = false
	} else if vk, ok := c["serviceAccountVerificationKeys"].([]string); ok && len(vk) != 0 {
		f["service_account_verification_keys"] = schema.NewSet(schema.HashString, tpgresource.ConvertStringArrToInterface(vk))
		allEmpty = false
	}
	if kv, ok := c["controlPlaneDiskEncryptionKeyVersions"].([]interface{}); ok && len(kv) != 0 {
		f["control_plane_disk_encryption_key_versions"] = schema.NewSet(schema.HashString, kv)
		allEmpty = false
	} else if kv, ok := c["controlPlaneDiskEncryptionKeyVersions"].([]string); ok && len(kv) != 0 {
		f["control_plane_disk_encryption_key_versions"] = schema.NewSet(schema.HashString, tpgresource.ConvertStringArrToInterface(kv))
		allEmpty = false
	}
	if allEmpty {
		return nil
	}
	return []map[string]interface{}{f}
}

