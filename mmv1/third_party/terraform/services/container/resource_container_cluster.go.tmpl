	if v := d.Get("enable_l4_ilb_subsetting").(bool); v {
		networkConfig["enableL4ilbSubsetting"] = v
	}
	if v := d.Get("disable_l4_lb_firewall_reconciliation").(bool); v {
		networkConfig["disableL4LbFirewallReconciliation"] = v
	}
	if v := expandDnsConfig(d.Get("dns_config")); v != nil {
