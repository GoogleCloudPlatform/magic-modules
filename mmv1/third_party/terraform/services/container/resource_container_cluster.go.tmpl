func flattenPrivateClusterConfig(cpec map[string]interface{}, pcc map[string]interface{}, nc map[string]interface{}) []map[string]interface{} {
	if cpec == nil && pcc == nil && nc == nil {
		return nil
	}

	r := map[string]interface{}{}
	if cpec != nil {
		ip, _ := cpec["ipEndpointsConfig"].(map[string]interface{})
		// Note the change in semantics from private to public endpoint.
		enablePublicEndpoint, _ := ip["enablePublicEndpoint"].(bool)
		r["enable_private_endpoint"] = !enablePublicEndpoint
		r["private_endpoint"] = ip["privateEndpoint"]
		r["private_endpoint_subnetwork"] = ip["privateEndpointSubnetwork"]
		r["public_endpoint"] = ip["publicEndpoint"]
		r["master_global_access_config"] = []map[string]interface{}{
			{
				"enabled": ip["globalAccess"],
			},
		}
	}
	// This is the only field that is canonically still in the PrivateClusterConfig message.
	if pcc != nil {
		r["peering_name"] = pcc["peeringName"]
		r["master_ipv4_cidr_block"] = pcc["masterIpv4CidrBlock"]
	}
	if nc != nil {
		r["enable_private_nodes"] = nc["defaultEnablePrivateNodes"]
	}

	return []map[string]interface{}{r}
}

