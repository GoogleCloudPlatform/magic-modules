func expandMaintenancePolicy(d *schema.ResourceData, meta interface{}) map[string]interface{} {
	config := meta.(*transport_tpg.Config)
	// We have to perform a full Get() as part of this, to get the fingerprint.  We can't do this
	// at any other time, because the fingerprint update might happen between plan and apply.
	// We can omit error checks, since to have gotten this far, a project is definitely configured.
	project, _ := tpgresource.GetProject(d, config)
	location, _ := tpgresource.GetLocation(d, config)
	clusterName := d.Get("name").(string)
	name := containerClusterFullName(project, location, clusterName)
	userAgent, err := tpgresource.GenerateUserAgentString(d, config.UserAgent)
	if err != nil {
		return nil
	}
	getUrl := fmt.Sprintf("%s%s", transport_tpg.BaseUrl(Product, config), name)
	cluster, _ := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "GET",
		Project:   project,
		RawURL:    getUrl,
		UserAgent: userAgent,
	})
	resourceVersion := ""
	exclusions := make(map[string]interface{})
	if cluster != nil {
		if mp, ok := cluster["maintenancePolicy"].(map[string]interface{}); ok && mp != nil {
			// If the cluster doesn't exist or if there is a read error of any kind, we will pass in an empty
			// resourceVersion.  If there happens to be a change to maintenance policy, we will fail at that
			// point.  This is a compromise between code cleanliness and a slightly worse user experience in
			// an unlikely error case - we choose code cleanliness.
			resourceVersion, _ = mp["resourceVersion"].(string)

			// Having a MaintenancePolicy doesn't mean that you need MaintenanceExclusions, but if they were set,
			// they need to be assigned to exclusions.
			if win, ok := mp["window"].(map[string]interface{}); ok && win != nil {
				if mex, ok := win["maintenanceExclusions"].(map[string]interface{}); ok && mex != nil {
					for k, v := range mex {
						exclusions[k] = v
					}
				}
			}
		}
	}

	configured := d.Get("maintenance_policy")
	l := configured.([]interface{})
	if len(l) == 0 || l[0] == nil {
		window := map[string]interface{}{}
		if len(exclusions) > 0 {
			window["maintenanceExclusions"] = exclusions
		}
		res := map[string]interface{}{
			"window": window,
		}
		if resourceVersion != "" {
			res["resourceVersion"] = resourceVersion
		}
		return res
	}
	maintenancePolicy := l[0].(map[string]interface{})

	if maintenanceExclusions, ok := maintenancePolicy["maintenance_exclusion"]; ok {
		for k := range exclusions {
			delete(exclusions, k)
		}
		for _, me := range maintenanceExclusions.(*schema.Set).List() {
			exclusion := me.(map[string]interface{})
			mex := map[string]interface{}{}
			if v, ok := exclusion["start_time"].(string); ok && v != "" {
				mex["startTime"] = v
			}
			if v, ok := exclusion["end_time"].(string); ok && v != "" {
				mex["endTime"] = v
			}
			if exclusionOptions, ok := exclusion["exclusion_options"]; ok && len(exclusionOptions.([]interface{})) > 0 {
				meo := exclusionOptions.([]interface{})[0].(map[string]interface{})
				meoMap := map[string]interface{}{
					"scope": meo["scope"].(string),
				}
				if len(meo["end_time_behavior"].(string)) > 0 {
					meoMap["endTimeBehavior"] = meo["end_time_behavior"].(string)
					delete(mex, "endTime")
				}
				mex["maintenanceExclusionOptions"] = meoMap
			}
			exclusions[exclusion["exclusion_name"].(string)] = mex
		}
	}

	var budget map[string]interface{}
	if disruptionBudget, ok := maintenancePolicy["disruption_budget"]; ok && len(disruptionBudget.([]interface{})) > 0 {
		db := disruptionBudget.([]interface{})[0].(map[string]interface{})
		budget = map[string]interface{}{}
		if v, ok := db["minor_version_disruption_interval"].(string); ok && v != "" {
			budget["minorVersionDisruptionInterval"] = v
		}
		if v, ok := db["patch_version_disruption_interval"].(string); ok && v != "" {
			budget["patchVersionDisruptionInterval"] = v
		}
	}

	if dailyMaintenanceWindow, ok := maintenancePolicy["daily_maintenance_window"]; ok && len(dailyMaintenanceWindow.([]interface{})) > 0 {
		dmw := dailyMaintenanceWindow.([]interface{})[0].(map[string]interface{})
		startTime := dmw["start_time"].(string)
		dmwMap := map[string]interface{}{}
		if startTime != "" {
			dmwMap["startTime"] = startTime
		}
		window := map[string]interface{}{
			"dailyMaintenanceWindow": dmwMap,
		}
		if len(exclusions) > 0 {
			window["maintenanceExclusions"] = exclusions
		}
		res := map[string]interface{}{
			"window": window,
		}
		if budget != nil {
			res["disruptionBudget"] = budget
		}
		if resourceVersion != "" {
			res["resourceVersion"] = resourceVersion
		}
		return res
	}
	if recurringWindow, ok := maintenancePolicy["recurring_window"]; ok && len(recurringWindow.([]interface{})) > 0 {
		rw := recurringWindow.([]interface{})[0].(map[string]interface{})
		tw := map[string]interface{}{}
		if v, ok := rw["start_time"].(string); ok && v != "" {
			tw["startTime"] = v
		}
		if v, ok := rw["end_time"].(string); ok && v != "" {
			tw["endTime"] = v
		}
		rwMap := map[string]interface{}{
			"window": tw,
		}
		if v, ok := rw["recurrence"].(string); ok && v != "" {
			rwMap["recurrence"] = v
		}
		window := map[string]interface{}{
			"recurringWindow": rwMap,
		}
		if len(exclusions) > 0 {
			window["maintenanceExclusions"] = exclusions
		}
		res := map[string]interface{}{
			"window": window,
		}
		if budget != nil {
			res["disruptionBudget"] = budget
		}
		if resourceVersion != "" {
			res["resourceVersion"] = resourceVersion
		}
		return res
	}
	if recurringMaintenanceWindow, ok := maintenancePolicy["recurring_maintenance_window"]; ok && len(recurringMaintenanceWindow.([]interface{})) > 0 {
		rmw := recurringMaintenanceWindow.([]interface{})[0].(map[string]interface{})
		duration, _ := time.ParseDuration(rmw["window_duration"].(string))

		wstCfg := rmw["window_start_time"].([]interface{})[0].(map[string]interface{})
		wst := map[string]interface{}{}
		if v, ok := wstCfg["hours"].(int); ok && v != 0 {
			wst["hours"] = v
		}
		if v, ok := wstCfg["minutes"].(int); ok && v != 0 {
			wst["minutes"] = v
		}
		if v, ok := wstCfg["seconds"].(int); ok && v != 0 {
			wst["seconds"] = v
		}

		rmwMap := map[string]interface{}{
			"windowStartTime": wst,
			"windowDuration":  fmt.Sprintf("%ds", int(duration.Seconds())),
		}
		if v, ok := rmw["recurrence"].(string); ok && v != "" {
			rmwMap["recurrence"] = v
		}

		if _, ok := rmw["delay_until"]; ok && len(rmw["delay_until"].([]interface{})) == 1 {
			duCfg := rmw["delay_until"].([]interface{})[0].(map[string]interface{})
			du := map[string]interface{}{}
			if v, ok := duCfg["year"].(int); ok && v != 0 {
				du["year"] = v
			}
			if v, ok := duCfg["month"].(int); ok && v != 0 {
				du["month"] = v
			}
			if v, ok := duCfg["day"].(int); ok && v != 0 {
				du["day"] = v
			}
			rmwMap["delayUntil"] = du
		}

		window := map[string]interface{}{
			"recurringMaintenanceWindow": rmwMap,
		}
		if len(exclusions) > 0 {
			window["maintenanceExclusions"] = exclusions
		}
		policy := map[string]interface{}{
			"window": window,
		}
		if resourceVersion != "" {
			policy["resourceVersion"] = resourceVersion
		}
		return policy
	}
	return nil
}

func expandClusterAutoscaling(configured interface{}, d *schema.ResourceData) map[string]interface{} {
	l, ok := configured.([]interface{})
	enableAutopilot := false
	if v, ok := d.GetOk("enable_autopilot"); ok && v == true {
		enableAutopilot = true
	}
	if !ok || l == nil || len(l) == 0 || l[0] == nil {
		if enableAutopilot {
			return nil
		}
		return map[string]interface{}{
			"enableNodeAutoprovisioning": false,
		}
	}

	config := l[0].(map[string]interface{})

	var resourceLimits []map[string]interface{}
	if limits, ok := config["resource_limits"]; ok {
		resourceLimits = make([]map[string]interface{}, 0)
		if lmts, ok := limits.([]interface{}); ok {
			for _, v := range lmts {
				limit := v.(map[string]interface{})
				rl := map[string]interface{}{}
				if rt, ok := limit["resource_type"].(string); ok && rt != "" {
					rl["resourceType"] = rt
				}
				// Here we're relying on *not* setting ForceSendFields for 0-values.
				if v, ok := limit["minimum"].(int); ok && v != 0 {
					rl["minimum"] = strconv.Itoa(v)
				}
				if v, ok := limit["maximum"].(int); ok && v != 0 {
					rl["maximum"] = strconv.Itoa(v)
				}
				resourceLimits = append(resourceLimits, rl)
			}
		}
	}
	var defaultCCConfig map[string]interface{}
	if defaultCCEnabled, ok := config["default_compute_class_enabled"]; ok {
		defaultCCConfig = map[string]interface{}{}
		if v, ok := defaultCCEnabled.(bool); ok && v {
			defaultCCConfig["enabled"] = v
		}
	}
	var defaults map[string]interface{}
	if shouldInclude(d, "cluster_autoscaling.0.auto_provisioning_defaults") {
		defaults = expandAutoProvisioningDefaults(config["auto_provisioning_defaults"], d)
	}
	res := map[string]interface{}{}
	if v, ok := config["enabled"].(bool); ok && v {
		res["enableNodeAutoprovisioning"] = v
	}
	if len(resourceLimits) > 0 {
		res["resourceLimits"] = resourceLimits
	}
	if defaultCCConfig != nil {
		res["defaultComputeClassConfig"] = defaultCCConfig
	}
	if v, ok := config["autoscaling_profile"].(string); ok && v != "" {
		res["autoscalingProfile"] = v
	}
	if defaults != nil {
		res["autoprovisioningNodePoolDefaults"] = defaults
	}
	if locs := tpgresource.ConvertStringArr(config["auto_provisioning_locations"].([]interface{})); len(locs) > 0 {
		res["autoprovisioningLocations"] = locs
	}
	return res
}

func expandAutoProvisioningDefaults(configured interface{}, d *schema.ResourceData) map[string]interface{} {
	l, ok := configured.([]interface{})
	if !ok || l == nil || len(l) == 0 || l[0] == nil {
		return map[string]interface{}{}
	}
	config := l[0].(map[string]interface{})

	var management map[string]interface{}
	if shouldInclude(d, "cluster_autoscaling.0.auto_provisioning_defaults.0.management") {
		management = expandManagement(config["management"])
	}
	var upgradeSettings map[string]interface{}
	if shouldInclude(d, "cluster_autoscaling.0.auto_provisioning_defaults.0.upgrade_settings") {
		upgradeSettings = expandUpgradeSettings(config["upgrade_settings"], d)
	}
	npd := map[string]interface{}{}
	if scopes := tpgresource.ConvertStringArr(config["oauth_scopes"].([]interface{})); len(scopes) > 0 {
		npd["oauthScopes"] = scopes
	}
	if v, ok := config["service_account"].(string); ok && v != "" {
		npd["serviceAccount"] = v
	}
	if v, ok := config["disk_size"].(int); ok && v != 0 {
		npd["diskSizeGb"] = v
	}
	if v, ok := config["disk_type"].(string); ok && v != "" {
		npd["diskType"] = v
	}
	if v, ok := config["image_type"].(string); ok && v != "" {
		npd["imageType"] = v
	}
	if v, ok := config["boot_disk_kms_key"].(string); ok && v != "" {
		npd["bootDiskKmsKey"] = v
	}
	if management != nil {
		npd["management"] = management
	}
	if upgradeSettings != nil {
		npd["upgradeSettings"] = upgradeSettings
	}

	if v, ok := config["shielded_instance_config"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		sic := map[string]interface{}{}
		if v, ok := conf["enable_secure_boot"].(bool); ok && v {
			sic["enableSecureBoot"] = v
		}
		if v, ok := conf["enable_integrity_monitoring"].(bool); ok && v {
			sic["enableIntegrityMonitoring"] = v
		}
		npd["shieldedInstanceConfig"] = sic
	}

	cpu := config["min_cpu_platform"].(string)
	// the only way to unset the field is to pass "automatic" as its value
	if cpu == "" {
		cpu = "automatic"
	}
	npd["minCpuPlatform"] = cpu

	return npd
}

