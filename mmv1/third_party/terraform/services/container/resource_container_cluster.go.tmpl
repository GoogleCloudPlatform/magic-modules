	if v := expandGatewayApiConfig(d.Get("gateway_api_config")); v != nil {
		networkConfig["gatewayApiConfig"] = v
	}
	if v := d.Get("enable_multi_networking").(bool); v {
		networkConfig["enableMultiNetworking"] = v
	}
	if v := expandDefaultEnablePrivateNodes(d); v {
		networkConfig["defaultEnablePrivateNodes"] = v
	}
	if v := d.Get("enable_fqdn_network_policy").(bool); v {
		networkConfig["enableFqdnNetworkPolicy"] = v
	}
	if v := expandNetworkPerformanceConfig(d.Get("network_performance_config")); v != nil {
		networkConfig["networkPerformanceConfig"] = v
	}

	cluster := map[string]interface{}{}
	if clusterName != "" {
		cluster["name"] = clusterName
	}
	if v := d.Get("initial_node_count").(int); v != 0 {
		cluster["initialNodeCount"] = v
