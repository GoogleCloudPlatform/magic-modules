func validateNodePoolAutoConfig(cluster map[string]interface{}) error {
	npac, _ := cluster["nodePoolAutoConfig"].(map[string]interface{})
	if cluster == nil || npac == nil {
		return nil
	}
	nt, _ := npac["networkTags"].(map[string]interface{})
	strTags, _ := nt["tags"].([]string)
	ifaceTags, _ := nt["tags"].([]interface{})
	if len(strTags) > 0 || len(ifaceTags) > 0 {
		autopilot, _ := cluster["autopilot"].(map[string]interface{})
		autoscaling, _ := cluster["autoscaling"].(map[string]interface{})
		autopilotEnabled, _ := autopilot["enabled"].(bool)
		autoscalingEnabled, _ := autoscaling["enableNodeAutoprovisioning"].(bool)
		if !autopilotEnabled && !autoscalingEnabled {
			return fmt.Errorf("node_pool_auto_config network tags can only be set if enable_autopilot or cluster_autoscaling is enabled")
		}
	}

	return nil
}

