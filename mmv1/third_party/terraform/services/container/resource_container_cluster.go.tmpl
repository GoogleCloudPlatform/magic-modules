func expandEnableK8sBetaApis(configured interface{}, enabledAPIs []string) map[string]interface{} {
	l := configured.([]interface{})
	if len(l) == 0 || l[0] == nil {
		return nil
	}

	config := l[0].(map[string]interface{})
	result := map[string]interface{}{}
	if v, ok := config["enabled_apis"]; ok {
		notEnabledAPIsSet := v.(*schema.Set)
		for _, enabledAPI := range enabledAPIs {
			if notEnabledAPIsSet.Contains(enabledAPI) {
				notEnabledAPIsSet.Remove(enabledAPI)
			}
		}

		if apis := tpgresource.ConvertStringSet(notEnabledAPIsSet); len(apis) > 0 {
			result["enabledApis"] = apis
