func isEnablePrivateEndpointPSCCluster(cluster map[string]interface{}) bool {
	pcc, _ := cluster["privateClusterConfig"].(map[string]interface{})
	// EnablePrivateEndpoint not provided
	if cluster == nil || pcc == nil {
		return false
	}
	// Not a PSC cluster
	enablePrivateNodes, _ := pcc["enablePrivateNodes"].(bool)
	masterIpv4CidrBlock, _ := pcc["masterIpv4CidrBlock"].(string)
	if enablePrivateNodes || len(masterIpv4CidrBlock) > 0 {
		return false
	}
	// PSC Cluster with EnablePrivateEndpoint
	if enablePrivateEndpoint, _ := pcc["enablePrivateEndpoint"].(bool); enablePrivateEndpoint {
		return true
	}
	return false
}

