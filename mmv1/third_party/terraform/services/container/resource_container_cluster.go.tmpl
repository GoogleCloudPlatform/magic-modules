	if v := expandBinaryAuthorization(d.Get("binary_authorization")); v != nil {
		cluster["binaryAuthorization"] = v
	}
	cluster["autopilot"] = autopilot
	if v := expandReleaseChannel(d.Get("release_channel")); v != nil {
		cluster["releaseChannel"] = v
	}
	if v := expandGkeAutoUpgradeConfig(d.Get("gke_auto_upgrade_config")); v != nil {
		cluster["gkeAutoUpgradeConfig"] = v
	}
{{- if ne $.TargetVersionName "ga" }}
	if v := expandClusterTelemetry(d.Get("cluster_telemetry")); v != nil {
		cluster["clusterTelemetry"] = v
	}
{{- end }}
	if v := d.Get("enable_tpu").(bool); v {
		cluster["enableTpu"] = v
	}
	cluster["networkConfig"] = networkConfig
	if v := expandMasterAuth(d.Get("master_auth")); v != nil {
		cluster["masterAuth"] = v
	}
	if v := expandNotificationConfig(d.Get("notification_config")); v != nil {
		cluster["notificationConfig"] = v
	}
	if v := expandConfidentialNodes(d.Get("confidential_nodes")); v != nil {
		cluster["confidentialNodes"] = v
	}
	if v := tpgresource.ExpandStringMap(d, "effective_labels"); len(v) > 0 {
		cluster["resourceLabels"] = v
	}
	if v := expandNodePoolAutoConfig(d.Get("node_pool_auto_config")); v != nil {
		cluster["nodePoolAutoConfig"] = v
	}
{{- if ne $.TargetVersionName "ga" }}
	if v := expandProtectConfig(d.Get("protect_config")); v != nil {
		cluster["protectConfig"] = v
	}
{{- end }}
	if v := expandCostManagementConfig(d.Get("cost_management_config")); v != nil {
		cluster["costManagementConfig"] = v
	}
	if v := expandEnableK8sBetaApis(d.Get("enable_k8s_beta_apis"), nil); v != nil {
		cluster["enableK8sBetaApis"] = v
	}

	v := d.Get("enable_shielded_nodes")
	cluster["shieldedNodes"] = map[string]interface{}{
		"enabled": v.(bool),
	}

	if v, ok := d.GetOk("default_max_pods_per_node"); ok {
		if sub := expandDefaultMaxPodsConstraint(v); sub != nil {
			cluster["defaultMaxPodsConstraint"] = sub
		}
	}

	// Only allow setting node_version on create if it's set to the equivalent master version,
	// since `InitialClusterVersion` only accepts valid master-style versions.
	if v, ok := d.GetOk("node_version"); ok {
		// ignore -gke.X suffix for now. if it becomes a problem later, we can fix it.
		icv, _ := cluster["initialClusterVersion"].(string)
		mv := strings.Split(icv, "-")[0]
		nv := strings.Split(v.(string), "-")[0]
		if mv != nv {
			return fmt.Errorf("node_version and min_master_version must be set to equivalent values on create")
		}
	}

	if v, ok := d.GetOk("node_locations"); ok {
		locationsSet := v.(*schema.Set)
		if locationsSet.Contains(location) {
			return fmt.Errorf("when using a multi-zonal cluster, node_locations should not contain the original 'zone'")
		}

		// GKE requires a full list of node locations
		// but when using a multi-zonal cluster our schema only asks for the
		// additional zones, so append the cluster location if it's a zone
		if tpgresource.IsZone(location) {
			locationsSet.Add(location)
		}
		if locs := tpgresource.ConvertStringSet(locationsSet); len(locs) > 0 {
			cluster["locations"] = locs
		}
	}

	if v, ok := d.GetOk("network"); ok {
		network, err := tpgresource.ParseNetworkFieldValue(v.(string), d, config)
		if err != nil {
			return err
		}
		if rel := network.RelativeLink(); rel != "" {
			cluster["network"] = rel
		}
	}

	if v, ok := d.GetOk("subnetwork"); ok {
		subnetwork, err := tpgresource.ParseRegionalFieldValue("subnetworks", v.(string), "project", "location", "location", d, config, true) // variant of ParseSubnetworkFieldValue
		if err != nil {
			return err
		}
		if rel := subnetwork.RelativeLink(); rel != "" {
			cluster["subnetwork"] = rel
		}
	}

	nodePoolsCount := d.Get("node_pool.#").(int)
	if nodePoolsCount > 0 {
		nodePools := make([]map[string]interface{}, 0, nodePoolsCount)
		for i := 0; i < nodePoolsCount; i++ {
			prefix := fmt.Sprintf("node_pool.%d.", i)
			nodePool, err := expandNodePool(d, prefix)
			if err != nil {
				return err
			}
			nodePools = append(nodePools, nodePool)
		}
		if len(nodePools) > 0 {
			cluster["nodePools"] = nodePools
		}
	} else {
		// Node Configs have default values that are set in the expand function,
		// but can only be set if node pools are unspecified.
		if sub := expandNodeConfig(d, "", []interface{}{}); sub != nil {
			cluster["nodeConfig"] = sub
		}
	}

	if v, ok := d.GetOk("node_pool_defaults"); ok {
		if sub := expandNodePoolDefaults(v); sub != nil {
			cluster["nodePoolDefaults"] = sub
		}
	}

	if v, ok := d.GetOk("node_config"); ok {
		if sub := expandNodeConfig(d, "", v); sub != nil {
			cluster["nodeConfig"] = sub
		}
	}

	if v, ok := d.GetOk("authenticator_groups_config"); ok {
		if sub := expandAuthenticatorGroupsConfig(v); sub != nil {
			cluster["authenticatorGroupsConfig"] = sub
		}
	}

	if v, ok := d.GetOk("private_cluster_config.0.master_ipv4_cidr_block"); ok {
		if sub := expandPrivateClusterConfigMasterIpv4CidrBlock(v, cluster); sub != nil {
			cluster["privateClusterConfig"] = sub
		}
	}

	if v, ok := d.GetOk("vertical_pod_autoscaling"); ok {
		if sub := expandVerticalPodAutoscaling(v); sub != nil {
			cluster["verticalPodAutoscaling"] = sub
		}
	}

	if v, ok := d.GetOk("service_external_ips_config"); ok {
		if sub := expandServiceExternalIpsConfig(v); sub != nil {
			networkConfig["serviceExternalIpsConfig"] = sub
		}
	}

	if v, ok := d.GetOk("mesh_certificates"); ok {
		if sub := expandMeshCertificates(v); sub != nil {
			cluster["meshCertificates"] = sub
		}
	}

	if v, ok := d.GetOk("database_encryption"); ok {
		if sub := expandDatabaseEncryption(v); sub != nil {
			cluster["databaseEncryption"] = sub
		}
	}

	if v, ok := d.GetOk("workload_identity_config"); ok {
		if sub := expandWorkloadIdentityConfig(v); sub != nil {
			cluster["workloadIdentityConfig"] = sub
		}
	}

	if v, ok := d.GetOk("identity_service_config"); ok {
		if sub := expandIdentityServiceConfig(v); sub != nil {
			cluster["identityServiceConfig"] = sub
		}
	}

{{ if ne $.TargetVersionName `ga` -}}
	if v, ok := d.GetOk("tpu_config"); ok {
		if sub := expandContainerClusterTpuConfig(v); sub != nil {
			cluster["tpuConfig"] = sub
		}
	}
{{- end }}

	if v, ok := d.GetOk("resource_usage_export_config"); ok {
		if sub := expandResourceUsageExportConfig(v); sub != nil {
			cluster["resourceUsageExportConfig"] = sub
		}
	}

	if v, ok := d.GetOk("logging_config"); ok {
		if sub := expandContainerClusterLoggingConfig(v); sub != nil {
			cluster["loggingConfig"] = sub
		}
	}

	if v, ok := d.GetOk("monitoring_config"); ok {
		if sub := expandMonitoringConfig(v); sub != nil {
			cluster["monitoringConfig"] = sub
		}
	}

	if v, ok := d.GetOk("fleet"); ok {
		if sub := expandFleet(v); sub != nil {
			cluster["fleet"] = sub
		}
	}

	if v, ok := d.GetOk("user_managed_keys_config"); ok {
		if sub := expandUserManagedKeysConfig(v); sub != nil {
			cluster["userManagedKeysConfig"] = sub
		}
	}

	if err := validateNodePoolAutoConfig(cluster); err != nil {
		return err
	}

	if v, ok := d.GetOk("security_posture_config"); ok {
		if sub := expandSecurityPostureConfig(v); sub != nil {
			cluster["securityPostureConfig"] = sub
		}
	}

	if v, ok := d.GetOk("enterprise_config"); ok {
		if sub := expandEnterpriseConfig(v); sub != nil {
			cluster["enterpriseConfig"] = sub
		}
	}

	if v, ok := d.GetOk("anonymous_authentication_config"); ok {
		if sub := expandAnonymousAuthenticationConfig(v); sub != nil {
			cluster["anonymousAuthenticationConfig"] = sub
		}
	}

	if v, ok := d.GetOk("node_creation_config"); ok {
		if sub := expandNodeCreationConfig(v); sub != nil {
			cluster["nodeCreationConfig"] = sub
		}
	}

	if v, ok := d.GetOk("rbac_binding_config"); ok {
		if sub := expandRBACBindingConfig(v); sub != nil {
			cluster["rbacBindingConfig"] = sub
		}
	}

	needUpdateAfterCreate := false

	if len(aircs) > 0 {
		needUpdateAfterCreate = true
	}

	// For now PSC based cluster don't support `enable_private_endpoint` on `create`, but only on `update` API call.
	// If cluster is PSC based and enable_private_endpoint is set to true we will ignore it on `create` call and update cluster right after creation.
	enablePrivateEndpointPSCCluster := isEnablePrivateEndpointPSCCluster(cluster)
	if enablePrivateEndpointPSCCluster {
		if pcc, ok := cluster["privateClusterConfig"].(map[string]interface{}); ok && pcc != nil {
			delete(pcc, "enablePrivateEndpoint")
		}
		needUpdateAfterCreate = true
	}

	enablePDCSI := isEnablePDCSI(cluster)
	if !enablePDCSI {
		// GcePersistentDiskCsiDriver cannot be disabled at cluster create, only on cluster update. Ignore on create then update after creation.
		// If pdcsi is disabled, the config should be defined. But we will be paranoid and double-check.
		needUpdateAfterCreate = true
		addonsConfig, _ := cluster["addonsConfig"].(map[string]interface{})
		if addonsConfig == nil {
			addonsConfig = map[string]interface{}{}
			cluster["addonsConfig"] = addonsConfig
		}
		gcePd, _ := addonsConfig["gcePersistentDiskCsiDriverConfig"].(map[string]interface{})
		if gcePd == nil {
			gcePd = map[string]interface{}{}
			addonsConfig["gcePersistentDiskCsiDriverConfig"] = gcePd
		}
		gcePd["enabled"] = true
	}

	{{ if ne $.TargetVersionName `ga` -}}
	if v, ok := d.GetOk("workload_alts_config"); ok {
		if sub := expandWorkloadAltsConfig(v); sub != nil {
			cluster["workloadAltsConfig"] = sub
		}
	}
	{{- end }}
	{{ if ne $.TargetVersionName `ga` -}}
	if v, ok := d.GetOk("schedule_upgrade_config"); ok {
		if sub := expandScheduleUpgradeConfig(v); sub != nil {
			cluster["scheduleUpgradeConfig"] = sub
		}
	}
	{{- end }}

	req := map[string]interface{}{
		"cluster": cluster,
	}

	transport_tpg.MutexStore.Lock(containerClusterMutexKey(project, location, clusterName))
	defer transport_tpg.MutexStore.Unlock(containerClusterMutexKey(project, location, clusterName))

	parent := fmt.Sprintf("projects/%s/locations/%s", project, location)
	createUrl := fmt.Sprintf("%s%s/clusters", transport_tpg.BaseUrl(Product, config), parent)
	op, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
		Config:    config,
		Method:    "POST",
		Project:   project,
		RawURL:    createUrl,
		UserAgent: userAgent,
		Body:      req,
	})
	if err != nil {
		return err
	}

	d.SetId(containerClusterFullName(project, location, clusterName))

	// Wait until it's created
	waitErr := ContainerOperationWait(config, op, project, location, "creating GKE cluster", userAgent, d.Timeout(schema.TimeoutCreate))
	if waitErr != nil {
		// Check if the create operation failed because Terraform was prematurely terminated. If it was we can persist the
		// operation id to state so that a subsequent refresh of this resource will wait until the operation has terminated
		// before attempting to Read the state of the cluster. This allows a graceful resumption of a Create that was killed
		// by the upstream Terraform process exiting early such as a sigterm.
		select {
		case <-config.Context.Done():
			opName, _ := op["name"].(string)
			log.Printf("[DEBUG] Persisting %s so this operation can be resumed \n", opName)
			if err := d.Set("operation", opName); err != nil {
				return fmt.Errorf("Error setting operation: %s", err)
			}

			return nil
		default:
			// leaving default case to ensure this is non blocking
		}

		// Try a GET on the cluster so we can see the state in debug logs. This will help classify error states.
		getUrl := fmt.Sprintf("%s%s", transport_tpg.BaseUrl(Product, config), containerClusterFullName(project, location, clusterName))
		_, getErr := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "GET",
			Project:   project,
			RawURL:    getUrl,
			UserAgent: userAgent,
		})
		if getErr != nil {
			log.Printf("[WARN] Cluster %s was created in an error state and not found", clusterName)
			d.SetId("")
		}

		// Don't clear cluster id, this will taint the resource
		log.Printf("[WARN] GKE cluster %s was created in an error state, and has been marked as tainted", clusterName)
		return waitErr
	}

	log.Printf("[INFO] GKE cluster %s has been created", clusterName)

	if d.Get("remove_default_node_pool").(bool) {
		parent := fmt.Sprintf("%s/nodePools/%s", containerClusterFullName(project, location, clusterName), "default-pool")
		deleteUrl := fmt.Sprintf("%s%s", transport_tpg.BaseUrl(Product, config), parent)
		op, err = transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "DELETE",
			Project:   project,
			RawURL:    deleteUrl,
			UserAgent: userAgent,
		})
		if err != nil {
			return errwrap.Wrapf("Error deleting default node pool: {{"{{"}}err{{"}}"}}", err)
		}
		err = ContainerOperationWait(config, op, project, location, "removing default node pool", userAgent, d.Timeout(schema.TimeoutCreate))
		if err != nil {
			return errwrap.Wrapf("Error while waiting to delete default node pool: {{"{{"}}err{{"}}"}}", err)
		}
	}

	if needUpdateAfterCreate {
		name := containerClusterFullName(project, location, clusterName)
		update := map[string]interface{}{}
		var forceSendFields []string
		if enablePrivateEndpointPSCCluster {
			update["desiredEnablePrivateEndpoint"] = true
			forceSendFields = append(forceSendFields, "DesiredEnablePrivateEndpoint")
		}
		if !enablePDCSI {
			update["desiredAddonsConfig"] = map[string]interface{}{
				"gcePersistentDiskCsiDriverConfig": map[string]interface{}{},
			}
			forceSendFields = append(forceSendFields, "DesiredAddonsConfig.GcePersistentDiskCsiDriverConfig.Enabled")
		}

		if len(aircs) > 0 {
			update["desiredAdditionalIpRangesConfig"] = map[string]interface{}{
				"additionalIpRangesConfigs": aircs,
			}
		}

		req := map[string]interface{}{"update": update}
		updateUrl := fmt.Sprintf("%s%s", transport_tpg.BaseUrl(Product, config), name)
		op, err = transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "PUT",
			Project:   project,
			RawURL:    updateUrl,
			UserAgent: userAgent,
			Body:      req,
		})
		if err != nil {
			return errwrap.Wrapf(fmt.Sprintf("Error updating cluster for %v: {{"{{"}}err{{"}}"}}", forceSendFields), err)
		}

		err = ContainerOperationWait(config, op, project, location, "updating enable private endpoint", userAgent, d.Timeout(schema.TimeoutCreate))
		if err != nil {
			return errwrap.Wrapf(fmt.Sprintf("Error while waiting on cluster update for %v: {{"{{"}}err{{"}}"}}", forceSendFields), err)
		}
	}

	if names, ok := d.GetOk("ip_allocation_policy.0.additional_pod_ranges_config.0.pod_range_names"); ok {
		name := containerClusterFullName(project, location, clusterName)
		additionalPodRangesConfig := map[string]interface{}{}
		if prn := tpgresource.ConvertStringSet(names.(*schema.Set)); len(prn) > 0 {
			additionalPodRangesConfig["podRangeNames"] = prn
		}

		req := map[string]interface{}{
			"update": map[string]interface{}{
				"additionalPodRangesConfig": additionalPodRangesConfig,
			},
		}
		updateUrl := fmt.Sprintf("%s%s", transport_tpg.BaseUrl(Product, config), name)
		op, err = transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "PUT",
			Project:   project,
			RawURL:    updateUrl,
			UserAgent: userAgent,
			Body:      req,
		})
		if err != nil {
			return errwrap.Wrapf("Error updating AdditionalPodRangesConfig: {{"{{"}}err{{"}}"}}", err)
		}

		err = ContainerOperationWait(config, op, project, location, "updating AdditionalPodRangesConfig", userAgent, d.Timeout(schema.TimeoutCreate))
		if err != nil {
			return errwrap.Wrapf("Error while waiting to update AdditionalPodRangesConfig: {{"{{"}}err{{"}}"}}", err)
		}
	}

	if linuxNodeConfig, ok := d.GetOk("node_pool_auto_config.0.linux_node_config"); ok {
		name := containerClusterFullName(project, location, clusterName)
		update := map[string]interface{}{}
		if sub := expandLinuxNodeConfig(linuxNodeConfig); sub != nil {
			update["desiredNodePoolAutoConfigLinuxNodeConfig"] = sub
		}
		req := map[string]interface{}{
			"update": update,
		}
		updateUrl := fmt.Sprintf("%s%s", transport_tpg.BaseUrl(Product, config), name)
		op, err = transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
			Config:    config,
			Method:    "PUT",
			Project:   project,
			RawURL:    updateUrl,
			UserAgent: userAgent,
			Body:      req,
		})
		if err != nil {
			return errwrap.Wrapf("Error updating LinuxNodeConfig: {{"{{"}}err{{"}}"}}", err)
		}

		err = ContainerOperationWait(config, op, project, location, "updating LinuxNodeConfig", userAgent, d.Timeout(schema.TimeoutCreate))
		if err != nil {
			return errwrap.Wrapf("Error while waiting to update LinuxNodeConfig: {{"{{"}}err{{"}}"}}", err)
		}
	}

	if err := resourceContainerClusterRead(d, meta); err != nil {
		return err
	}

	state, err := containerClusterAwaitRestingState(config, project, location, clusterName, userAgent, d.Timeout(schema.TimeoutCreate))
	if err != nil {
		return err
	}

	if containerClusterRestingStates[state] == ErrorState {
		return fmt.Errorf("Cluster %s was created in the error state %q", clusterName, state)
	}

	return nil
}

