func flattenMaintenancePolicy(v interface{}) []map[string]interface{} {
	mp, _ := v.(map[string]interface{})
	mpWindow, _ := mp["window"].(map[string]interface{})
	if mp == nil || mpWindow == nil {
		return nil
	}

	exclusions := []map[string]interface{}{}
	if maintExclusions, ok := mpWindow["maintenanceExclusions"].(map[string]interface{}); ok && maintExclusions != nil {
		for wName, rawWin := range maintExclusions {
			window, _ := rawWin.(map[string]interface{})
			exclusion := map[string]interface{}{
				"start_time":     window["startTime"],
				"exclusion_name": wName,
			}
			if meo, ok := window["maintenanceExclusionOptions"].(map[string]interface{}); ok && meo != nil {
				// When the scope is set to NO_UPGRADES which is the default value,
				// the maintenance exclusion returned by GCP will be empty.
				// This seems like a bug. To workaround this, assign NO_UPGRADES to the scope explicitly
				scope := "NO_UPGRADES"
				if s, ok := meo["scope"].(string); ok && s != "" {
					scope = s
				}
				if etb, ok := meo["endTimeBehavior"].(string); ok && etb != "" {
					exclusion["exclusion_options"] = []map[string]interface{}{
						{
							"scope":             scope,
							"end_time_behavior": etb,
						},
					}
				} else {
					exclusion["exclusion_options"] = []map[string]interface{}{
						{
							"scope": scope,
						},
					}
					if et, ok := window["endTime"].(string); ok && et != "" {
						exclusion["end_time"] = et
					}
				}
			} else {
				if et, ok := window["endTime"].(string); ok && et != "" {
					exclusion["end_time"] = et
				}
			}
			exclusions = append(exclusions, exclusion)
		}
	}
	var budget []map[string]interface{}
	if db, ok := mp["disruptionBudget"].(map[string]interface{}); ok && db != nil {
		m := make(map[string]interface{})
		if v, ok := db["minorVersionDisruptionInterval"].(string); ok && v != "" {
			m["minor_version_disruption_interval"] = v
		}
		if v, ok := db["patchVersionDisruptionInterval"].(string); ok && v != "" {
			m["patch_version_disruption_interval"] = v
		}
		if v, ok := db["lastMinorVersionDisruptionTime"].(string); ok && v != "" {
			m["last_minor_version_disruption_time"] = v
		}
		if v, ok := db["lastDisruptionTime"].(string); ok && v != "" {
			m["last_disruption_time"] = v
		}
		if len(m) > 0 {
			budget = append(budget, m)
		}
	}

	if dmw, ok := mpWindow["dailyMaintenanceWindow"].(map[string]interface{}); ok && dmw != nil {
		return []map[string]interface{}{
			{
				"daily_maintenance_window": []map[string]interface{}{
					{
						"start_time": dmw["startTime"],
						"duration":   dmw["duration"],
					},
				},
				"maintenance_exclusion": exclusions,
				"disruption_budget":     budget,
			},
		}
	}
	if rw, ok := mpWindow["recurringWindow"].(map[string]interface{}); ok && rw != nil {
		rwWin, _ := rw["window"].(map[string]interface{})
		return []map[string]interface{}{
			{
				"recurring_window": []map[string]interface{}{
					{
						"start_time": rwWin["startTime"],
						"end_time":   rwWin["endTime"],
						"recurrence": rw["recurrence"],
					},
				},
				"maintenance_exclusion": exclusions,
				"disruption_budget":     budget,
			},
		}
	}
	if rmw, ok := mpWindow["recurringMaintenanceWindow"].(map[string]interface{}); ok && rmw != nil {
		wst, _ := rmw["windowStartTime"].(map[string]interface{})
		window := []map[string]interface{}{
			{
				"recurring_maintenance_window": []map[string]interface{}{
					{
						"window_start_time": []map[string]interface{}{
							{
								"hours":   wst["hours"],
								"minutes": wst["minutes"],
								"seconds": wst["seconds"],
							},
						},
						"window_duration": rmw["windowDuration"],
						"recurrence":      rmw["recurrence"],
					},
				},
				"maintenance_exclusion": exclusions,
			},
		}

		if du, ok := rmw["delayUntil"].(map[string]interface{}); ok && du != nil {
			window[0]["recurring_maintenance_window"].([]map[string]interface{})[0]["delay_until"] = []map[string]interface{}{
				{
					"year":  du["year"],
					"month": du["month"],
					"day":   du["day"],
				},
			}
		}
		return window
	}
	return nil
}

func flattenMasterAuth(v interface{}) []map[string]interface{} {
	ma, _ := v.(map[string]interface{})
	if ma == nil {
		return nil
	}
	clientCert, _ := ma["clientCertificate"].(string)
	masterAuth := []map[string]interface{}{
		{
			"client_certificate":     clientCert,
			"client_key":             ma["clientKey"],
			"cluster_ca_certificate": ma["clusterCaCertificate"],
		},
	}

	// No version of the GKE API returns the client_certificate_config value.
	// Instead, we need to infer whether or not it was set based on the
	// client cert being returned from the API or not.
	// Previous versions of the provider didn't record anything in state when
	// a client cert was enabled, only setting the block when it was false.
	masterAuth[0]["client_certificate_config"] = []map[string]interface{}{
		{
			"issue_client_certificate": len(clientCert) != 0,
		},
	}

	return masterAuth
}

func flattenClusterAutoscaling(v interface{}) []map[string]interface{} {
	a, _ := v.(map[string]interface{})
	r := make(map[string]interface{})
	if a == nil {
		r["enabled"] = false
		return []map[string]interface{}{r}
	}

	r["enabled"] = a["enableNodeAutoprovisioning"]
	rawLimits, _ := a["resourceLimits"].([]interface{})
	resourceLimits := make([]interface{}, 0, len(rawLimits))
	for _, rawRl := range rawLimits {
		rl, ok := rawRl.(map[string]interface{})
		if !ok || rl == nil {
			continue
		}
		var minimum, maximum interface{} = rl["minimum"], rl["maximum"]
		if v, ok := minimum.(string); ok {
			minimum, _ = strconv.Atoi(v)
		}
		if v, ok := maximum.(string); ok {
			maximum, _ = strconv.Atoi(v)
		}
		resourceLimits = append(resourceLimits, map[string]interface{}{
			"resource_type": rl["resourceType"],
			"minimum":       minimum,
			"maximum":       maximum,
		})
	}
	r["resource_limits"] = resourceLimits
	r["autoscaling_profile"] = a["autoscalingProfile"]
	if npd, ok := a["autoprovisioningNodePoolDefaults"].(map[string]interface{}); ok && npd != nil {
		r["auto_provisioning_defaults"] = flattenAutoProvisioningDefaults(npd)
	}
	r["auto_provisioning_locations"] = a["autoprovisioningLocations"]

	if dccc, ok := a["defaultComputeClassConfig"].(map[string]interface{}); ok && dccc != nil {
		r["default_compute_class_enabled"] = dccc["enabled"]
	}

	return []map[string]interface{}{r}
}

