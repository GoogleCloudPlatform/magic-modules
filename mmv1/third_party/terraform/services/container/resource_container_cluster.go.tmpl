	if v := expandMaintenancePolicy(d, meta); v != nil {
		cluster["maintenancePolicy"] = v
	}
	if v := expandControlPlaneEndpointsConfig(d); v != nil {
		cluster["controlPlaneEndpointsConfig"] = v
	}
	if v := d.Get("min_master_version").(string); v != "" {
		cluster["initialClusterVersion"] = v
	}
	if v := d.Get("cluster_ipv4_cidr").(string); v != "" {
		cluster["clusterIpv4Cidr"] = v
	}
	if v := d.Get("description").(string); v != "" {
		cluster["description"] = v
	}
	cluster["legacyAbac"] = map[string]interface{}{
		"enabled": d.Get("enable_legacy_abac").(bool),
	}
	if v := d.Get("logging_service").(string); v != "" {
		cluster["loggingService"] = v
	}
	if v := d.Get("monitoring_service").(string); v != "" {
		cluster["monitoringService"] = v
	}
	if v := expandNetworkPolicy(d.Get("network_policy")); v != nil {
		cluster["networkPolicy"] = v
	}
	if v := expandClusterAddonsConfig(d.Get("addons_config")); v != nil {
		cluster["addonsConfig"] = v
	}
{{- if ne $.TargetVersionName "ga" }}
	if v := expandManagedMachineLearningDiagnosticsConfig(d.Get("managed_machine_learning_diagnostics_config")); v != nil {
