	}
	if v := expandDataplaneV2Config(d.Get("dataplane_optimization_mode")); v != nil {
		networkConfig["dataplaneV2Config"] = v
	}
	if v := d.Get("enable_cilium_clusterwide_network_policy").(bool); v {
		networkConfig["enableCiliumClusterwideNetworkPolicy"] = v
	}
	if v := d.Get("private_ipv6_google_access").(string); v != "" {
