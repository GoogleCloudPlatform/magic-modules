func flattenRegistryHosts(registryHosts []interface{}) []map[string]interface{} {
	items := []map[string]interface{}{}
	if len(registryHosts) == 0 {
		return items
	}

	for _, raw := range registryHosts {
		host, ok := raw.(map[string]interface{})
		if !ok || host == nil {
			continue
		}
		item := make(map[string]interface{})
		item["server"] = host["server"]
		hosts, _ := host["hosts"].([]interface{})
		item["hosts"] = flattenHostInRegistryHosts(hosts)
		items = append(items, item)
	}
	return items
}

func flattenHostInRegistryHosts(hosts []interface{}) []map[string]interface{} {
	items := make([]map[string]interface{}, 0, len(hosts))
	if len(hosts) == 0 {
		return items
	}
	for _, rawH := range hosts {
		h, ok := rawH.(map[string]interface{})
		if !ok || h == nil {
			continue
		}
		item := make(map[string]interface{})
		item["host"] = h["host"]
		item["capabilities"] = h["capabilities"]
		item["override_path"] = h["overridePath"]
		item["dial_timeout"] = h["dialTimeout"]

		if headers, ok := h["header"].([]interface{}); ok && headers != nil {
			tmp := make([]interface{}, len(headers))
			for i, rawVal := range headers {
				val, _ := rawVal.(map[string]interface{})
				tmp[i] = map[string]interface{}{
					"key":   val["key"],
					"value": val["value"],
				}
			}
			item["header"] = tmp
		}

		if cas, ok := h["ca"].([]interface{}); ok && cas != nil {
			tmp := make([]interface{}, len(cas))
			for i, rawVal := range cas {
				val, _ := rawVal.(map[string]interface{})
				if val != nil {
					if uri, ok := val["gcpSecretManagerSecretUri"].(string); ok && uri != "" {
						tmp[i] = map[string]interface{}{
							"gcp_secret_manager_secret_uri": uri,
						}
					}
				}
			}
			item["ca"] = tmp
		}

		if clients, ok := h["client"].([]interface{}); ok && clients != nil {
			tmp := make([]interface{}, len(clients))
			for i, rawVal := range clients {
				val, _ := rawVal.(map[string]interface{})
				currentClient := map[string]interface{}{}
				if cert, ok := val["cert"].(map[string]interface{}); ok && cert != nil {
					if uri, ok := cert["gcpSecretManagerSecretUri"].(string); ok && uri != "" {
						currentClient["cert"] = []interface{}{
							map[string]interface{}{
								"gcp_secret_manager_secret_uri": uri,
							},
						}
					}
				}
				if key, ok := val["key"].(map[string]interface{}); ok && key != nil {
					if uri, ok := key["gcpSecretManagerSecretUri"].(string); ok && uri != "" {
						currentClient["key"] = []interface{}{
							map[string]interface{}{
								"gcp_secret_manager_secret_uri": uri,
							},
						}
					}
				}
				tmp[i] = currentClient
			}
			item["client"] = tmp
		}
		items = append(items, item)
	}
	return items
}

