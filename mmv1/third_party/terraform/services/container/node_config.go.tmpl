	if v, ok := nodeConfig["taint"]; ok && len(v.([]interface{})) > 0 {
		taints := v.([]interface{})
		nodeTaints := make([]map[string]interface{}, 0, len(taints))
		for _, raw := range taints {
			data := raw.(map[string]interface{})
			taint := map[string]interface{}{}
			if v, ok := data["key"].(string); ok && v != "" {
				taint["key"] = v
			}
			if v, ok := data["value"].(string); ok && v != "" {
