// flattenTaints records the set of taints already present in state.
func flattenTaints(c []interface{}, oldTaints []interface{}) []map[string]interface{} {
	taintKeys := map[string]struct{}{}
	for _, raw := range oldTaints {
		data := raw.(map[string]interface{})
		taintKey := data["key"].(string)
		taintKeys[taintKey] = struct{}{}
	}

	result := []map[string]interface{}{}
	for _, raw := range c {
		taint, ok := raw.(map[string]interface{})
		if !ok || taint == nil {
			continue
		}
		key, _ := taint["key"].(string)
		if _, ok := taintKeys[key]; ok {
			result = append(result, map[string]interface{}{
				"key":    key,
				"value":  taint["value"],
				"effect": taint["effect"],
			})
		}
	}

	return result
}

