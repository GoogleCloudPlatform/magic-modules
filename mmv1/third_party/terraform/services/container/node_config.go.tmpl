func expandNodeConfigDefaults(configured interface{}) map[string]interface{} {
	configs := configured.([]interface{})
	if len(configs) == 0 || configs[0] == nil {
		return nil
	}
	config := configs[0].(map[string]interface{})

	nodeConfigDefaults := map[string]interface{}{}
	if sub := expandContainerdConfig(config["containerd_config"]); sub != nil {
		nodeConfigDefaults["containerdConfig"] = sub
	}
	if v, ok := config["insecure_kubelet_readonly_port_enabled"]; ok {
		nodeConfigDefaults["nodeKubeletConfig"] = map[string]interface{}{
			"insecureKubeletReadonlyPortEnabled": expandInsecureKubeletReadonlyPortEnabled(v),
		}
	}
	if variant, ok := config["logging_variant"]; ok {
		variantConfig := map[string]interface{}{}
		if v := variant.(string); v != "" {
			variantConfig["variant"] = v
		}
		nodeConfigDefaults["loggingConfig"] = map[string]interface{}{
			"variantConfig": variantConfig,
		}
	}

	if v, ok := config["gcfs_config"]; ok && len(v.([]interface{})) > 0 {
		gcfsConfig := v.([]interface{})[0].(map[string]interface{})
		gcfs := map[string]interface{}{}
		if enabled := gcfsConfig["enabled"].(bool); enabled {
			gcfs["enabled"] = enabled
		}
		nodeConfigDefaults["gcfsConfig"] = gcfs
	}

	return nodeConfigDefaults
}

func expandNodeConfig(d *schema.ResourceData, prefix string, v interface{}) map[string]interface{} {
	if v == nil {
		return map[string]interface{}{
			"oauthScopes": defaultOauthScopes,
		}
	}
	nodeConfigs := v.([]interface{})
	nc := map[string]interface{}{
		// Defaults can't be set on a list/set in the schema, so set the default on create here.
		"oauthScopes": defaultOauthScopes,
	}
	if len(nodeConfigs) == 0 {
		return nc
	}

	nodeConfig := nodeConfigs[0].(map[string]interface{})

	if v, ok := nodeConfig["taint_config"]; ok {
		if sub := expandTaintConfig(v); sub != nil {
			nc["taintConfig"] = sub
		}
	}

	if v, ok := nodeConfig["containerd_config"]; ok {
		if sub := expandContainerdConfig(v); sub != nil {
			nc["containerdConfig"] = sub
		}
	}

	if v, ok := nodeConfig["machine_type"].(string); ok && v != "" {
		nc["machineType"] = v
	}

	if v, ok := nodeConfig["gpudirect_strategy"]; ok {
		if sub := expandGpuDirectConfig(v); sub != nil {
			nc["gpuDirectConfig"] = sub
		}
	}

	if v, ok := nodeConfig["guest_accelerator"]; ok {
		accels := v.([]interface{})
		guestAccelerators := make([]map[string]interface{}, 0, len(accels))
		for _, raw := range accels {
			data := raw.(map[string]interface{})
			if data["count"].(int) == 0 {
				continue
			}
			guestAcceleratorConfig := map[string]interface{}{}
			if count := data["count"].(int); count != 0 {
				guestAcceleratorConfig["acceleratorCount"] = strconv.Itoa(count)
			}
			if v, ok := data["type"].(string); ok && v != "" {
				guestAcceleratorConfig["acceleratorType"] = v
			}
			if v, ok := data["gpu_partition_size"].(string); ok && v != "" {
				guestAcceleratorConfig["gpuPartitionSize"] = v
			}

			if v, ok := data["gpu_driver_installation_config"]; ok && len(v.([]interface{})) > 0 {
				gpuDriverInstallationConfig := data["gpu_driver_installation_config"].([]interface{})[0].(map[string]interface{})
				gpuDriverCfg := map[string]interface{}{}
				if v, ok := gpuDriverInstallationConfig["gpu_driver_version"].(string); ok && v != "" {
					gpuDriverCfg["gpuDriverVersion"] = v
				}
				guestAcceleratorConfig["gpuDriverInstallationConfig"] = gpuDriverCfg
			}

			if v, ok := data["gpu_sharing_config"]; ok && len(v.([]interface{})) > 0 {
				gpuSharingConfig := data["gpu_sharing_config"].([]interface{})[0].(map[string]interface{})
				gpuSharingCfg := map[string]interface{}{}
				if v, ok := gpuSharingConfig["gpu_sharing_strategy"].(string); ok && v != "" {
					gpuSharingCfg["gpuSharingStrategy"] = v
				}
				if v, ok := gpuSharingConfig["max_shared_clients_per_gpu"].(int); ok && v != 0 {
					gpuSharingCfg["maxSharedClientsPerGpu"] = strconv.Itoa(v)
				}
				guestAcceleratorConfig["gpuSharingConfig"] = gpuSharingCfg
			}

			guestAccelerators = append(guestAccelerators, guestAcceleratorConfig)
		}
		if len(guestAccelerators) > 0 {
			nc["accelerators"] = guestAccelerators
		}
	}

	if v, ok := nodeConfig["disk_size_gb"].(int); ok && v != 0 {
		nc["diskSizeGb"] = v
	}

	if v, ok := nodeConfig["disk_type"].(string); ok && v != "" {
		nc["diskType"] = v
	}

	if v, ok := nodeConfig["boot_disk"]; ok {
		if sub := expandBootDiskConfig(v); sub != nil {
			nc["bootDisk"] = sub
		}
	}

	if v, ok := nodeConfig["local_ssd_count"].(int); ok && v != 0 {
		nc["localSsdCount"] = v
	}

	if v, ok := nodeConfig["logging_variant"]; ok {
		variantConfig := map[string]interface{}{}
		if variant := v.(string); variant != "" {
			variantConfig["variant"] = variant
		}
		nc["loggingConfig"] = map[string]interface{}{
			"variantConfig": variantConfig,
		}
	}

{{ if ne $.TargetVersionName `ga` -}}
	if v, ok := nodeConfig["ephemeral_storage_config"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		esc := map[string]interface{}{}
		if v, ok := conf["local_ssd_count"].(int); ok && v != 0 {
			esc["localSsdCount"] = v
		}
		nc["ephemeralStorageConfig"] = esc
	}
{{- end }}
	if v, ok := nodeConfig["local_nvme_ssd_block_config"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		lnsbc := map[string]interface{}{}
		if v, ok := conf["local_ssd_count"].(int); ok && v != 0 {
			lnsbc["localSsdCount"] = v
		}
		nc["localNvmeSsdBlockConfig"] = lnsbc
	}

	if v, ok := nodeConfig["ephemeral_storage_local_ssd_config"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		eslsc := map[string]interface{}{}
		if v, ok := conf["local_ssd_count"].(int); ok && v != 0 {
			eslsc["localSsdCount"] = v
		}
		if dataCacheCount, ok := conf["data_cache_count"].(int); ok && dataCacheCount != 0 {
			eslsc["dataCacheCount"] = dataCacheCount
		}
		nc["ephemeralStorageLocalSsdConfig"] = eslsc
	}

	if v, ok := nodeConfig["secondary_boot_disks"]; ok && len(v.([]interface{})) > 0 {
		var secondaryBootDisks []map[string]interface{}
		conf, confOK := v.([]interface{})[0].(map[string]interface{})
		if confOK {
			sbd := map[string]interface{}{}
			if diskImage := conf["disk_image"].(string); diskImage != "" {
				sbd["diskImage"] = diskImage
			}
			if modeValue, modeOK := conf["mode"].(string); modeOK && modeValue != "" {
				sbd["mode"] = modeValue
			}
			secondaryBootDisks = append(secondaryBootDisks, sbd)
		} else {
			secondaryBootDisks = append(secondaryBootDisks, map[string]interface{}{})
		}
		if len(secondaryBootDisks) > 0 {
			nc["secondaryBootDisks"] = secondaryBootDisks
		}
	}

	if v, ok := nodeConfig["gcfs_config"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		gcfs := map[string]interface{}{}
		if enabled := conf["enabled"].(bool); enabled {
			gcfs["enabled"] = enabled
		}
		nc["gcfsConfig"] = gcfs
	}

	if v, ok := nodeConfig["gvnic"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		gvnic := map[string]interface{}{}
		if enabled := conf["enabled"].(bool); enabled {
			gvnic["enabled"] = enabled
		}
		nc["gvnic"] = gvnic
	}

	if v, ok := nodeConfig["fast_socket"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		fastSocket := map[string]interface{}{}
		if enabled := conf["enabled"].(bool); enabled {
			fastSocket["enabled"] = enabled
		}
		nc["fastSocket"] = fastSocket
	}

	if v, ok := nodeConfig["reservation_affinity"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		valuesSet := conf["values"].(*schema.Set)
		values := make([]string, valuesSet.Len())
		for i, value := range valuesSet.List() {
			values[i] = value.(string)
		}

		ra := map[string]interface{}{}
		if v, ok := conf["consume_reservation_type"].(string); ok && v != "" {
			ra["consumeReservationType"] = v
		}
		if v, ok := conf["key"].(string); ok && v != "" {
			ra["key"] = v
		}
		if len(values) > 0 {
			ra["values"] = values
		}
		nc["reservationAffinity"] = ra
	}

	if scopes, ok := nodeConfig["oauth_scopes"]; ok {
		scopesSet := scopes.(*schema.Set)
		scopes := make([]string, scopesSet.Len())
		for i, scope := range scopesSet.List() {
			scopes[i] = tpgresource.CanonicalizeServiceScope(scope.(string))
		}

		if len(scopes) > 0 {
			nc["oauthScopes"] = scopes
		} else {
			delete(nc, "oauthScopes")
		}
	}

	if v, ok := nodeConfig["service_account"].(string); ok && v != "" {
		nc["serviceAccount"] = v
	}

	if v, ok := nodeConfig["metadata"]; ok {
		m := make(map[string]string)
		for k, val := range v.(map[string]interface{}) {
			m[k] = val.(string)
		}
		if len(m) > 0 {
			nc["metadata"] = m
		}
	}

	if v, ok := nodeConfig["image_type"].(string); ok && v != "" {
		nc["imageType"] = v
	}

	if v, ok := nodeConfig["labels"]; ok {
		m := make(map[string]string)
		for k, val := range v.(map[string]interface{}) {
			m[k] = val.(string)
		}
		if len(m) > 0 {
			nc["labels"] = m
		}
	}

	if v, ok := nodeConfig["resource_labels"]; ok {
		m := make(map[string]string)
		for k, val := range v.(map[string]interface{}) {
			m[k] = val.(string)
		}
		if len(m) > 0 {
			nc["resourceLabels"] = m
		}
	}

	if v, ok := nodeConfig["resource_manager_tags"]; ok && len(v.(map[string]interface{})) > 0 {
		if sub := expandResourceManagerTags(v); sub != nil {
			nc["resourceManagerTags"] = sub
		}
	}

	if v, ok := nodeConfig["tags"]; ok {
		tagsList := v.([]interface{})
		tags := []string{}
		for _, v := range tagsList {
			if v != nil {
				tags = append(tags, v.(string))
			}
		}
		if len(tags) > 0 {
			nc["tags"] = tags
		}
	}

	if v, ok := nodeConfig["storage_pools"]; ok {
		spList := v.([]interface{})
		storagePools := []string{}
		for _, v := range spList {
			if v != nil {
				storagePools = append(storagePools, v.(string))
			}
		}
		if len(storagePools) > 0 {
			nc["storagePools"] = storagePools
		}
	}
	if v, ok := nodeConfig["shielded_instance_config"]; ok && len(v.([]interface{})) > 0 {
		conf := v.([]interface{})[0].(map[string]interface{})
		sic := map[string]interface{}{}
		if v, ok := conf["enable_secure_boot"].(bool); ok && v {
			sic["enableSecureBoot"] = v
