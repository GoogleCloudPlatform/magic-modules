func expandRegistryHosts(v interface{}) []map[string]interface{} {
	if v == nil {
		return nil
	}
	ls := v.([]interface{})
	if len(ls) == 0 {
		return nil
	}
	registryHosts := make([]map[string]interface{}, 0, len(ls))
	for _, raw := range ls {
		data := raw.(map[string]interface{})
		rh := map[string]interface{}{}
		if v, ok := data["server"].(string); ok && v != "" {
			rh["server"] = v
		}
		if v, ok := data["hosts"]; ok {
			hosts := v.([]interface{})
			hostsSlice := make([]map[string]interface{}, 0, len(hosts))
			for _, rawHost := range hosts {
				hostData := rawHost.(map[string]interface{})
				h := map[string]interface{}{}
				if v, ok := hostData["host"].(string); ok && v != "" {
					h["host"] = v
				}
				if v, ok := hostData["override_path"].(bool); ok && v {
					h["overridePath"] = v
				}
				if v, ok := hostData["dial_timeout"].(string); ok && v != "" {
					h["dialTimeout"] = v
				}
				if v, ok := hostData["capabilities"]; ok {
					cap := v.([]interface{})
					caps := make([]string, len(cap))
					for i, c := range cap {
						caps[i] = c.(string)
					}
					if len(caps) > 0 {
						h["capabilities"] = caps
					}
				}
				if v, ok := hostData["header"]; ok {
					headers := v.([]interface{})
					headerSlice := make([]map[string]interface{}, len(headers))
					for i, headerRaw := range headers {
						headerSlice[i] = expandRegistryHeader(headerRaw)
					}
					if len(headerSlice) > 0 {
						h["header"] = headerSlice
					}
				}
				if v, ok := hostData["ca"]; ok {
					ca := v.([]interface{})
					caSlice := make([]map[string]interface{}, len(ca))
					for i, caRaw := range ca {
						caSlice[i] = expandRegistryCertificateConfig(caRaw)
					}
					if len(caSlice) > 0 {
						h["ca"] = caSlice
					}
				}
				if v, ok := hostData["client"]; ok {
					client := v.([]interface{})
					clientSlice := make([]map[string]interface{}, len(client))
					for i, clientRaw := range client {
						clientSlice[i] = expandRegistryCertificateConfigPair(clientRaw)
					}
					if len(clientSlice) > 0 {
						h["client"] = clientSlice
					}
				}
				hostsSlice = append(hostsSlice, h)
			}
			if len(hostsSlice) > 0 {
				rh["hosts"] = hostsSlice
			}
		}
		registryHosts = append(registryHosts, rh)
	}
	return registryHosts
}

func expandRegistryHeader(v interface{}) map[string]interface{} {
	header := map[string]interface{}{}
	if v == nil {
		return header
	}
	ls := v.(map[string]interface{})
	if val, ok := ls["key"].(string); ok && val != "" {
		header["key"] = val
	}
	if val, ok := ls["value"]; ok {
		headerVal := val.([]interface{})
		vals := make([]string, len(headerVal))
		for i, hv := range headerVal {
			vals[i] = hv.(string)
		}
		if len(vals) > 0 {
			header["value"] = vals
		}
	}
	return header
}

