func expandNodeNetworkConfig(v interface{}) map[string]interface{} {
	networkNodeConfigs := v.([]interface{})

	nnc := map[string]interface{}{}

	if len(networkNodeConfigs) == 0 {
		return nnc
	}

	networkNodeConfig := networkNodeConfigs[0].(map[string]interface{})

	if v, ok := networkNodeConfig["create_pod_range"]; ok {
		setField(nnc, "createPodRange", v.(bool))
	}

	if v, ok := networkNodeConfig["pod_range"]; ok {
		setField(nnc, "podRange", v.(string))
	}

	if v, ok := networkNodeConfig["pod_ipv4_cidr_block"]; ok {
		setField(nnc, "podIpv4CidrBlock", v.(string))
	}

	if v, ok := networkNodeConfig["enable_private_nodes"]; ok {
		nnc["enablePrivateNodes"] = v.(bool)
	}

	if v, ok := networkNodeConfig["additional_node_network_configs"]; ok && len(v.([]interface{})) > 0 {
		node_network_configs := v.([]interface{})
		nodeNetworkConfigs := make([]map[string]interface{}, 0, len(node_network_configs))
		for _, raw := range node_network_configs {
			data := raw.(map[string]interface{})
			networkConfig := map[string]interface{}{}
			setField(networkConfig, "network", data["network"].(string))
			setField(networkConfig, "subnetwork", data["subnetwork"].(string))
			{{ if ne $.TargetVersionName `ga` -}}
			setField(networkConfig, "stackType", data["stack_type"].(string))
			{{- end }}
			nodeNetworkConfigs = append(nodeNetworkConfigs, networkConfig)
		}
		setField(nnc, "additionalNodeNetworkConfigs", nodeNetworkConfigs)
	}

	if v, ok := networkNodeConfig["additional_pod_network_configs"]; ok && len(v.([]interface{})) > 0 {
		pod_network_configs := v.([]interface{})
		podNetworkConfigs := make([]map[string]interface{}, 0, len(pod_network_configs))
		for _, raw := range pod_network_configs {
			data := raw.(map[string]interface{})
			mpc := map[string]interface{}{}
			setStringIntField(mpc, "maxPodsPerNode", int64(data["max_pods_per_node"].(int)))
			podnetworkConfig := map[string]interface{}{
				"maxPodsPerNode": mpc,
			}
			setField(podnetworkConfig, "subnetwork", data["subnetwork"].(string))
			setField(podnetworkConfig, "secondaryPodRange", data["secondary_pod_range"].(string))
			podNetworkConfigs = append(podNetworkConfigs, podnetworkConfig)
		}
		setField(nnc, "additionalPodNetworkConfigs", podNetworkConfigs)
	}

	setField(nnc, "podCidrOverprovisionConfig", expandPodCidrOverprovisionConfig(networkNodeConfig["pod_cidr_overprovision_config"]))

	if v, ok := networkNodeConfig["network_performance_config"]; ok && len(v.([]interface{})) > 0 {
		npc := map[string]interface{}{}
		network_performance_config := v.([]interface{})[0].(map[string]interface{})
		if total_egress_bandwidth_tier, ok := network_performance_config["total_egress_bandwidth_tier"]; ok {
			setField(npc, "totalEgressBandwidthTier", total_egress_bandwidth_tier.(string))
		}
		nnc["networkPerformanceConfig"] = npc
	}
	if v, ok := networkNodeConfig["accelerator_network_profile"]; ok {
		setField(nnc, "acceleratorNetworkProfile", v.(string))
	}

	// Allow user to set the top-level node-pool subnetwork via network_config.subnetwork
	if v, ok := networkNodeConfig["subnetwork"]; ok {
		if s, ok := v.(string); ok && s != "" {
			nnc["subnetwork"] = s
		}
	}
	return nnc
}


func nodePoolUpdate(d *schema.ResourceData, meta interface{}, nodePoolInfo *NodePoolInformation, prefix string, timeout time.Duration) error {
	config := meta.(*transport_tpg.Config)
	name := d.Get(prefix + "name").(string)

	userAgent, err :=  tpgresource.GenerateUserAgentString(d, config.UserAgent)
	if err != nil {
		return err
	}


	// Nodepool write-lock will be acquired when update function is called.
	npLockKey := nodePoolInfo.nodePoolLockKey(name)

	if d.HasChange(prefix + "autoscaling") {
		update := map[string]interface{}{}
		setField(update, "desiredNodePoolId", name)
		if v, ok := d.GetOk(prefix + "autoscaling"); ok {
			autoscaling := v.([]interface{})[0].(map[string]interface{})
			desiredAutoscaling := map[string]interface{}{
				"enabled":           true,
				"minNodeCount":      int64(autoscaling["min_node_count"].(int)),
				"totalMinNodeCount": int64(autoscaling["total_min_node_count"].(int)),
			}
			setField(desiredAutoscaling, "maxNodeCount", int64(autoscaling["max_node_count"].(int)))
			setField(desiredAutoscaling, "totalMaxNodeCount", int64(autoscaling["total_max_node_count"].(int)))
			setField(desiredAutoscaling, "locationPolicy", autoscaling["location_policy"].(string))
			update["desiredNodePoolAutoscaling"] = desiredAutoscaling
		} else {
			update["desiredNodePoolAutoscaling"] = map[string]interface{}{}
		}

		req := map[string]interface{}{
			"update": update,
		}

		updateF := func() error {
			url := fmt.Sprintf("%s%s", transport_tpg.BaseUrl(Product, config), nodePoolInfo.parent())
			op, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
				Config:    config,
				Method:    "PUT",
				Project:   nodePoolInfo.project,
				RawURL:    url,
				UserAgent: userAgent,
				Body:      req,
			})
			if err != nil {
				return err
			}

			// Wait until it's updated
			return ContainerOperationWait(config, op,
				nodePoolInfo.project,
				nodePoolInfo.location, "updating GKE node pool", userAgent,
				timeout)
		}

		if err := retryWhileIncompatibleOperation(timeout, npLockKey, updateF); err != nil {
			return err
		}
		log.Printf("[INFO] Updated autoscaling in Node Pool %s", d.Id())
	}

	if d.HasChange(prefix + "node_config") {
		if err := nodePoolNodeConfigUpdate(d, config, nodePoolInfo, prefix, name, timeout); err != nil {
			return err
		}
	}

	if d.HasChange(prefix + "node_count") {
		newSize := int64(d.Get(prefix + "node_count").(int))
		req := map[string]interface{}{}
		setField(req, "nodeCount", newSize)
		updateF := func() error {
			url := fmt.Sprintf("%s%s:setSize", transport_tpg.BaseUrl(Product, config), nodePoolInfo.fullyQualifiedName(name))
			op, err := transport_tpg.SendRequest(transport_tpg.SendRequestOptions{
				Config:    config,
				Method:    "POST",
				Project:   nodePoolInfo.project,
				RawURL:    url,
				UserAgent: userAgent,
				Body:      req,
			})

			if err != nil {
				return err
			}

			// Wait until it's updated
