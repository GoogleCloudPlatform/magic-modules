func flattenNodePool(d *schema.ResourceData, config *transport_tpg.Config, np map[string]interface{}, prefix string) (map[string]interface{}, error) {
	userAgent, err :=  tpgresource.GenerateUserAgentString(d, config.UserAgent)
	if err != nil {
		return nil, err
	}

	size := 0
	igmUrls := []string{}
	managedIgmUrls := []string{}
	nodeCount := 0
	npName := flattenString(np["name"])
	initialNodeCount := flattenInt(np["initialNodeCount"])
	instanceGroupUrls := flattenStringSlice(np["instanceGroupUrls"])

	var ignoreNodeCountChanges bool
	if v := d.Get(prefix + "ignore_node_count_changes"); v != nil {
		ignoreNodeCountChanges = v.(bool)
	}
	if v := d.Get("ignore_node_count_changes"); v != nil {
		ignoreNodeCountChanges = ignoreNodeCountChanges || v.(bool)
	}

	if ignoreNodeCountChanges {
		log.Printf("[DEBUG] Skipping IGM fetch for node pool %q due to ignore_node_count_changes = true", npName)
		if v, ok := d.GetOkExists(prefix + "node_count"); ok {
			nodeCount = v.(int)
		} else {
			nodeCount = initialNodeCount
		}
		// When ignoring, we might not get exact matching IGMs but we can still pass the unvalidated list from API
		// or leave them empty. Passing the API URLs to igmUrls at least populates them for basic usage.
		for _, url := range instanceGroupUrls {
			igmUrls = append(igmUrls, url)
			igmCache.invalidateItem(url)
		}
	} else {
		for _, url := range instanceGroupUrls {
			// retrieve instance group manager (InstanceGroupUrls are actually URLs for InstanceGroupManagers)
			matches := instanceGroupManagerURL.FindStringSubmatch(url)
			if len(matches) < 4 {
				return nil, fmt.Errorf("Error reading instance group manage URL '%q'", url)
			}
			if strings.HasPrefix("gk3", matches[3]) {
				// IGM is autopilot so we know it will not be found, skip it
				continue
			}
			if err := igmCache.refreshIfNeeded(d, config, userAgent, npName, url); err != nil {
				return nil, err
			}
			igm, ok := igmCache.get(matches[0])
			if !ok {
				// The IGM URL is stale; don't include it
				continue
			}
			targetSize, ok := igm["targetSize"].(float64)
			if !ok {
				return nil, fmt.Errorf("targetSize field is missing or not a number in instance group manager %q", matches[0])
			}
			size += int(targetSize)
			igmUrls = append(igmUrls, url)
			instanceGroup, _ := igm["instanceGroup"].(string)
			managedIgmUrls = append(managedIgmUrls, instanceGroup)
		}
		if len(igmUrls) > 0 {
			nodeCount = size / len(igmUrls)
		}
	}
	nodePool := map[string]interface{}{
		"name":                        npName,
		"name_prefix":                 d.Get(prefix + "name_prefix"),
		"initial_node_count":          initialNodeCount,
		"node_locations":              schema.NewSet(schema.HashString, tpgresource.ConvertStringArrToInterface(flattenStringSlice(np["locations"]))),
		"node_count":                  nodeCount,
		"node_config":                 flattenNodeConfig(getMap(np, "config"), d.Get(prefix+"node_config")),
		"instance_group_urls":         igmUrls,
		"managed_instance_group_urls": managedIgmUrls,
		"version":                     flattenString(np["version"]),
		"network_config":              flattenNodeNetworkConfig(getMap(np, "networkConfig"), d, prefix),
		"ignore_node_count_changes":   d.Get(prefix + "ignore_node_count_changes"),
	}

	if autoscaling := getMap(np, "autoscaling"); autoscaling != nil {
		if flattenBool(autoscaling["enabled"]) {
			nodePool["autoscaling"] = []map[string]interface{}{
				{
					"min_node_count":       flattenInt(autoscaling["minNodeCount"]),
					"max_node_count":       flattenInt(autoscaling["maxNodeCount"]),
					"total_min_node_count": flattenInt(autoscaling["totalMinNodeCount"]),
					"total_max_node_count": flattenInt(autoscaling["totalMaxNodeCount"]),
					"location_policy":      flattenString(autoscaling["locationPolicy"]),
				},
			}
		} else {
			nodePool["autoscaling"] = []map[string]interface{}{}
		}
	}

	if placementPolicy := getMap(np, "placementPolicy"); placementPolicy != nil {
		nodePool["placement_policy"] = []map[string]interface{}{
			{
				"type":         flattenString(placementPolicy["type"]),
				"policy_name":  flattenString(placementPolicy["policyName"]),
				"tpu_topology": flattenString(placementPolicy["tpuTopology"]),
			},
		}
	}

	if queuedProvisioning := getMap(np, "queuedProvisioning"); queuedProvisioning != nil {
		nodePool["queued_provisioning"] = []map[string]interface{}{
			{
				"enabled": flattenBool(queuedProvisioning["enabled"]),
			},
		}
	}

	if bep := getMap(np, "bestEffortProvisioning"); bep != nil && flattenBool(bep["enabled"]) {
		nodePool["best_effort_provisioning"] = []map[string]interface{}{
			{
				"enabled":             true,
				"min_provision_nodes": flattenInt(bep["minProvisionNodes"]),
			},
		}
	} else if v, ok := d.GetOk(prefix + "best_effort_provisioning"); ok && len(v.([]interface{})) > 0 {
		// The API omits bestEffortProvisioning when it is disabled. Keep an explicitly
		// configured `enabled = false` block in state so it doesn't cause a permadiff.
		nodePool["best_effort_provisioning"] = []map[string]interface{}{
			{
				"enabled":             false,
				"min_provision_nodes": 0,
			},
		}
	}

	if maxPodsConstraint := getMap(np, "maxPodsConstraint"); maxPodsConstraint != nil {
		nodePool["max_pods_per_node"] = flattenInt(maxPodsConstraint["maxPodsPerNode"])
	}

	if management := getMap(np, "management"); management != nil {
		nodePool["management"] = []map[string]interface{}{
			{
				"auto_repair":  flattenBool(management["autoRepair"]),
				"auto_upgrade": flattenBool(management["autoUpgrade"]),
			},
		}
	}

	if upgradeSettings := getMap(np, "upgradeSettings"); upgradeSettings != nil {
		nodePool["upgrade_settings"] = flattenNodePoolUpgradeSettings(upgradeSettings)
	} else {
		delete(nodePool, "upgrade_settings")
	}

	if nodeDrainConfig := getMap(np, "nodeDrainConfig"); nodeDrainConfig != nil {
		nodePool["node_drain_config"] = flattenNodePoolNodeDrainConfig(nodeDrainConfig)
	}

	if maintenancePolicy := getMap(np, "maintenancePolicy"); maintenancePolicy != nil {
		nodePool["maintenance_policy"] = flattenNodePoolMaintenancePolicy(maintenancePolicy)
	}

	return nodePool, nil
}

