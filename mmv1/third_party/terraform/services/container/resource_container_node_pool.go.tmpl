			setField(upgradeSettings, "strategy", strategy)
		}

		if d.HasChange(prefix + "upgrade_settings.0.max_surge") {
			if strategy != "SURGE" {
				return nil, fmt.Errorf("Surge upgrade settings may not be changed when surge strategy is not enabled")
			}
			if v, ok := upgradeSettingsConfig["max_surge"]; ok {
				setField(upgradeSettings, "maxSurge", int64(v.(int)))
			}
		}

		if d.HasChange(prefix + "upgrade_settings.0.max_unavailable") {
			if strategy != "SURGE" {
				return nil, fmt.Errorf("Surge upgrade settings may not be changed when surge strategy is not enabled")
			}
			if v, ok := upgradeSettingsConfig["max_unavailable"]; ok {
				setField(upgradeSettings, "maxUnavailable", int64(v.(int)))
			}
		}

		if v, ok := upgradeSettingsConfig["blue_green_settings"]; ok && len(v.([]interface{})) > 0 {
			blueGreenSettingsConfig := v.([]interface{})[0].(map[string]interface{})
			blueGreenSettings := map[string]interface{}{}

			if strategy != "BLUE_GREEN" {
				return nil, fmt.Errorf("Blue-green upgrade settings may not be changed when blue-green strategy is not enabled")
			}

			{{ if ne $.TargetVersionName `ga` -}}
			if s, ok1 := blueGreenSettingsConfig["standard_rollout_policy"]; ok1 && len(s.([]interface{})) > 0 {
				if a, ok2 := blueGreenSettingsConfig["autoscaled_rollout_policy"]; ok2 && len(a.([]interface{})) > 0{
					return nil, fmt.Errorf("`standard_rollout_policy` and `autoscaled_rollout_policy` cannot be set at the same time")
				}
			}
			{{- end }}

			if v, ok := blueGreenSettingsConfig["node_pool_soak_duration"]; ok {
				setField(blueGreenSettings, "nodePoolSoakDuration", v.(string))
			}

			if v, ok := blueGreenSettingsConfig["standard_rollout_policy"]; ok && len(v.([]interface{})) > 0 {
				standardRolloutPolicy := map[string]interface{}{}
				if standardRolloutPolicyConfig, ok := v.([]interface{})[0].(map[string]interface{}); ok {
					if v, ok := standardRolloutPolicyConfig["batch_soak_duration"]; ok {
						setField(standardRolloutPolicy, "batchSoakDuration", v.(string))
					}
					if v, ok := standardRolloutPolicyConfig["batch_node_count"]; ok {
						setField(standardRolloutPolicy, "batchNodeCount", int64(v.(int)))
					}
					if v, ok := standardRolloutPolicyConfig["batch_percentage"]; ok {
						setField(standardRolloutPolicy, "batchPercentage", v.(float64))
					}
				}

				blueGreenSettings["standardRolloutPolicy"] = standardRolloutPolicy
			}
			{{ if ne $.TargetVersionName `ga` -}}
			if v, ok := blueGreenSettingsConfig["autoscaled_rollout_policy"]; ok && len(v.([]interface{})) > 0 {
				autoscaledRolloutPolicy := map[string]interface{}{}
				if autoscaledRolloutPolicyConfig, ok := v.([]interface{})[0].(map[string]interface{}); ok {
					if v, ok := autoscaledRolloutPolicyConfig["wait_for_drain_duration"]; ok {
						setField(autoscaledRolloutPolicy, "waitForDrainDuration", v.(string))
					}
				}
				blueGreenSettings["autoscaledRolloutPolicy"] = autoscaledRolloutPolicy
			}
			{{- end }}
			upgradeSettings["blueGreenSettings"] = blueGreenSettings
		}
		np["upgradeSettings"] = upgradeSettings
	}

	if v, ok := d.GetOk(prefix + "node_drain_config"); ok {
		nodeDrainConfig := v.([]interface{})[0].(map[string]interface{})
		ndc := map[string]interface{}{}

		if v, ok := nodeDrainConfig["respect_pdb_during_node_pool_deletion"]; ok {
			setField(ndc, "respectPdbDuringNodePoolDeletion", v.(bool))
		}
		if v, ok := nodeDrainConfig["grace_termination_duration"]; ok {
			setField(ndc, "graceTerminationDuration", v.(string))
		}
		if v, ok := nodeDrainConfig["pdb_timeout_duration"]; ok {
			setField(ndc, "pdbTimeoutDuration", v.(string))
		}
		np["nodeDrainConfig"] = ndc
	}

	if v, ok := d.GetOk(prefix + "maintenance_policy"); ok {
		maintenancePolicy := v.([]interface{})[0].(map[string]interface{})
		if v, ok := maintenancePolicy["exclusion_until_end_of_support"]; ok && len(v.([]interface{})) > 0 {
			excl := map[string]interface{}{}
			if exclusionUntilEndOfSupport, ok := v.([]interface{})[0].(map[string]interface{}); ok {
				if v, ok := exclusionUntilEndOfSupport["enabled"]; ok {
					setField(excl, "enabled", v.(bool))
				}
			}
			np["maintenancePolicy"] = map[string]interface{}{
				"exclusionUntilEndOfSupport": excl,
			}
		}
	}

	return np, nil
}

